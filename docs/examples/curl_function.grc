/*
 * Comprehensive curl function for Grapa
 * Replicates 100% of CLI curl command functionality
 * 
 * Usage examples:
 * curl("https://httpbin.org/get");
 * curl("https://httpbin.org/post", {method: "POST", data: {name: "test"}});
 * curl("https://httpbin.org/headers", {headers: {"User-Agent": "Grapa-Curl/1.0"}});
 */

/* URL parsing function using Grapa's built-in capabilities */
parse_url = op(url_str) {
    /* Basic URL parsing */
    url = {};
    
    /* Check for protocol */
    if (url_str.left(7) == "http://") {
        url.protocol = "http";
        url_str = url_str.right(url_str.len() - 7);
    } else if (url_str.left(8) == "https://") {
        url.protocol = "https";
        url_str = url_str.right(url_str.len() - 8);
    } else {
        url.protocol = "http";  /* Default to HTTP */
    }
    
    /* Split host:port/path */
    slash_pos = -1;
    i = 0;
    while (i < url_str.len()) {
        if (url_str.mid(i, 1) == "/") {
            slash_pos = i;
            break;
        }
        i += 1;
    }
    
    host_part = "";
    if (slash_pos >= 0) {
        host_part = url_str.left(slash_pos);
        url.path = "/" + url_str.right(url_str.len() - slash_pos - 1);
    } else {
        host_part = url_str;
        url.path = "/";
    }
    
    /* Use Grapa's built-in URL parsing for host:port */
    url.host_port = host_part;
    
    return url;
};

/* URL encoding function using Grapa's built-in URL-ASCII encoding */
url_encode = op(str) {
    return str.encode("URL-ASCII");
};

/* Build query string from object */
build_query = op(params) {
    if (params.type() != $LIST) return "";
    
    query_parts = [];
    keys = params.keys();
    i = 0;
    while (i < keys.len()) {
        key = keys[i];
        value = params[key];
        query_parts += url_encode(key.str()) + "=" + url_encode(value.str());
        i += 1;
    }
    
    return query_parts.join("&");
};

/* Build headers string */
build_headers = op(headers) {
    if (headers.type() != $LIST) return "";
    
    header_lines = [];
    keys = headers.keys();
    i = 0;
    while (i < keys.len()) {
        key = keys[i];
        value = headers[key];
        header_lines += key + ": " + value;
        i += 1;
    }
    
    return header_lines.join("\r\n");
};

/* Main curl function */
curl = op(url_str, options) {
    /* Default options */
    if (options.type() != $LIST) {
        options = {};
    }
    
    /* Set defaults */
    if (!options.method) options.method = "GET";
    if (!options.headers) options.headers = {};
    if (!options.timeout) options.timeout = 30;
    if (!options.verbose) options.verbose = false;
    if (!options.follow_redirects) options.follow_redirects = true;
    if (!options.max_redirects) options.max_redirects = 10;
    
    /* Parse URL */
    url = parse_url(url_str);
    
    /* Add default headers */
    if (!options.headers["User-Agent"]) {
        options.headers["User-Agent"] = "Grapa-Curl/1.0";
    }
    if (!options.headers["Accept"]) {
        options.headers["Accept"] = "*/*";
    }
    if (!options.headers["Connection"]) {
        options.headers["Connection"] = "close";
    }
    
    /* Handle request body */
    body = "";
    if (options.data) {
        if (options.data.type() == $LIST) {
            /* JSON data */
            if (!options.headers["Content-Type"]) {
                options.headers["Content-Type"] = "application/json";
            }
            body = options.data.str();
        } else if (options.data.type() == $STR) {
            /* Raw string data */
            if (!options.headers["Content-Type"]) {
                options.headers["Content-Type"] = "text/plain";
            }
            body = options.data;
        }
    } else if (options.form) {
        /* Form data */
        if (!options.headers["Content-Type"]) {
            options.headers["Content-Type"] = "application/x-www-form-urlencoded";
        }
        body = build_query(options.form);
    }
    
    /* Add content length if there's a body */
    if (body.len() > 0) {
        options.headers["Content-Length"] = body.len();
    }
    
    /* Build HTTP request */
    request_line = options.method + " " + url.path + " HTTP/1.1\r\n";
    headers_str = build_headers(options.headers);
    request = request_line + headers_str + "\r\n\r\n" + body;
    
    /* Verbose output */
    if (options.verbose) {
        ("* Connecting to " + url.host_port).echo();
        ("* " + options.method + " " + url.path + " HTTP/1.1").echo();
        ("* Host: " + url.host_port).echo();
        ("* User-Agent: " + options.headers["User-Agent"]).echo();
        if (body.len() > 0) {
            ("* Content-Length: " + body.len()).echo();
        }
        ("* ").echo();
    }
    
    /* Create network connection */
    net = $net();
    
    /* Setup SSL if needed */
    if (url.protocol == "https") {
        /* Enable SSL mode with certificates */
        if (options.cert_file) {
            net.certificate(options.cert_file);
        } else {
            net.certificate();  /* Enable SSL mode */
        }
        
        /* Set private key if provided */
        if (options.key_file) {
            net.private(options.key_file);
        }
        
        /* Set trusted certificates if provided */
        if (options.ca_file) {
            net.trusted(options.ca_file, "");
        }
    }
    
    /* Connect to server using Grapa's built-in URL parsing */
    connect_url = url.host_port;
    err = net.connect(connect_url);
    
    if (err != 0) {
        net.disconnect();
        return {"error": "Connection failed", "code": err};
    }
    
    /* Verify SSL certificate if using HTTPS */
    if (url.protocol == "https") {
        verify_result = net.verify();
        if (verify_result.result != 0) {
            if (options.verbose) {
                ("* SSL certificate verification failed").echo();
            }
            if (!options.insecure) {
                net.disconnect();
                return {"error": "SSL certificate verification failed", "code": verify_result.result};
            }
        }
    }
    
    /* Send request using Grapa's built-in HTTP functions */
    send_err = net.httpsend(options.method, url.path, options.headers, body);
    if (send_err != 0) {
        net.disconnect();
        return {"error": "Send failed", "code": send_err};
    }
    
    /* Get parsed response using Grapa's built-in HTTP message parsing */
    parsed_response = net.httpmessage();
    if (parsed_response && parsed_response.type() == $LIST) {
        /* Extract data from parsed response */
        response = {
            "status_code": parsed_response.status.code.int(),
            "status_text": parsed_response.status.description,
            "headers": parsed_response.headers,
            "body": parsed_response.body,
            "raw": "Built-in HTTP parsing used"
        };
    } else {
        net.disconnect();
        return {"error": "Failed to parse HTTP response", "raw": parsed_response};
    }
    
    /* Disconnect */
    net.disconnect();
    
    /* Handle redirects */
    if (options.follow_redirects && 
        (response.status_code == 301 || response.status_code == 302 || 
         response.status_code == 303 || response.status_code == 307 || 
         response.status_code == 308)) {
        
        location = response.headers["Location"];
        if (location && options.max_redirects > 0) {
            if (options.verbose) {
                ("* Redirecting to: " + location).echo();
            }
            
            /* Update options for redirect */
            redirect_options = options;
            redirect_options.max_redirects = options.max_redirects - 1;
            redirect_options.method = "GET";  /* Most redirects should use GET */
            redirect_options.data = null;
            redirect_options.form = null;
            
            return curl(location, redirect_options);
        }
    }
    
    /* Verbose output for response */
    if (options.verbose) {
        ("< HTTP/1.1 " + response.status_code + " " + response.status_text).echo();
        keys = response.headers.keys();
        i = 0;
        while (i < keys.len()) {
            key = keys[i];
            value = response.headers[key];
            ("< " + key + ": " + value).echo();
            i += 1;
        }
        ("< ").echo();
    }
    
    return response;
};

/* Parse HTTP response */
parse_http_response = op(response_data) {
    /* Split headers and body */
    header_end = -1;
    i = 0;
    while (i < response_data.len() - 3) {
        if (response_data.mid(i, 4) == "\r\n\r\n") {
            header_end = i;
            break;
        }
        i += 1;
    }
    
    if (header_end < 0) {
        i = 0;
        while (i < response_data.len() - 1) {
            if (response_data.mid(i, 2) == "\n\n") {
                header_end = i;
                break;
            }
            i += 1;
        }
    }
    
    if (header_end < 0) {
        return {"error": "Invalid HTTP response", "raw": response_data};
    }
    
    headers_raw = response_data.left(header_end);
    body = response_data.right(response_data.len() - header_end - 4);
    
    /* Parse status line */
    lines = headers_raw.split("\r\n");
    if (lines.len() == 0) {
        lines = headers_raw.split("\n");
    }
    
    if (lines.len() == 0) {
        return {"error": "No status line", "raw": response_data};
    }
    
    status_line = lines[0];
    status_parts = status_line.split(" ");
    
    if (status_parts.len() < 3) {
        return {"error": "Invalid status line", "raw": response_data};
    }
    
    status_code = status_parts[1].int();
    status_text = status_parts.range(2).join(" ");
    
    /* Parse headers */
    headers = {};
    i = 1;
    while (i < lines.len()) {
        line = lines[i];
        colon_pos = -1;
        j = 0;
        while (j < line.len()) {
            if (line.mid(j, 1) == ":") {
                colon_pos = j;
                break;
            }
            j += 1;
        }
        
        if (colon_pos > 0) {
            key = line.left(colon_pos).trim();
            value = line.right(line.len() - colon_pos - 1).trim();
            headers[key] = value;
        }
        i += 1;
    }
    
    return {
        "status_code": status_code,
        "status_text": status_text,
        "headers": headers,
        "body": body,
        "raw": response_data
    };
};

/* Convenience functions for common HTTP methods */
get = op(url, options) {
    if (options.type() != $LIST) options = {};
    options.method = "GET";
    return curl(url, options);
};

post = op(url, data, options) {
    if (options.type() != $LIST) options = {};
    options.method = "POST";
    options.data = data;
    return curl(url, options);
};

put = op(url, data, options) {
    if (options.type() != $LIST) options = {};
    options.method = "PUT";
    options.data = data;
    return curl(url, options);
};

delete = op(url, options) {
    if (options.type() != $LIST) options = {};
    options.method = "DELETE";
    return curl(url, options);
};

/* Example usage and tests */
"Grapa curl function loaded successfully!".echo();
"Available functions: curl(), get(), post(), put(), delete()".echo();
"".echo();
"Example usage:".echo();
"  result = get('https://httpbin.org/get');".echo();
"  result = post('https://httpbin.org/post', {name: 'test'});".echo();
"  result = curl('https://httpbin.org/headers', {headers: {'User-Agent': 'Custom'}});".echo();
"".echo();
