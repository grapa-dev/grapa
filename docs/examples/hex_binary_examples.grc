/* Hex and Binary Literals Examples
   Demonstrates Grapa's enhanced hex and binary literal support */

"=== Hex and Binary Literals Examples ===".echo();

/* Basic hex literals */
"Basic hex literals:".echo();
0x12.echo();              /* 18 */
0xABCD.echo();            /* 43981 */
0xAbCd.echo();            /* 43981 (case insensitive) */
0x123456.echo();          /* 1193046 */

/* Hex with underscores for readability */
"Hex with underscores:".echo();
0x12_34.echo();           /* 4660 */
0x12_34_56.echo();        /* 1193046 */
0xABCD_EF01.echo();       /* 2882400001 */

/* Hex floats */
"Hex floats:".echo();
0x12.34.echo();           /* 18.203125 */
0x12_34.56_78.echo();     /* 4660.33984375 */
0xABCD.EF01.echo();       /* 43981.937255859375 */

/* Basic binary literals */
"Basic binary literals:".echo();
0b010.echo();             /* 2 */
0b1010.echo();            /* 10 */
0b11111111.echo();        /* 255 */
0b10101010.echo();        /* 170 */

/* Binary with underscores */
"Binary with underscores:".echo();
0b010_101.echo();         /* 21 */
0b1010_1010.echo();       /* 170 */
0b1111_1111_1111_1111.echo(); /* 65535 */

/* Binary floats */
"Binary floats:".echo();
0b010.011.echo();         /* 2.375 */
0b010_101.011_001.echo(); /* 21.1875 */
0b1010.1010.echo();       /* 10.625 */

/* Type behavior */
"Type behavior:".echo();
0x12.type().echo();       /* $INT */
0x12.34.type().echo();    /* $FLOAT */
0b010.type().echo();      /* $INT */
0b010.011.type().echo();  /* $FLOAT */

/* Method calls on hex/binary literals */
"Method calls:".echo();
0x12.hex().echo();        /* "12" */
0x12.int().echo();        /* 18 */
0x12.float().echo();      /* 18.0 */
0b010.bin().echo();       /* "10" */
0b010.int().echo();       /* 2 */
0b010.float().echo();     /* 2.0 */

/* String parsing with .exec() */
"String parsing:".echo();
'0x12'.exec().echo();           /* 18 */
'0x12.34'.exec().echo();        /* 18.203125 */
'0b101'.exec().echo();          /* 5 */
'0b101.011'.exec().echo();      /* 5.375 */
'0x12_34'.exec().echo();        /* 4660 */
'0b010_101'.exec().echo();      /* 21 */

/* Mathematical operations */
"Mathematical operations:".echo();
(0x12 + 0b101).echo();          /* 23 (18 + 5) */
(0x12 * 0b101).echo();          /* 90 (18 * 5) */
(0x12.34 + 0b101.011).echo();   /* 23.578125 */

/* Comparisons */
"Comparisons:".echo();
(0x12 == 18).echo();            /* true */
(0b101 == 5).echo();            /* true */
(0x12 > 0b101).echo();          /* true */
(0x12.34 > 0b101.011).echo();   /* true */

/* Large numbers */
"Large numbers:".echo();
0xFFFFFFFF.echo();              /* 4294967295 */
0b11111111111111111111111111111111.echo(); /* 4294967295 */

/* Edge cases */
"Edge cases:".echo();
0x0.echo();                     /* 0 */
0x0.0.echo();                   /* 0.0 */
0b0.echo();                     /* 0 */
0b0.0.echo();                   /* 0.0 */

/* Practical examples */
"Practical examples:".echo();

/* Color values */
red = 0xFF0000;     /* Red color */
green = 0x00FF00;   /* Green color */
blue = 0x0000FF;    /* Blue color */
("Red: " + red.str()).echo();
("Green: " + green.str()).echo();
("Blue: " + blue.str()).echo();

/* Bit flags */
READ = 0b001;       /* Read permission */
WRITE = 0b010;      /* Write permission */
EXECUTE = 0b100;    /* Execute permission */
permissions = READ + WRITE;  /* Read and write */
("Permissions: " + permissions.str()).echo();

/* Memory addresses (simulated) */
base_addr = 0x1000_0000;    /* Base memory address */
offset = 0x0000_1000;       /* Offset */
final_addr = base_addr + offset;
("Final address: " + final_addr.str()).echo();

/* Network addresses */
ip_addr = 0xC0A80101;       /* 192.168.1.1 in hex */
("IP address: " + ip_addr.str()).echo();

"=== Examples completed ===".echo();
