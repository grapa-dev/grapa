/*
 * File Operations: Method Usage Patterns
 * 
 * This example demonstrates the proper usage patterns for
 * .get()/.set() and .getfield()/.setfield() methods.
 */

f = $file();

/* ========================================
 * USAGE PATTERN COMPARISON
 * ======================================== */

"=== USAGE PATTERN COMPARISON ===".echo();

/* Simple file operations - use .set() */
f.set("config.txt", "Simple configuration content");
f.set("log.txt", "Log entry content");

/* Structured data operations - use .setfield() */
f.setfield("user1", "name", "Alice");     /* key=user1, field=name, value=Alice */
f.setfield("user1", "age", 25);           /* key=user1, field=age, value=25 */
f.setfield("user1", "job", "Engineer");   /* key=user1, field=job, value=Engineer */

f.setfield("user2", "name", "Bob");       /* key=user2, field=name, value=Bob */
f.setfield("user2", "age", 30);           /* key=user2, field=age, value=30 */
f.setfield("user2", "job", "Designer");   /* key=user2, field=job, value=Designer */

/* ========================================
 * RETRIEVAL COMPARISON
 * ======================================== */

"=== RETRIEVAL COMPARISON ===".echo();

/* Simple file retrieval - use .get() */
config_content = f.get("config.txt");
log_content = f.get("log.txt");

/* Structured data retrieval - use .getfield() */
name1 = f.getfield("user1", "name");
age1 = f.getfield("user1", "age");
job1 = f.getfield("user1", "job");

name2 = f.getfield("user2", "name");
age2 = f.getfield("user2", "age");
job2 = f.getfield("user2", "job");

"Simple files:".echo();
"  Config: " + config_content.hex().str().echo();
"  Log: " + log_content.hex().str().echo();

"User 1 (structured data):".echo();
"  Name: " + name1.echo();
"  Age: " + age1.echo();
"  Job: " + job1.echo();

"User 2 (structured data):".echo();
"  Name: " + name2.echo();
"  Age: " + age2.echo();
"  Job: " + job2.echo();

/* ========================================
 * USE CASE EXAMPLES
 * ======================================== */

"=== USE CASE EXAMPLES ===".echo();

/* Simple file content - use .set()/.get() */
f.set("simple.txt", "This is simple file content");
content_simple = f.get("simple.txt");
"Simple content: " + content_simple.hex().str().echo();

/* Structured data - use .setfield()/.getfield() */
f.setfield("data_record", "title", "Document Title");
f.setfield("data_record", "author", "John Doe");
f.setfield("data_record", "pages", 150);
title = f.getfield("data_record", "title");
author = f.getfield("data_record", "author");
pages = f.getfield("data_record", "pages");
"Document: " + title + " by " + author + " (" + pages + " pages)".echo();

/* ========================================
 * METHOD SELECTION GUIDELINES
 * ======================================== */

"=== METHOD SELECTION GUIDELINES ===".echo();

"Use .get()/.set() for:".echo();
"- Simple file content (text, JSON, binary data)".echo();
"- Configuration files".echo();
"- Log files".echo();
"- Any content that doesn't need field-level access".echo();

"Use .getfield()/.setfield() for:".echo();
"- Database records with multiple fields".echo();
"- Structured data with named fields".echo();
"- User profiles, settings, metadata".echo();
"- Any data requiring field-specific access".echo();

/* ========================================
 * ERROR HANDLING
 * ======================================== */

"=== ERROR HANDLING ===".echo();

/* .getfield() requires field parameter */
try missing_field = f.getfield("user1")  /* Missing field parameter */
catch: "Expected error: .getfield() requires field parameter".echo();

/* .get() works without field parameter for simple files */
simple_file_ok = f.get("simple.txt");  /* This works for simple files */
"Simple file retrieval works: " + (simple_file_ok != null).echo();

/* ========================================
 * CLEANUP
 * ======================================== */

f.rm("config.txt");
f.rm("log.txt");
f.rm("simple.txt");

"Method usage patterns demonstration completed!".echo();
