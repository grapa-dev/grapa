/* HTTP Methods Demo: .httpsend(), .httpread(), .httpmessage() */

"\n===== HTTP Methods Demo =====\n".echo();

/* Example 1: Simple GET request with .httpsend() and .httpmessage() */
"\n--- Example 1: GET request with automatic JSON parsing ---\n".echo();
client1 = $net();
client1.connect('http://jsonplaceholder.typicode.com', null, null);

/* Send GET request with headers */
headers = {
    "Host": "jsonplaceholder.typicode.com",
    "User-Agent": "Grapa-HTTP-Demo/1.0",
    "Accept": "application/json"
};
client1.httpsend("GET", "/posts/1", headers, "");

/* Parse response automatically */
response1 = client1.httpmessage();
("Status Code: " + response1."status"."code" + "\n").echo();
("Response Headers: " + response1."headers".str() + "\n").echo();
("Response Body Type: " + response1."body".type() + "\n").echo();
("JSON Data - Title: " + response1."body"."title" + "\n").echo();
("JSON Data - User ID: " + response1."body"."userId" + "\n").echo();
response1."body".echo();
"\n".echo();

client1.disconnect();

/* Example 2: POST request with JSON data */
"\n--- Example 2: POST request with JSON body ---\n".echo();
client2 = $net();
client2.connect('http://httpbin.org', null, null);

/* Prepare JSON data */
jsonData = {
    "name": "Grapa Demo",
    "version": "1.0",
    "features": ["http", "json", "parsing"]
};

/* Send POST request */
headers2 = {
    "Host": "httpbin.org",
    "Content-Type": "application/json",
    "Content-Length": jsonData.len().str(),
    "User-Agent": "Grapa-HTTP-Demo/1.0"
};
client2.httpsend("POST", "/post", headers2, jsonData);

/* Parse response */
response2 = client2.httpmessage();
("Status Code: " + response2."status"."code" + "\n").echo();
("Received Body: " + response2."body".str() + "\n").echo();
("Received JSON Data: " + response2."body"."json".str() + "\n").echo();

client2.disconnect();

/* Example 3: HTML response with XML parsing */
"\n--- Example 3: HTML response with XML parsing ---\n".echo();
client3 = $net();
client3.connect('http://httpbin.org', null, null);

/* Send GET request to get HTML response */
headers3 = {"Host": "httpbin.org"};
client3.httpsend("GET", "/html", headers3, "");

/* Parse response - .httpsend() automatically called .httpread() */
rawResponse = client3.httpmessage();
rawBody = rawResponse."body";

("Raw Response Status: " + rawResponse."status"."code" + "\n").echo();
("Raw Response Content Type: " + rawResponse."headers"."content-type".str() + "\n").echo();
("Raw Response Content Length: " + rawResponse."headers"."content-length" + "\n").echo();
("Raw Response Data Type: " + rawBody.type() + "\n").echo();
("Raw Response Data Preview: " + rawBody.str().mid(0, 200) + "...\n").echo();

client3.disconnect();

/* Example 4: Error handling */
"\n--- Example 4: Error handling (404 Not Found) ---\n".echo();
client4 = $net();
client4.connect('http://httpbin.org', null, null);

headers4 = {"Host": "httpbin.org"};
client4.httpsend("GET", "/nonexistent", headers4, "");

response4 = client4.httpmessage();
("Error Status Code: " + response4."status"."code" + "\n").echo();
("Error Description: " + response4."status"."description" + "\n").echo();

client4.disconnect();

/* Example 5: Using .httpread() separately (with low-level .send()) */
"\n--- Example 5: Manual .httpread() with low-level .send() ---\n".echo();
client5 = $net();
client5.connect('http://jsonplaceholder.typicode.com', null, null);

/* Use low-level .send() to send raw HTTP request */
/* This does NOT automatically call .httpread() */
client5.send('GET /posts/1 HTTP/1.1\r\nHost: jsonplaceholder.typicode.com\r\n\r\n');

/* Now we manually call .httpread() to get the response */
rawResponse = client5.httpread();

/* Then parse it with .httpmessage() */
parsedResponse = client5.httpmessage();
parsedBody = parsedResponse."body";

("Manual HttpRead - Raw Length: " + rawResponse.len() + "\n").echo();
("Parsed Status: " + parsedResponse."status"."code" + "\n").echo();
("Parsed Content Type: " + parsedResponse."headers"."content-type".str() + "\n").echo();
("Parsed Data Type: " + parsedBody.type() + "\n").echo();
("Parsed Title: " + parsedBody."title" + "\n").echo();

client5.disconnect();


"\n===== Demo Complete =====\n".echo();

