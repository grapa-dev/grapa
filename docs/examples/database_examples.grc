// Database Examples - Comprehensive Guide
// This file demonstrates all three database types: ROW, COL, and GROUP

// ================================================================================
// Example 1: ROW Database (Transactional Workloads)
// ================================================================================

"=== ROW Database Example (Transactional) ===\n".echo();

// Create ROW database for transactional workloads
row_db = {}.table("ROW");
"✓ ROW database created\n".echo();

// Create fields for user management
row_db.mkfield("id", "INT", "FIX", 4);
row_db.mkfield("name", "STR", "VAR");
row_db.mkfield("email", "STR", "VAR");
row_db.mkfield("age", "INT", "FIX", 4);
row_db.mkfield("active", "BOOL", "FIX", 1);
"✓ Fields created for user management\n".echo();

// Insert user records (transactional operations)
row_db.setfield("user1", "id", 1);
row_db.setfield("user1", "name", "Alice Johnson");
row_db.setfield("user1", "email", "alice@example.com");
row_db.setfield("user1", "age", 28);
row_db.setfield("user1", "active", 1);

row_db.setfield("user2", "id", 2);
row_db.setfield("user2", "name", "Bob Smith");
row_db.setfield("user2", "email", "bob@example.com");
row_db.setfield("user2", "age", 32);
row_db.setfield("user2", "active", 1);

row_db.setfield("user3", "id", 3);
row_db.setfield("user3", "name", "Carol Davis");
row_db.setfield("user3", "email", "carol@example.com");
row_db.setfield("user3", "age", 25);
row_db.setfield("user3", "active", 0);
"✓ 3 user records inserted\n".echo();

// Retrieve user data (point queries)
user1_name = row_db.getfield("user1", "name");
user1_age = row_db.getfield("user1", "age");
("✓ Retrieved user1: " + user1_name + ", age " + user1_age.str() + "\n").echo();

// Update user data (transactional update)
row_db.setfield("user1", "age", 29);
updated_age = row_db.getfield("user1", "age");
("✓ Updated user1 age to: " + updated_age.str() + "\n").echo();

// List all records
row_records = row_db.ls();
("✓ Total ROW records: " + row_records.len().str() + "\n").echo();

// ================================================================================
// Example 2: COL Database (Analytical Workloads)
// ================================================================================

"\n=== COL Database Example (Analytical) ===\n".echo();

// Create COL database for analytical workloads
col_db = {}.table("COL");
"✓ COL database created\n".echo();

// Create fields for analytics data
col_db.mkfield("metric", "STR", "VAR");
col_db.mkfield("value", "FLOAT", "FIX", 8);
col_db.mkfield("timestamp", "INT", "FIX", 8);
col_db.mkfield("category", "STR", "VAR");
"✓ Fields created for analytics\n".echo();

// Insert analytics data (column-oriented storage)
col_db.setfield("metric1", "metric", "page_views");
col_db.setfield("metric1", "value", 1250.5);
col_db.setfield("metric1", "timestamp", 1640995200);
col_db.setfield("metric1", "category", "traffic");

col_db.setfield("metric2", "metric", "conversion_rate");
col_db.setfield("metric2", "value", 0.0234);
col_db.setfield("metric2", "timestamp", 1640995200);
col_db.setfield("metric2", "category", "sales");

col_db.setfield("metric3", "metric", "avg_session_duration");
col_db.setfield("metric3", "value", 245.7);
col_db.setfield("metric3", "timestamp", 1640995200);
col_db.setfield("metric3", "category", "engagement");
"✓ 3 analytics records inserted\n".echo();

// Retrieve analytics data
page_views = col_db.getfield("metric1", "value");
conversion_rate = col_db.getfield("metric2", "value");
("✓ Analytics data: page_views=" + page_views.float(12).str() + ", conversion_rate=" + conversion_rate.float(12).str() + "\n").echo();

// List all records
col_records = col_db.ls();
("✓ Total COL records: " + col_records.len().str() + "\n").echo();

// ================================================================================
// Example 3: GROUP Database (Hierarchical Structures)
// ================================================================================

"\n=== GROUP Database Example (Hierarchical) ===\n".echo();

// Create GROUP database for hierarchical structures
group_db = {}.table("GROUP");
"✓ GROUP database created\n".echo();

// Create nested databases within the group
group_db.mk("users", "ROW");
group_db.mk("analytics", "COL");
group_db.mk("config", "GROUP");
"✓ Nested databases created\n".echo();

// Navigate to users database
group_db.cd("users");
"✓ Navigated to users database\n".echo();

// Create fields in users database
group_db.mkfield("id", "INT", "FIX", 4);
group_db.mkfield("name", "STR", "VAR");
group_db.mkfield("role", "STR", "VAR");
"✓ Users fields created\n".echo();

// Insert user data in nested database
group_db.setfield("admin1", "id", 1);
group_db.setfield("admin1", "name", "Admin User");
group_db.setfield("admin1", "role", "administrator");
"✓ Admin user inserted in nested database\n".echo();

// Navigate to analytics database
group_db.cd("../analytics");
"✓ Navigated to analytics database\n".echo();

// Create fields in analytics database
group_db.mkfield("metric", "STR", "VAR");
group_db.mkfield("value", "FLOAT", "FIX", 8);
"✓ Analytics fields created\n".echo();

// Insert analytics data in nested database
group_db.setfield("metric1", "metric", "system_uptime");
group_db.setfield("metric1", "value", 99.95);
"✓ System metric inserted in nested database\n".echo();

// Navigate back to root and list contents
group_db.cd("..");
group_contents = group_db.ls();
("✓ GROUP contents: " + group_contents.len().str() + " items\n").echo();

// Navigate back to users and retrieve data
group_db.cd("users");
admin_name = group_db.getfield("admin1", "name");
("✓ Retrieved from nested users DB: " + admin_name + "\n").echo();

// ================================================================================
// Example 4: Cross-Database Operations
// ================================================================================

"\n=== Cross-Database Operations ===\n".echo();

// Demonstrate data integrity across all database types
row_user2_name = row_db.getfield("user2", "name");
col_metric_name = col_db.getfield("metric1", "metric");
group_admin_role = group_db.getfield("admin1", "role");

("✓ Cross-database validation:\n").echo();
("  ROW: " + row_user2_name + "\n").echo();
("  COL: " + col_metric_name + "\n").echo();
("  GROUP: " + group_admin_role + "\n").echo();

// ================================================================================
// Example 5: Database Type Selection Guidelines
// ================================================================================

"\n=== Database Type Selection Guidelines ===\n".echo();

"Use ROW databases when:\n".echo();
"- You need fast point queries on specific records\n".echo();
"- You have frequent record updates\n".echo();
"- You're building transactional applications\n".echo();
"- You have small to medium datasets\n".echo();

"Use COL databases when:\n".echo();
"- You need fast column scans and aggregations\n".echo();
"- You have analytical workloads\n".echo();
"- You're working with large datasets\n".echo();
"- You have sparse data (many NULL values)\n".echo();

"Use GROUP databases when:\n".echo();
"- You need hierarchical data structures\n".echo();
"- You want to organize data in folders/directories\n".echo();
"- You need to nest different database types\n".echo();
"- You're building file system-like structures\n".echo();

"\n=== Database Examples Complete ===\n".echo(); 