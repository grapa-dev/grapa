/*
Bad Syntax Example: Missing Semicolons

This file demonstrates missing semicolon errors that the syntax checker should detect:
- Missing semicolons after statements
- Missing semicolons after variable assignments
- Missing semicolons after function calls
*/

// Example 1: Missing semicolon after variable assignment
x = 10
y = 20
z = x + y

// Example 2: Missing semicolon after return statement
function getValue() {
    return 42
}

// Example 3: Missing semicolon after break statement
for (i = 0; i < 10; i++) {
    if (i == 5) {
        break
    }
}

// Example 4: Missing semicolon after continue statement
for (i = 0; i < 10; i++) {
    if (i % 2 == 0) {
        continue
    }
}

// Example 5: Missing semicolon after throw statement
function validateInput(input) {
    if (input == null) {
        throw "Input cannot be null"
    }
}

// Example 6: Mixed semicolon usage
a = 1;  // Has semicolon
b = 2   // Missing semicolon
c = 3;  // Has semicolon
d = 4   // Missing semicolon

// Example 7: Function call without semicolon
"Hello World".echo()
"Goodbye World".echo()  // Missing semicolon

// Example 8: Complex expression without semicolon
result = (a + b) * (c - d) / (e + f)
final = result + 100
