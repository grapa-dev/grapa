/* Isolated Rule Execution Demo
 * 
 * This demonstrates how to execute custom rules without hooking them
 * into the main Grapa language, which is crucial for ETL work and
 * domain-specific processing where you want isolated rule execution.
 * 
 * Key patterns:
 * 1. op()("input", custom_rule)() - Execute against specific rule
 * 2. $sys().eval("input", {}, "rule_name") - Execute with custom rule set
 * 3. Dynamic rule definition and execution
 */

("=== Isolated Rule Execution Demo ===\n").echo();

/* ======================================== */
/* Pattern 1: op()("input", rule)() */
/* ======================================== */

("1. Using op()(\"input\", rule)() pattern\n").echo();

/* Define a custom rule for CSV parsing */
csv_rule = rule $ID ',' $INT ',' $ID {op(name:$1,age:$3,city:$5){
    return {
        name: name,
        age: age,
        city: city
    };
}};

/* Execute against the custom rule without affecting main language */
result1 = op()("John,25,NY", csv_rule)();
"CSV parse result: ${result1}\n".interpolate().echo();

/* Define a custom rule for log parsing */
catch_sq_bracket_rule = rule ('[') <> (']') {@<lit,{$2}>};
id_list_rule = rule $ID <id_list_rule> {@<prepend,{$2,$1}>} | $ID {@<createarray,{$1}>};
log_rule = rule <catch_sq_bracket_rule> <id_list_rule> {op(timestamp:$1,message:$2){
    return {
        timestamp: timestamp,
        message: message,
        level: "INFO"
    };
}};

/* Execute log parsing */
result2 = op()("[2024-01-15 10:30:00] User login successful", log_rule)();
"Log parse result: ${result2}\n".interpolate().echo();

/* Define a custom rule for configuration parsing */
config_rule = rule $ID '=' $ID {op(key:$1,value:$3){
    return {key: key, value: value};
}};

/* Execute config parsing */
result3 = op()("server_name=myapp", config_rule)();
"Config parse result: ${result3}\n".interpolate().echo();

("\n").echo();

/* ======================================== */
/* Pattern 2: Using objects with srule parameter */
/* ======================================== */

("2. Using objects with srule parameter\n").echo();

("2a. $GOBJ\n").echo();

etl_rules = {

    parse = op(parse_data, parse_rule){op()(parse_data, parse_rule)()},

    csv_parser = rule $ID ',' $INT ',' $ID {op(name:$1,age:$3,city:$5){
        {name: name, age: age, city: city};
    }},

    catch_sq_bracket_rule = rule ('[') <@<join,{$1}>>  (']') {@<lit,{$2}>},

    id_list_rule = rule $ID <id_list_rule> {@<prepend,{$2,$1}>} | $ID {@<createarray,{$1}>},

    log_parser = rule <catch_sq_bracket_rule> <id_list_rule> {op(timestamp:$1,message:$2){
        {timestamp: timestamp, message: message, level: "INFO"};
    }},
    
    config_parser = rule $ID '=' $ID {op(key:$1,value:$3){
        {key: key, value: value};
    }}
};

/* Execute with custom rule set */
csv_result = etl_rules.parse("John,25,NY", etl_rules.csv_parser);
"CSV eval result: ${csv_result}\n".interpolate().echo();

log_result = etl_rules.parse("[2024-01-15 10:30:00] User login successful", etl_rules.log_parser);
"Log eval result: ${log_result}\n".interpolate().echo();

config_result = etl_rules.parse("server_name=myapp", etl_rules.config_parser);
"Config eval result: ${config_result}\n".interpolate().echo();

("\n").echo();

("2b. $CLASS\n").echo();

/* Define rules in a namespace */
etl_rules_class = class {

    parse = op(parse_data, parse_rule){op()(parse_data, parse_rule)()};

    csv_parser = rule $ID ',' $INT ',' $ID {op(name:$1,age:$3,city:$5){
        {name: name, age: age, city: city};
    }};

    catch_sq_bracket_rule = rule ('[') <> (']') {@<lit,{$2}>};

    id_list_rule = rule $ID <id_list_rule> {@<prepend,{$2,$1}>} | $ID {@<createarray,{$1}>};

    log_parser = rule <catch_sq_bracket_rule> <id_list_rule> {op(timestamp:$1,message:$2){
        {timestamp: timestamp, message: message, level: "INFO"};
    }};
    
    config_parser = rule $ID '=' $ID {op(key:$1,value:$3){
        {key: key, value: value};
    }};
};

etl_rules = etl_rules_class();

/* Execute with custom rule set */
csv_result = etl_rules.parse("John,25,NY", etl_rules.csv_parser);
"CSV eval result: ${csv_result}\n".interpolate().echo();

log_result = etl_rules.parse("[2024-01-15 10:30:00] User login successful", etl_rules.log_parser);
"Log eval result: ${log_result}\n".interpolate().echo();

config_result = etl_rules.parse("server_name=myapp", etl_rules.config_parser);
"Config eval result: ${config_result}\n".interpolate().echo();

("\n").echo();

/* ======================================== */
/* Pattern 3: Dynamic Rule Definition and Execution */
/* ======================================== */

("3. Dynamic rule definition and execution\n").echo();

("3a. $GOBJ\n").echo();

etl_rules = {
    parse = op(parse_data, parse_rule){op()(parse_data, parse_rule)()},
};
etl_rules += (csv_parser : rule $ID ',' $INT ',' $ID {op(name:$1,age:$3,city:$5){{name: name, age: age, city: city};}});
csv_result = etl_rules.parse("John,25,NY", etl_rules.csv_parser);
"CSV eval result: ${csv_result}\n".interpolate().echo();
("\n").echo();

("3a. $CLASS\n").echo();

etl_rules_class = class {
    parse = op(parse_data, parse_rule){op()(parse_data, parse_rule)()};
    add_rule = op(pName,pRule) {$this.@pName=pRule;};
};
etl_rules = etl_rules_class();
etl_rules.add_rule("csv_parser", rule $ID ',' $INT ',' $ID {op(name:$1,age:$3,city:$5){{name: name, age: age, city: city};}});
csv_result = etl_rules.parse("John,25,NY", etl_rules.csv_parser);
"CSV eval result: ${csv_result}\n".interpolate().echo();
("\n").echo();

