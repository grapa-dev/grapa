/* ========================================
 * String Interpolation Example
 * ======================================== */

/* String interpolation function */
interpolate = op(template){
    $local.result = null;
    $local.i = null;
    $local.char = null;
    $local.expression_start = null;
    $local.brace_count = null;
    $local.expression = null;
    $local.evaluated = null;
    
    /* Parse template string and replace ${expression} with evaluated values */
    result = "";
    i = 1;
    while (i <= template.len()) {
        char = template[i];
        if (char == "$" && i + 1 <= template.len() && template[i + 1] == "{") {
            /* Found ${ - extract expression */
            i += 2; /* Skip ${ */
            expression_start = i;
            brace_count = 1;
            
            /* Find matching } */
            while (i <= template.len() && brace_count > 0) {
                if (template[i] == "{") {
                    brace_count += 1;
                } else if (template[i] == "}") {
                    brace_count -= 1;
                };
                i += 1;
            };
            
            if (brace_count == 0) {
                /* Extract and evaluate expression */
                expression = template[expression_start:i-2];
                evaluated = op(parse)(expression)();
                result += evaluated;
            } else {
                /* Unmatched braces - treat as literal */
                result += "${";
                i = expression_start;
            };
        } else {
            result += char;
            i += 1;
        };
    };
    result;
};

/* ========================================
 * USAGE EXAMPLES
 * ======================================== */

/* Basic string interpolation */
name = "World";
age = 25;

/* Function-style usage */
result1 = interpolate("Hello ${name}!");
result2 = interpolate("Age: ${age} years old");
result3 = interpolate("Hello ${name}, you are ${age} years old!");

/* Chaining with other methods */
interpolate("Hello ${name}, you are ${age} years old!\n").echo();

/* With expressions */
x = 10;
y = 5;
sum_result = interpolate("Sum: ${x + y}");

/* With complex expressions */
user = "Alice";
score = 95;
grade = "A";
report = interpolate("Student: ${user}, Score: ${score}, Grade: ${grade}");

/* Chaining multiple operations */
interpolate("Report: ${report}\n").upper().echo(); 