/* Optimized curl function using maximum Grapa C++ capabilities */

curl = op(url_str, options) {
    if (options.type() != $LIST) {
        options = {};
    };
    
    /* Parse URL like supreme example - separate host:port from path */
    url = {};
    if (url_str.left(7) == "http://") {
        url.protocol = "http";
        url_str = url_str.right(url_str.len() - 7);
    } else if (url_str.left(8) == "https://") {
        url.protocol = "https";
        url_str = url_str.right(url_str.len() - 8);
    } else {
        url.protocol = "http";
    };
    
    /* Split host:port from path like supreme example */
    slash_pos = -1;
    i = 0;
    while (i < url_str.len()) {
        if (url_str.mid(i, 1) == "/") {
            slash_pos = i;
            break;
        };
        i += 1;
    };
    
    host_part = "";
    if (slash_pos >= 0) {
        host_part = url_str.left(slash_pos);
        url.path = "/" + url_str.right(url_str.len() - slash_pos - 1);
    } else {
        host_part = url_str;
        url.path = "/";
    };
    
    url.host_port = host_part;
    
    /* Add default port if not specified */
    if (url.host_port.right(1) != ":" && url.protocol == "http") {
        url.host_port += ":80";
    } else if (url.host_port.right(1) != ":" && url.protocol == "https") {
        url.host_port += ":443";
    };
    
    /* Use C++ networking exactly like supreme example */
    n2 = $net();
    
    /* Use supreme example certificate pattern */
    cert = null;
    if (url.protocol == "https" && options.cert_file) {
        cert = options.cert_file;
    };
    
    /* Connect using C++ capabilities exactly like supreme example */
    err = n2.connect(url.host_port, cert, null);
    if (err != 0) {
        n2.disconnect();
        return {"error": "Connection failed", "code": err};
    };
    
    /* Verify SSL certificate if using HTTPS */
    if (url_str.left(8) == "https://" && !options.insecure) {
        verify_result = n2.verify();
        if (verify_result.result != 0) {
            n2.disconnect();
            return {"error": "SSL certificate verification failed", "code": verify_result.result};
        };
    };
    
    /* Build headers like supreme example */
    headers = {};
    if (!options.headers) {
        options.headers = {};
    };
    
    /* Add default headers like supreme example */
    if (!options.headers["User-Agent"]) {
        headers["User-Agent"] = "Grapa-Curl/1.0";
    };
    if (!options.headers["Host"]) {
        headers["Host"] = url.host_port;
    };
    
    /* Merge custom headers */
    keys = options.headers.keys();
    i = 0;
    while (i < keys.len()) {
        headers[keys[i]] = options.headers[keys[i]];
        i += 1;
    };
    
    /* Use C++ HTTP capabilities exactly like supreme example */
    method = options.method || "GET";
    send_err = n2.httpsend(method, url.path, headers, "");
    if (send_err != 0) {
        n2.disconnect();
        return {"error": "Send failed", "code": send_err};
    };
    
    /* Use C++ HTTP response parsing */
    parsed_response = n2.httpmessage();
    if (!parsed_response || parsed_response.type() != $LIST) {
        n2.disconnect();
        return {"error": "Failed to parse HTTP response"};
    };
    
    n2.disconnect();
    
    /* Return structured response using C++ parsed data */
    return {
        "status_code": parsed_response.status.code.int(),
        "status_text": parsed_response.status.description,
        "headers": parsed_response.headers,
        "body": parsed_response.body,
        "url": url_str
    };
};

/* Test the optimized function */
"Testing optimized curl function...".echo();
result = curl("http://httpbin.org/get");
result.status_code.echo();
result.body.echo();

"Testing HTTPS with C++ SSL capabilities...".echo();
https_result = curl("https://httpbin.org/get", {insecure: true});
https_result.status_code.echo();
