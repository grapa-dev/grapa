/* Simple GrapaDB2 test to isolate the issue */

/* Create a GrapaDB2 database using the grapadb2:// protocol */
db2 = $unified();

/* Debug: show the URL we're about to use */
url = "grapadb2://testdb2";
"URL: ".echo();
url.echo();
"URL length: ".echo();
url.len().echo();

/* Try a different approach - use grapadb:// first to see if that works */
db1 = $unified();
grapadb_url = "grapadb://testdb1";
"GrapaDB URL: ".echo();
grapadb_url.echo();
"GrapaDB URL length: ".echo();
grapadb_url.len().echo();

result1 = db1.create(grapadb_url);
"GrapaDB storage type: ".echo();
db1.getType().echo();

/* Now try GrapaDB2 */
result = db2.create(url);

/* Check storage type */
storage_type = db2.getType();
"Storage type: ".echo();
storage_type.echo();

/* Create a field first */
result = db2.mk("$VALUE", "STR");
"mkfield result: ".echo();
result.echo();

/* Try to get a simple value */
result = db2.get("test", "$VALUE");
"Simple get result: ".echo();
result.echo();

/* Try to set a value first */
result = db2.set("test", "test_value", "$VALUE");
"set result: ".echo();
result.echo();

/* Try to get it again */
result = db2.get("test", "$VALUE");
"After set, get result: ".echo();
result.echo();

"Test complete".echo(); 