$global["$file"]
	= class ($OBJ) {
	pwd = @<"$file","pwd",{@<this>}>; 
	cd = @<[op,@<"$file","cd",{@<this>,@<var,{path}>}>],{path}>; 
	phd = @<"$file","phd",{@<this>}>; 
	chd = @<[op,@<"$file","chd",{@<this>,@<var,{path}>}>],{path}>; 
	ls  = @<[op,@<"$file","ls",{@<this>,@<var,{path}>,@<var,{format}>}>],{path,format}>; 
	mk = @<[op,@<"$file","mk",{@<this>,@<var,{name}>,@<var,{type}>}>],{name,type}>; 
	rm = @<[op,@<"$file","rm",{@<this>,@<var,{name}>}>],{name}>; 
	info = @<[op,@<"$file","info",{@<this>,@<var,{name}>,@<var,{format}>}>],{name,format}>; 
	split = @<[op,@<"$file","split",{@<this>,@<var,{count}>,@<var,{name}>,@<var,{path}>,@<var,{delim}>,@<var,{option}>}>],{count:2,name:null,path:null,delim:null,option:null}>; 
	mkfield = @<[op,@<"$file","mkfield",{@<this>,@<var,{name}>,@<var,{type}>,@<var,{storage}>,@<var,{size}>,@<var,{growth}>}>],{name,type,storage,size,growth}>; 
	rmfield = @<[op,@<"$file","rmfield",{@<this>,@<var,{name}>}>],{name}>; 
	dump = @<[op,@<"$file","dump",{@<this>,@<var,{level}>,@<var,{format}>}>],{level,format}>;
	};
