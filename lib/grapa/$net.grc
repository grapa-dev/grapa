$global["$net"]
	= class {
	type = @<"type",{@<this>}>; 
	describe = @<"describe",{@<this>}>; 
	mac = @<[op,@<"$net",mac>]>; 
	interfaces = @<[op,@<"$net",interfaces>]>; 
	connect = @<[op,@<"$net",connect,{this,@<var,{url}>,@<var,{cert}>,@<var,{proxy}>}>],{url,cert,proxy}>; 
	bind = @<[op,@<"$net",bind,{this,@<var,{url}>}>],{url}>; 
	listen = @<[op,@<"$net",listen,{this,@<var,{net}>}>],{net}>; 
	onlisten = @<[op,@<"$net",onlisten,{this,@<var,{url}>,@<var,{messageHandler}>,@<var,{connectHandler}>,@<var,{count}>}>],{url,messageHandler,connectHandler,count:1}>; 
	disconnect = @<[op,@<"$net",disconnect,{this}>]>; 
	proxy = @<[op,@<"$net",proxy,{this,@<var,{ptype}>,@<var,{pid}>,@<var,{ph}>}>],{ptype, pid, ph}>; 
	certificate = @<[op,@<"$net",certificate,{this,@<var,{cert}>}>],{cert}>; 
	private = @<[op,@<"$net",private,{this,@<var,{key}>,@<var,{pass}>,@<var,{param}>}>],{key,pass,param}>; 
	trusted = @<[op,@<"$net",trusted,{this,@<var,{file}>,@<var,{path}>}>],{file,path}>; 
	verify = @<[op,@<"$net",verify,{this}>]>; 
	chain = @<[op,@<"$net",chain,{this}>]>; 
	host = @<[op,@<"$net",host,{this}>]>; 
	send = @<[op,@<"$net",send,{this,@<var,{data}>}>],{data}>; 
	receive = @<[op,@<"$net",receive,{this}>]>; 
	pending = @<[op,@<"$net",pending,{this}>]>; 
	onreceive = @<[op,@<"$net",onreceive,{this,@<var,{handler}>}>],{handler}>;
	httpread = @<[op,@<"$http",read,{this}>]>; 
	httpsend = @<[op,@<"$http",send,{this,@<var,{method}>,@<var,{entity}>,@<var,{header}>,@<var,{body}>}>],{method,entity,header,body}>;
	httpmessage = @<[op,@<"$http",message,{this,@<var,{raw}>}>],{raw:null}>; 
	};
