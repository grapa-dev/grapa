$global["$net"]
	= class {
	type = @<"type",{@<this>}>; 
	describe = @<"describe",{@<this>}>; 
	mac = @<[op,@<"$net",mac>]>; 
	interfaces = @<[op,@<"$net",interfaces>]>; 
	connect = @<[op,@<"$net",connect,{this,@<var,{url}>,@<var,{cert}>,@<var,{proxy}>}>],{url:null,cert:null,proxy:null}>; 
	bind = @<[op,@<"$net",bind,{this,@<var,{url}>}>],{url:null}>; 
	listen = @<[op,@<"$net",listen,{this,@<var,{net}>}>],{net:null}>; 
	onlisten = @<[op,@<"$net",onlisten,{this,@<var,{url}>,@<var,{messageHandler}>,@<var,{connectHandler}>,@<var,{count}>}>],{url:null,messageHandler:null,connectHandler:null,count:1}>; 
	disconnect = @<[op,@<"$net",disconnect,{this}>]>; 
	proxy = @<[op,@<"$net",proxy,{this,@<var,{ptype}>,@<var,{pid}>,@<var,{ph}>}>],{ptype:null, pid:null, ph:null}>; 
	certificate = @<[op,@<"$net",certificate,{this,@<var,{cert}>}>],{cert:null}>; 
	private = @<[op,@<"$net",private,{this,@<var,{key}>,@<var,{pass}>,@<var,{param}>}>],{key:null,pass:null,param:null}>; 
	trusted = @<[op,@<"$net",trusted,{this,@<var,{file}>,@<var,{path}>}>],{file:null,path:null}>; 
	verify = @<[op,@<"$net",verify,{this}>]>; 
	chain = @<[op,@<"$net",chain,{this}>]>; 
	host = @<[op,@<"$net",host,{this}>]>; 
	send = @<[op,@<"$net",send,{this,@<var,{data}>}>],{data:null}>; 
	receive = @<[op,@<"$net",receive,{this}>]>; 
	pending = @<[op,@<"$net",pending,{this}>]>; 
	onreceive = @<[op,@<"$net",onreceive,{this,@<var,{handler}>}>],{handler:null}>;
	httpread = @<[op,@<"$net",httpread,{this}>]>; 
	httpsend = @<[op,@<"$net",httpsend,{this,@<var,{method}>,@<var,{entity}>,@<var,{header}>,@<var,{body}>}>],{method:null,entity:null,header:null,body:null}>;
	httpmessage = @<[op,@<"$net",httpmessage,{this,@<var,{raw}>}>],{raw:null}>; 
	};
