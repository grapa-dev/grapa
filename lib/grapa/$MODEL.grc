$global["$MODEL"]
	= class {
	type = @<"type",{@<this>}>; 
    load = @<[op,@<"$MODEL","load",{@<this>,@<var,{"modelpath"}>,@<var,{"method"}>}>],{modelpath:null,method:null}>;
    gen = @<[op,@<"$MODEL","gen",{@<this>,@<var,{"prompt"}>,@<var,{"params"}>}>],{prompt:null,params:null}>;
    info = @<"$MODEL","info",{@<this>}>;
    params = @<[op,@<"$MODEL","params",{@<this>,@<var,{"params"}>}>],{params:null}>;
    context = @<[op,@<"$MODEL","context",{@<this>,@<var,{"context"}>}>],{context:null}>;
	};
	
