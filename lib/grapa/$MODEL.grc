$global["$MODEL"]
	= class {
	type = @<"type",{@<this>}>; 
    load = @<[op,@<"$MODEL","load",{@<this,{}>,@<var,{path}>,@<var,{backend}>}>],{path,backend}>;
    gen = @<[op,@<"$MODEL","gen",{@<this,{}>,@<var,{prompt}>,@<var,{params}>}>],{prompt,params}>;
    info = @<"$MODEL","info",{@<this>}>;
    params = @<[op,@<"$MODEL","params",{@<this,{}>,@<var,{params}>}>],{params}>;
	};
	
