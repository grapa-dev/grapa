	append = @<[op,@<"$WIDGET","append",{@<this>,@<var,{data}>}>],{data:null}>;
	resizable = @<[op,@<"$WIDGET","resizable",{@<this>,@<var,{widget}>}>],{widget:null}>; 
	

	textstyle = @<"$WIDGET","textstyle",{@<this>}>; 
	setlabeltext = @<[op,@<"$WIDGET","setlabeltext",{@<this>,@<var,{label}>,@<var,{shortcut}>}>],{label:null,shortcut:null}>; 
	labeltext = @<"$WIDGET","labeltext",{@<this>}>; 
	setlabeltype = @<[op,@<"$WIDGET","setlabeltype",{@<this>,@<var,{labeltype}>}>],{labeltype:null}>; 
	labeltype = @<"$WIDGET","labeltype",{@<this>}>; 
	setlabelstyle = @<[op,@<"$WIDGET","setlabelstyle",{@<this>,@<var,{font}>,@<var,{size}>,@<var,{color}>}>],{font:null,size:null,color:null}>; 
	labelstyle = @<"$WIDGET","labelstyle",{@<this>}>; 
	setvisiblefocus = @<"$WIDGET","setvisiblefocus",{@<this>}>; 
	visiblefocus = @<"$WIDGET","visiblefocus",{@<this>}>; 
	visibler = @<"$WIDGET","visibler",{@<this>}>; 
	activate = @<"$WIDGET","activate",{@<this>}>; 
	deactivate = @<"$WIDGET","deactivate",{@<this>}>; 
	setoutput = @<"$WIDGET","setoutput",{@<this>}>; 
	output = @<"$WIDGET","output",{@<this>}>; 
	settip = @<[op,@<"$WIDGET","settip",{@<this>,@<var,{tip}>}>],{tip:null}>; 
	tip = @<"$WIDGET","tip",{@<this>}>; 
	update = @<"$WIDGET","update",{@<this>}>; 
