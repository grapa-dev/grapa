$global["$WIDGET"]
	= class {
	type = @<"type",{@<this>}>; 
	$new = @<[op,@<"$WIDGET","new",{@<this>,@<var,{widget}>,@<var,{x}>,@<var,{y}>,@<var,{w}>,@<var,{h}>,@<var,{label}>,@<var,{attr}>}>],{widget:null,x:null,y:null,w:null,h:null,label:null,attr:null}>; 
	get = @<[op,@<"$WIDGET","get",{@<this>,@<var,{name}>,@<var,{params}>}>],{name:null,params:null}>; 
