	eventalt = @<"$WIDGET","eventalt",{@<this>}>; 
	eventctrl = @<"$WIDGET","eventctrl",{@<this>}>; 
	eventx = @<"$WIDGET","eventx",{@<this>}>; 
	eventy = @<"$WIDGET","eventy",{@<this>}>; 
	eventrx = @<"$WIDGET","eventrx",{@<this>}>; 
