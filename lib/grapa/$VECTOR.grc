@global["$VECTOR"]
	= class ($OBJ) {
	t = @<"vector_t",{@<this>}>; 
	rref = @<"vector_rref",{@<this>}>; 
	inv = @<"vector_inv",{@<this>}>; 
	det = @<"vector_det",{@<this>}>; 
	rank = @<"vector_rank",{@<this>}>; 
	solve = @<"vector_solve",{@<this>}>; 
	cov = @<[op,@<"vector_cov",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	sum = @<[op,@<"vector_sum",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	mean = @<[op,@<"vector_mean",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	min = @<[op,@<"vector_min",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	max = @<[op,@<"vector_max",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	std = @<[op,@<"vector_std",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	var = @<[op,@<"vector_var",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	shape = @<"vector_shape",{@<this>}>;
	reshape = @<[op,@<"vector_reshape",{@<this,{}>,@<var,{shape}>}>],{"shape":null}>; 
	dot = @<[op,@<"vector_dot",{@<this,{}>,@<var,{other}>}>],{"other":null}>; 
	triu = @<[op,@<"vector_triu",{@<this,{}>,@<var,{offset}>}>],{"offset":null}>; 
	tril = @<[op,@<"vector_tril",{@<this,{}>,@<var,{offset}>}>],{"offset":null}>; 
	eigh = @<"vector_eigh",{@<this>}>; 
	identity = @<[op,@<"vector_identity",{@<this,{}>,@<var,{offset}>}>],{"offset":null}>; 
	diag = @<[op,@<"vector_diag",{@<this,{}>,@<var,{offset}>}>],{"offset":null}>; 
	norm = @<[op,@<"vector_norm",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	mode = @<[op,@<"vector_mode",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	median = @<[op,@<"vector_median",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	percentile = @<[op,@<"vector_percentile",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	quantile = @<[op,@<"vector_quantile",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	skew = @<[op,@<"vector_skew",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	kurtosis = @<[op,@<"vector_kurtosis",{@<this,{}>,@<var,{axis}>}>],{"axis":null}>; 
	};
	