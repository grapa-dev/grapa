$global["$thread"]
	= class {
	type = @<"type",{@<this>}>; 
	describe = @<"describe",{@<this>}>; 
	trylock = @<[op,@<"$thread",trylock>]>; 
	lock = @<[op,@<"$thread",lock>]>; 
	unlock = @<[op,@<"$thread",unlock>]>; 
	wait = @<[op,@<"$thread",wait>]>; 
	signal = @<[op,@<"$thread",signal>]>; 
	waiting = @<[op,@<"$thread",waiting>]>; 
	start = @<[op,@<"$thread",start,{null,@<var,{runCode}>,@<var,{param}>,@<var,{doneCode}>}>],{runCode:null,param:null,doneCode:null}>; 
	stop = @<[op,@<"$thread",stop>]>; 
	started = @<[op,@<"$thread",started>]>; 
	suspend = @<[op,@<"$thread",suspend>]>; 
	resume = @<[op,@<"$thread",resume>]>; 
	suspended = @<[op,@<"$thread",suspended>]>;
	};
