/* Model Error Handling Example */

"Model Error Handling Example".echo();
"=============================".echo();

/* Test various error scenarios */
"=== Testing Error Scenarios ===".echo();

/* Test 1: Non-existent model file */
"Test 1: Non-existent model file".echo();
model1 = $MODEL();
result1 = model1.load("nonexistent/model.gguf");
if (result1 != 0) {
    ("Error loading non-existent model: " + result1.str()).echo();
    "This is expected behavior".echo();
} else {
    "Unexpected: Model loaded successfully".echo();
}

/* Test 2: Invalid model path */
"Test 2: Invalid model path".echo();
model2 = $MODEL();
result2 = model2.load("");
if (result2 != 0) {
    ("Error loading empty path: " + result2.str()).echo();
    "This is expected behavior".echo();
} else {
    "Unexpected: Model loaded successfully".echo();
}

/* Test 3: Generation without loading model */
"Test 3: Generation without loading model".echo();
model3 = $MODEL();
try {
    response = model3.gen("Hello");
    if (response.len() == 0) {
        "Empty response (expected for unloaded model)".echo();
    } else {
        ("Unexpected response: " + response.str()).echo();
    }
} catch (error) {
    ("Generation error (expected): " + error.str()).echo();
}

/* Test 4: Robust error handling pattern */
"=== Robust Error Handling Pattern ===".echo();

robust_model = $MODEL();

/* Function to safely load and use model */
safe_generate = op(model, prompt, params) {
    /* Try to load model if not already loaded */
    info = model.info();
    if (!info.loaded) {
        result = model.load("models/qwen2.5-7b-instruct-q3_k_m.gguf");
        if (result != 0) {
            return {"error": "load_failed", "code": result};
        }
    }
    
    /* Try to generate text */
    try {
        if (params) {
            response = model.gen(prompt, params);
        } else {
            response = model.gen(prompt);
        }
        
        if (response.len() == 0) {
            return {"error": "empty_response", "code": -1};
        }
        
        return {"success": true, "response": response};
    } catch (error) {
        return {"error": "generation_failed", "code": -2, "details": error};
    }
};

/* Test robust generation */
"Testing robust generation:".echo();
result = safe_generate(robust_model, "Hello, how are you?");
if (result.success) {
    ("Success: " + result.response.str()).echo();
} else {
    ("Error: " + result.error.str() + " (code: " + result.code.str() + ")").echo();
}

/* Test with parameters */
"Testing with parameters:".echo();
result2 = safe_generate(robust_model, "Write a haiku about programming", {
    "temperature": 0.8,
    "max_tokens": 50
});
if (result2.success) {
    ("Success: " + result2.response.str()).echo();
} else {
    ("Error: " + result2.error.str() + " (code: " + result2.code.str() + ")").echo();
}

/* Test parameter validation */
"=== Parameter Validation ===".echo();

validate_params = op(model, params) {
    errors = [];
    
    if (params.temperature && (params.temperature < 0.0 || params.temperature > 2.0)) {
        errors += "Temperature must be between 0.0 and 2.0";
    }
    
    if (params.max_tokens && (params.max_tokens < 1 || params.max_tokens > 4096)) {
        errors += "Max tokens must be between 1 and 4096";
    }
    
    if (params.top_k && (params.top_k < 1 || params.top_k > 100)) {
        errors += "Top K must be between 1 and 100";
    }
    
    if (params.top_p && (params.top_p < 0.0 || params.top_p > 1.0)) {
        errors += "Top P must be between 0.0 and 1.0";
    }
    
    if (params.verbose && (params.verbose < 0 || params.verbose > 4)) {
        errors += "Verbose must be between 0 and 4";
    }
    
    return errors;
};

/* Test parameter validation */
"Testing parameter validation:".echo();
test_params = {
    "temperature": 2.5,  /* Invalid: too high */
    "max_tokens": 5000,  /* Invalid: too high */
    "top_k": 150,        /* Invalid: too high */
    "top_p": 1.5,        /* Invalid: too high */
    "verbose": 5         /* Invalid: too high */
};

errors = validate_params(robust_model, test_params);
if (errors.len() > 0) {
    "Parameter validation errors:".echo();
    for (i = 0; i < errors.len(); i++) {
        ("  - " + errors[i].str()).echo();
    }
} else {
    "All parameters are valid".echo();
}

/* Test with valid parameters */
"Testing with valid parameters:".echo();
valid_params = {
    "temperature": 0.8,
    "max_tokens": 100,
    "top_k": 50,
    "top_p": 0.9,
    "verbose": 1
};

errors = validate_params(robust_model, valid_params);
if (errors.len() == 0) {
    "All parameters are valid".echo();
    result = safe_generate(robust_model, "Test with valid parameters", valid_params);
    if (result.success) {
        ("Success: " + result.response.str()).echo();
    } else {
        ("Error: " + result.error.str()).echo();
    }
} else {
    "Unexpected validation errors:".echo();
    for (i = 0; i < errors.len(); i++) {
        ("  - " + errors[i].str()).echo();
    }
}

/* Clean up */
robust_model.unload();
"Example completed!".echo();
