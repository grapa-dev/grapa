/*
Minimal Grapa Syntax Checker - Simple CLI tool
*/

// Simple syntax checker class
$global["$MinimalChecker"] = class {
    check = op(filePath) {
        code = $file().get(filePath);
        if (code.type() == "$ERR") {
            return "Error: Could not read file";
        }
        
        // Simple check for missing semicolons
        lines = code.split("\n");
        errors = [];
        
        foreach line in lines {
            if (line.grep("return|break|continue", "x").len() > 0 && line.right(1) != ";") {
                errors.push("Missing semicolon: " + line);
            }
        }
        
        if (errors.len() == 0) {
            return "✅ No syntax errors found";
        } else {
            return "❌ Found " + errors.len() + " error(s)";
        }
    };
};

// CLI interface
args = $sys().getenv("$ARGV");
if (args.len() > 2) {
    command = args[1];
    if (command == "check") {
        checker = $MinimalChecker();
        result = checker.check(args[2]);
        result.echo();
    } else {
        "Usage: grapa minimal_syntax_checker.grc check <file.grc>".echo();
    }
} else {
    "Grapa Minimal Syntax Checker".echo();
    "Usage: grapa minimal_syntax_checker.grc check <file.grc>".echo();
}
