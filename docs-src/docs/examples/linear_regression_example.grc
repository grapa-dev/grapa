/* Linear Regression Example in Grapa
 * 
 * This example demonstrates how to implement linear regression
 * using Grapa's vector operations, including:
 * - Data preprocessing
 * - Model training using normal equation
 * - Predictions and evaluation
 * - Performance metrics calculation
 */

("=== Linear Regression Example ===\n").echo();

/* ======================================== */
/* 1. Data Generation and Preprocessing */
/* ======================================== */

32.setfloat(0);

("--- Data Generation ---\n").echo();

/* Generate sample data: y = 2*x1 + 3*x2 + 5 + noise */
n_samples = 100000;
X_data = [];
y_data = [];

i = 1;
while (i <= n_samples) {
    x1 = (i / 10).float();  /* Feature 1 */
    x2 = (i % 10).float();  /* Feature 2 */
    noise = ((i % 3) - 1) * 0.1;  /* Small noise */
    y = 2 * x1 + 3 * x2 + 5 + noise;  /* True relationship */
    
    X_data += [x1, x2];
    y_data += y;
    i += 1;
}

/* Convert to vectors */
X = X_data.vector();
y = y_data.vector();

("Generated " + n_samples.str() + " samples\n").echo();
("X shape: " + X.shape().str() + "\n").echo();
("y shape: " + y.shape().str() + "\n").echo();

/* ======================================== */
/* 2. Feature Scaling */
/* ======================================== */

("--- Feature Scaling ---" + "\n").echo();

/* Standardize features (Z-score normalization) */
feature_means = X.mean(0);
feature_stds = X.std(0);

("Feature means: " + feature_means.str() + "\n").echo();
("Feature standard deviations: " + feature_stds.str()  + "\n").echo();

/* Scale the features */
X_scaled = [];
i = 0;
while (i < X.shape().get(0)) {
    row = [];
    j = 0;
    while (j < X.shape().get(1)) {
        standardized_val = (X.getfield(i,j) - feature_means.getfield(j,0)) / feature_stds.getfield(j,0);
        row += standardized_val;
        j += 1;
    }
    X_scaled += row;
    i += 1;
}

X_scaled = X_scaled.vector();
("Features scaled successfully" + "\n").echo();

/* ======================================== */
/* 3. Linear Regression Implementation */
/* ======================================== */

("--- Linear Regression Training ---" + "\n").echo();

/* Add bias term (intercept) to design matrix */
add_bias_column = op(X) {
    $local.X_with_bias = null;
    $local.i = null;
    $local.row = null;
    $local.j = null;
    
    X_with_bias = [];
    i = 0;
    while (i < X.shape().get(0)) {
		row = [1];  /* Bias term */
		j = 0;
		while (j < X.shape().get(1)) {
			row += X.getfield(i,j);
			j += 1;
		}
		X_with_bias += row;
		i += 1;
	}
    X_with_bias.vector();
};

/* Normal equation: β = (X^T * X)^-1 * X^T * y */
X_with_bias = add_bias_column(X_scaled);
("Design matrix shape: " + X_with_bias.shape().str() + "\n").echo();

/* Calculate coefficients using normal equation */
start_time = $TIME().utc();
XT = X_with_bias.t();
XT.setconst(true);
XTX = XT.dot(X_with_bias);
XTX.setconst(true);
XTy = XT.dot(y);
XTy.setconst(true);
coefficients = XTX.inv().dot(XTy);
coefficients.setconst(true);
training_time = start_time.ms();

("Training completed in " + training_time.str() + "ms\n").echo();
("Coefficients: " + coefficients.str() + "\n").echo();

/* ======================================== */
/* 4. Predictions */
/* ======================================== */

("--- Making Predictions ---" + "\n").echo();

/* Make predictions on training data */
predictions = X_with_bias.dot(coefficients);

/* Show first few predictions */
("First 5 predictions:" + "\n").echo();
i = 0;
while (i < 5) {
    ("  Sample " + i + ": True=" + y.get(i).str() + ", Predicted=" + predictions.get(i).str() + "\n").echo();
    i += 1;
}

/* ======================================== */
/* 5. Model Evaluation */
/* ======================================== */

("--- Model Evaluation ---" + "\n").echo();

/* Calculate performance metrics */
calculate_r_squared = op(y_true, y_pred) {
    $local.y_mean = y_true.mean();
    $local.ss_total = ((y_true - y_mean) * #[op(x){x**2}]#).sum();
    $local.ss_residual = ((y_true - y_pred) * #[op(x){x**2}]#).sum();
    1.0 - (ss_residual.get(0) / ss_total.get(0));
};

calculate_mse = op(y_true, y_pred) {
    ((y_true - y_pred) * #[op(x){x**2}]#).mean().get(0);
};

calculate_rmse = op(y_true, y_pred) {
    mse = calculate_mse(y_true, y_pred);
    mse ** 0.5;
};

/* Calculate metrics */
r_squared = calculate_r_squared(y, predictions);
mse = calculate_mse(y, predictions);
rmse = calculate_rmse(y, predictions);

("Performance Metrics:" + "\n").echo();
("  R-squared: " + r_squared.str() + "\n").echo();
("  Mean Squared Error: " + mse.str() + "\n").echo();
("  Root Mean Squared Error: " + rmse.str() + "\n").echo();

/* ======================================== */
/* 6. Ridge Regression Example */
/* ======================================== */

("--- Ridge Regression Example ---" + "\n").echo();

/* Ridge regression with L2 regularization */
ridge_regression = op(X, y, lambda) {
    $local.n_features = null;
    $local.regularization_matrix = null;
    $local.i = null;
    $local.row = null;
    $local.j = null;
    $local.XT = null;
    $local.XTX = null;
    $local.XTX_reg = null;
    $local.XTy = null;
    $local.coefficients = null;
    
    /* Add regularization term */
    $local.n_features = X.shape().get(1);
    $local.regularization_matrix = [];
    $local.i = 0;
    while (i < n_features) {
        row = [];
        j = 0;
        while (j < n_features) {
            if (i == j && i > 0) {  /* Don't regularize bias term */
                row += lambda;
            } else {
                row += 0.0;
            }
            j += 1;
        }
        regularization_matrix += row;
        i += 1;
    }
    $local.regularization_matrix = regularization_matrix.vector();
    
    /* Calculate coefficients with regularization */
    $local.XT = X.t();
    $local.XTX = XT.dot(X);
    $local.XTX_reg = XTX + regularization_matrix;
    $local.XTy = XT.dot(y);
    
    XTX_reg.inv().dot(XTy);
};

/* Try different regularization strengths */
lambda_values = [0.0, 0.1, 1.0, 10.0];
("Ridge regression with different lambda values:" + "\n").echo();
start_time2 = $TIME().utc();
results = lambda_values.map(op(lambda){
    $local.X_with_bias_copy = X_with_bias;
    $local.y_copy = y;
    $local.ridge_coefficients = ridge_regression(X_with_bias_copy,y_copy,lambda);
    $local.ridge_predictions = X_with_bias.dot(ridge_coefficients);
    ridge_coefficients = null;
    $local.ridge_r_squared = calculate_r_squared(y_copy, ridge_predictions).float(32);
    $local.ridge_rmse = calculate_rmse(y_copy, ridge_predictions).float(32);
    ridge_predictions = null;
	{"lambda":lambda,"ridge_r_squared":ridge_r_squared,"ridge_rmse":ridge_rmse};
});
training_time2 = start_time2.ms();
"Training completed in ${training_time2}ms\n".interpolate().echo();
for(i=0;i<results.len();i+=1) {
    "  Lambda=${results[i].lambda.float(10)}: R²=${results[i].ridge_r_squared}, RMSE=${results[i].ridge_rmse}\n".interpolate().echo();
};

/* ======================================== */
/* 7. New Data Prediction */
/* ======================================== */

("--- New Data Prediction ---" + "\n").echo();

/* Create new data points */
new_data = #[[1.5, 2.5], [3.0, 4.0], [5.5, 6.5]]#;
("New data points: " + new_data.str() + "\n").echo();

/* Scale new data using same parameters */
new_data_scaled = [];
i = 0;
while (i < new_data.shape().get(0)) {
    row = [];
    j = 0;
    while (j < new_data.shape().get(1)) {
        standardized_val = (new_data.getfield(i,j) - feature_means.getfield(j,0)) / feature_stds.getfield(j,0);
        row += standardized_val;
        j += 1;
    }
    new_data_scaled += row;
    i += 1;
}

new_data_scaled = new_data_scaled.vector();
new_data_with_bias = add_bias_column(new_data_scaled);

/* Make predictions */
new_predictions = new_data_with_bias.dot(coefficients);

("Predictions for new data:" + "\n").echo();
i = 0;
while (i < new_data.shape().get(0)) {
    ("  Input: " + new_data.array()[i].str() + " -> Prediction: " + new_predictions.array()[i].str() + "\n").echo();
    i += 1;
}

/* ======================================== */
/* 8. Summary */
/* ======================================== */

("\n--- Summary ---" + "\n").echo();

("Linear regression implementation completed successfully!" + "\n").echo();
("Key results:" + "\n").echo();
("  - Model trained on " + n_samples.str() + " samples" + "\n").echo();
("  - Training time: " + training_time.str() + "ms" + "\n").echo();
("  - R-squared: " + r_squared.str() + "\n").echo();
("  - RMSE: " + rmse.str() + "\n").echo();
("  - Coefficients: " + coefficients.str() + "\n").echo();

("The model successfully learned the relationship: y = 2*x1 + 3*x2 + 5" + "\n").echo();
("Grapa's vector operations provide all necessary capabilities for linear regression!" + "\n").echo();

("=== Linear Regression Example Complete ===" + "\n").echo();
