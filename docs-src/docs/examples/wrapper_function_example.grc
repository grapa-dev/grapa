/* Wrapper Function Pattern Example for ETL Processing */

/* Define ETL processing functions */
clean_data = op(p){p.trim().lower()};
validate_email = op(p){p.grep("^[^@]+@[^@]+\\.[^@]+$").len() > 0 ? p : null};
format_output = op(p){p.upper() + " - PROCESSED"};
filter_length = op(p){p.len() > 5 ? p : null};

/* Define ETL pipeline rules using wrapper functions */
$global["$etl_pipeline"] = {
    /* Clean step */
    clean_step: rule <$raw_data,op(b:$1){clean_data(b)}> {@<var,{$1}>},
    
    /* Validate step */
    validate_step: rule <$cleaned_data,op(b:$1){validate_email(b)}> {@<var,{$1}>},
    
    /* Filter step */
    filter_step: rule <$validated_data,op(b:$1){filter_length(b)}> {@<var,{$1}>},
    
    /* Format step */
    format_step: rule <$filtered_data,op(b:$1){format_output(b)}> {@<var,{$1}>}
};

/* ETL pipeline function */
etl_process = op(input_data) {
    $local.cleaned = null;
    $local.validated = null;
    $local.filtered = null;
    $local.formatted = null;
    
    /* Apply ETL pipeline steps directly */
    cleaned = clean_data(input_data);
    validated = validate_email(cleaned);
    
    /* Check if validation passed */
    if (validated == null) {
        return "VALIDATION_FAILED";
    };
    
    filtered = filter_length(validated);
    
    /* Check if filtering passed */
    if (filtered == null) {
        return "FILTER_FAILED";
    };
    
    formatted = format_output(filtered);
    return formatted;
};

/* Test the ETL pipeline */
test_data = "  john.doe@example.com  ";
result = etl_process(test_data);
("Test 1 - Valid email: " + test_data + " -> " + result + "\n").echo();

/* Test with invalid data */
test_data2 = "invalid-email";
result2 = etl_process(test_data2);
("Test 2 - Invalid email: " + test_data2 + " -> " + result2 + "\n").echo();

/* Test with short valid email */
test_data3 = "a@b.c";
result3 = etl_process(test_data3);
("Test 3 - Short email: " + test_data3 + " -> " + result3 + "\n").echo(); 