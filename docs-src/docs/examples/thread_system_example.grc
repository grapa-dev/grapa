/* Grapa Thread System Example
   Demonstrates the complete $thread system capabilities including:
   - Basic thread lifecycle management
   - Coroutine suspend/resume functionality
   - Synchronization primitives (locks, condition variables)
   - Producer-consumer patterns
   - Resource pool management
   - Proper thread-safe variable declarations */

/* Thread-Safe Variable Declarations */
$global shared_counter = 0;
$global shared_queue = [];
$global queue_lock = $thread();
$global data_ready = $thread();
$global space_available = $thread();
$global workers_complete = 0;
$global completion_lock = $thread();
$global counter_lock = $thread();
$global resource_pool = {
    available: ["Resource_A", "Resource_B", "Resource_C"],
    in_use: {},
    lock: $thread()
};
$global coordination_condition = $thread();
$global ready_count = 0;
$global ready_lock = $thread();

"=== Grapa Thread System Example ===\n".echo();

/* Example 1: Basic Thread Lifecycle */
"Example 1: Basic Thread Lifecycle\n".echo();

basic_thread = $thread();
basic_thread.start(
    op() {
        "Basic thread: Starting work\n".echo();
        $sys().sleep(200);
        "Basic thread: Work completed\n".echo();
        return "Basic thread result";
    },
    null,
    op(input, result) {
        ("Basic thread callback: " + result + "\n").echo();
    }
);

$sys().sleep(300);

/* Example 2: Coroutine Suspend/Resume */
"Example 2: Coroutine Suspend/Resume\n".echo();

coroutine = $thread();
coroutine.start(
    op() {
        "Coroutine: Starting\n".echo();
        $sys().sleep(100);
        "Coroutine: About to suspend\n".echo();
        coroutine.suspend();  /* Suspend self */
        "Coroutine: Resumed from suspension\n".echo();
        $sys().sleep(100);
        "Coroutine: Completed\n".echo();
        return "Coroutine completed";
    },
    null,
    op(input, result) {
        ("Coroutine callback: " + result + "\n").echo();
    }
);

$sys().sleep(150);
"Main: Resuming coroutine\n".echo();
coroutine.resume();
$sys().sleep(200);

/* Example 3: Thread-Safe Counter with Lock */
"Example 3: Thread-Safe Counter with Lock\n".echo();

/* Create multiple threads that increment the counter */
for (i = 0; i < 3; i+=1) {
    $local.counter_worker = $thread();
    counter_worker.start(
        op(worker_id) {
            for (j = 0; j < 5; j+=1) {
                counter_lock.lock();
                shared_counter += shared_counter;
                current = shared_counter;
                counter_lock.unlock();
                ("Worker " + worker_id + ": Counter = " + current + "\n").echo();
                $sys().sleep(50);
            };
            return ("Worker " + worker_id + " completed");
        },
        i,
        op(input, result) {
            ("Counter worker callback: " + result + "\n").echo();
        }
    );
};

$sys().sleep(400);
("Final counter value: " + shared_counter + "\n").echo();

/* Example 4: Producer-Consumer Pattern */
"Example 4: Producer-Consumer Pattern\n".echo();

/* Producer thread */
producer = $thread();
producer.start(
    op() {
        "Producer: Starting production\n".echo();
        
        for (i = 0; i < 8; i+=1) {
            queue_lock.lock();
            shared_queue.push("Item " + i);
            queue_lock.unlock();
            data_ready.signal();
            ("Producer: Added Item " + i + "\n").echo();
            $sys().sleep(100);
        };
        
        "Producer: Production complete\n".echo();
        return "Producer completed";
    },
    null,
    op(input, result) {
        ("Producer callback: " + result + "\n").echo();
    }
);

if (false)
/* Consumer threads */
for (consumer_id = 0; consumer_id < 2; consumer_id+=1) {
    $local.consumer = $thread();
    consumer.start(
        op(id) {
            ("Consumer " + id + ": Starting consumption\n").echo();
            
            $local.items_consumed = 0;
            while (items_consumed < 4) {
                queue_lock.lock();
                while (shared_queue.len() == 0) {
                    queue_lock.unlock();
                    data_ready.wait();
                    queue_lock.lock();
                };
                
                $local.item = shared_queue.shift();
                queue_lock.unlock();
                
                ("Consumer " + id + ": Consumed " + item + "\n").echo();
                items_consumed++;
                $sys().sleep(150);
            };
            
            ("Consumer " + id + ": Consumption complete\n").echo();
            return ("Consumer " + id + " completed");
        },
        consumer_id,
        op(input, result) {
            ("Consumer callback: " + result + "\n").echo();
        }
    );
};

$sys().sleep(1000);

/* Example 5: Resource Pool Management */
"Example 5: Resource Pool Management\n".echo();

/* Resource requesters */
for (requester_id = 0; requester_id < 4; requester_id+=1) {
    $local.requester = $thread();
    requester.start(
        op(id) {
            ("Requester " + id + ": Requesting resource\n").echo();
            
            resource_pool.lock.lock();
            if (resource_pool.available.len() > 0) {
                $local.resource = resource_pool.available.pop();
                resource_pool.in_use[id] = resource;
                resource_pool.lock.unlock();
                
                ("Requester " + id + ": Got " + resource + "\n").echo();
                $sys().sleep(200);  /* Use resource */
                
                resource_pool.lock.lock();
                resource_pool.available.push(resource);
                delete resource_pool.in_use[id];
                resource_pool.lock.unlock();
                
                ("Requester " + id + ": Returned " + resource + "\n").echo();
            } else {
                resource_pool.lock.unlock();
                ("Requester " + id + ": No resources available\n").echo();
            };
            
            return ("Requester " + id + " completed");
        },
        requester_id,
        op(input, result) {
            ("Requester callback: " + result + "\n").echo();
        }
    );
};

$sys().sleep(600);

/* Example 6: Condition Variable Coordination */
"Example 6: Condition Variable Coordination\n".echo();

if (false)
/* Create threads that wait for coordination */
for (coord_id = 0; coord_id < 3; coord_id+=1) {
    $local.coordinator = $thread();
    coordinator.start(
        op(id) {
            ("Coordinator " + id + ": Starting\n").echo();
            $sys().sleep(100);
            
            ready_lock.lock();
            ready_count++;
            ("Coordinator " + id + ": Ready (count: " + ready_count + ")\n").echo();
            ready_lock.unlock();
            
            coordination_condition.wait();
            ("Coordinator " + id + ": Coordinated and proceeding\n").echo();
            
            return ("Coordinator " + id + " completed");
        },
        coord_id,
        op(input, result) {
            ("Coordinator callback: " + result + "\n").echo();
        }
    );
};

$sys().sleep(200);
"Main: Signaling all coordinators\n".echo();
coordination_condition.signal();
$sys().sleep(300);

/* Example 7: Thread State Inspection */
"Example 7: Thread State Inspection\n".echo();

inspection_thread = $thread();

/* Check initial state */
started = inspection_thread.started();
suspended = inspection_thread.suspended();
("Initial state - Started: " + started + ", Suspended: " + suspended + "\n").echo();

inspection_thread.start(
    op() {
        "Inspection thread: Running\n".echo();
        $sys().sleep(100);
        return "Inspection completed";
    },
    null,
    op(input, result) {
        ("Inspection callback: " + result + "\n").echo();
    }
);

/* Check running state */
started = inspection_thread.started();
("Running state - Started: " + started + "\n").echo();

$sys().sleep(150);

/* Check final state */
started = inspection_thread.started();
("Final state - Started: " + started + "\n").echo();

/* Example 8: Performance Demonstration */
"Example 8: Performance Demonstration\n".echo();

start_time = $TIME().utc();

/* Create many threads rapidly */
for (i = 0; i < 10; i+=1) {
    $local.perf_thread = $thread();
    perf_thread.start(
        op(thread_id) {
            $sys().sleep(10);
            return ("Perf thread " + thread_id + " completed");
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
};

$sys().sleep(200);

end_time = $TIME().utc();
creation_time = end_time - start_time;
("Performance test completed in " + creation_time + "ms\n").echo();

/* Summary */
"=== Thread System Example Summary ===\n".echo();
("Total counter increments: " + shared_counter + "\n").echo();
("Final queue size: " + shared_queue.len() + "\n").echo();
("Available resources: " + resource_pool.available.len() + "\n").echo();
("Thread system demonstration complete!\n").echo();
