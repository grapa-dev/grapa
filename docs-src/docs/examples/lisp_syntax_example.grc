/* LISP Syntax Extension Example - True Native Syntax Using Grapa Grammar System */

/* Step 1: Initialize LISP environment */
("Setting up LISP environment...").echo();
$global.lisp_functions = {};
$global.lisp_vars = {};

/* Step 2: Define LISP syntax using Grapa's grammar system - NO MANUAL PARSING */

/* Initialize $custom_command and custom_function for LISP syntax */
("Defining LISP syntax with native grammar...").echo();

/* S-expressions with native grammar - individual argument parsing */
$custom_command = rule '(' $STR $STR $STR ')' {op(function:$2,arg1:$3,arg2:$4){
    /* Evaluate S-expression - NO MANUAL PARSING */
    result = lisp_eval(function, [arg1, arg2]);
    ("LISP S-expression: (" + function + " " + arg1 + " " + arg2 + ") = " + result).echo();
    return result;
}};

/* S-expressions with three arguments */
$custom_command = $custom_command | rule '(' $STR $STR $STR $STR ')' {op(function:$2,arg1:$3,arg2:$4,arg3:$5){
    /* Evaluate S-expression - NO MANUAL PARSING */
    result = lisp_eval(function, [arg1, arg2, arg3]);
    ("LISP S-expression: (" + function + " " + arg1 + " " + arg2 + " " + arg3 + ") = " + result).echo();
    return result;
}};

/* S-expressions with single argument */
$custom_command = $custom_command | rule '(' $STR $STR ')' {op(function:$2,arg1:$3){
    /* Evaluate S-expression - NO MANUAL PARSING */
    result = lisp_eval(function, [arg1]);
    ("LISP S-expression: (" + function + " " + arg1 + ") = " + result).echo();
    return result;
}};

/* Function definition with native grammar */
$custom_command = $custom_command | rule '(defun' $STR '(' $STR $STR ')' $STR ')' {op(name:$2,param1:$4,param2:$5,body:$7){
    /* Store function definition - NO MANUAL PARSING */
    $global.lisp_functions[name] = {
        params: [param1, param2],
        body: body
    };
    ("LISP Function defined: " + name + "(" + param1 + " " + param2 + ")").echo();
    return name;
}};

/* Function definition with single parameter */
$custom_command = $custom_command | rule '(defun' $STR '(' $STR ')' $STR ')' {op(name:$2,param1:$4,body:$6){
    /* Store function definition - NO MANUAL PARSING */
    $global.lisp_functions[name] = {
        params: [param1],
        body: body
    };
    ("LISP Function defined: " + name + "(" + param1 + ")").echo();
    return name;
}};

/* Variable assignment with native grammar */
$custom_command = $custom_command | rule '(setq' $STR $STR ')' {op(var:$2,value:$3){
    /* Set variable - NO MANUAL PARSING */
    evaluated_value = evaluate_sexp(value);
    $global.lisp_vars[var] = evaluated_value;
    ("LISP Variable set: " + var + " = " + evaluated_value).echo();
    return evaluated_value;
}};

/* Conditional expression with native grammar */
$custom_command = $custom_command | rule '(if' $STR $STR $STR ')' {op(condition:$2,then:$3,else:$4){
    /* Evaluate conditional - NO MANUAL PARSING */
    cond_result = evaluate_sexp(condition);
    if (cond_result) {
        result = evaluate_sexp(then);
        ("LISP If: condition true, result = " + result).echo();
    } else {
        result = evaluate_sexp(else);
        ("LISP If: condition false, result = " + result).echo();
    };
    return result;
}};

/* List operations with native grammar */
$custom_command = $custom_command | rule '(car' $STR ')' {op(list_expr:$2){
    /* Get first element - NO MANUAL PARSING */
    list_val = evaluate_sexp(list_expr);
    if (list_val.type() == $GOBJ) {
        result = list_val[0];
        ("LISP Car: " + result).echo();
        return result;
    } else {
        ("Error: car requires a list").echo();
        return null;
    };
}};

$custom_command = $custom_command | rule '(cdr' $STR ')' {op(list_expr:$2){
    /* Get rest of list - NO MANUAL PARSING */
    list_val = evaluate_sexp(list_expr);
    if (list_val.type() == $GOBJ) {
        result = list_val.mid(1);
        ("LISP Cdr: " + result).echo();
        return result;
    } else {
        ("Error: cdr requires a list").echo();
        return null;
    };
}};

$custom_command = $custom_command | rule '(cons' $STR $STR ')' {op(element:$2,list_expr:$3){
    /* Construct list - NO MANUAL PARSING */
    element_val = evaluate_sexp(element);
    list_val = evaluate_sexp(list_expr);
    if (list_val.type() == $GOBJ) {
        result = [element_val].concat(list_val);
        ("LISP Cons: " + result).echo();
        return result;
    } else {
        ("Error: cons requires a list as second argument").echo();
        return null;
    };
}};

$custom_command = $custom_command | rule '(list' $STR $STR ')' {op(elem1:$2,elem2:$3){
    /* Create list - NO MANUAL PARSING */
    val1 = evaluate_sexp(elem1);
    val2 = evaluate_sexp(elem2);
    result = [val1, val2];
    ("LISP List: " + result).echo();
    return result;
}};

$custom_command = $custom_command | rule '(list' $STR $STR $STR ')' {op(elem1:$2,elem2:$3,elem3:$4){
    /* Create list with three elements - NO MANUAL PARSING */
    val1 = evaluate_sexp(elem1);
    val2 = evaluate_sexp(elem2);
    val3 = evaluate_sexp(elem3);
    result = [val1, val2, val3];
    ("LISP List: " + result).echo();
    return result;
}};

/* List with single element */
$custom_command = $custom_command | rule '(list' $STR ')' {op(elem1:$2){
    /* Create list with single element - NO MANUAL PARSING */
    val1 = evaluate_sexp(elem1);
    result = [val1];
    ("LISP List: " + result).echo();
    return result;
}};

/* Helper functions for evaluation */
lisp_eval = op(function, args) {
    $local.result = null;
    $local.i = null;
    $local.func_def = null;
    
    if (function == "+") {
        result = 0;
        i = 0;
        while (i < args.len()) {
            result = result + evaluate_sexp(args[i]);
            i = i + 1;
        };
        return result;
    } else if (function == "*") {
        result = 1;
        i = 0;
        while (i < args.len()) {
            result = result * evaluate_sexp(args[i]);
            i = i + 1;
        };
        return result;
    } else if (function == "-") {
        if (args.len() == 1) {
            return -evaluate_sexp(args[0]);
        } else {
            result = evaluate_sexp(args[0]);
            i = 1;
            while (i < args.len()) {
                result = result - evaluate_sexp(args[i]);
                i = i + 1;
            };
            return result;
        };
    } else if (function == "/") {
        result = evaluate_sexp(args[0]);
        i = 1;
        while (i < args.len()) {
            result = result / evaluate_sexp(args[i]);
            i = i + 1;
        };
        return result;
    } else if (function == ">") {
        return evaluate_sexp(args[0]) > evaluate_sexp(args[1]);
    } else if (function == "<") {
        return evaluate_sexp(args[0]) < evaluate_sexp(args[1]);
    } else if (function == "=") {
        return evaluate_sexp(args[0]) == evaluate_sexp(args[1]);
    } else {
        /* Check if it's a user-defined function */
        if ($global.lisp_functions[function]) {
            func_def = $global.lisp_functions[function];
            /* Simple function application - in real LISP this would be more complex */
            return "Function " + function + " called with " + args;
        } else {
            ("Unknown function: " + function).echo();
            return null;
        };
    };
};

evaluate_sexp = op(expr) {
    $local.result = null;
    
    if (expr.type() == $INT || expr.type() == $FLOAT) {
        return expr;
    } else if (expr.type() == $STR) {
        /* Check if it's a quoted string */
        if (expr.indexOf('"') == 0 && expr.lastIndexOf('"') == expr.len() - 1) {
            return expr.substring(1, expr.len() - 1);
        } else if ($global.lisp_vars[expr]) {
            return $global.lisp_vars[expr];
        } else {
            return expr;
        };
    } else {
        return expr;
    };
};

("LISP native syntax defined!\n").echo();

/* Step 3: Execute LISP syntax using op(parse)() - TRUE NATIVE SYNTAX */

("=== Executing LISP Native Syntax ===").echo();

("1. Basic arithmetic (native grammar):").echo();
result1 = op(parse)("(+ 1 2)")();
("Result: " + result1).echo();

result2 = op(parse)("(* 3 4)")();
("Result: " + result2).echo();

result3 = op(parse)("(+ 1 2 3)")();
("Result: " + result3).echo();

result4 = op(parse)("(- 10 3)")();
("Result: " + result4).echo();

("\n2. Variable assignment (native grammar):").echo();
op(parse)("(setq x 10)")();
op(parse)("(setq y 20)")();

("\n3. Using variables (native grammar):").echo();
result5 = op(parse)("(+ x y)")();
("Result: " + result5).echo();

("\n4. Conditional expressions (native grammar):").echo();
result6 = op(parse)("(if (> 5 3) \"yes\" \"no\")")();
("Result: " + result6).echo();

("\n5. List operations (native grammar):").echo();
list1 = op(parse)("(list 1 2 3)")();
("List created: " + list1).echo();

list2 = op(parse)("(list 1)")();
("Single element list: " + list2).echo();

car_result = op(parse)("(car (list 1 2 3))")();
("Car result: " + car_result).echo();

cdr_result = op(parse)("(cdr (list 1 2 3))")();
("Cdr result: " + cdr_result).echo();

cons_result = op(parse)("(cons 0 (list 1 2 3))")();
("Cons result: " + cons_result).echo();

("\n6. Function definition (native grammar):").echo();
op(parse)("(defun square (x) (* x x))")();
op(parse)("(defun add (x y) (+ x y))")();

/* Step 4: Demonstrate expression usage */
("\n=== Expression Usage ===").echo();

("Using LISP expressions in Grapa:").echo();
lisp_result = op(parse)("(+ 5 3)")();
grapa_calc = lisp_result * 2;
("LISP result * 2 = " + grapa_calc).echo();

("Using LISP conditionals in Grapa:").echo();
if (op(parse)("(> 10 5)")()) {
    ("LISP condition is true").echo();
} else {
    ("LISP condition is false").echo();
};

("\n=== Power of Native Syntax ===").echo();
("This demonstrates TRUE native syntax using Grapa's grammar system.").echo();
("All parsing is handled by Grapa's grammar - no manual string manipulation.").echo();
("The grammar rules capture individual components as separate tokens.").echo();
("Implementation code receives already-parsed, structured data.").echo();
("Multiple LISP syntax patterns coexist using the | operator.").echo();
("LISP syntax is now truly native to Grapa!").echo();
