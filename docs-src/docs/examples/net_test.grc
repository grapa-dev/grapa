"\n=====\n".echo();
"https with cert\n".echo();
clienta = $net();
clienta.connect('http://httpbin.org', null, null);
clienta.send('GET / HTTP/1.1\r\nHost: localhost:8080\r\n\r\n');
responsea = clienta.receive();
while(clienta.pending()) responsea += clienta.receive();
clienta.disconnect();
responsea.echo();

"\n=====\n".echo();
"http with no cert\n".echo();
clienta = $net();
certData = $file().get("keys/client.crt");
clienta.connect('http://httpbin.org', certData, null);
clienta.send('GET / HTTP/1.1\r\nHost: localhost:8080\r\n\r\n');
responsea = clienta.receive();
while(clienta.pending()) responsea += clienta.receive();
clienta.disconnect();
responsea.echo();

"\n=====\n".echo();
"https with no cert\n".echo();
clienta = $net();
clienta.connect('http://httpbin.org', null, null);
clienta.send('GET / HTTP/1.1\r\nHost: localhost:8080\r\n\r\n');
responsea = clienta.receive();
while(clienta.pending()) responsea += clienta.receive();
clienta.disconnect();
responsea.echo();

"\nDONE\n".echo();
