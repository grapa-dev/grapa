/* Comprehensive Network Server/Client Test */
/* This script demonstrates Grapa's complete networking capabilities */

"Starting comprehensive network server/client test...\n".echo();

/* ======================================== */
/* SERVER SETUP */
/* ======================================== */

/* HTTP Server Message Handler */
httpMessageHandler = op(netSession, message, hasmore) {
    netSession."data" += message;
    
    if (hasmore == 0) {
		if (netSession."data".len()==0)
		{
			("HTTP Server:" + netSession."connectionId".str() + ": CLOSE\n").echo();
			netSession.disconnect();
            ("HTTP Server:" + netSession."connectionId".str() + ": DISCONNECTED\n").echo();
			return(null);
		};
				
        /* Extract path from netSession."data" */
		$local.datasplit = netSession."data".split(" ");
        $local.method = datasplit[0];
        $local.path = datasplit[1];
        
        /* Generate response based on path */
        $local.response = "";
        if (path == "/") {
            response = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n<h1>Grapa HTTP Server</h1><p>Server is running!</p>";
        } else if (path == "/json") {
            json_data = {"message": "Hello from Grapa", "server": "HTTP"};
            response = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n" + json_data.str();
        } else if (path == "/echo") {
            /* Echo back the netSession."data" */
            response = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\n" + netSession."data";
        } else {
            response = "HTTP/1.1 404 Not Found\r\nContent-Type: text/html\r\n\r\n<h1>404 - Not Found</h1>";
        };
        
        ("HTTP Server:" + netSession."connectionId".str() + ": Processed " + method + " " + path + " message length " + netSession."data".len().str() +"\n").echo();
		
        netSession."data" = "";
        netSession.send(response);
    };
};

/* Connection Handler for server */
connectionHandler = op(netSession) {
    netSession."data" = "";
    netSession."connectionId" = 32.random();
    ("New connection established: " + netSession."connectionId" + "\n").echo();
};

/* ======================================== */
/* START SERVERS */
/* ======================================== */

/* Start HTTP Server */
httpServer = $net();
httpServer.onlisten(':8080', httpMessageHandler, connectionHandler,5);


("HTTP server started on port 8080\n").echo();
("Servers are ready for connections\n").echo();

/* ======================================== */
/* CLIENT TESTS */
/* ======================================== */

/* Test HTTP Client */
"Testing HTTP client connections...\n".echo();

/* Test 1: Basic HTTP GET */
testHttpClient = op() {
    $local.n = $net();
    n.connect("localhost:8080", null, null);
    
    /* Send raw HTTP request */
    $local.request = "GET / HTTP/1.1\r\nHost: localhost:8080\r\nUser-Agent: Grapa-Test-Client/1.0\r\n\r\n";
    n.send(request);
    
    /* Receive response */
    $local.response = n.receive();
    while (n.pending()) response += n.receive();
    
    n.disconnect();
    
    ("HTTP Test 1 - Response length: " + response.len() + "\n").echo();
    return response;
};

/* Test 2: HTTP JSON endpoint */
testHttpJson = op() {
    $local.n = $net();
    n.connect("localhost:8080", null, null);
    
    $local.request = "GET /json HTTP/1.1\r\nHost: localhost:8080\r\nAccept: application/json\r\n\r\n";
    n.send(request);
    
    $local.response = n.receive();
    while (n.pending()) response += n.receive();
    
    n.disconnect();
    
    ("HTTP Test 2 - JSON Response length: " + response.len() + "\n").echo();
    return response;
};

/* Test 3: HTTP with custom headers */
testHttpHeaders = op() {
    $local.n = $net();
    n.connect("localhost:8080", null, null);
    
    $local.request = "GET /echo HTTP/1.1\r\nHost: localhost:8080\r\nUser-Agent: Grapa-Test-Client/1.0\r\nAccept: text/html,application/json\r\nX-Custom-Header: test-value\r\n\r\n";
    n.send(request);
    
    $local.response = n.receive();
    while (n.pending())response += n.receive();
    
    n.disconnect();
    
    ("HTTP Test 3 - Headers Response length: " + response.len() + "\n").echo();
    return response;
};

/* Test 4: HTTP POST with data */
testHttpPost = op() {
    $local.n = $net();
    n.connect("localhost:8080", null, null);
    
    $local.post_data = '{"name": "test", "value": 123}';
    $local.request = "POST /echo HTTP/1.1\r\nHost: localhost:8080\r\nContent-Type: application/json\r\nContent-Length: " + post_data.len() + "\r\n\r\n" + post_data;
    n.send(request);
    
    $local.response = n.receive();
    while (n.pending()) response += n.receive();
    
    n.disconnect();
    
    ("HTTP Test 4 - POST Response length: " + response.len() + "\n").echo();
    return response;
};

/* Run HTTP tests */
http_test1 = testHttpClient();
http_test2 = testHttpJson();
http_test3 = testHttpHeaders();
http_test4 = testHttpPost();



/* ======================================== */
/* ADVANCED TESTS */
/* ======================================== */

/* Test 8: Multiple concurrent connections */
"Testing concurrent connections...\n".echo();

concurrent_results = [testHttpClient,testHttpJson,testHttpHeaders,testHttpPost].map(op(x){@x().len();});
("Concurrent Test - All response lengths: " + concurrent_results.str() + "\n").echo();

/* Test 9: Network interface information */
"Testing network interface functions...\n".echo();

/* Get MAC address */
mac_info = $net().mac();
("MAC: " + mac_info.str() + "\n").echo();

/* Get all interfaces */
interfaces = $net().interfaces();
("Network Interfaces: " + interfaces.str() + "\n").echo();

/* Test 10: Connection information */
"Testing connection information...\n".echo();

test_conn = $net();
test_conn.connect("localhost:8080", null, null);
("Network Host: " + test_conn.host().str() + "\n").echo();
test_conn.disconnect();

("Connection test completed\n").echo();

/* ======================================== */
/* RESULTS SUMMARY */
/* ======================================== */

"\n".echo();

$sys().sleep(1000);

"=== NETWORK TEST RESULTS ===\n".echo();

/* HTTP Results */
("HTTP Tests:\n").echo();
("  Test 1 (Basic GET): " + http_test1.len() + " bytes\n").echo();
("  Test 2 (JSON): " + http_test2.len() + " bytes\n").echo();
("  Test 3 (Headers): " + http_test3.len() + " bytes\n").echo();
("  Test 4 (POST): " + http_test4.len() + " bytes\n").echo();


/* Advanced Results */
("Advanced Tests:\n").echo();
("  Concurrent Connections: " + concurrent_results.len() + " successful\n").echo();
("  Network Interfaces: " + interfaces.len() + " found\n").echo();
("  MAC Address: " + mac_info.mac.hex() + "\n").echo();

/* ======================================== */
/* CLEANUP */
/* ======================================== */

"Shutting down servers...\n".echo();

/* Disconnect servers */
httpServer.disconnect();

("Network test completed successfully!\n").echo();
("All Grapa networking capabilities validated.\n").echo();
