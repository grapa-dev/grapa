/* Simple directory test */
testDir = op(dirPath) {
    fileList = $file().ls(dirPath);
    count = 0;
    
    foreach fileInfo in fileList {
        fileName = fileInfo."$KEY";
        if (fileName.right(4) == ".grc") {
            count += 1;
        };
    };
    
    return "Found ${count} .grc files".interpolate();
};

result = testDir("../../../test/core");
result.echo();
