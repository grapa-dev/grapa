/* Grapa Thread System Example
   Demonstrates the complete $thread system capabilities including:
   - Example 5: Resource pool management

"=== Grapa Thread System Example ===\n".echo();

/* Example 5: Resource Pool Management */
"Example 5: Resource Pool Management\n".echo();

/* Resource requesters */
requester = [];
$global resource_pool = {
    available: ["Resource_A", "Resource_B", "Resource_C"],
    in_use: [],
    lock: $thread()
};
for (requester_id = 0; requester_id < 4; requester_id+=1) {
    requester += $thread();
    requester[-1].start(
        op(id) {
            ("Requester " + id + ": Requesting resource\n").echo();
            resource_pool.lock.lock();
            if (resource_pool.available.len() > 0) {
                $local.resource = resource_pool.available[-1];
                resource_pool.available -= resource_pool.available[-1];
                resource_pool.in_use[id] = resource;
                resource_pool.lock.unlock();
                
                ("Requester " + id + ": Got " + resource + "\n").echo();
                $sys().sleep(200);  /* Use resource */
                
                resource_pool.lock.lock();
                resource_pool.available += resource;
                resource_pool.in_use -= resource_pool.in_use[id];
                resource_pool.lock.unlock();
                
                ("Requester " + id + ": Returned " + resource + "\n").echo();
            } else {
                resource_pool.lock.unlock();
                ("Requester " + id + ": No resources available\n").echo();
            };
            
            return ("Requester " + id + " completed");
        },
        requester_id,
        op(input, result) {
            ("Requester callback: " + result + "\n").echo();
        }
    );
};
