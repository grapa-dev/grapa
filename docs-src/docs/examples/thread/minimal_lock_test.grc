/* Minimal Thread Lock Test */
"=== Minimal Thread Lock Test ===\n".echo();

/* Create a lock */
lock = $thread();

/* Test basic lock/unlock */
"Test: Basic lock/unlock\n".echo();
lock.lock();
"Main: acquired lock\n".echo();
lock.unlock();
"Main: released lock\n".echo();

/* Test single thread competing for lock */
"Test: Single thread competing for lock\n".echo();
lock.lock();
"Main: acquired lock again\n".echo();

/* Create a single worker */
worker = $thread();
worker.start(
    op() {
        "Worker: trying to acquire lock\n".echo();
        lock.lock();
        "Worker: acquired lock\n".echo();
        $sys().sleep(100);
        "Worker: releasing lock\n".echo();
        lock.unlock();
        "Worker: released lock\n".echo();
        return "Worker completed";
    },
    null,
    op(input, result) {
        ("Worker callback: " + result + "\n").echo();
    }
);

/* Wait for worker to start */
while(worker.started() == false)
    $sys().sleep(10);

"Main: worker started, waiting for it to complete\n".echo();

/* Wait for worker to complete */
while(worker.started())
    $sys().sleep(10);

"Main: worker completed\n".echo();
"Minimal lock test completed successfully!\n".echo();
