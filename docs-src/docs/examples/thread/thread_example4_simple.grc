/* Simple Thread Suspend/Resume Test */
"=== Simple Thread Suspend/Resume Test ===\n".echo();

/* Create a simple thread that suspends and resumes */
test_thread = $thread();
test_thread.start(
    op() {
        "Thread: Starting\n".echo();
        $sys().sleep(100);
        "Thread: About to suspend\n".echo();
        test_thread.suspend();
        "Thread: Suspended\n".echo();
        $sys().sleep(100);
        "Thread: Resumed and continuing\n".echo();
        $sys().sleep(100);
        "Thread: Completing\n".echo();
        return "Thread completed successfully";
    },
    null,
    op(input, result) {
        ("Thread callback: " + result + "\n").echo();
    }
);

/* Wait for thread to start and suspend */
while(test_thread.started() == false || test_thread.suspended() == false) {
    $sys().sleep(10);
}

"Main: Thread is suspended, resuming it\n".echo();
test_thread.resume();

/* Wait for thread to complete */
while(test_thread.started()) {
    $sys().sleep(10);
}

"Main: Thread completed\n".echo();
test_thread = null;
"Test completed successfully\n".echo();
