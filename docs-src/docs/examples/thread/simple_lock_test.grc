/* Simple Thread Lock Test */
"=== Simple Thread Lock Test ===\n".echo();

/* Create a lock */
lock = $thread();

/* Test 1: Basic lock/unlock */
"Test 1: Basic lock/unlock\n".echo();
lock.lock();
"Main thread: acquired lock\n".echo();
lock.unlock();
"Main thread: released lock\n".echo();

/* Test 2: Thread trying to acquire lock */
"Test 2: Thread trying to acquire lock\n".echo();
lock.lock();
"Main thread: acquired lock again\n".echo();

/* Create a thread that tries to acquire the lock */
worker = $thread();
worker.start(
    op() {
        "Worker: trying to acquire lock\n".echo();
        lock.lock();
        "Worker: acquired lock\n".echo();
        $sys().sleep(100);
        "Worker: releasing lock\n".echo();
        lock.unlock();
        "Worker: released lock\n".echo();
        return "Worker completed";
    },
    null,
    op(input, result) {
        ("Worker callback: " + result + "\n").echo();
    }
);

/* Wait for worker to start */
while(worker.started() == false)
    $sys().sleep(10);

"Main thread: waiting for worker to complete\n".echo();

/* Wait for worker to complete */
while(worker.started())
    $sys().sleep(10);

"Main thread: worker completed\n".echo();

/* Test 3: Multiple threads competing for lock */
"Test 3: Multiple threads competing for lock\n".echo();
lock.lock();
"Main thread: acquired lock for test 3\n".echo();

workers = [];
i = 0;
while(i < 3)
{
    workers += $thread();
    workers[-1].start(
        op(id) {
            ("Worker " + id + ": trying to acquire lock\n").echo();
            lock.lock();
            ("Worker " + id + ": acquired lock\n").echo();
            $sys().sleep(50);
            ("Worker " + id + ": releasing lock\n").echo();
            lock.unlock();
            ("Worker " + id + ": released lock\n").echo();
            return ("Worker " + id + " completed");
        },
        i,
        op(input, result) {
            ("Worker " + input + " callback: " + result + "\n").echo();
        }
    );
    i += 1;
}

/* Wait for all workers to start */
i = 0;
while(i < 3)
{
    while(workers[i].started() == false)
        $sys().sleep(10);
    i += 1;
}

"Main thread: all workers started, releasing lock\n".echo();
lock.unlock();

/* Wait for all workers to complete */
i = 0;
while(i < 3)
{
    while(workers[i].started())
        $sys().sleep(10);
    i += 1;
}

"Main thread: all workers completed\n".echo();
"Simple lock test completed successfully!\n".echo();
