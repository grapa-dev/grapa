/* Simple Network Server/Client Test */
/* Based on the working pattern we discovered */

"Starting simple network test...\n".echo();

/* ======================================== */
/* SIMPLE HTTP SERVER */
/* ======================================== */

/* Simple message handler */
messageHandler = op(netSession, message, hasmore) {
    netSession.data += message;
    
    if (hasmore == 0) {
        /* Parse basic HTTP request */
        request = netSession.data;
        method = request.left(3);
        
        /* Generate simple response */
        if (method == "GET") {
            response = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n<h1>Simple Grapa Server</h1><p>Method: " + method + "</p>";
        } else if (method == "POST") {
            response = "HTTP/1.1 200 OK\r\nContent-Type: text/json\r\n\r\n{\"status\":\"success\",\"method\":\"" + method + "\"}";
        } else {
            response = "HTTP/1.1 405 Method Not Allowed\r\n\r\n";
        };
        
        netSession.send(response);
        netSession.data = "";
        
        ("Server: Processed " + method + " request\n").echo();
    };
};

/* Connection handler */
connectionHandler = op(netSession) {
    netSession.data = "";
    netSession.connectionId = Math.random().int();
    ("New connection: " + netSession.connectionId + "\n").echo();
};

/* ======================================== */
/* START SERVER */
/* ======================================== */

server = $net();
server.onlisten('0.0.0.0:8080', messageHandler, connectionHandler);

("HTTP server started on port 8080\n").echo();
("Waiting for connections...\n").echo();

/* Wait for server to start */
Sleep(1000);

/* ======================================== */
/* CLIENT TESTS */
/* ======================================== */

"Testing client connections...\n".echo();

/* Test 1: Basic GET request */
client1 = $net();
client1.connect('localhost:8080', null, null);
client1.send('GET / HTTP/1.1\r\nHost: localhost:8080\r\n\r\n');
response1 = client1.receive();
("Client 1 - Response length: " + response1.len() + "\n").echo();
client1.disconnect();

/* Test 2: POST request */
client2 = $net();
client2.connect('localhost:8080', null, null);
client2.send('POST / HTTP/1.1\r\nHost: localhost:8080\r\nContent-Type: application/json\r\n\r\n{"test":123}');
response2 = client2.receive();
("Client 2 - Response length: " + response2.len() + "\n").echo();
client2.disconnect();

/* ======================================== */
/* NETWORK FUNCTIONS TEST */
/* ======================================== */

"Testing network functions...\n".echo();

/* Test MAC address */
mac_info = $net().mac();
("MAC Address: " + mac_info.mac + "\n").echo();

/* Test interfaces */
interfaces = $net().interfaces();
("Network Interfaces: " + interfaces.len() + " found\n").echo();

/* ======================================== */
/* RESULTS */
/* ======================================== */

"".echo();
"=== SIMPLE NETWORK TEST RESULTS ===".echo();
("✓ Server started successfully\n").echo();
("✓ Client connections worked\n").echo();
("✓ Network functions accessible\n").echo();

/* ======================================== */
/* CLEANUP */
/* ======================================== */

"Cleaning up...\n".echo();
server.disconnect();

("Simple network test completed successfully!\n").echo();

