/* Model Examples - Comprehensive Usage Guide */

"Model Examples - Comprehensive Usage Guide\n".echo();
"=============================================\n".echo();

/* This file demonstrates comprehensive usage of the $MODEL data type */
/* Note: Uses qwen2.5-7b-instruct-q3_k_m.gguf for simplicity (single file download) */
/* For higher quality results, substitute qwen2.5-7b-instruct-q5_k_m.gguf (requires merging 2 files) */

modelpath = "models/qwen2.5-7b-instruct-q5_k_m.gguf";

"=== Basic Model Usage ===\n".echo();

/* Simple Text Generation */
"--- Simple Text Generation ---\n".echo();
model = $MODEL();
"Loading model...\n".echo();

/* Auto-detect method from file extension */
result = model.load(modelpath);
if (result.type() != $ERR) {
    "Model loaded successfully!\n".echo();
    /* Generate a simple response */
    response = model.gen("Hello, how are you?");
    ("Response: " + response.str() + "\n").echo();
} else {
    ("Failed to load model: " + result.str() + "\n").echo();
};

/* Clean up */
model.load();

"\n".echo();

/* Model Information */
"--- Model Information ---\n".echo();
model = $MODEL();
model.load(modelpath);

info = model.info();
("Model loaded: " + info."loaded".str() + "\n").echo();
("Method: " + info."method".str() + "\n").echo();
("Model path: " + info."model_path".str() + "\n").echo();
("Model name: " + info."model".str() + "\n").echo();

/* Display current parameters */
params = model.params();
("Current parameters:" + "\n").echo();
("  Temperature: " + params."temperature".float(20).str() + "\n").echo();
("  Max tokens: " + params."max_tokens".str() + "\n").echo();
("  Context size: " + params."context_size".str() + "\n").echo();

model.load();

"\n".echo();

"=== Parameter Configuration ===\n".echo();

/* Setting Generation Parameters */
"--- Setting Generation Parameters ---\n".echo();
model = $MODEL();

"Parameters configured\n".echo();
/* Auto-detect method from file extension */
model.load(modelpath);

/* Set generation parameters */
model.params({
    "temperature": 0.8,      /* More creative responses */
    "max_tokens": 100,       /* Longer responses */
    "top_k": 50,             /* More diverse token selection */
    "verbose": 1             /* Show errors only */
});


/* Generate with configured parameters */
response = model.gen("Write a short story about a robot");
("Story: " + response.str() + "\n").echo();

model.load();

"\n".echo();

/* Dynamic Parameter Override */
"--- Dynamic Parameter Override ---\n".echo();
model = $MODEL();
/* Auto-detect method from file extension */
model.load(modelpath);

/* Conservative generation */
conservative_response = model.gen("Explain quantum computing", {
    "temperature": 0.3,
    "max_tokens": 50
});

/* Creative generation */
creative_response = model.gen("Write a poem about space", {
    "temperature": 1.2,
    "max_tokens": 150
});

("Conservative: " + conservative_response.str() + "\n").echo();
("Creative: " + creative_response.str() + "\n").echo();

model.load();

"\n".echo();

"=== Verbose Control ===\n".echo();

/* Debugging with Verbose Output */
"--- Debugging with Verbose Output ---\n".echo();
model = $MODEL();

"Loading model with debug output...\n".echo();
/* Auto-detect method from file extension */
result = model.load(modelpath);

model.params({"verbose": 4});  /* Maximum verbosity */

if (result.type() != $ERR) {
    "Model loaded, generating with debug info...\n".echo();
    response = model.gen("What is machine learning?");
    ("Response: " + response.str() + "\n").echo();
} else {
    ("Load failed with error: " + result.str() + "\n").echo();
};

model.load();

"\n".echo();

/* Silent Operation */
"--- Silent Operation ---\n".echo();
model = $MODEL();

/* Auto-detect method from file extension */
model.load(modelpath);

model.params({"verbose": 0});  /* No output */

response = model.gen("Hello");
("Response: " + response.str() + "\n").echo();

model.load();

"\n".echo();

"=== Multiple Model Instances ===\n".echo();

/* Concurrent Model Usage */
"--- Concurrent Model Usage ---\n".echo();
model1 = $MODEL();
model2 = $MODEL();

/* Load the same model in both instances (auto-detect method) */
model1.load(modelpath);
model2.load(modelpath);

/* Configure different parameters for each */
model1.params({"temperature": 0.5});
model2.params({"temperature": 1.0});

conservative = model1.gen("Explain AI");
creative = model2.gen("Explain AI");

("Conservative: " + conservative.str() + "\n").echo();
("Creative: " + creative.str() + "\n").echo();

/* Clean up both models */
model1.load();
model2.load();

"\n".echo();

"=== Error Handling ===\n".echo();

/* Robust Error Handling */
"--- Robust Error Handling ---\n".echo();
model = $MODEL();

/* Try to load a model */
result = model.load("nonexistent/model.gguf");
if (result.type() == $ERR) {
    ("Error loading model: " + result.str() + "\n").echo();
    ("This could be due to:" + "\n").echo();
    ("  - File not found"+ "\n").echo();
    ("  - Invalid model format" + "\n").echo();
    ("  - Insufficient memory" + "\n").echo();
}
else {
    response = model.gen("Hello");
    if (response.len() == 0) {
        "Warning: Empty response generated\n".echo();
    } else {
        ("Generated: " + response.str() + "\n").echo();
    };
};

/* Always clean up */
model.load();

"\n".echo();

"=== Context Management ===\n".echo();

/* Setting and Getting Context */
"--- Setting and Getting Context ---\n".echo();
model = $MODEL();
/* Auto-detect method from file extension */
model.load(modelpath);

/* Set initial context */
model.context("You are a helpful assistant. Previous conversation: User asked about AI.");

/* Generate response with context */
response1 = model.gen("What is machine learning?");
("Response 1: " + response1.str() + "\n").echo();

/* Get current context */
current_context = model.context();
("Current context: " + current_context."text".str() + "\n").echo();
("Context tokens: " + current_context."tokens".len().str() + " tokens" + "\n").echo();

/* Continue conversation with preserved context */
response2 = model.gen("Can you explain that in simpler terms?");
("Response 2: " + response2.str() + "\n").echo();

model.load();

"\n".echo();

/* Efficient Token Context */
"--- Efficient Token Context ---\n".echo();
model = $MODEL();
model.load(modelpath);

/* Set context using tokens (more efficient than text) */
token_context = [1, 2, 3, 4, 5];  /* Example token IDs */
model.context(token_context);

/* Generate with token context */
response = model.gen("Continue the conversation");
("Response: " + response.str() + "\n").echo();

/* Get context back as object with both text and tokens */
context_info = model.context();
("Method: " + context_info."method".str() + "\n").echo();
("Model: " + context_info."model".str() + "\n").echo();

model.load();

"\n".echo();

"=== Practical Applications ===\n".echo();

/* Chat Bot Implementation */
"--- Chat Bot Implementation ---\n".echo();
chatbot = $MODEL();

"Loading chatbot model...\n".echo();
/* Auto-detect method from file extension */
result = chatbot.load(modelpath);

chatbot.params({
    "temperature": 0.7,
    "max_tokens": 200,
    "verbose": 0
});

if (result.type() != $ERR) {
    "Chatbot ready! Type 'quit' to exit\n".echo();
    
    /* Simulate chat loop */
    user_input = "Hello, what can you help me with?";
    while (user_input != "quit") {
        response = chatbot.gen(user_input);
        ("Bot: " + response.str() + "\n").echo();
        
        /* In a real implementation, you would get user input here */
        user_input = "quit";  /* Exit after first response for demo */
    };
} else {
    ("Failed to load chatbot: " + result.str() + "\n").echo();
};

chatbot.load();

"\n".echo();

/* Content Generation */
"--- Content Generation ---\n".echo();
content_generator = $MODEL();
/* Auto-detect method from file extension */
content_generator.load(modelpath);

/* Technical writing */
technical = content_generator.gen("Explain how neural networks work", {
    "temperature": 0.3,
    "max_tokens": 150
});

/* Creative writing */
creative = content_generator.gen("Write a creative story about AI", {
    "temperature": 1.1,
    "max_tokens": 200
});

("Technical: " + technical.str() + "\n").echo();
("Creative: " + creative.str() + "\n").echo();

content_generator.load();

"\n".echo();

"=== Performance Optimization ===\n".echo();

/* Efficient Model Usage */
"--- Efficient Model Usage ---\n".echo();
model = $MODEL();

"Loading optimized model...\n".echo();
/* Auto-detect method from file extension */
model.load(modelpath);

/* Set optimal parameters for your use case */:
model.params({
    "context_size": 1024,    /* Smaller context for faster processing */
    "max_tokens": 50,        /* Limit response length */
    "verbose": 0             /* Disable logging for speed */
});

/* Batch multiple generations */
prompts = ["What is AI?", "Explain ML", "Define deep learning"];
responses = [];

for (i = 0; i < prompts.len(); i+=1) {
    response = model.gen(prompts[i]);
    responses.append(response);
    ("Response " + (i+1).str() + ": " + response.str() + "\n").echo();
};

model.load();

"\n".echo();

"=== Examples Complete ===\n".echo();
"All model examples have been demonstrated!\n".echo();
