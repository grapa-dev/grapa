/* Complete working curl function with proper line feeds */

curl = op(url_str, options) {
    /* Handle null or invalid options */
    if (options == null || options.type() != $LIST) {
        options = {};
    };
    
    /* Determine HTTP method */
    method = "GET";
    if (options.method.type() == $STR) {
        method = options.method;
    };
    
	cert = null;
	url_part = "";
    /* Extract host from URL for Host header */
    host = "";
    if (url_str.left(7) == "http://") {
        url_part = url_str.right(url_str.len() - 7);
    } else if (url_str.left(8) == "https://") {
        url_part = url_str.right(url_str.len() - 8);
		cert = "keys/client.crt";
    } else {
        url_part = url_str;
    };
    
   /* Create network connection */
    client = $net();
    
    /* Connect to the URL */
    err = client.connect(url_str, cert, null);
    
    /* Check for connection error */
    if (err.type() == $ERR) {
        client.disconnect();
        return {"error": -1, "message": "Connection failed"};
    };
    
     /* Find first slash to get host */
    slash_pos = -1;
    i = 0;
    while (i < url_part.len()) {
        if (url_part.mid(i, 1) == "/") {
            slash_pos = i;
            break;
        };
        i += 1;
    };
    
    if (slash_pos >= 0) {
        host = url_part.left(slash_pos);
    } else {
        host = url_part;
    };
    
    /* Build HTTP request */
    request = method + " / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n";
	
	("url_part: " + url_part + "\n").echo();
	("Build HTTP request: " + request).echo();

    /* Send request */
    client.send(request);
    
    /* Receive response */
    response = client.receive();
    while (client.pending()) {
        response += client.receive();
    };
    
    /* Parse response */
    header_end = -1;
    i = 0;
    while (i < response.len() - 3) {
        if (response.mid(i, 4) == "\r\n\r\n") {
            header_end = i;
            break;
        };
        i += 1;
    };
    
    if (header_end < 0) {
        client.disconnect();
        return {"error": -1, "message": "Invalid HTTP response"};
    };
    
    headers_raw = response.left(header_end);
    response_body = response.right(response.len() - header_end - 4);
    
    /* Parse status line */
    lines = headers_raw.split("\r\n");
    if (lines.len() == 0) {
        client.disconnect();
        return {"error": -1, "message": "No status line"};
    };
    
    status_line = lines[0];
    status_parts = status_line.split(" ");
    
    if (status_parts.len() < 3) {
        client.disconnect();
        return {"error": -1, "message": "Invalid status line"};
    };
    
    status_code = status_parts[1].int();
    status_text = status_parts.range(2).join(" ");
    
    client.disconnect();
    
    return {
        "status_code": status_code,
        "status_text": status_text,
        "body": response_body
    };
};

/* Test the complete working curl function */
"Testing complete working curl function...\n".echo();

"Test 1: HTTP GET\n".echo();
result = curl("http://httpbin.org");
("HTTP GET status: " + result.status_code + "\n").echo();

"Test 2: HTTPS GET\n".echo();
result2 = curl("https://httpbin.org");
("HTTPS GET status: " + result2.status_code + "\n").echo();

"All tests completed.\n".echo();
