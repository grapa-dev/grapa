/* Simple curl function for testing */
parse_url = op(url_str) {
    url = {};
    if (url_str.left(7) == "http://") {
        url.protocol = "http";
        url_str = url_str.right(url_str.len() - 7);
    } else if (url_str.left(8) == "https://") {
        url.protocol = "https";
        url_str = url_str.right(url_str.len() - 8);
    } else {
        url.protocol = "http";
    };
    
    slash_pos = -1;
    i = 0;
    while (i < url_str.len()) {
        if (url_str.mid(i, 1) == "/") {
            slash_pos = i;
            break;
        };
        i += 1;
    };
    
    host_part = "";
    if (slash_pos >= 0) {
        host_part = url_str.left(slash_pos);
        url.path = "/" + url_str.right(url_str.len() - slash_pos - 1);
    } else {
        host_part = url_str;
        url.path = "/";
    };
    
    url.host_port = host_part;
    
    /* Add default port if not specified */
    if (url.host_port.right(1) != ":" && url.protocol == "http") {
        url.host_port += ":80";
    } else if (url.host_port.right(1) != ":" && url.protocol == "https") {
        url.host_port += ":443";
    };
    
    return url;
};

curl = op(url_str, options) {
    /* Handle null or invalid options */
    if (options == null || options.type() != $LIST) {
        options = {};
    };
    
    url = parse_url(url_str);
    
    /* Configure SSL/TLS certificates */
    cert = null;
    if (url.protocol == "https") {
        if (options.cert_file) {
            cert = options.cert_file;
        };
    };
    
    /* Configure proxy if specified */
    proxy = null;
    if (options.proxy) {
        if (options.proxy.type() == $STR) {
            /* Simple proxy string: "http://proxy:port" */
            proxy_str = options.proxy;
            if (proxy_str.left(7) == "http://") {
                proxy_str = proxy_str.right(proxy_str.len() - 7);
            } else if (proxy_str.left(8) == "https://") {
                proxy_str = proxy_str.right(proxy_str.len() - 8);
            };
            
            /* Extract host:port from proxy string */
            slash_pos = -1;
            i = 0;
            while (i < proxy_str.len()) {
                if (proxy_str.mid(i, 1) == "/") {
                    slash_pos = i;
                    break;
                };
                i += 1;
            };
            
            if (slash_pos >= 0) {
                proxy_host_port = proxy_str.left(slash_pos);
            } else {
                proxy_host_port = proxy_str;
            };
            
            proxy = {
                type: "HTTP",
                id: proxy_host_port,
                ip: proxy_host_port
            };
        } else if (options.proxy.type() == $LIST) {
            /* Detailed proxy configuration */
            proxy_host = options.proxy.host || options.proxy.hostname;
            proxy_port = options.proxy.port || "8080";
            proxy_type = options.proxy.type || "HTTP";
            
            if (proxy_host) {
                proxy_host_port = proxy_host;
                if (proxy_port && proxy_host.right(1) != ":") {
                    proxy_host_port += ":" + proxy_port;
                };
                proxy = {
                    type: proxy_type,
                    id: proxy_host_port,
                    ip: proxy_host_port
                };
            };
        };
    };
    
    n2 = $net();
    
    /* Configure SSL/TLS certificates before connection */
    if (url.protocol == "https") {
        /* Set client certificate if provided */
        if (options.cert_file) {
            n2.certificate(options.cert_file);
        };
        
        /* Set private key if provided */
        if (options.key_file) {
            n2.private(options.key_file, options.key_password, null);
        };
        
        /* Set trusted CA certificates if provided */
        if (options.ca_file || options.ca_path) {
            n2.trusted(options.ca_file || "", options.ca_path || "");
        };
    };
    
    n2.connect(url.host_port, cert, proxy);
    
    /* Build headers like supreme example */
    header = {"Host": url.host_port};
    if (!options.headers) {
        options.headers = {};
    };
    
    /* Determine HTTP method - handle null, invalid types, and unknown methods */
    method = "GET";
    if (options.method != null && options.method.type() == $STR) {
        method_str = options.method;
        if (method_str == "POST") {
            method = "POST";
        } else if (method_str == "PUT") {
            method = "PUT";
        } else if (method_str == "DELETE") {
            method = "DELETE";
        } else if (method_str == "PATCH") {
            method = "PATCH";
        } else if (method_str == "HEAD") {
            method = "HEAD";
        } else if (method_str == "OPTIONS") {
            method = "OPTIONS";
        } else {
            /* Unknown method - log warning and use GET */
            ("Warning: Unknown HTTP method '" + method_str + "', using GET").echo();
        };
    } else if (options.method != null) {
        /* Invalid method type - log warning and use GET */
        ("Warning: Invalid method type " + options.method.type() + ", using GET").echo();
    };
    
    /* Prepare request body */
    body = "";
    if (options.data != null) {
        if (options.data.type() == $LIST) {
            /* JSON object - convert to string */
            body = options.data.str();
            if (!header["Content-Type"]) {
                header["Content-Type"] = "application/json";
            };
        } else if (options.data.type() == $STR) {
            /* String data */
            body = options.data;
            if (!header["Content-Type"]) {
                header["Content-Type"] = "text/plain";
            };
        } else {
            /* Invalid data type - convert to string */
            body = options.data.str();
            if (!header["Content-Type"]) {
                header["Content-Type"] = "text/plain";
            };
            ("Warning: Invalid data type " + options.data.type() + ", converting to string").echo();
        };
    } else if (options.form != null) {
        /* URL-encoded form data */
        if (options.form.type() == $LIST) {
            form_keys = options.form.keys();
            i = 0;
            while (i < form_keys.len()) {
                if (i > 0) {
                    body += "&";
                };
                key = form_keys[i];
                value = options.form[key];
                body += key.encode("URL-ASCII") + "=" + value.encode("URL-ASCII");
                i += 1;
            };
        } else {
            ("Warning: Invalid form type " + options.form.type() + ", ignoring form data").echo();
        };
        if (!header["Content-Type"]) {
            header["Content-Type"] = "application/x-www-form-urlencoded";
        };
    };
    
    /* Add Content-Length header for requests with body */
    if (body.len() > 0) {
        header["Content-Length"] = body.len();
    };
    
    /* Merge custom headers after body preparation */
    if (options.headers) {
        header_keys = options.headers.keys();
        i = 0;
        while (i < header_keys.len()) {
            header[header_keys[i]] = options.headers[header_keys[i]];
            i += 1;
        };
    };
    
    n2.httpsend(method, url.path, header, body);
    
    parsed_response = n2.httpmessage();
    
    /* Get SSL certificate information for HTTPS connections */
    ssl_info = null;
    if (url.protocol == "https") {
        verify_result = n2.verify();
        ssl_info = {
            "verify_error": verify_result.X509_error,
            "certificate": verify_result.X509_certificate,
            "certificate_info": null
        };
        
        /* Decode certificate if available */
        if (verify_result.X509_certificate.len() > 0) {
            ssl_info.certificate_info = verify_result.X509_certificate.decode("PEM");
        };
        
        /* Get certificate chain */
        chain_result = n2.chain();
        ssl_info.chain_length = chain_result.len();
    };
    
    n2.disconnect();
    
    return {
        "status_code": parsed_response.status.code.int(),
        "status_text": parsed_response.status.description,
        "headers": parsed_response.headers,
        "body": parsed_response.body,
        "ssl_info": ssl_info
    };
};

/* Test the functions */
"Testing parse_url function...".echo();
url = parse_url("http://httpbin.org/get");
url.echo();

"Testing curl function...".echo();
result = curl("http://httpbin.org/get");
result.status_code.echo();
result.body.echo();

"Testing curl with custom headers...".echo();
result2 = curl("http://httpbin.org/get", {headers: {"User-Agent": "Grapa-Curl-Test/1.0"}});
result2.status_code.echo();

"Testing HTTPS with certificate...".echo();
result3 = curl("https://httpbin.org/get", {cert_file: "keys/client.crt"});
result3.status_code.echo();

"Testing HTTPS without certificate...".echo();
result4 = curl("https://httpbin.org/get");
result4.status_code.echo();
if (result4.ssl_info) {
    ("SSL verify error: " + result4.ssl_info.verify_error).echo();
    ("SSL chain length: " + result4.ssl_info.chain_length).echo();
};

"Testing proxy support (commented out - requires actual proxy)...".echo();
