/* ========================================
 * String Interpolation Example
 * ======================================== */

/* String interpolation method for $STR class */
@global["$STR"]
= class ($OBJ) {
    interpolate = op(template){
        /* Parse template string and replace ${expression} with evaluated values */
        result = "";
        i = 1;
        while (i <= template.len()) {
            char = template[i];
            if (char == "$" && i + 1 <= template.len() && template[i + 1] == "{") {
                /* Found ${ - extract expression */
                i += 2; /* Skip ${ */
                expression_start = i;
                brace_count = 1;
                
                /* Find matching } */
                while (i <= template.len() && brace_count > 0) {
                    if (template[i] == "{") {
                        brace_count += 1;
                    } else if (template[i] == "}") {
                        brace_count -= 1;
                    };
                    i += 1;
                };
                
                if (brace_count == 0) {
                    /* Extract and evaluate expression */
                    expression = template[expression_start:i-2];
                    evaluated = op(parse)(expression)();
                    result += evaluated;
                } else {
                    /* Unmatched braces - treat as literal */
                    result += "${";
                    i = expression_start;
                };
            } else {
                result += char;
                i += 1;
            };
        };
        result;
    };
};

/* ========================================
 * USAGE EXAMPLES
 * ======================================== */

/* Basic string interpolation */
name = "World";
age = 25;

/* Method-style usage (Phase 2 C++ implementation) */
result1 = "Hello ${name}!".interpolate();
result2 = "Age: ${age} years old".interpolate();
result3 = "Hello ${name}, you are ${age} years old!".interpolate();

/* Chaining with other methods */
"Hello ${name}, you are ${age} years old!\n".interpolate().echo();

/* With expressions */
x = 10;
y = 5;
sum_result = "Sum: ${x + y}".interpolate();

/* With complex expressions */
user = "Alice";
score = 95;
grade = "A";
report = "Student: ${user}, Score: ${score}, Grade: ${grade}".interpolate();

/* Chaining multiple operations */
"Report: ${report}\n".interpolate().upper().echo(); 