/*
 * RSA and Cryptographic Functions Example for Grapa
 * 
 * This example demonstrates Grapa's extensive cryptographic capabilities:
 * - RSA key generation, encryption, decryption, signing, and verification
 * - Elliptic Curve (EC) cryptography
 * - Diffie-Hellman (DH) key exchange
 * - Hash functions and encoding
 * 
 * Note: These functions require proper initialization and may have OpenSSL 3.x compatibility issues
 * that need to be addressed in the C++ backend.
 */

"=== RSA and Cryptographic Functions Example ===\n".echo();

/* ======================================== */
/* 1. BASIC ENCODING/DECODING */
/* ======================================== */

"1. Basic Encoding/Decoding:\n".echo();

/* Base64 encoding/decoding */
test_data = "Hello, Grapa Cryptography!";
base64_encoded = test_data.encode({"method": "base64"});
base64_decoded = base64_encoded.decode("base64");

("Original: " + test_data + "\n").echo();
("Base64 encoded: " + base64_encoded + "\n").echo();
("Base64 decoded: " + base64_decoded + "\n").echo();
("Match: " + (test_data == base64_decoded).str() + "\n").echo();

/* Hex encoding (for output formatting) */
hex_encoded = test_data.uhex();

("Hex encoded: " + hex_encoded + "\n").echo();

/* ======================================== */
/* 2. HASH FUNCTIONS */
/* ======================================== */

"2. Hash Functions:\n".echo();

/* SHA-256 hashing */
md_keys_sha256 = "md".genkeys({"digest": "sha256"});
sha256_hash = test_data.encode(md_keys_sha256);
("SHA-256 hash: " + sha256_hash.uhex() + "\n").echo();

/* MD5 hashing (for legacy compatibility) */
md_keys_md5 = "md".genkeys({"digest": "md5"});
md5_hash = test_data.encode(md_keys_md5);
("MD5 hash: " + md5_hash.uhex() + "\n").echo();

/* ======================================== */
/* 3. RSA KEY GENERATION */
/* ======================================== */

"3. RSA Key Generation:\n".echo();

/* Generate RSA key pair */
rsa_keys = "rsa".genkeys();
("RSA keys generated successfully\n").echo();
("Key data type: " + rsa_keys.type() + "\n").echo();
("Key type: " + rsa_keys."method" + "\n").echo();

/* ======================================== */
/* 4. ELLIPTIC CURVE CRYPTOGRAPHY */
/* ======================================== */

"4. Elliptic Curve Cryptography:\n".echo();

/* Generate EC key pair */
ec_keys = "ec".genkeys({"curve": "prime256v1"});
("EC keys generated successfully\n").echo();
("Key data type: " + ec_keys.type() + "\n").echo();
("Key type: " + ec_keys."method" + "\n").echo();


/* ======================================== */
/* 5. DIFFIE-HELLMAN KEY EXCHANGE */
/* ======================================== */

"5. Diffie-Hellman Key Exchange:\n".echo();

/* Generate DH parameters and keys */
dh_keys = "dh".genkeys();
("DH keys generated successfully\n").echo();
("Key data type: " + dh_keys.type() + "\n").echo();
("Key type: " + dh_keys."method" + "\n").echo();

/* ======================================== */
/* 6. RSA ENCRYPTION/DECRYPTION */
/* ======================================== */

"6. RSA Encryption/Decryption:\n".echo();

/* Example of how RSA encryption would work (if keys were properly generated) */
message = "Secret message for RSA encryption";

/* Test RSA signing and verification (this works) */
signature = message.sign(rsa_keys);
("RSA signature created successfully\n").echo();
("Signature type: " + signature.type() + "\n").echo();

/* Verify the signature */
verified = signature.verify(rsa_keys, message);
("Signature verification: " + verified.str() + "\n").echo();

/* ======================================== */
/* 7. DIGITAL SIGNATURES */
/* ======================================== */

"7. Digital Signatures:\n".echo();

/* Test digital signatures with different algorithms */
/* SHA-256 signature */
sha256_sig = message.sign(rsa_keys, {"digest": "sha256"});
("SHA-256 signature created\n").echo();

/* SHA-512 signature */
sha512_sig = message.sign(rsa_keys, {"digest": "sha512"});
("SHA-512 signature created\n").echo();

/* Verify signatures */
sha256_verified = sha256_sig.verify(rsa_keys, message, {"digest": "sha256"});
("SHA-256 verification: " + sha256_verified.str() + "\n").echo();

sha512_verified = sha512_sig.verify(rsa_keys, message, {"digest": "sha512"});
("SHA-512 verification: " + sha512_verified.str() + "\n").echo();

/* ======================================== */
/* 8. SECRET KEY DERIVATION (MULTIPLE METHODS) */
/* ======================================== */

"8. Secret Key Derivation (Multiple Methods):\n".echo();

/* Method 1: EC Key Exchange */
("--- EC Key Exchange ---\n").echo();
ec_alice = "ec".genkeys({"curve": "prime256v1"});
ec_bob = "ec".genkeys({"curve": "prime256v1"});

ec_alice_secret = ec_alice.secret({
    'method': 'ec',
    'curve': 'prime256v1',
    'pub': ec_bob.'pub'
});
ec_bob_secret = ec_bob.secret({
    'method': 'ec',
    'curve': 'prime256v1',
    'pub': ec_alice.'pub'
});

("EC Alice secret: " + ec_alice_secret.uhex() + "\n").echo();
("EC Bob secret: " + ec_bob_secret.uhex() + "\n").echo();
("EC Secrets match: " + (ec_alice_secret == ec_bob_secret).str() + "\n").echo();

/* Method 2: RPK Key Exchange */
("--- RPK Key Exchange ---\n").echo();
rpk_alice = "rpk".genkeys({"alg": "X25519"});
rpk_bob = "rpk".genkeys({"alg": "X25519"});

rpk_alice_secret = rpk_alice.secret({
    'method': 'rpk',
    'alg': 'X25519',
    'pub': rpk_bob.'pub'
});
rpk_bob_secret = rpk_bob.secret({
    'method': 'rpk',
    'alg': 'X25519',
    'pub': rpk_alice.'pub'
});

("RPK Alice secret: " + rpk_alice_secret.uhex() + "\n").echo();
("RPK Bob secret: " + rpk_bob_secret.uhex() + "\n").echo();
("RPK Secrets match: " + (rpk_alice_secret == rpk_bob_secret).str() + "\n").echo();

/* ======================================== */
/* 9. AES ENCRYPTION */
/* ======================================== */

"9. AES Encryption:\n".echo();

/* Generate AES key and IV */
aes_key = "11111111111222222222222333333333";  /* 32 bytes for AES-256 */
aes_iv = "1111111111112222";                   /* 16 bytes for IV */

/* Encrypt with AES-256 */
aes_encrypted = message.encode("AES256", {
    'cipher': 'AES256',
    'key': aes_key,
    'iv': aes_iv
});
("AES encrypted: " + aes_encrypted.uhex() + "\n").echo();

/* Decrypt with AES-256 */
aes_decrypted = aes_encrypted.decode("AES256", {
    'cipher': 'AES256', 
    'key': aes_key,
    'iv': aes_iv
});
("AES decrypted: " + aes_decrypted.str() + "\n").echo();

("AES match: " + (message == aes_decrypted).str() + "\n").echo();


/* ======================================== */
/* 10. CRYPTOGRAPHIC UTILITIES */
/* ======================================== */

"10. Cryptographic Utilities:\n".echo();

/* Generate random data */
random_large = 1024.random();
("Random large number: " + random_large + "\n").echo();

/* Generate random numbers in different ranges */
random_0_99 = 100.random();
("Random 0-99: " + random_0_99 + "\n").echo();

random_1_1000 = 1000.random();
("Random 1-1000: " + random_1_1000 + "\n").echo();

/* ======================================== */
/* 11. ERROR HANDLING AND COMPATIBILITY */
/* ======================================== */

"11. Error Handling and Compatibility:\n".echo();

"Note: Most cryptographic functions are working correctly!\n".echo();
"The following functions are working:\n".echo();
("- Basic encoding/decoding (base64, hex)\n").echo();
("- Hash functions (sha256, md5)\n").echo();
("- RSA key generation and signing/verification\n").echo();
("- EC key generation\n").echo();
("- DH key generation\n").echo();
("- Digital signatures (sign, verify)\n").echo();
("- AES encryption/decryption\n").echo();
("- Random number generation\n").echo();

/* ======================================== */
/* SUMMARY */
/* ======================================== */

"=== Summary ===\n".echo();
"✅ Working functions:\n".echo();
("- Basic encoding/decoding (base64, hex)\n").echo();
("- Hash functions (sha256, md5)\n").echo();
("- RSA key generation and signing/verification\n").echo();
("- EC key generation\n").echo();
("- DH key generation\n").echo();
("- Digital signatures (sign, verify)\n").echo();
("- AES encryption/decryption\n").echo();
("- Random number generation\n").echo();

"=== RSA and Cryptographic Functions Example Complete ===\n".echo();
