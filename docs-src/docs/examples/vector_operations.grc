/* Vector Operations Examples
 * 
 * This file demonstrates the full range of vector operations available in Grapa,
 * from basic creation and manipulation to advanced linear algebra and statistics.
 * 
 * Key features demonstrated:
 * - Vector creation and conversion
 * - Basic arithmetic operations
 * - Matrix operations and linear algebra
 * - Statistical functions with axis support
 * - Multi-dimensional operations
 * - Performance considerations
 */

("=== Vector Operations Examples ===\n").echo();

/* Basic Vector Creation and Conversion */

("--- Basic Vector Creation ---\n").echo();

// Create vectors from arrays
vec1 = [1, 2, 3].vector();
vec2 = [[1, 2], [3, 4]].vector();
vec3 = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]].vector();

("1D Vector: " + vec1 + "\n").echo();
("2D Vector: " + vec2 + "\n").echo();
("3D Vector: " + vec3 + "\n").echo();

// Convert back to arrays
arr1 = vec1.array();
arr2 = vec2.array();
("Converted back: " + arr1 + "\n").echo();

// Shape information
("Vector shapes: " + vec1.shape() + ", " + vec2.shape() + ", " + vec3.shape() + "\n").echo();

/* Basic Arithmetic Operations */

("--- Basic Arithmetic ---\n").echo();

// Element-wise operations
a = [1, 2, 3].vector();
b = [4, 5, 6].vector();

sum = a + b;
diff = a - b;
product = a * b;
quotient = a / b;

("Sum: " + sum + "\n").echo();
("Difference: " + diff + "\n").echo();
("Product: " + product + "\n").echo();
("Quotient: " + quotient + "\n").echo();

// Scalar operations
scaled = a * 2;
shifted = a + 10;
("Scaled: " + scaled + "\n").echo();
("Shifted: " + shifted + "\n").echo();

/* Matrix Operations */

("--- Matrix Operations ---\n").echo();

// Create a 2x2 matrix
mat = [[1, 2], [3, 4]].vector();

// Basic matrix operations
transposed = mat.t();
inverse = mat.inv();
determinant = mat.det();
rank_val = mat.rank();

("Original matrix: " + mat + "\n").echo();
("Transpose: " + transposed + "\n").echo();
("Inverse: " + inverse + "\n").echo();
("Determinant: " + determinant + "\n").echo();
("Rank: " + rank_val + "\n").echo();

// Matrix structure operations
triu_mat = mat.triu();
tril_mat = mat.tril();
("Upper triangular: " + triu_mat + "\n").echo();
("Lower triangular: " + tril_mat + "\n").echo();

// 3x3 matrix for more complex operations
mat3 = [[1, 2, 3], [4, 5, 6], [7, 8, 9]].vector();
("3x3 matrix: " + mat3 + "\n").echo();

// Triangular with offsets
triu_offset = mat3.triu(1);
tril_offset = mat3.tril(-1);
("Upper triangular (offset 1): " + triu_offset + "\n").echo();
("Lower triangular (offset -1): " + tril_offset + "\n").echo();

/* Linear Algebra Operations */

("--- Linear Algebra ---\n").echo();

// Dot product
vec_a = [1, 2, 3].vector();
vec_b = [4, 5, 6].vector();
dot_result = vec_a.dot(vec_b);
("Dot product: " + dot_result + "\n").echo();

// Matrix-vector multiplication
mat_2x3 = [[1, 2, 3], [4, 5, 6]].vector();
vec_3 = [1, 2, 3].vector();
mat_vec_result = mat_2x3.dot(vec_3);
("Matrix-vector product: " + mat_vec_result + "\n").echo();

// Matrix-matrix multiplication
mat_a = [[1, 2], [3, 4]].vector();
mat_b = [[5, 6], [7, 8]].vector();
mat_mat_result = mat_a.dot(mat_b);
("Matrix-matrix product: " + mat_mat_result + "\n").echo();

// Solve linear system (if matrix is square and non-singular)
// Note: This may return $ERR for singular matrices
square_mat = [[2, 1], [1, 3]].vector();
rhs = [5, 6].vector();
solution = square_mat.solve(rhs);
("Linear system solution: " + solution + "\n").echo();

/* Statistical Operations */

("--- Statistical Operations ---\n").echo();

// Create sample data
data_2d = [[1, 2, 3], [4, 5, 6], [7, 8, 9]].vector();

// Basic statistics
total_sum = data_2d.sum();
total_mean = data_2d.mean();
("Total sum: " + total_sum + "\n").echo();
("Total mean: " + total_mean + "\n").echo();

// Axis-based operations
sum_axis_0 = data_2d.sum(0);  // Sum along rows
sum_axis_1 = data_2d.sum(1);  // Sum along columns
mean_axis_0 = data_2d.mean(0); // Mean along rows
mean_axis_1 = data_2d.mean(1); // Mean along columns

("Sum along axis 0 (rows): " + sum_axis_0 + "\n").echo();
("Sum along axis 1 (columns): " + sum_axis_1 + "\n").echo();
("Mean along axis 0 (rows): " + mean_axis_0 + "\n").echo();
("Mean along axis 1 (columns): " + mean_axis_1 + "\n").echo();

// Covariance
cov_matrix = data_2d.cov();
("Covariance matrix: " + cov_matrix + "\n").echo();

/* Multi-dimensional Operations */

("--- Multi-dimensional Operations ---\n").echo();

// Create 3D data
data_3d = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]].vector();
("3D data shape: " + data_3d.shape() + "\n").echo();

// Operations on different axes
sum_3d_0 = data_3d.sum(0);
sum_3d_1 = data_3d.sum(1);
sum_3d_2 = data_3d.sum(2);

("3D sum axis 0: " + sum_3d_0 + "\n").echo();
("3D sum axis 1: " + sum_3d_1 + "\n").echo();
("3D sum axis 2: " + sum_3d_2 + "\n").echo();

// Reshaping
reshaped_2d = data_3d.reshape([4, 2]);
reshaped_1d = data_3d.reshape([8]);
("Reshaped to 4x2: " + reshaped_2d + "\n").echo();
("Reshaped to 1D: " + reshaped_1d + "\n").echo();

/* Advanced Matrix Operations */

("--- Advanced Matrix Operations ---\n").echo();

// Eigenvalues and eigenvectors (for symmetric matrices)
symmetric_mat = [[2, 1], [1, 3]].vector();
eigen_result = symmetric_mat.eigh();
("Eigenvalues/eigenvectors: " + eigen_result + "\n").echo();

// Reduced row echelon form
rref_mat = [[1, 2, 3], [4, 5, 6], [7, 8, 9]].vector();
rref_result = rref_mat.rref();
("RREF: " + rref_result + "\n").echo();

/* Performance Examples */

("--- Performance Examples ---\n").echo();

// Large vector operations
large_vec = (1000).range().vector();
("Large vector size: " + large_vec.shape() + "\n").echo();

// Timing operations
start_time = time();
large_sum = large_vec.sum();
end_time = time();
("Large vector sum time: " + (end_time - start_time) + " seconds\n").echo();

// Matrix operations on larger data
large_mat = (100).range().reshape([10, 10]).vector();
start_time = time();
large_det = large_mat.det();
end_time = time();
("Large matrix determinant time: " + (end_time - start_time) + " seconds\n").echo();

/* Error Handling Examples */

("--- Error Handling ---\n").echo();

// Try to convert irregular array (should fail)
irregular = [[1, 2], [3]];
("Attempting to convert irregular array...\n").echo();
irregular_vec = irregular.vector();
if (irregular_vec.type() == $ERR) {
    ("✅ Correctly rejected irregular array\n").echo();
} else {
("❌ Unexpectedly accepted irregular array\n").echo();
}

// Try to solve with singular matrix
singular_mat = [[1, 1], [1, 1]].vector();
singular_rhs = [1, 2].vector();
singular_solution = singular_mat.solve(singular_rhs);
if (singular_solution.type() == $ERR) {
("✅ Correctly handled singular matrix\n").echo();
} else {
("❌ Unexpectedly solved singular matrix\n").echo();
}

/* Real-world Examples */

("--- Real-world Examples ---\n").echo();

// Image processing simulation (2D data)
image_data = (64).range().reshape([8, 8]).vector();
("Image data (8x8): " + image_data + "\n").echo();

// Apply a simple filter (average of neighbors)
filtered = image_data.triu(-1).tril(1);  // Keep main diagonal and adjacent
("Filtered image: " + filtered + "\n").echo();

// Data analysis example
sales_data = [[100, 150, 200], [120, 180, 220], [90, 140, 190]].vector();
("Sales data: " + sales_data + "\n").echo();

// Calculate statistics
total_sales = sales_data.sum();
avg_sales = sales_data.mean();
sales_by_period = sales_data.sum(1);  // Sum across products
sales_by_product = sales_data.sum(0); // Sum across periods

("Total sales: " + total_sales + "\n").echo();
("Average sales: " + avg_sales + "\n").echo();
("Sales by product: " + sales_by_product + "\n").echo();
("Sales by period: " + sales_by_period + "\n").echo();

/* Best Practices */

("--- Best Practices ---\n").echo();

("✅ Use .vector() for mathematical operations\n").echo();
("✅ Use .array() for general data manipulation\n").echo();
("✅ Specify axis parameter for multi-dimensional operations\n").echo();
("✅ Check for $ERR when operations may fail\n").echo();
("✅ Use reshape() for changing dimensions\n").echo();
("✅ Consider memory usage for large vectors\n").echo();

("=== Vector Operations Examples Complete ===\n").echo();
