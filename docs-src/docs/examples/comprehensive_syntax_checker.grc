/*
Comprehensive Grapa Syntax Checker
*/

// Comprehensive syntax checking function
checkFile = op(filePath) {
    $local.code = $file().get(filePath);
    if (code.type() == $ERR) {
        return "Error: Could not read file\n";
    };
    
    code = code.str();

    // Comprehensive syntax checking
    $local.lines = code.split("\n");
    $local.errors = [];
    $local.lineNumber = 1;
    
    foreach line in lines {
        // Skip empty lines and whitespace-only lines for performance
        $local.trimmedLine = line.trim();
        if (trimmedLine.len() == 0) {
            lineNumber += 1;
            continue;
        };
        
        // Remove comments for analysis (only if needed)
        $local.cleanLine = trimmedLine;
        $local.commentPos = cleanLine.find("//");
        if (commentPos >= 0) {
            cleanLine = cleanLine.left(commentPos);
        };
        
        // Skip if line is empty after comment removal
        if (cleanLine.trim().len() == 0) {
            lineNumber += 1;
            continue;
        };
        
        // Check for missing semicolons after statements
        if ((cleanLine.grep("return", "w").len() > 0 || cleanLine.grep("break", "w").len() > 0 || cleanLine.grep("continue", "w").len() > 0 || cleanLine.grep("throw", "w").len() > 0) && cleanLine.right(1) != ";") {
            errors += "Line ${lineNumber}: Missing semicolon after statement".interpolate();
        };
        
        // Check for unbalanced brackets (only if line contains bracket characters)
        if (cleanLine.find("(") >= 0 || cleanLine.find(")") >= 0 || cleanLine.find("{") >= 0 || cleanLine.find("}") >= 0 || cleanLine.find("[") >= 0 || cleanLine.find("]") >= 0) {
            $local.openParen = cleanLine.grep("\\(", "o").len();
            $local.closeParen = cleanLine.grep("\\)", "o").len();
            $local.openBrace = cleanLine.grep("\\{", "o").len();
            $local.closeBrace = cleanLine.grep("\\}", "o").len();
            $local.openBracket = cleanLine.grep("\\[", "o").len();
            $local.closeBracket = cleanLine.grep("\\]", "o").len();
            
            if (openParen != closeParen) {
                errors += "Line ${lineNumber}: Unbalanced parentheses".interpolate();
            };
            if (openBrace != closeBrace) {
                errors += "Line ${lineNumber}: Unbalanced braces".interpolate();
            };
            if (openBracket != closeBracket) {
                errors += "Line ${lineNumber}: Unbalanced brackets".interpolate();
            };
        };
        
        // Check for unterminated strings (only if line contains quotes)
        if (cleanLine.find("\"") >= 0 || cleanLine.find("'") >= 0) {
            $local.quoteCount = cleanLine.grep("\"", "o").len();
            $local.singleQuoteCount = cleanLine.grep("'", "o").len();
            
            if (quoteCount % 2 != 0) {
                errors += "Line ${lineNumber}: Unterminated double-quoted string\n".interpolate();
            };
            if (singleQuoteCount % 2 != 0) {
                errors += "Line ${lineNumber}: Unterminated single-quoted string\n".interpolate();
            };
        };
        
        // Check for consecutive operators (only if line contains operators)
        if (cleanLine.find("+") >= 0 || cleanLine.find("-") >= 0 || cleanLine.find("*") >= 0) {
            if (cleanLine.grep("\\+\\+", "o").len() > 0 || cleanLine.grep("\\-\\-", "o").len() > 0 || cleanLine.grep("\\*\\*", "o").len() > 0) {
                errors += "Line ${lineNumber}: Consecutive operators detected (++, --, **)\n".interpolate();
            };
        };
        
        // Check for variable scoping issues (missing $ prefix)
        if (cleanLine.find("=") >= 0 && cleanLine.find("//") == -1 && cleanLine.find("/*") == -1) {
            // Check for old namespace syntax (local., global., this.)
            if (cleanLine.find("local.") >= 0 || cleanLine.find("global.") >= 0 || cleanLine.find("this.") >= 0) {
                if (cleanLine.find("cleanLine.find") == -1 && cleanLine.find("Old namespace syntax detected") == -1 && cleanLine.find("errors += ") == -1) {
                    if ((cleanLine.find("local.") >= 0 && cleanLine.find("$local.") == -1) ||
                        (cleanLine.find("global.") >= 0 && cleanLine.find("$global.") == -1) ||
                        (cleanLine.find("this.") >= 0 && cleanLine.find("$this.") == -1)) {
                        errors += "Line ${lineNumber}: Old namespace syntax detected (use $local, $global, $this instead of local., global., this.)\n".interpolate();
                    };
                };
            };
            
            // Check for simple variable assignments without namespace prefix
            if (cleanLine.grep("^\\s*[a-zA-Z_][a-zA-Z0-9_]*\\s*=", "o").len() > 0 && 
                cleanLine.find("$local.") == -1 && cleanLine.find("$global.") == -1 && cleanLine.find("$this.") == -1 &&
                cleanLine.find("//") == -1 && cleanLine.find("/*") == -1) {
                // Skip if it's a method call or complex expression
                if (cleanLine.find("(") == -1 && cleanLine.find(".") == -1 && cleanLine.find("[") == -1) {
                    errors += "Line ${lineNumber}: Consider using $local for thread safety\n".interpolate();
                };
            };
        };
        
        // Check for loop syntax validation (only if line contains loop keywords)
        if (cleanLine.find("while") >= 0 || cleanLine.find("for") >= 0 || cleanLine.find("foreach") >= 0) {
            if (cleanLine.find("//") == -1 && cleanLine.find("/*") == -1) {
                // Check while loop syntax
                if (cleanLine.grep("while\\s+\\(", "o").len() == 0 && cleanLine.grep("while\\s+[^\\s]", "o").len() > 0) {
                    errors += "Line ${lineNumber}: Missing parentheses in while loop\n".interpolate();
                };
                
                // Check for loop syntax
                if (cleanLine.grep("for\\s+\\(", "o").len() == 0 && cleanLine.grep("for\\s+[^\\s]", "o").len() > 0) {
                    errors += "Line ${lineNumber}: Missing parentheses in for loop\n".interpolate();
                };
                
                // Check foreach loop syntax
                if (cleanLine.grep("foreach\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s+in", "o").len() == 0 && cleanLine.grep("foreach\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s+[^i]", "o").len() > 0) {
                    errors += "Line ${lineNumber}: Missing 'in' keyword in foreach loop\n".interpolate();
                };
            };
        };
        
        // Check for data type access patterns (only if line contains array access or method chaining)
        if (cleanLine.find("[") >= 0 || cleanLine.find("]") >= 0 || cleanLine.find("..") >= 0) {
            if (cleanLine.find("//") == -1 && cleanLine.find("/*") == -1) {
                // Check for missing opening bracket
                if (cleanLine.grep("\\]\\s*=", "o").len() > 0 && cleanLine.grep("\\[.*\\]\\s*=", "o").len() == 0) {
                    errors += "Line ${lineNumber}: Missing opening bracket in array access\n".interpolate();
                };
                
                // Check for missing closing bracket
                if (cleanLine.grep("\\[\\s*[^\\]]*$", "o").len() > 0) {
                    errors += "Line ${lineNumber}: Missing closing bracket in array access\n".interpolate();
                };
                
                // Check for double dots (method chaining)
                if (cleanLine.grep("\\.\\.", "o").len() > 0) {
                    errors += "Line ${lineNumber}: Double dots detected - use single dot for method chaining\n".interpolate();
                };
                
                // Check for simplified array access issues
                if (cleanLine.grep("\\.[0-9]", "o").len() > 0) {
                    errors += "Line ${lineNumber}: Consider using array[index] instead of array.index for array access\n".interpolate();
                };
            };
        };
        
        // Check for operator precedence issues (only if line contains operators)
        if (cleanLine.find("//") == -1 && cleanLine.find("/*") == -1 && 
            (cleanLine.find("+") >= 0 || cleanLine.find("-") >= 0 || cleanLine.find("*") >= 0 || 
             cleanLine.find("/") >= 0 || cleanLine.find("%") >= 0 || cleanLine.find("=") >= 0 ||
             cleanLine.find("==") >= 0 || cleanLine.find("!=") >= 0 || cleanLine.find("<") >= 0 ||
             cleanLine.find(">") >= 0 || cleanLine.find("<=") >= 0 || cleanLine.find(">=") >= 0 ||
             cleanLine.find("&&") >= 0 || cleanLine.find("||") >= 0 || cleanLine.find("&") >= 0 ||
             cleanLine.find("|") >= 0 || cleanLine.find("^") >= 0 || cleanLine.find("<<") >= 0 ||
             cleanLine.find(">>") >= 0 || cleanLine.find("**") >= 0 || cleanLine.find("++") >= 0 ||
             cleanLine.find("--") >= 0 || cleanLine.find("?") >= 0 || cleanLine.find(":") >= 0)) {
            
            // Check for ambiguous operator precedence patterns
            // Multiplication/Division should have higher precedence than Addition/Subtraction
            if (cleanLine.grep("\\+\\s*[a-zA-Z_$][a-zA-Z0-9_$]*\\s*\\*", "o").len() > 0 || 
                cleanLine.grep("\\-\\s*[a-zA-Z_$][a-zA-Z0-9_$]*\\s*\\*", "o").len() > 0 ||
                cleanLine.grep("\\+\\s*[a-zA-Z_$][a-zA-Z0-9_$]*\\s*\\/", "o").len() > 0 || 
                cleanLine.grep("\\-\\s*[a-zA-Z_$][a-zA-Z0-9_$]*\\s*\\/", "o").len() > 0) {
                errors += "Line ${lineNumber}: Ambiguous operator precedence - consider using parentheses for clarity\n".interpolate();
            };
            
            // Assignment operators should not be mixed with arithmetic without parentheses
            if (cleanLine.grep("\\+\\s*=", "o").len() > 0 && cleanLine.grep("\\*\\s*=", "o").len() > 0) {
                errors += "Line ${lineNumber}: Mixed assignment operators - consider using parentheses for clarity\n".interpolate();
            };
            
            // Comparison operators should not be mixed with arithmetic without parentheses
            if ((cleanLine.grep("\\+", "o").len() > 0 || cleanLine.grep("\\-", "o").len() > 0) &&
                (cleanLine.grep("==", "o").len() > 0 || cleanLine.grep("!=", "o").len() > 0 ||
                 cleanLine.grep("<=", "o").len() > 0 || cleanLine.grep(">=", "o").len() > 0 ||
                 cleanLine.grep("<", "o").len() > 0 || cleanLine.grep(">", "o").len() > 0)) {
                errors += "Line ${lineNumber}: Mixed arithmetic and comparison operators - consider using parentheses for clarity\n".interpolate();
            };
            
            // Logical operators should not be mixed with arithmetic without parentheses
            if ((cleanLine.grep("\\+", "o").len() > 0 || cleanLine.grep("\\-", "o").len() > 0 ||
                 cleanLine.grep("\\*", "o").len() > 0 || cleanLine.grep("\\/", "o").len() > 0) &&
                (cleanLine.grep("&&", "o").len() > 0 || cleanLine.grep("\\|\\|", "o").len() > 0)) {
                errors += "Line ${lineNumber}: Mixed arithmetic and logical operators - consider using parentheses for clarity\n".interpolate();
            };
            
            // Bitwise operators should not be mixed with arithmetic without parentheses
            if ((cleanLine.grep("\\+", "o").len() > 0 || cleanLine.grep("\\-", "o").len() > 0) &&
                (cleanLine.grep("&", "o").len() > 0 || cleanLine.grep("\\|", "o").len() > 0 ||
                 cleanLine.grep("\\^", "o").len() > 0 || cleanLine.grep("<<", "o").len() > 0 ||
                 cleanLine.grep(">>", "o").len() > 0)) {
                errors += "Line ${lineNumber}: Mixed arithmetic and bitwise operators - consider using parentheses for clarity\n".interpolate();
            };
            
            // Ternary operator should be properly parenthesized when mixed with other operators
            if (cleanLine.grep("\\?", "o").len() > 0 && cleanLine.grep(":", "o").len() > 0 &&
                (cleanLine.grep("\\+", "o").len() > 0 || cleanLine.grep("\\-", "o").len() > 0 ||
                 cleanLine.grep("\\*", "o").len() > 0 || cleanLine.grep("\\/", "o").len() > 0 ||
                 cleanLine.grep("==", "o").len() > 0 || cleanLine.grep("!=", "o").len() > 0)) {
                errors += "Line ${lineNumber}: Ternary operator mixed with other operators - consider using parentheses for clarity\n".interpolate();
            };
        };
        
        // Check for method chaining validation (only if line contains method calls)
        if (cleanLine.find("//") == -1 && cleanLine.find("/*") == -1 && cleanLine.find(".") >= 0) {
            // Check for common method chaining patterns
            if (cleanLine.find(".map(") >= 0 || cleanLine.find(".filter(") >= 0 || cleanLine.find(".reduce(") >= 0) {
                // Check if method chaining is properly formatted
                if (cleanLine.find(".map(") >= 0 && cleanLine.find(".map(") != cleanLine.find(".map(")) {
                    errors += "Line ${lineNumber}: Multiple .map() calls detected - consider chaining or separate variables\n".interpolate();
                };
                if (cleanLine.find(".filter(") >= 0 && cleanLine.find(".filter(") != cleanLine.find(".filter(")) {
                    errors += "Line ${lineNumber}: Multiple .filter() calls detected - consider chaining or separate variables\n".interpolate();
                };
                if (cleanLine.find(".reduce(") >= 0 && cleanLine.find(".reduce(") != cleanLine.find(".reduce(")) {
                    errors += "Line ${lineNumber}: Multiple .reduce() calls detected - consider chaining or separate variables\n".interpolate();
                };
            };
            
            // Check for missing closing parentheses in common methods
            if (cleanLine.find(".echo(") >= 0 && cleanLine.find(".echo(") != cleanLine.find(".echo(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .echo() method\n".interpolate();
            };
            if (cleanLine.find(".interpolate(") >= 0 && cleanLine.find(".interpolate(") != cleanLine.find(".interpolate(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .interpolate() method\n".interpolate();
            };
            if (cleanLine.find(".split(") >= 0 && cleanLine.find(".split(") != cleanLine.find(".split(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .split() method\n".interpolate();
            };
            if (cleanLine.find(".sum(") >= 0 && cleanLine.find(".sum(") != cleanLine.find(".sum(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .sum() method\n".interpolate();
            };
            if (cleanLine.find(".mean(") >= 0 && cleanLine.find(".mean(") != cleanLine.find(".mean(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .mean() method\n".interpolate();
            };
            if (cleanLine.find(".std(") >= 0 && cleanLine.find(".std(") != cleanLine.find(".std(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .std() method\n".interpolate();
            };
            
            // Check for string method parentheses
            if (cleanLine.find(".upper(") >= 0 && cleanLine.find(".upper(") != cleanLine.find(".upper(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .upper() method\n".interpolate();
            };
            if (cleanLine.find(".lower(") >= 0 && cleanLine.find(".lower(") != cleanLine.find(".lower(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .lower() method\n".interpolate();
            };
            if (cleanLine.find(".casefold(") >= 0 && cleanLine.find(".casefold(") != cleanLine.find(".casefold(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .casefold() method\n".interpolate();
            };
            if (cleanLine.find(".levenshtein(") >= 0 && cleanLine.find(".levenshtein(") != cleanLine.find(".levenshtein(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .levenshtein() method\n".interpolate();
            };
            if (cleanLine.find(".jarowinkler(") >= 0 && cleanLine.find(".jarowinkler(") != cleanLine.find(".jarowinkler(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .jarowinkler() method\n".interpolate();
            };
            if (cleanLine.find(".cosinesimilarity(") >= 0 && cleanLine.find(".cosinesimilarity(") != cleanLine.find(".cosinesimilarity(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .cosinesimilarity() method\n".interpolate();
            };
            
            // Check for vector method parentheses
            if (cleanLine.find(".min(") >= 0 && cleanLine.find(".min(") != cleanLine.find(".min(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .min() method\n".interpolate();
            };
            if (cleanLine.find(".max(") >= 0 && cleanLine.find(".max(") != cleanLine.find(".max(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .max() method\n".interpolate();
            };
            if (cleanLine.find(".var(") >= 0 && cleanLine.find(".var(") != cleanLine.find(".var(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .var() method\n".interpolate();
            };
            if (cleanLine.find(".shape(") >= 0 && cleanLine.find(".shape(") != cleanLine.find(".shape(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .shape() method\n".interpolate();
            };
            if (cleanLine.find(".reshape(") >= 0 && cleanLine.find(".reshape(") != cleanLine.find(".reshape(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .reshape() method\n".interpolate();
            };
            if (cleanLine.find(".dot(") >= 0 && cleanLine.find(".dot(") != cleanLine.find(".dot(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .dot() method\n".interpolate();
            };
            if (cleanLine.find(".norm(") >= 0 && cleanLine.find(".norm(") != cleanLine.find(".norm(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .norm() method\n".interpolate();
            };
            if (cleanLine.find(".mode(") >= 0 && cleanLine.find(".mode(") != cleanLine.find(".mode(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .mode() method\n".interpolate();
            };
            if (cleanLine.find(".median(") >= 0 && cleanLine.find(".median(") != cleanLine.find(".median(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .median() method\n".interpolate();
            };
            if (cleanLine.find(".percentile(") >= 0 && cleanLine.find(".percentile(") != cleanLine.find(".percentile(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .percentile() method\n".interpolate();
            };
            if (cleanLine.find(".quantile(") >= 0 && cleanLine.find(".quantile(") != cleanLine.find(".quantile(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .quantile() method\n".interpolate();
            };
            if (cleanLine.find(".skew(") >= 0 && cleanLine.find(".skew(") != cleanLine.find(".skew(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .skew() method\n".interpolate();
            };
            if (cleanLine.find(".kurtosis(") >= 0 && cleanLine.find(".kurtosis(") != cleanLine.find(".kurtosis(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .kurtosis() method\n".interpolate();
            };
            
            // Check for list method parentheses
            if (cleanLine.find(".message(") >= 0 && cleanLine.find(".message(") != cleanLine.find(".message(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .message() method\n".interpolate();
            };
            if (cleanLine.find(".err(") >= 0 && cleanLine.find(".err(") != cleanLine.find(".err(")) {
                errors += "Line ${lineNumber}: Missing closing parenthesis in .err() method\n".interpolate();
            };
        };
        
        lineNumber += 1;
    };
    
    if (errors.len() == 0) {
        return "✅ No syntax errors found\n";
    } else {
        return "❌ Syntax errors found:\n${errors.join('\n')}\n".interpolate();
    };
};

// Main script logic
args = $sys().getenv("$ARGV");
if (args.len() >= 3) {
    command = args[1];
    if (command == "check") {
        result = checkFile(args[2]);
        result.echo();
    } else if (command == "help") {
        "Grapa Comprehensive Syntax Checker - ".echo();
        "Usage: grapa comprehensive_syntax_checker.grc check <file.grc>".echo();
        "Usage: grapa comprehensive_syntax_checker.grc help".echo();
        "".echo();
        "Checks for:".echo();
        "- Missing semicolons".echo();
        "- Unbalanced brackets (parentheses, braces, brackets)".echo();
        "- Unterminated strings".echo();
        "- Consecutive operators (++, --, **)".echo();
        "- Variable scoping issues (missing $ prefix)".echo();
        "- Thread safety (recommends $local for variables)".echo();
        "- Loop syntax validation (while, for, foreach)".echo();
        "- Data type access patterns (array brackets, method chaining)".echo();
        "- Operator precedence validation (ambiguous precedence, mixed operators)".echo();
        "- Method chaining validation (.map(), .filter(), .reduce(), .echo(), etc.)".echo();
        "- String method validation (.upper(), .lower(), .casefold(), .levenshtein(), etc.)".echo();
        "- Vector method validation (.sum(), .mean(), .std(), .min(), .max(), .var(), etc.)".echo();
        "- Advanced vector methods (.shape(), .reshape(), .dot(), .norm(), .mode(), .median(), etc.)".echo();
        "- Statistical methods (.percentile(), .quantile(), .skew(), .kurtosis())".echo();
        "- List method validation (.message(), .err())".echo();
        "".echo();
        "Note: Uses Grapa's advanced grep engine with PCRE2 support:".echo();
        "- Word boundary matching (w flag)".echo();
        "- Full Unicode support".echo();
        "- Advanced regex patterns".echo();
        "".echo();
        "Performance optimizations:".echo();
        "- Skips empty lines and whitespace-only lines".echo();
        "- Only processes bracket/quote/operator checks when needed".echo();
        "- Only validates method calls when method patterns are present".echo();
        "- Optimized for large files with minimal processing overhead".echo();
    } else {
        "Unknown command: ${command}".interpolate().echo();
        "Use 'help' for usage information".echo();
    };
} else {
    "Grapa Comprehensive Syntax Checker".echo();
    "Usage: grapa comprehensive_syntax_checker.grc check <file.grc>".echo();
    "Usage: grapa comprehensive_syntax_checker.grc help".echo();
};
