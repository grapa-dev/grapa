/* Model Parameter Configuration Example */

"Model Parameter Configuration Example".echo();
"=====================================".echo();

model = $MODEL();

/* Demonstrate different parameter configurations */
"=== Conservative Generation ===".echo();
model.params({
    "temperature": 0.3,
    "max_tokens": 30,
    "top_k": 20,
    "verbose": 0
});

"Conservative parameters:".echo();
params = model.params();
("  Temperature: " + params.temperature.str()).echo();
("  Max tokens: " + params.max_tokens.str()).echo();
("  Top K: " + params.top_k.str()).echo();

/* Load model for testing */
result = model.load("models/qwen2.5-7b-instruct-q3_k_m.gguf");
if (result == 0) {
    "Model loaded successfully!".echo();
    
    /* Test conservative generation */
    conservative_response = model.gen("Explain artificial intelligence");
    ("Conservative response: " + conservative_response.str()).echo();
    
    /* Switch to creative parameters */
    "=== Creative Generation ===".echo();
    model.params({
        "temperature": 1.2,
        "max_tokens": 100,
        "top_k": 80
    });
    
    "Creative parameters:".echo();
    params = model.params();
    ("  Temperature: " + params.temperature.str()).echo();
    ("  Max tokens: " + params.max_tokens.str()).echo();
    ("  Top K: " + params.top_k.str()).echo();
    
    /* Test creative generation */
    creative_response = model.gen("Write a creative story about a robot");
    ("Creative response: " + creative_response.str()).echo();
    
    /* Test with inline parameter override */
    "=== Inline Parameter Override ===".echo();
    override_response = model.gen("What is machine learning?", {
        "temperature": 0.1,
        "max_tokens": 20
    });
    ("Override response: " + override_response.str()).echo();
    
    /* Show that original parameters are preserved */
    "Original parameters preserved:".echo();
    params = model.params();
    ("  Temperature: " + params.temperature.str()).echo();
    ("  Max tokens: " + params.max_tokens.str()).echo();
    
} else {
    ("Failed to load model: " + result.str()).echo();
}

/* Clean up */
model.unload();
"Example completed!".echo();
