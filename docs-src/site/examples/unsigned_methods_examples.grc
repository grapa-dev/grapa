/* Unsigned Methods Examples
   Demonstrates Grapa's unsigned methods for cryptographic applications */

"=== Unsigned Methods Examples ===".echo();

/* Basic unsigned conversions */
"Basic unsigned conversions:".echo();
(-1).uint().echo();              /* 255 */
(-100).uint().echo();            /* 156 */
(-1000).uint().echo();           /* 64536 */
(-2147483648).uint().echo();     /* 2147483648 */

/* Unsigned raw representation */
"Unsigned raw representation:".echo();
(-1).uraw().echo();              /* 0xD6 */
(255).uraw().echo();             /* 0x0FF */
(-100).uraw().echo();            /* 0x9C */
(-1000).uraw().echo();           /* 0xFC18 */

/* Unsigned hex representation */
"Unsigned hex representation:".echo();
(-1).uhex().echo();              /* D6 */
(255).uhex().echo();             /* FF */
(-100).uhex().echo();            /* 9C */
(-1000).uhex().echo();           /* FC18 */

/* Unsigned binary representation */
"Unsigned binary representation:".echo();
(-1).ubin().echo();              /* 11010110 */
(255).ubin().echo();             /* 11111111 */
(-100).ubin().echo();            /* 10011100 */
(-1000).ubin().echo();           /* 11111100100011000 */

/* Comparison with regular methods */
"Comparison with regular methods:".echo();
"Regular methods preserve sign:".echo();
(-1).int().echo();               /* -1 */
(-1).hex().echo();               /* -01 */
(-1).bin().echo();               /* -1 */
(-1).raw().echo();               /* 0xD6 */

"Unsigned methods convert to unsigned:".echo();
(-1).uint().echo();              /* 255 */
(-1).uhex().echo();              /* D6 */
(-1).ubin().echo();              /* 11010110 */
(-1).uraw().echo();              /* 0xD6 */

/* Cryptographic applications */
"Cryptographic applications:".echo();

/* Large random number generation */
"Large random number generation:".echo();
large_random = 0x80000000;       /* Number with leading bit set */
("Large random: " + large_random.str()).echo();
("As unsigned: " + large_random.uint().str()).echo();
("Hex representation: " + large_random.uhex()).echo();

/* Key generation simulation */
"Key generation simulation:".echo();
key_part1 = 0x12345678;
key_part2 = 0x87654321;
combined_key = key_part1 + key_part2;
("Combined key: " + combined_key.uhex()).echo();
("Key length (bits): " + combined_key.ubin().len().str()).echo();

/* Hash function input preparation */
"Hash function input preparation:".echo();
input_data = -12345;
unsigned_input = input_data.uint();
("Original input: " + input_data.str()).echo();
("Unsigned input: " + unsigned_input.str()).echo();
("Hex for hash: " + unsigned_input.uhex()).echo();

/* Bit manipulation for cryptography */
"Bit manipulation for cryptography:".echo();
crypto_value = -98765;
binary_rep = crypto_value.ubin();
bit_count = binary_rep.grep("1", "c")[0].int();
("Crypto value: " + crypto_value.str()).echo();
("Binary representation: " + binary_rep).echo();
("Number of 1 bits: " + bit_count.str()).echo();

/* Network protocol data handling */
"Network protocol data handling:".echo();
protocol_data = -54321;
("Protocol data (signed): " + protocol_data.str()).echo();
("Protocol data (unsigned): " + protocol_data.uint().str()).echo();
("Protocol data (hex): " + protocol_data.uhex()).echo();
("Protocol data (raw): " + protocol_data.uraw()).echo();

/* Binary file format parsing */
"Binary file format parsing:".echo();
file_offset = -1024;
("File offset (signed): " + file_offset.str()).echo();
("File offset (unsigned): " + file_offset.uint().str()).echo();
("File offset (hex): " + file_offset.uhex()).echo();

/* Mathematical operations with unsigned values */
"Mathematical operations with unsigned values:".echo();
a = -100;
b = -200;
unsigned_a = a.uint();
unsigned_b = b.uint();
sum = unsigned_a + unsigned_b;
("A (signed): " + a.str() + ", A (unsigned): " + unsigned_a.str()).echo();
("B (signed): " + b.str() + ", B (unsigned): " + unsigned_b.str()).echo();
("Sum (unsigned): " + sum.str()).echo();

/* Comparison operations */
"Comparison operations:".echo();
x = -50;
y = 206;  /* -50 as unsigned 8-bit */
("x (signed): " + x.str()).echo();
("y (unsigned equivalent): " + y.str()).echo();
("x.uint() == y: " + (x.uint() == y).str()).echo();
("x == y: " + (x == y).str()).echo();

/* Edge cases */
"Edge cases:".echo();
zero = 0;
max_8bit = 255;
max_16bit = 65535;
("Zero (unsigned): " + zero.uint().str()).echo();
("Max 8-bit (unsigned): " + max_8bit.uint().str()).echo();
("Max 16-bit (unsigned): " + max_16bit.uint().str()).echo();

/* Practical cryptographic workflow */
"Practical cryptographic workflow:".echo();

/* Step 1: Generate random components */
seed = 0x123456789ABCDEF0;
nonce = 0x9876543210FEDCBA;
("Seed: " + seed.uhex()).echo();
("Nonce: " + nonce.uhex()).echo();

/* Step 2: Combine components */
combined = seed + nonce;
("Combined: " + combined.uhex()).echo();

/* Step 3: Apply cryptographic transformation */
transformed = combined * 2 + 1;
("Transformed: " + transformed.uhex()).echo();

/* Step 4: Extract final key */
final_key = transformed.uint();
("Final key: " + final_key.uhex()).echo();

"=== Examples completed ===".echo();
