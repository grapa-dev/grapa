/* Advanced Language Features Demo
 * 
 * This example demonstrates all the advanced language features that are
 * already implemented in Grapa, showing how it has achieved complete
 * functional equivalence with modern languages.
 */

("=== Advanced Language Features Demo ===").echo();

/* 1. Pattern Matching */
("--- 1. Pattern Matching ---").echo();

// Array destructuring via namespace concatenation
data = [1, 2, 3, 4, 5];
@local ++= {first: data[0], second: data[1], rest: data.slice(2)};
("Destructured: first=" + first + ", second=" + second + ", rest=" + rest).echo();

// Object destructuring via namespace concatenation
person = {name: "Alice", age: 30, city: "NY"};
@local ++= person;
("Destructured person: name=" + name + ", age=" + age + ", city=" + city).echo();

// Match expressions via switch/case
value = 42;
result = switch (value) {
    case 10: "ten";
    case 20: "twenty";
    case 42: "forty-two";
    default: "unknown";
};
("Switch result: " + result).echo();

// Guard clauses via conditional cases
score = 85;
grade = switch (score) {
    case (score >= 90): "A";
    case (score >= 80): "B";
    case (score >= 70): "C";
    case (score >= 60): "D";
    default: "F";
};
("Grade for " + score + ": " + grade).echo();

// Pattern matching via .grep() and .match()
text = "Hello World 123";
has_digits = text.match("\\d+");
has_letters = text.match("[a-zA-Z]+");
("Text analysis: has_digits=" + has_digits + ", has_letters=" + has_letters).echo();

/* 2. Metaprogramming Capabilities */
("--- 2. Metaprogramming Capabilities ---").echo();

// Macro system via custom_command/custom_function rules
custom_command = rule process $STR { op(data:$2) { data.upper() + " processed"; } };
result = process "hello";
("Custom command result: " + result).echo();

// AST manipulation via execution trees (.plan())
code = op(x) { x * 2 + 1; };
tree = code.plan();
("Execution tree: " + tree).echo();
result = tree(5);
("Tree execution result: " + result).echo();

// Code reflection via .describe() and .type()
func = op(x, y) { x + y; };
("Function description: " + func.describe()).echo();
("Function type: " + func.type()).echo();

// Dynamic grammar modification via @global rules
@global["$custom_rule"] = rule <$expression> '++' {@<increment,{$1}>};
increment = op(x) { x + 1; };
test_value = 5;
result = test_value++;
("Dynamic grammar result: " + result).echo();

// Code generation and execution via op()()
generated_code = "x * y + z";
generated_func = op("x"=0, "y"=0, "z"=0)(generated_code);
result = generated_func(2, 3, 4);
("Generated function result: " + result).echo();

// System-level metaprogramming via $sys().eval() and $sys().compile()
compiled = $sys().compile("input * 2 + offset");
result1 = $sys().eval(compiled, {"input": 5, "offset": 3});
result2 = $sys().eval(compiled, {"input": 10, "offset": 1});
("System eval results: " + result1 + ", " + result2).echo();

/* 3. Concurrency/Async Support */
("--- 3. Concurrency/Async Support ---").echo();

// Parallel processing with .map(), .filter(), .reduce() with thread count
numbers = (100).range();
parallel_squares = numbers.map(op(x) { x * x; }, 4); // 4 threads
parallel_evens = numbers.filter(op(x) { x % 2 == 0; }, 4); // 4 threads
parallel_sum = numbers.reduce(op(acc, x) { acc + x; }, 0, 4); // 4 threads

("Parallel processing: squares=" + parallel_squares.len() + 
 ", evens=" + parallel_evens.len() + ", sum=" + parallel_sum).echo();

// Thread management via $thread() objects with lock/unlock/trylock
lock_obj = $thread();
lock_obj.lock();
shared_data = 42;
("Thread-safe operation: " + shared_data).echo();
lock_obj.unlock();

// Async/promise-like patterns via parallel processing
async_process = op(data) {
    // Simulate async operation with parallel processing
    data.map(op(item) { 
        // Simulate work
        item * 2; 
    }, 2);
};

result = async_process([1, 2, 3, 4, 5]);
("Async-like result: " + result).echo();

// Parallel execution blocks
parallel_results = [
    op() { "Task 1 completed"; }(),
    op() { "Task 2 completed"; }(),
    op() { "Task 3 completed"; }()
];
("Parallel execution: " + parallel_results).echo();

/* 4. Type System Enhancements */
("--- 4. Type System Enhancements ---").echo();

// Dynamic typing - types determined at runtime
x = 5;                    // $INT
x = "hello";              // $STR
x = [1, 2, 3];            // $ARRAY
("Dynamic typing: x type=" + x.type()).echo();

// Runtime type checking via .type() method
validate_type = op(value, expected_type) {
    actual_type = value.type();
    if (actual_type == expected_type) {
        "Type check passed: " + actual_type;
    } else {
        "Type check failed: expected " + expected_type + ", got " + actual_type;
    }
};

result = validate_type(42, $INT);
(result).echo();

// Runtime type constraints
safe_divide = op(a, b) {
    if (a.type() != $INT && a.type() != $FLOAT) {
        "Error: First argument must be numeric";
    } else if (b.type() != $INT && b.type() != $FLOAT) {
        "Error: Second argument must be numeric";
    } else if (b == 0) {
        "Error: Division by zero";
    } else {
        a / b;
    }
};

result = safe_divide(10, 2);
("Type-constrained result: " + result).echo();

// Automatic type inference
inferred_int = 5 + 3;           // Automatically $INT
inferred_float = 5.0 + 3;       // Automatically $FLOAT
inferred_str = "Hello" + "World"; // Automatically $STR
("Type inference: int=" + inferred_int.type() + 
 ", float=" + inferred_float.type() + 
 ", str=" + inferred_str.type()).echo();

// Generic-like functions
generic_process = op(data) {
    data_type = data.type();
    
    switch (data_type) {
        case $INT: data * 2;
        case $STR: data.upper();
        case $ARRAY: data.map(op(x) { x * 2; });
        case $LIST: data.map(op(key, value) { key + ": " + value; });
        default: "Unsupported type: " + data_type;
    }
};

test_cases = [42, "hello", [1, 2, 3], {a: 1, b: 2}];
results = test_cases.map(op(test) { generic_process(test); });
("Generic-like results: " + results).echo();

/* 5. Advanced Data Structures */
("--- 5. Advanced Data Structures ---").echo();

// Set-like functionality via arrays with .unique()
create_set = op(items) { items.unique(); };
set1 = create_set([1, 2, 3, 3, 4, 4, 5]);
set2 = create_set([3, 4, 5, 6, 7]);
set_union = (set1 + set2).unique();
set_intersection = set1.filter(op(item) { set2.grep(item).len() > 0; });
("Set operations: union=" + set_union + ", intersection=" + set_intersection).echo();

// Map-like functionality via objects ($LIST)
create_map = op(key_value_pairs) {
    map_obj = {};
    key_value_pairs.map(op(pair) {
        map_obj[pair.key] = pair.value;
    });
    map_obj;
};

map_data = [
    {key: "name", value: "Alice"},
    {key: "age", value: 30},
    {key: "city", value: "NY"}
];
map_obj = create_map(map_data);
("Map object: " + map_obj).echo();

// Weak reference patterns via function closures
create_weak_ref = op(target) { op() { target; }; };
original_data = {name: "Alice", data: [1, 2, 3]};
weak_ref = create_weak_ref(original_data);
accessed_data = weak_ref();
("Weak ref access: " + accessed_data).echo();

// Iterator protocols via custom functions
create_iterator = op(collection) {
    state = {index: 0, collection: collection};
    
    {
        has_next: op() { state.index < state.collection.len(); },
        next: op() { 
            if (state.index < state.collection.len()) {
                item = state.collection[state.index];
                state.index += 1;
                item;
            } else {
                null;
            }
        }
    };
};

iterator = create_iterator([1, 2, 3, 4, 5]);
("Iterator test:").echo();
while (iterator.has_next()) {
    item = iterator.next();
    ("  Next: " + item).echo();
}

// Priority queue
create_priority_queue = op() {
    items = [];
    
    {
        enqueue: op(item, priority) {
            items += [{item: item, priority: priority}];
            items = items.sort(op(a, b) { b.priority - a.priority; });
        },
        dequeue: op() {
            if (items.len() > 0) {
                item = items[0];
                items = items.slice(1);
                item.item;
            } else {
                null;
            }
        },
        size: op() { items.len(); }
    };
};

pq = create_priority_queue();
pq.enqueue("Task A", 1);
pq.enqueue("Task B", 3);
pq.enqueue("Task C", 2);
("Priority queue size: " + pq.size()).echo();

/* 6. Debugging and Development Tools */
("--- 6. Debugging and Development Tools ---").echo();

// Stack traces via .describe() and .type()
func = op(x) { x * 2; };
("Function description: " + func.describe()).echo();
("Function type: " + func.type()).echo();

// Source maps via .debug() method
debug_info = func.debug();
("Debug info: " + debug_info).echo();

// Profiling via $TIME() and timing functions
start_time = $TIME();
// Simulate work
(1000).range().map(op(x) { x * x; });
end_time = $TIME();
duration = end_time - start_time;
("Profiling: operation took " + duration + " seconds").echo();

// Hot reloading via dynamic grammar modification
@global["$hot_reload"] = rule reload $STR { op(script:$2) { 
    "Reloading: " + script; 
    // In a real implementation, this would reload the script
} };
result = reload "updated_script.grc";
(result).echo();

// Debug mode via -d flag (demonstrated conceptually)
debug_mode = true;
if (debug_mode) {
    ("Debug mode: Detailed execution info available").echo();
}

// Component-specific debugging
debug_component = op(component, level) {
    if (level == "verbose") {
        ("Debug [" + component + "]: Detailed information").echo();
    } else if (level == "info") {
        ("Debug [" + component + "]: Basic information").echo();
    } else {
        ("Debug [" + component + "]: Error only").echo();
    }
};

debug_component("database", "verbose");
debug_component("parser", "info");

("=== Advanced Language Features Demo Complete ===").echo();
