dim = 3072;
sets = 25;
planes = 6;
prec = 16.0;
test_size = 1000;

dbname = "test"+test_size.str().lpad(7,"0")+"_"+dim.str().lpad(4,"0")+"_"+sets.str().lpad(2,"0")+"_"+planes.str().lpad(2,"0")+".gdb";

vectors = $file();
vectors.cd(dbname);

start_time = $TIME().utc();

if ($file().info(dbname)."$TYPE"!="FILE")
{
	vectors.rm(dbname);
	vectors.mk(dbname,"COL");
	vectors.cd(dbname);
	vectors.mkfield("$KEY","STR","FIX",16);
	for j in sets.range()
	{
		vectors.mkfield("h"+j.str().lpad(2,"0"),"INT","FIX",8);
	};
	vectors.mkfield("vector","RAW","VAR");
	hashsource = dim.genhashset("cosine",sets,planes,1234);
	for i in test_size.range()
	{
		/* Create truly random vectors for realistic similarity testing */
		vector = (prec.random(#[dim]#)*2)-1;
		hash = vector.genhash(hashsource);
		name = "r"+i.str().lpad(8,"0");
		field = {"vector":vector};
		for j in sets.range()
		{
			field += (("h"+j.str().lpad(2,"0")):(hash[j]));
		};
		vectors.setfield(name,field);
	};
};

search_vector = (prec.random(#[dim]#)*2)-1;
hashsource = dim.genhashset("cosine",sets,planes,1234);
search = search_vector.genhash(hashsource);

create_vector_time = start_time.ms();
indexes = vectors.ls("",null,["$ID"]).vector().sort(1,["$ID"]).t().list()[0];
vector_results = indexes.similarity(search_vector, "cosine", {
	"datasource": vectors,
	"datafield": "vector",
	"top_n": 10,
	"include_scores": true,
	"include_items": false
});
pure_vector_time = start_time.ms() - create_vector_time;

field = [];
for j in sets.range()
	field += {("h"+j.str().lpad(2,"0")):(search[j])};
indexes2 = vectors.ls("",field,["$ID"]).vector().sort(1,["$ID"]).t().list()[0];
index_time = start_time.ms() - create_vector_time - pure_vector_time;

vector_results2 = indexes2.similarity(search_vector, "cosine", {
	"datasource": vectors,
	"datafield": "vector",
	"top_n": 10,
	"include_scores": true,
	"include_items": false
});

pure_vector_time2 = start_time.ms() - create_vector_time - pure_vector_time;

("    Create vector: " + create_vector_time.float(30).str() + "ms\n").echo();
("    Search vector: " + pure_vector_time.float(30).str() + "ms\n").echo();
("    Search index: " + index_time.float(30).str() + "ms\n").echo();
("    Search vector2: " + pure_vector_time2.float(30).str() + "ms\n").echo();
("    Results: " + vector_results."results".len().str() + "\n").echo();

"Full search\n".echo();
vector_results.str().echo();
"\n".echo();
"Index search\n".echo();
vector_results2.str().echo();
"\n".echo();
"Full size:".echo();
indexes.len().echo();
"\n".echo();    "Index size:".echo();
indexes2.len().echo();
"\n".echo();

("\n=== TEST COMPLETE ===\n").echo();
