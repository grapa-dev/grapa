{
  "Hello World": {
    "prefix": "hello",
    "body": [
      "'Hello, World!'.echo();"
    ],
    "description": "Simple hello world example"
  },
  "String Echo": {
    "prefix": "echo",
    "body": [
      "'${1:text}'.echo();"
    ],
    "description": "Echo a string"
  },
  "String Length": {
    "prefix": "len",
    "body": [
      "'${1:text}'.len()"
    ],
    "description": "Get string length"
  },
  "Array Creation": {
    "prefix": "array",
    "body": [
      "${1:name} = [${2:item1}, ${3:item2}];"
    ],
    "description": "Create an array"
  },
  "Array Get": {
    "prefix": "get",
    "body": [
      "${1:array}.getfield(${2:index})"
    ],
    "description": "Get array element"
  },
  "Array Add": {
    "prefix": "add",
    "body": [
      "${1:array}.add(${2:item});"
    ],
    "description": "Add item to array"
  },
  "File Read": {
    "prefix": "read",
    "body": [
      "content = \$file().getfield(\"${1:filename}\");",
      "content.echo();"
    ],
    "description": "Read file contents (hex format)"
  },
  "File Read String": {
    "prefix": "readstr",
    "body": [
      "content = \$file().getfield(\"${1:filename}\").str();",
      "content.echo();"
    ],
    "description": "Read file contents as string"
  },
  "File Write": {
    "prefix": "write",
    "body": [
      "\$file().setfield(\"${1:filename}\", \"${2:content}\");"
    ],
    "description": "Write to file"
  },
  "File Info": {
    "prefix": "fileinfo",
    "body": [
      "info = \$file().info(\"${1:filename}\");",
      "info.echo();"
    ],
    "description": "Get file information"
  },
  "Directory List": {
    "prefix": "ls",
    "body": [
      "files = \$file().ls(\"${1:path}\");",
      "files.echo();"
    ],
    "description": "List directory contents"
  },
  "Change Directory": {
    "prefix": "cd",
    "body": [
      "\$file().cd(\"${1:path}\");"
    ],
    "description": "Change directory"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t${2:// code}",
      "}"
    ],
    "description": "If statement"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "\t${2:// code}",
      "} else {",
      "\t${3:// code}",
      "}"
    ],
    "description": "If-else statement"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t${2:// code}",
      "}"
    ],
    "description": "While loop"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for (${1:i} = 0; ${1:i} < ${2:limit}; ${1:i}++) {",
      "\t${3:// code}",
      "}"
    ],
    "description": "For loop"
  },
  "RSA Key Generation": {
    "prefix": "rsa",
    "body": [
      "${1:rsa} = \"rsa\".genkeys(${2:});"
    ],
    "description": "Generate RSA keys"
  },
  "RSA Sign": {
    "prefix": "sign",
    "body": [
      "${1:data}.sign(${2:keys});"
    ],
    "description": "Sign data with keys"
  },
  "RSA Verify": {
    "prefix": "verify",
    "body": [
      "${1:signature}.verify(${2:keys}, '${3:data}');"
    ],
    "description": "Verify signature with keys"
  },
  "EC Key Generation": {
    "prefix": "ec",
    "body": [
      "${1:ec} = \"ec\".genkeys(${2:});"
    ],
    "description": "Generate EC keys"
  },
  "DH Key Generation": {
    "prefix": "dh",
    "body": [
      "${1:dh} = \"dh\".genkeys(${2:});"
    ],
    "description": "Generate DH keys"
  },
  "Hash Encoding": {
    "prefix": "hash",
    "body": [
      "'${1:data}'.encode('${2:sha256}');"
    ],
    "description": "Hash data"
  },
  "Error Handling": {
    "prefix": "iferr",
    "body": [
      "${1:result}.iferr('${2:fallback}')"
    ],
    "description": "Handle errors with fallback"
  },
  "Null Handling": {
    "prefix": "ifnull",
    "body": [
      "${1:value}.ifnull('${2:default}')"
    ],
    "description": "Handle null values with default"
  },
  "Database Query": {
    "prefix": "query",
    "body": [
      "${1:table}.query('${2:SELECT * FROM table}')"
    ],
    "description": "Execute database query"
  },
  "Database Insert": {
    "prefix": "insert",
    "body": [
      "${1:table}.insert({${2:field}: '${3:value}'});"
    ],
    "description": "Insert record into table"
  },
  "Block Comment": {
    "prefix": "comment",
    "body": [
      "/*",
      " * ${1:comment}",
      " */"
    ],
    "description": "Block comment"
  },
  "Function Definition": {
    "prefix": "function",
    "body": [
      "${1:functionName} = {",
      "\t${2:// function body}",
      "\treturn ${3:value};",
      "};"
    ],
    "description": "Function definition"
  },
  "JSON Object": {
    "prefix": "json",
    "body": [
      "${1:obj} = {",
      "\t${2:key}: '${3:value}'",
      "};"
    ],
    "description": "Create JSON object"
  },
  "Vector": {
    "prefix": "vector",
    "body": [
      "${1:vec} = #[${2:1}, ${3:2}, ${4:3}]#;"
    ],
    "description": "Create vector with #[]# syntax"
  },
  "JSON Access": {
    "prefix": "jsonget",
    "body": [
      "${1:obj}.getfield('${2:key}')"
    ],
    "description": "Access JSON property"
  },
  "JSON Set": {
    "prefix": "jsonset",
    "body": [
      "${1:obj}.setfield('${2:key}', '${3:value}');"
    ],
    "description": "Set JSON property"
  },
  "Multi-line Assignment": {
    "prefix": "multiline",
    "body": [
      "${1:variable} = \\\\",
      "${2:value1}",
      "${3:value2};"
    ],
    "description": "Multi-line assignment with line feed escaping"
  },
  "Function Definition": {
    "prefix": "op",
    "body": [
      "${1:functionName} = op(${2:params}) {",
      "\t${3:// function body}",
      "\treturn ${4:value};",
      "};"
    ],
    "description": "Define a function with op keyword"
  },
  "Class Definition": {
    "prefix": "class",
    "body": [
      "@global[\"${1:ClassName}\"] = class (${2:ParentClass}) {",
      "\t${3:// class methods}",
      "};"
    ],
    "description": "Define a class"
  },
  "Switch Statement": {
    "prefix": "switch",
    "body": [
      "switch (${1:expression}) {",
      "\tcase ${2:value}:",
      "\t\t${3:// code}",
      "\t\tbreak;",
      "\tdefault:",
      "\t\t${4:// default code}",
      "}"
    ],
    "description": "Switch statement"
  },
  "Try-Catch Block": {
    "prefix": "try",
    "body": [
      "try {",
      "\t${1:// code that might throw}",
      "} catch (${2:error}) {",
      "\t${3:// error handling}",
      "} finally {",
      "\t${4:// cleanup code}",
      "}"
    ],
    "description": "Try-catch-finally block"
  },
  "For Each Loop": {
    "prefix": "foreach",
    "body": [
      "foreach ${1:item} in ${2:collection} {",
      "\t${3:// code}",
      "}"
    ],
    "description": "For-each loop"
  },
  "Range Loop": {
    "prefix": "forrange",
    "body": [
      "for ${1:i} from ${2:start} to ${3:end} step ${4:1} {",
      "\t${5:// code}",
      "}"
    ],
    "description": "Range-based for loop"
  },
  "System Variable": {
    "prefix": "sysvar",
    "body": [
      "\\$${1:VAR}"
    ],
    "description": "System variable with $ prefix"
  },
  "Error Handling": {
    "prefix": "iferr",
    "body": [
      "${1:result}.iferr(${2:fallback})"
    ],
    "description": "Handle errors with fallback"
  },
  "Null Handling": {
    "prefix": "ifnull",
    "body": [
      "${1:value}.ifnull(${2:default})"
    ],
    "description": "Handle null values with default"
  },
  "String Interpolation": {
    "prefix": "interpolate",
    "body": [
      "'${1:template}'.interpolate({${2:vars}})"
    ],
    "description": "String interpolation with variables"
  },
  "Vector Creation": {
    "prefix": "vector",
    "body": [
      "${1:vec} = #[${2:1}, ${3:2}, ${4:3}]#;"
    ],
    "description": "Create vector with #[]# syntax"
  },
  "Table Creation": {
    "prefix": "table",
    "body": [
      "${1:table} = {}.table();"
    ],
    "description": "Create database table"
  },
  "Network Connection": {
    "prefix": "netconnect",
    "body": [
      "${1:conn} = $net().connect('${2:url}');"
    ],
    "description": "Create network connection"
  },
  "Thread Creation": {
    "prefix": "thread",
    "body": [
      "${1:thread} = $thread().start(${2:runCode}, ${3:param});"
    ],
    "description": "Create and start thread"
  },
  "Time Operations": {
    "prefix": "time",
    "body": [
      "${1:time} = $TIME().utc();"
    ],
    "description": "Get current UTC time"
  },
  "Math Operations": {
    "prefix": "math",
    "body": [
      "${1:result} = ${2:value}.${3:sin}();"
    ],
    "description": "Mathematical function call"
  }
}
