{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Grapa",
  "scopeName": "source.grapa",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#vectors"
    },
    {
      "include": "#json"
    },
    {
      "include": "#xml"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.grapa",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "comment.line.number-sign.grapa",
              "match": "\\*"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.grapa",
          "match": "//.*$"
        }
      ]
    },
            "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.grapa",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.grapa",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.grapa",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.grapa",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "vectors": {
            "name": "meta.vector.grapa",
            "begin": "#\\[",
            "end": "\\]#",
            "patterns": [
                {
                    "include": "#numbers"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#variables"
                }
            ]
        },
        "json": {
            "name": "meta.json.grapa",
            "begin": "\\{",
            "end": "\\}",
            "patterns": [
                {
                    "name": "string.quoted.double.grapa",
                    "match": "\"[^\"]*\""
                },
                {
                    "name": "constant.numeric.grapa",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                },
                {
                    "name": "keyword.control.grapa",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "xml": {
            "patterns": [
                {
                    "name": "entity.name.tag.grapa",
                    "match": "<([a-zA-Z][a-zA-Z0-9]*)\\b>"
                },
                {
                    "name": "entity.name.tag.grapa", 
                    "match": "</([a-zA-Z][a-zA-Z0-9]*)\\b>"
                }
            ]
        },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.grapa",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.float.grapa",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.hex.grapa",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.grapa",
          "match": "\\b(if|else|elseif|while|for|foreach|do|break|continue|return|throw|exit|switch|case|default|try|catch|finally)\\b"
        },
        {
          "name": "keyword.operator.grapa",
          "match": "\\b(and|or|not|in|from|to|step)\\b"
        },
        {
          "name": "keyword.other.grapa",
          "match": "\\b(iferr|ifnull|op|class|token|rule|lambda|static|const|obj|include)\\b"
        },
        {
          "name": "keyword.system.grapa",
          "match": "\\b(this|parent|global|local|oplocal|root|self|sys|net|thread|TIME|math|file|TABLE|VECTOR|WIDGET|XML|TAG|EL|CLASS|OP|RULE|ERR|RAW|BOOL|FLOAT|INT|ID|SYSID|SYSINT|SYSSTR|LIST|ARRAY|TUPLE)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.grapa",
          "match": "\\$[A-Z]+\\b"
        },
        {
          "name": "variable.other.grapa",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.grapa",
          "match": "=|\\+=|\\+\\+=|-=|\\*=|/=|%=|\\*\\*="
        },
        {
          "name": "keyword.operator.arithmetic.grapa",
          "match": "\\+|-|\\*|/|%|\\*\\*"
        },
        {
          "name": "keyword.operator.comparison.grapa",
          "match": "==|!=|<|>|<=|>=|<=>"
        },
        {
          "name": "keyword.operator.logical.grapa",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.grapa",
          "match": "&|\\||\\^|~|<<|>>"
        },
        {
          "name": "keyword.operator.ternary.grapa",
          "match": "\\?|:"
        },
        {
          "name": "keyword.operator.extend.grapa",
          "match": "\\+\\+|-\\-"
        },
        {
          "name": "keyword.operator.access.grapa",
          "match": "\\."
        },
        {
          "name": "keyword.operator.access.grapa",
          "match": "\\[|\\]"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.grapa",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*\\("
        },
        {
          "name": "support.function.grapa",
          "match": "\\b(type|describe|raw|uraw|bool|int|uint|float|fix|setfloat|setfix|str|list|array|vector|table|base|hex|uhex|bin|ubin|time|bits|bytes|len|left|right|mid|midtrim|find|rtrim|ltrim|trim|lrot|rrot|lpad|rpad|reverse|replace|interpolate|grep|match|split|join|identity|setbit|clearbit|genbits|genkeys|encode|decode|sign|signadd|verify|verifyrecover|secret|setfield|map|filter|reduce|sort|argsort|unique|group|isint|iferr|ifnull|shell|exec|post|getname|echo|debug|string|const|setconst|json|xml|html|findall|range|keys|sleep|get|set|getfield|upper|lower|casefold|levenshtein|jarowinkler|cosinesimilarity|pwd|cd|phd|chd|ls|mk|rm|info|mkfield|rmfield|dump|compilef|compile|eval|getenv|putenv|setenv|mac|interfaces|connect|bind|listen|onlisten|disconnect|proxy|certificate|private|trusted|verify|chain|host|send|receive|pending|onreceive|httpread|httpsend|httpmessage|trylock|lock|unlock|wait|signal|waiting|start|stop|started|suspend|resume|suspended|e|pi|log|ln|sin|cos|tan|cot|sec|csc|asin|acos|atan|acot|asec|acsc|sinh|cosh|tanh|coth|sech|csch|asinh|acosh|atanh|acoth|asech|acsch|atan2|hypot|random|abs|modpow|modinv|genprime|isprime|gcd|utc|tz|ms)\\b"
        }
      ]
    }
  }
}
