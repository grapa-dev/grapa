/* Simple GrapaDBX Test */
"=== Simple GrapaDBX Test ===\n".echo();

u = $unified();
"Created unified object\n".echo();

result = u.create("grapadbx://test.dbx");
"Create result: ".echo();
result.echo();
"\n".echo();

if (result.type() == $ERR) {
    "❌ Database creation failed\n".echo();
} else {
    "✅ Database creation succeeded\n".echo();
} 