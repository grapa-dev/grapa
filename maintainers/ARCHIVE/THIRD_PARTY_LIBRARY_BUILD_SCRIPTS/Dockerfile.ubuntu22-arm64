FROM --platform=linux/arm64 ubuntu:22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Update and install all required packages
RUN apt-get update && apt-get install -y \
    # Core build tools
    build-essential \
    cmake \
    pkg-config \
    \
    # Development tools
    gdb \
    git \
    autoconf \
    automake \
    libtool \
    \
    # X11 development libraries (required for FLTK)
    libx11-dev \
    libxfixes-dev \
    libxft-dev \
    libxext-dev \
    libxrender-dev \
    libxinerama-dev \
    libxcursor-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    \
    # Additional libraries for complete FLTK build
    libpng-dev \
    libjpeg-dev \
    libz-dev \
    libssl-dev \
    \
    # Graphics and audio libraries
    libglu1-mesa-dev \
    libasound2-dev \
    \
    # Additional X11 packages
    libxcb1-dev \
    \
    # Clean up
    && rm -rf /var/lib/apt/lists/*

# Set working directory to /data (mapped to $HOME on Mac)
WORKDIR /data

# Default command
CMD ["/bin/bash"] 