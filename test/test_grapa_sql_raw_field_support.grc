file_stats = SELECT 
    file_name,
    file_content.hex() as hex_content,
    file_content.len() as file_size
FROM . WHERE file_content.len() > 100;

// Cross-reference between file system and database
f.cd("binary_database");
cross_ref = SELECT 
    b.id,
    b.name,
    b.binary_content.hex() as db_hex,
    f.file_content.hex() as fs_hex
