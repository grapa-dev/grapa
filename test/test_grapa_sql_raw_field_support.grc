"✓ f.cd(\"binary_database\");\n".echo();
"✓ cross_ref = SELECT b.id, b.name, b.binary_content.hex() as db_hex, f.file_content.hex() as fs_hex FROM binary_data/b JOIN /documents/f ON b.name = f.file_name;\n".echo();
