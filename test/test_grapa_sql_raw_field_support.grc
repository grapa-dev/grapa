    id INT,
    name STR,
    binary_content RAW,
    metadata RAW,
    file_size INT
);

// Insert RAW data using SQL
INSERT INTO binary_data (id, name, binary_content, metadata, file_size) VALUES 
    (1, 'file1', 'hello'.raw(), (0x6869).raw(), 5),
    (2, 'file2', 'world'.raw(), (0x776f).raw(), 5),
    (3, 'file3', (12345).raw(), (0x3039).raw(), 4);

// Query RAW data with byte-by-byte comparison
SELECT * FROM binary_data WHERE binary_content = 'hello'.raw();
SELECT * FROM binary_data WHERE metadata > (0x5000).raw();

// RAW field functions in SQL
