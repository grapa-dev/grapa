"✓ SELECT * FROM binary_data WHERE RAW_CONTAINS(binary_content, 'test'.raw());\n".echo();
"✓ SELECT * FROM binary_data WHERE RAW_MATCHES(binary_content, '0x68%');  // Hex pattern\n".echo();
"✓ SELECT id, name, STR_TO_RAW('hello') as from_string, INT_TO_RAW(12345) as from_int, HEX_TO_RAW('0x6869') as from_hex FROM binary_data;\n".echo();
"\n".echo();

