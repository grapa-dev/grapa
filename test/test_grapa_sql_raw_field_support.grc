/* Test 3: RAW Field Comparison Modes */
"Test 3: RAW Field Comparison Modes\n".echo();
"----------------------------------\n".echo();

"Different comparison modes for RAW fields:\n".echo();
"\n".echo();

/* This would show different RAW field comparison modes */
/*
// Byte-by-byte comparison (default)
SELECT * FROM binary_data WHERE binary_content = 'hello'.raw();

// Type-aware comparison
SELECT * FROM binary_data WHERE binary_content.str() = 'hello';
SELECT * FROM binary_data WHERE binary_content.int() > 1000;

// Hex pattern matching
SELECT * FROM binary_data WHERE binary_content.hex() LIKE '0x68%';

// Length-based comparison
SELECT * FROM binary_data WHERE binary_content.len() > 10;

// Range comparison
SELECT * FROM binary_data WHERE metadata >= (0x1000).raw() AND metadata <= (0xFFFF).raw();
*/
"✓ SELECT * FROM binary_data WHERE binary_content = 'hello'.raw();  // Byte-by-byte\n".echo();
"✓ SELECT * FROM binary_data WHERE binary_content.str() = 'hello';  // Type-aware\n".echo();
"✓ SELECT * FROM binary_data WHERE binary_content.int() > 1000;     // Type-aware\n".echo();
"✓ SELECT * FROM binary_data WHERE binary_content.hex() LIKE '0x68%';  // Hex pattern\n".echo();
"✓ SELECT * FROM binary_data WHERE binary_content.len() > 10;       // Length-based\n".echo();
"✓ SELECT * FROM binary_data WHERE metadata >= (0x1000).raw() AND metadata <= (0xFFFF).raw();  // Range\n".echo();
"\n".echo();

