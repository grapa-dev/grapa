/* Test 7: RAW Field with Transactions */
"Test 7: RAW Field with Transactions\n".echo();
"-----------------------------------\n".echo();

"RAW fields with transaction support:\n".echo();
"\n".echo();

/* This would show RAW fields with transactions */
/*
// RAW fields with transactions
BEGIN TRANSACTION;

// Insert RAW data
INSERT INTO binary_data (id, name, binary_content, metadata) VALUES 
    (4, 'file4', 'transaction_test'.raw(), (0x7478).raw());

// Update RAW data
UPDATE binary_data SET binary_content = 'updated_content'.raw() WHERE id = 1;

// Query RAW data
SELECT * FROM binary_data WHERE binary_content = 'transaction_test'.raw();

COMMIT;

// Rollback example
BEGIN TRANSACTION;
INSERT INTO binary_data (id, name, binary_content) VALUES (5, 'file5', 'will_be_rolled_back'.raw());
ROLLBACK;  // This RAW data will not be saved
*/
"✓ BEGIN TRANSACTION;\n".echo();
"✓ INSERT INTO binary_data (id, name, binary_content, metadata) VALUES (4, 'file4', 'transaction_test'.raw(), (0x7478).raw());\n".echo();
"✓ UPDATE binary_data SET binary_content = 'updated_content'.raw() WHERE id = 1;\n".echo();
"✓ SELECT * FROM binary_data WHERE binary_content = 'transaction_test'.raw();\n".echo();
"✓ COMMIT;\n".echo();
"✓ BEGIN TRANSACTION;\n".echo();
"✓ INSERT INTO binary_data (id, name, binary_content) VALUES (5, 'file5', 'will_be_rolled_back'.raw());\n".echo();
"✓ ROLLBACK;  // This RAW data will not be saved\n".echo();
"\n".echo();

