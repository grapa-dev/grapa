"================================================================================\n".echo();
"Get $file() GROUP structure\n".echo();
"================================================================================\n".echo();
"Create nested GROUP structure\n".echo();
fdata = $file();
fdata.mk("users", "GROUP");
fdata.cd("users");
fdata.mk("admins", "GROUP");
fdata.mk("regular", "GROUP");
fdata.cd("admins");
fdata.mk("alice", "GROUP");
fdata.set("alice", "role", "superadmin");
fdata.set("alice", "level", 10);
fdata.cd("..");
fdata.cd("regular");
fdata.mk("bob", "GROUP");
fdata.set("bob", "role", "user");
fdata.set("bob", "level", 1);
"--------------------------\n".echo();
fdata.debug();
"================================================================================\n".echo(); 