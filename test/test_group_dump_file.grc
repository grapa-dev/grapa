/* GROUP Database Test with File Output
"=== GROUP Database Test with File Output ===".echo();

/* Create GROUP database
group_db = $file().table("GROUP");
"GROUP database created".echo();

/* Create a simple nested structure
group_db.mk("users", "ROW");
"Created users sub-database".echo();

/* Navigate to users and add some data
users_db = group_db.cd("users");
users_db.mkfield("name", "STR", "VAR");
users_db.set("user1", "Alice", "name");
"Added user data".echo();

/* Navigate back to root
group_db.cd("..");
"Back to root".echo();

/* Create a file to capture dump output
dump_file = $file().create("group_dump.txt");
"Created dump file".echo();

/* Show the tree structure to file
"=== GROUP Database Tree Structure ===".echo();
group_db.dump(dump_file);

/* Close the dump file
dump_file.close();
"Closed dump file".echo();

/* Read and display the dump content
"=== Reading dump file content ===".echo();
dump_content = $file().read("group_dump.txt");
dump_content.echo();

/* Clean up
$file().rm("group_dump.txt")
"Cleaned up dump file".echo() 