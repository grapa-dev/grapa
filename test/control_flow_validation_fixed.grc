"Test 13: Simple Return Test".echo();
testFunc = op() {
    return 42;
    999;  /* This should not execute if return works */
};
result = testFunc();
"Return value: ".interpolate(result).echo();
"Expected: 42 (if fixed), 999 (if not fixed)".echo();

"All control flow tests completed!".echo();
