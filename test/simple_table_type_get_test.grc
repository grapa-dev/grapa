/* Test .get() type behavior for INT, FLOAT, and RAW fields */
table = $file().table("ROW");
table.mkfield("name", "STR");
table.mkfield("age", "INT");
table.mkfield("value", "FLOAT");
table.mkfield("meta", "RAW");

table.set("user1", "Alice", "name");
table.set("user1", 42, "age");
table.set("user1", 3.14, "value");
table.set("user1", {"foo": 123, "bar": [1,2,3]}, "meta");

name = table.get("user1", "name");
age = table.get("user1", "age");
value = table.get("user1", "value");
meta = table.get("user1", "meta");

("Name: " + name).echo();
("Age type: " + age.type() + ", value: " + age.str()).echo();
("Value type: " + value.type() + ", value: " + value.str()).echo();
("Meta.foo: " + meta.foo.str()).echo();
("Meta.bar[1]: " + meta.bar[1].str()).echo(); 