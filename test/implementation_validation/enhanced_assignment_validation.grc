/* Enhanced Assignment Operators Validation Tests */
/* Testing examples from implementation documentation */

"=== Enhanced Assignment Operators Validation ===".echo();

/* Test 1: Multiplication assignment (*=) */
x = 10;
x *= 3;
"x *= 3: ${x}".interpolate().echo();  /* Should output: 30 */

/* Test 2: Division assignment (/=) */
x = 10;
x /= 2;
"x /= 2: ${x}".interpolate().echo();  /* Should output: 5.0 */

/* Test 3: Modulo assignment (%=) */
x = 10;
x %= 3;
"x %= 3: ${x}".interpolate().echo();  /* Should output: 1 */

/* Test 4: Exponentiation assignment (**=) */
x = 2;
x **= 3;
"x **= 3: ${x}".interpolate().echo();  /* Should output: 8 */

/* Test 5: Mixed type operations */
x = 10;
x *= 2.5;
"x *= 2.5: ${x}".interpolate().echo();  /* Should output: 25.0 */

x = 10;
x /= 2.5;
"x /= 2.5: ${x}".interpolate().echo();  /* Should output: 4.0 */

x = 10;
x %= 3.5;
"x %= 3.5: ${x}".interpolate().echo();  /* Should output: 3.0 */

x = 2;
x **= 3.5;
"x **= 3.5: ${x}".interpolate().echo();  /* Should output: 11.313... */

/* Test 6: Array operations with += */
arr = [1, 2, 3];
arr += 4;
"Array += 4: ${arr.str()}".interpolate().echo();  /* Should output: [1, 2, 3, 4] */

/* Test 7: String concatenation with += */
str = "Hello";
str += " World";
"String += ' World': ${str}".interpolate().echo();  /* Should output: Hello World */

/* Test 8: Object property assignment */
obj = $obj();
obj.setfield("count", 0);
obj.setfield("count", obj.getfield("count") + 1);
"Object count: ${obj.getfield('count')}".interpolate().echo();  /* Should output: 1 */

/* Test 9: Complex expressions with assignment */
value = 100;
value *= 2 + 3;  /* value = value * (2 + 3) = 100 * 5 = 500 */
"value *= 2 + 3: ${value}".interpolate().echo();  /* Should output: 500 */

/* Test 10: Multiple assignments in sequence */
a = 10;
b = 5;
a *= b;
b += a;
"a *= b, b += a: a=${a}, b=${b}".interpolate().echo();  /* Should output: a=50, b=55 */

/* Test 11: Assignment with function calls */
counter = 1;
counter *= 2;
counter += 3;
counter **= 2;
"Counter operations: ${counter}".interpolate().echo();  /* Should output: 25 */

/* Test 12: Array operations with multiple += */
numbers = [];
numbers += 1;
numbers += 2;
numbers += 3;
"Numbers array: ${numbers.str()}".interpolate().echo();  /* Should output: [1, 2, 3] */

/* Test 13: String building with += */
message = "";
message += "Hello";
message += " ";
message += "Grapa";
message += "!";
"Built message: ${message}".interpolate().echo();  /* Should output: Hello Grapa! */

/* Test 14: Object building with += */
config = $obj();
config.setfield("name", "test");
config.setfield("enabled", true);
config.setfield("count", 0);
config.setfield("count", config.getfield("count") + 10);
"Config object: name=${config.getfield('name')}, enabled=${config.getfield('enabled')}, count=${config.getfield('count')}".interpolate().echo();

"=== All Enhanced Assignment Operators Tests Completed ===".echo();
