/* Array Operations Validation Tests */
/* Testing examples from implementation documentation */

"=== Array Operations Validation ===".echo();

/* Test 1: Array append with += operator */
tasks = [];
task = op(id) {
    "Task ${id} completed".interpolate().echo();
};
tasks += task;
"Tasks array length: ${tasks.len()}".interpolate().echo();  /* Should output: 1 */

/* Test 2: Results array with += operator */
results = [];
response = $obj();
response.set("status", 200);
results += response;
"Results array length: ${results.len()}".interpolate().echo();  /* Should output: 1 */

/* Test 3: Numbers array with += operator */
numbers = [1, 2, 3, 4, 5];
numbers += 6;
"Numbers array: ${numbers.str()}".interpolate().echo();  /* Should output: [1, 2, 3, 4, 5, 6] */

/* Test 4: Functions array with += operator */
funcs = [];
func = op(x) { x * 2; };
funcs += func;
"Functions array length: ${funcs.len()}".interpolate().echo();  /* Should output: 1 */

/* Test 5: Array access with bracket notation */
data = [10, 20, 30, 40, 50];
first = data[0];
second = data[1];
"First element: ${first}, Second element: ${second}".interpolate().echo();  /* Should output: First element: 10, Second element: 20 */

/* Test 6: Array length with .len() */
array_length = data.len();
"Array length: ${array_length}".interpolate().echo();  /* Should output: Array length: 5 */

/* Test 7: Array iteration */
sum = 0;
for item in data {
    sum += item;
};
"Sum of array elements: ${sum}".interpolate().echo();  /* Should output: Sum of array elements: 150 */

/* Test 8: Array filtering */
even_numbers = data.filter(op(x) { x % 2 == 0; });
"Even numbers: ${even_numbers.str()}".interpolate().echo();  /* Should output: Even numbers: [10, 20, 30, 40, 50] */

/* Test 9: Array mapping */
doubled = data.map(op(x) { x * 2; });
"Doubled values: ${doubled.str()}".interpolate().echo();  /* Should output: Doubled values: [20, 40, 60, 80, 100] */

/* Test 10: Array reduction */
total = data.reduce(op(acc, x) { acc + x; }, 0);
"Total sum: ${total}".interpolate().echo();  /* Should output: Total sum: 150 */

"=== All Array Operations Tests Completed ===".echo();
