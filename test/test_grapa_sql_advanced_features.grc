/* This would demonstrate performance features
/*
/* Unicode performance
CREATE INDEX idx_unicode_greeting ON unicode_data (greeting COLLATE unicode);
SELECT * FROM unicode_data WHERE greeting = 'Hello 世界' COLLATE unicode;

/* Regex performance
CREATE INDEX idx_regex_email ON regex_data USING regex (email);
SELECT * FROM regex_data WHERE email REGEXP '@example\.com$';

/* JSON performance
CREATE INDEX idx_json_name ON json_data USING json (user_data->'name');
SELECT * FROM json_data WHERE user_data->'name' = 'Alice';

/* XML performance
CREATE INDEX idx_xml_name ON xml_data USING xml (user_xml->'user/name');
SELECT * FROM xml_data WHERE user_xml->'user/name' = 'Alice';

/* Query optimization
EXPLAIN SELECT * FROM unicode_data WHERE greeting REGEXP '\\p{Han}';
EXPLAIN SELECT * FROM json_data WHERE user_data->'skills' ? 'Python';

/* Performance monitoring
SELECT query_id, execution_time, memory_usage FROM query_performance WHERE execution_time > 1000;
*/
