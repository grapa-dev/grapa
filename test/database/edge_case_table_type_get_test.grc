/* Simple edge case tests for .getfield() */:
table = {}.table("ROW");
table.mkfield("intf", "INT");
table.mkfield("floatf", "FLOAT");
table.mkfield("rawf", "RAW");

/* Test basic operations */
table.setfield("user1", 42, "intf");
table.setfield("user1", 3.14, "floatf");
table.setfield("user1", "test", "rawf");

int_val = table.getfield("user1", "intf");
float_val = table.getfield("user1", "floatf");
raw_val = table.getfield("user1", "rawf");

("INT value: " + int_val + "\n").echo();
("FLOAT value: " + float_val + "\n").echo();
("RAW value: " + raw_val + "\n").echo();

/* Test missing record */
missing = table.getfield("missing", "intf");
("Missing record type: " + missing.type() + "\n").echo();

/* Test type conversion */
table.setfield("user2", "123", "intf");
converted = table.getfield("user2", "intf");
("String to INT: " + converted + "\n").echo();

"=== Edge Case Test Complete ===\n".echo(); 