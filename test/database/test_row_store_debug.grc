/* Test Row Store Database Operations with Debug */

"Testing Row Store Database Operations...\n".echo();

/* Test 1: Create a virtual $TABLE in memory */
"Test 1: Virtual $TABLE in Memory\n".echo();
"--------------------------------\n".echo();

"Creating virtual $TABLE in memory...\n".echo();
f = {}.table();
"Database type: ".echo();
f.type().echo();
"\n".echo();

"Creating fields for the database...\n".echo();
f.mkfield("id", "INT", "FIX", 4);
f.mkfield("name", "STR", "VAR");
f.mkfield("age", "INT", "FIX", 4);
f.mkfield("salary", "FLOAT", "FIX", 8);
f.mkfield("department", "STR", "VAR");

"Database structure after field creation:\n".echo();
f.dump().echo();
"\n".echo();

/* Test 2: Create records and set field values */
"Test 2: Record Creation and Field Setting\n".echo();
"-----------------------------------------\n".echo();

"Setting data for employee1...\n".echo();
f.setfield("employee1", "John Doe", "name");
f.setfield("employee1", 30, "age");
f.setfield("employee1", 75000.50, "salary");
f.setfield("employee1", "Engineering", "department");

"Database structure after employee1:\n".echo();
f.dump().echo();
"\n".echo();

"Setting data for employee2...\n".echo();
f.setfield("employee2", "Jane Smith", "name");
f.setfield("employee2", 28, "age");
f.setfield("employee2", 72000.25, "salary");
f.setfield("employee2", "Marketing", "department");

"Database structure after employee2:\n".echo();
f.dump().echo();
"\n".echo();

/* Test 3: Retrieve and verify field values */
"Test 3: Field Retrieval and Verification\n".echo();
"----------------------------------------\n".echo();

"Retrieving employee1 data...\n".echo();
name1 = f.getfield("employee1", "name");
age1 = f.getfield("employee1", "age");
salary1 = f.getfield("employee1", "salary");
dept1 = f.getfield("employee1", "department");

"employee1.name: ${name1}\n".interpolate().echo();
"employee1.age: ${age1}\n".interpolate().echo();
"employee1.salary: ${salary1}\n".interpolate().echo();
"employee1.department: ${dept1}\n".interpolate().echo();

"Retrieving employee2 data...\n".echo();
name2 = f.getfield("employee2", "name");
age2 = f.getfield("employee2", "age");
salary2 = f.getfield("employee2", "salary");
dept2 = f.getfield("employee2", "department");

"employee2.name: ${name2}\n".interpolate().echo();
"employee2.age: ${age2}\n".interpolate().echo();
"employee2.salary: ${salary2}\n".interpolate().echo();
"employee2.department: ${dept2}\n".interpolate().echo();

/* Test 4: Test unset fields */
"Test 4: Unset Fields\n".echo();
"-------------------\n".echo();

"Testing unset field (should be empty)...\n".echo();
unset_field = f.getfield("employee1", "id");
"employee1.id (unset): ${unset_field}\n".interpolate().echo();

/* Test 5: Update existing field */
"Test 5: Field Update\n".echo();
"-------------------\n".echo();

"Updating employee1 salary...\n".echo();
f.setfield("employee1", 80000.75, "salary");
updated_salary = f.getfield("employee1", "salary");
"employee1.salary (updated): ${updated_salary}\n".interpolate().echo();

"Final database structure:\n".echo();
f.dump().echo();
"\n".echo();

"Test completed successfully!\n".echo(); 