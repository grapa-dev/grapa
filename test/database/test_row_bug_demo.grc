/* ROW Table Test Demo (Updated August 2025) */
/* This script demonstrates ROW table functionality. */
/* As of August 2025, ROW tables work correctly. */

"=== ROW TABLE TEST DEMO ===".echo();
"\n".echo();

/* Create ROW table */
"Creating ROW table...\n".echo();
frow = {}.table("ROW");
frow.mkfield("name", "STR", "VAR");
frow.mkfield("age", "INT", "FIX", 4);
frow.mkfield("city", "STR", "VAR");

"ROW table created\n".echo();
"---\n".echo();

/* Add first record */
"Adding first record (user1)...\n".echo();
frow.setfield("user1", "name", "Alice");
frow.setfield("user1", "age", 25);
frow.setfield("user1", "city", "New York");

"First record added".echo();
"---\n".echo();

/* Test first record - should work */
"Testing first record retrieval (should work)...\n".echo();
name1 = frow.getfield("user1", "name").str();
age1 = frow.getfield("user1", "age").raw().int();
city1 = frow.getfield("user1", "city").str();

"user1.name: ".echo();
name1.echo();
"\n".echo();
"user1.age: ".echo();
age1.echo();
"\n".echo();
"user1.city: ".echo();
city1.echo();
"\n".echo();
"---".echo();

/* Add second record */
"Adding second record (user2)...\n".echo();
frow.setfield("user2", "name", "Bob");
frow.setfield("user2", "age", 30);
frow.setfield("user2", "city", "Los Angeles");

"Second record added\n".echo();
"---\n".echo();

/* Test both records - should work */
"Testing both records (should work)...\n".echo();
name1_again = frow.getfield("user1", "name");
name2 = frow.getfield("user2", "name");

"user1.name (after user2): ".echo();
name1_again.echo();
"\n".echo();
"user2.name: ".echo();
name2.echo();
"\n".echo();
"---\n".echo();

/* Add third record */
"Adding third record (user3)...\n".echo();
frow.setfield("user3", "name", "Charlie");
frow.setfield("user3", "age", 35);
frow.setfield("user3", "city", "Chicago");

"Third record added\n".echo();
"---\n".echo();

/* Test all records - should all work correctly */
"Testing all records (should all work correctly)...\n".echo();
name1_test = frow.getfield("user1", "name");
name2_test = frow.getfield("user2", "name");
name3_test = frow.getfield("user3", "name");

"user1.name (after user3): ".echo();
name1_test.echo();
"\n".echo();
"user2.name (after user3): ".echo();
name2_test.echo();
"\n".echo();
"user3.name (after user3): ".echo();
name3_test.echo();
"\n".echo();
"---\n".echo();

/* Show debug output */
"ROW table debug output:\n".echo();
frow.debug();
"\n".echo();
"---\n".echo();

/* Compare with COL table */
"Creating COL table for comparison...\n".echo();
fcol = {}.table("COL");
fcol.mkfield("name", "STR", "VAR");
fcol.mkfield("age", "INT", "FIX", 4);
fcol.mkfield("city", "STR", "VAR");

/* Add same 3 records to COL table */
fcol.setfield("user1", "name", "Alice");
fcol.setfield("user1", "age", 25);
fcol.setfield("user1", "city", "New York");

fcol.setfield("user2", "name", "Bob");
fcol.setfield("user2", "age", 30);
fcol.setfield("user2", "city", "Los Angeles");

fcol.setfield("user3", "name", "Charlie");
fcol.setfield("user3", "age", 35);
fcol.setfield("user3", "city", "Chicago");

/* Test COL table - should work correctly */
"Testing COL table (should work correctly)...\n".echo();
col_name1 = fcol.getfield("user1", "name");
col_name2 = fcol.getfield("user2", "name");
col_name3 = fcol.getfield("user3", "name");

"COL user1.name: ".echo();
col_name1.echo();
"\n".echo();
"COL user2.name: ".echo();
col_name2.echo();
"\n".echo();
"COL user3.name: ".echo();
col_name3.echo();
"\n".echo();
"---\n".echo();

/* Summary */
"=== ROW TABLE TEST SUMMARY ===\n".echo();
"ROW table: All records remain readable (working correctly)\n".echo();
"COL table: All records remain readable (working correctly)\n".echo();
"Status: Both ROW and COL tables work correctly\n".echo();
"---\n".echo();

"Demo completed\n".echo(); 
