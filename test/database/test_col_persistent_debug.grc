/* Test COL (column store) database operations with persistent storage and debug output */

/* Cleanup any existing test database */
f = $file()
f.rm("test_col_db")

/* Create a persistent column store database */
echo("=== COL Database Test (Persistent) ===")
echo("Creating persistent column store database...")
f.mk("test_col_db", "COL")
f.cd("test_col_db")
echo("Database type:", f.type())
echo("---")

/* Define fields for the table */
echo("Creating fields...")
f.mkfield("name", "STR", "VAR")
f.mkfield("age", "INT", "FIX", 4)
f.mkfield("city", "STR", "VAR")
f.mkfield("salary", "FLOAT", "FIX", 8)

echo("Fields defined")
echo("Fields:", f.fields())
echo("---")

/* Create first record */
echo("Creating first record...")
f.setfield("1", "name", "Alice")
f.setfield("1", "age", 30)
f.setfield("1", "city", "New York")
f.setfield("1", "salary", 75000.50)

echo("First record created")
f.dump().echo()
echo("---")

/* Create second record */
echo("Creating second record...")
f.setfield("2", "name", "Bob")
f.setfield("2", "age", 25)
f.setfield("2", "city", "Los Angeles")
f.setfield("2", "salary", 65000.75)

echo("Second record created")
f.dump().echo()
echo("---")

/* Test getting field values */
echo("Testing get operations:")
echo("Record 1 - name:", f.getfield("1", "name"))
echo("Record 1 - age:", f.getfield("1", "age"))
echo("Record 1 - city:", f.getfield("1", "city"))
echo("Record 1 - salary:", f.getfield("1", "salary"))
echo("---")

echo("Record 2 - name:", f.getfield("2", "name"))
echo("Record 2 - age:", f.getfield("2", "age"))
echo("Record 2 - city:", f.getfield("2", "city"))
echo("Record 2 - salary:", f.getfield("2", "salary"))
echo("---")

/* Test unset field */
echo("Testing unset field:")
echo("Record 1 - unset field:", f.getfield("1", "nonexistent"))
echo("---")

/* Update a field */
echo("Updating record 1 age to 31...")
f.setfield("1", "age", 31)
echo("Record 1 - updated age:", f.getfield("1", "age"))
echo("---")

/* Final database state */
echo("Final database state:")
f.dump().echo()
echo("---")

/* List database contents */
echo("Database contents:")
f.ls()
echo("---")

echo("COL test completed") 