/* Test GrapaDBX specifically via unified storage */

/* Create a GrapaDBX database explicitly */
dbx = $unified();
result = dbx.create("grapadbx: /* testdbx"); */
"Create result: ".echo();
result.echo();

/* Create a field first */
field_result = dbx.mkfield("name", "STR", "VAR");
"Field creation result: ".echo();
field_result.echo();

/* Set a value */
set_result = dbx.set("test", "test_value", "name");
"Set result: ".echo();
set_result.echo();

/* Get the value */
result = dbx.get("test", "name");
"Get result: ".echo();
result.echo();

"Test complete".echo(); 