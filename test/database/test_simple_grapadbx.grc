/* Simple GrapaDBX test to isolate the issue */

/* Create a GrapaDBX database using the grapadbx: /* protocol */ */
dbx = $unified();

/* Debug: show the URL we're about to use */
url = "grapadbx: /* testdbx"; */
"URL: ".echo();
url.echo();
"URL length: ".echo();
url.len().echo();

/* Try a different approach - use grapadb: /* first to see if that works */ */
db1 = $unified();
grapadb_url = "grapadb: /* testdb1"; */
"GrapaDB URL: ".echo();
grapadb_url.echo();
"GrapaDB URL length: ".echo();
grapadb_url.len().echo();

result1 = db1.create(grapadb_url);
"GrapaDB storage type: ".echo();
db1.getType().echo();

/* Now try GrapaDBX */
result = dbx.create(url);

/* Check storage type */
storage_type = dbx.getType();
"Storage type: ".echo();
storage_type.echo();

/* Create a field first */
result = dbx.mk("$VALUE", "STR");
"mkfield result: ".echo();
result.echo();

/* Try to get a simple value */
result = dbx.get("test", "$VALUE");
"Simple get result: ".echo();
result.echo();

/* Try to set a value first */
result = dbx.set("test", "test_value", "$VALUE");
"set result: ".echo();
result.echo();

/* Try to get it again */
result = dbx.get("test", "$VALUE");
"After set, get result: ".echo();
result.echo();

"Test complete".echo(); 