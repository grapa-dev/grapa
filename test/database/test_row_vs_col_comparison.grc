/* Test comparing ROW vs COL table behavior */

"=== Comparing ROW vs COL Tables ===\n".echo();

/* Create ROW table */
"Creating ROW table...\n".echo();
frow = {}.table("ROW");
frow.mkfield("name", "STR", "VAR");
frow.mkfield("age", "INT", "FIX", 4);
frow.mkfield("city", "STR", "VAR");
"ROW table created\n".echo();

/* Create COL table */
"---\n".echo();
"Creating COL table...\n".echo();
fcol = {}.table("COL");
fcol.mkfield("name", "STR", "VAR");
fcol.mkfield("age", "INT", "FIX", 4);
fcol.mkfield("city", "STR", "VAR");
"COL table created\n".echo();

/* Define helper operators */
setFields = op(pData,rName,pName,pAge,pCity) {
        pData.setfield(rName, "name", pName);
        pData.setfield(rName, "age", pAge);
        pData.setfield(rName, "city", pCity);
};
getFields = op(pData,rName) {
        {"name":pData.getfield(rName, "name"),"age":pData.getfield(rName, "age"), "city":pData.getfield(rName, "city")};
};

/* Add same data to both tables */
"---\n".echo();
"Adding data to ROW table...\n".echo();
setFields(frow,"user1","Alice",30,"New York");
setFields(frow,"user2","Bob",25,"Los Angeles");

"Adding data to COL table...\n".echo();
setFields(fcol,"user1","Alice",30,"New York");
setFields(fcol,"user2","Bob",25,"Los Angeles");

"Data added to both tables\n".echo();

/* Debug output */
"---\n".echo();
"ROW table debug output:\n".echo();
frow.dump().echo();
"---\n".echo();
"COL table debug output:\n".echo();
fcol.dump().echo();

/* Test field operations */
"---\n".echo();
"Testing field operations...\n".echo();
"ROW table - Record 1: ".echo();
(getFields(frow,"user1").str() + "\n").echo();
"COL table - Record 1: ".echo();
(getFields(fcol,"user1").str() + "\n").echo();
"ROW table - Record 2: ".echo();
(getFields(frow,"user2").str() + "\n").echo();
"COL table - Record 2: ".echo();
(getFields(fcol,"user2").str() + "\n").echo();

"Test completed\n".echo(); 