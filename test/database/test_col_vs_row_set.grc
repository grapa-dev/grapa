/* Test comparing ROW vs COL set operations */

"=== Testing ROW vs COL set operations ===\n".echo();
"\n".echo();

/* Test ROW table first */
"Creating ROW table...\n".echo();
"\n".echo();
frow = $file().table("ROW");
frow.mkfield("name", "STR", "VAR");
"ROW table and field created\n".echo();
"\n".echo();

"Setting data in ROW table...\n".echo();
"\n".echo();
frow.set("1", "name", "Alice");
"ROW table data set successfully\n".echo();
"\n".echo();

"Getting data from ROW table...\n".echo();
"\n".echo();
frow.get("1", "name").echo();
"ROW table data retrieved successfully\n".echo();
"\n".echo();

"---\n".echo();
"\n".echo();

/* Test COL table */
"Creating COL table...\n".echo();
"\n".echo();
fcol = $file().table("COL");
fcol.mkfield("name", "STR", "VAR");
"COL table and field created\n".echo();
"\n".echo();

"About to set data in COL table...\n".echo();
"\n".echo();
"Setting data in COL table...\n".echo();
"\n".echo();
fcol.set("1", "name", "Alice");
"COL table data set successfully\n".echo();
"\n".echo();

"Getting data from COL table...\n".echo();
"\n".echo();
fcol.get("1", "name").echo();
"\n".echo();
"COL table data retrieved successfully\n".echo();
"\n".echo();

"Test completed\n".echo();
"\n".echo();
