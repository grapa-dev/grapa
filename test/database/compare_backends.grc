/* Test GrapaDB2 Backend */
"Testing GrapaDB2 Backend...\n".echo();
db2 = $unified();
db2_result = db2.create("grapadb2://test_db2");
"GrapaDB2 Create result: " + db2_result + "\n".echo();

"=== TEST COMPLETE ===\n".echo(); 