result.echo();
"\n".echo();

/* Test 6: Cross-Storage Operations
"Test 6: Cross-Storage Operations\n".echo();
"-------------------------------\n".echo();

/* Test moving data between storage types
"Testing data transfer between storage types...\n".echo();

/* Create local file system storage
local = $unified();
local.create("file: /* /tmp");

/* Create local test file
local.set("local_file.txt", "This is local content", "$VALUE");
"Created local file\n".echo();

/* Create network storage
remote = $unified();
remote.create("ftp: /* ftp.example.com");

/* Upload local file to remote
"Uploading local file to remote...\n".echo();
local_content = local.get("local_file.txt", "$VALUE");
remote.set("remote_file.txt", local_content, "$VALUE");
"Upload complete\n".echo();

/* Download from remote to local with different name
"Downloading from remote to local...\n".echo();
remote_content = remote.get("remote_file.txt", "$VALUE");
local.set("downloaded_file.txt", remote_content, "$VALUE");
"Download complete\n".echo();

/* Verify the content
"Verifying content...\n".echo();
original = local.get("local_file.txt", "$VALUE");
downloaded = local.get("downloaded_file.txt", "$VALUE");
"Original: ".echo();
original.echo();
"\n".echo();
"Downloaded: ".echo();
downloaded.echo();
"\n".echo();

/* Cleanup
"Cleanup: Removing test files...\n".echo();
local.rm("local_file.txt");
local.rm("downloaded_file.txt");
remote.rm("remote_file.txt");

"=== NETWORK STORAGE BACKEND TEST COMPLETE ===\n".echo(); 