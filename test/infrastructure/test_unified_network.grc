/* Test Network Storage Backend Integration

"=== NETWORK STORAGE BACKEND TEST ===\n".echo();

/* Test 1: HTTP/HTTPS Storage
"Test 1: HTTP/HTTPS Storage\n".echo();
"-------------------------\n".echo();

/* Create unified storage object with HTTP
u1 = $unified();
"Testing HTTP storage...\n".echo();
result = u1.create("http: /* example.com");
"Create result: ".echo();
result.echo();
"\n".echo();

/* Test getType
"Storage type: ".echo();
result = u1.getType();
result.echo();
"\n".echo();

/* Test getInfo
"Storage info: ".echo();
result = u1.getInfo();
result.echo();
"\n".echo();

/* Test ls (directory listing)
"Testing ls (directory listing)...\n".echo();
result = u1.ls();
"List result: ".echo();
result.echo();
"\n".echo();

/* Test ls with different output formats
"Testing ls with JSON output:\n".echo();
result = u1.ls().json();
"JSON result: ".echo();
result.echo();
"\n".echo();

"Testing ls with table output:\n".echo();
result = u1.ls().table();
"Table result: ".echo();
result.echo();
"\n".echo();

