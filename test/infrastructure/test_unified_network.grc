/* Test 5: Error Handling
"Test 5: Error Handling\n".echo();
"---------------------\n".echo();

/* Test invalid network URL
"Testing invalid network URL...\n".echo();
u5 = $unified();
result = u5.create("invalid: /* invalid-url");
"Create result: ".echo();
result.echo();
"\n".echo();

/* Test operations without connection
"Testing operations without connection...\n".echo();
result = u5.ls();
