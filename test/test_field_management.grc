/* Test Field Definition Management - Add, Delete, Modify Fields */

"=== Testing Field Definition Management ===\n".echo();
"Demonstrating field operations with index dependency handling\n".echo();

/* Cleanup */
"Cleanup: Removing any existing test files...\n".echo();
f = $file();
f.rm("test_field_management");
"Cleanup completed.\n".echo();

/* ================================================================================ */
/* Test Setup: Create Database with Initial Fields */
/* ================================================================================ */
"Test Setup: Creating Database with Initial Fields\n".echo();
"------------------------------------------------\n".echo();

group_db = $file().table("GROUP");
"✓ GROUP database created\n".echo();

"Creating initial fields:\n".echo();
group_db.mkfield("name", "STR", "VAR");
group_db.mkfield("age", "INT", "FIX", 4);
group_db.mkfield("city", "STR", "VAR");
"✓ Initial fields created\n".echo();

"Adding some test data:\n".echo();
group_db.set("user1", "User data 1", "$VALUE");
group_db.set("user1", "John Doe", "name");
group_db.set("user1", 35, "age");
group_db.set("user1", "New York", "city");

group_db.set("user2", "User data 2", "$VALUE");
group_db.set("user2", "Jane Smith", "name");
group_db.set("user2", 28, "age");
group_db.set("user2", "Los Angeles", "city");
"✓ Test data added\n".echo();

/* ================================================================================ */
/* Test 1: Add New Fields */
/* ================================================================================ */
"Test 1: Add New Fields\n".echo();
"---------------------\n".echo();

"Adding new fields to existing table:\n".echo();
group_db.mkfield("department", "STR", "VAR");
group_db.mkfield("salary", "INT", "FIX", 4);
group_db.mkfield("hire_date", "STR", "VAR");
"✓ New fields added\n".echo();

"Setting data in new fields:\n".echo();
group_db.set("user1", "Engineering", "department");
group_db.set("user1", 75000, "salary");
group_db.set("user1", "2020-01-15", "hire_date");

group_db.set("user2", "Marketing", "department");
group_db.set("user2", 65000, "salary");
group_db.set("user2", "2021-03-20", "hire_date");
"✓ Data set in new fields\n".echo();

"Verifying all fields work:\n".echo();
user1_name = group_db.get("user1", "name");
user1_dept = group_db.get("user1", "department");
user1_salary = group_db.get("user1", "salary").raw().int();
("user1 - name: " + user1_name.str() + ", dept: " + user1_dept.str() + ", salary: " + user1_salary.str() + "\n").echo();

user2_name = group_db.get("user2", "name");
user2_dept = group_db.get("user2", "department");
user2_salary = group_db.get("user2", "salary").raw().int();
("user2 - name: " + user2_name.str() + ", dept: " + user2_dept.str() + ", salary: " + user2_salary.str() + "\n").echo();

/* ================================================================================ */
/* Test 2: Field Modification (Conceptual) */
/* ================================================================================ */
"Test 2: Field Modification (Conceptual)\n".echo();
"---------------------------------------\n".echo();

"Understanding field modification process:\n".echo();
"1. Type validation - ensure new type is compatible\n".echo();
"2. Storage migration - convert data to new storage format\n".echo();
"3. Index updates - rebuild affected indexes\n".echo();
"4. Data consistency - maintain referential integrity\n".echo();

"Note: Field modification requires careful handling of:\n".echo();
"- Data type conversions\n".echo();
"- Storage format changes\n".echo();
"- Index rebuilds\n".echo();
"- Transaction safety\n".echo();

/* ================================================================================ */
/* Test 3: Index Dependency Management */
/* ================================================================================ */
"Test 3: Index Dependency Management\n".echo();
"-----------------------------------\n".echo();

"Understanding index dependency constraints:\n".echo();
"Critical Constraint: Fields cannot be deleted if they are used in any indexes\n".echo();

"Index validation process:\n".echo();
"1. Scan all indexes to check field usage\n".echo();
"2. Return error if field is referenced by any index\n".echo();
"3. User must drop dependent indexes before field deletion\n".echo();

"Implementation details:\n".echo();
"```cpp\n".echo();
"// Check all indexes for field usage before deletion\n".echo();
"while (!err) {\n".echo();
"    if (indexFieldCursor.mValue == pFieldId)\n".echo();
"        return(-1);  // Field used in index - cannot delete\n".echo();
"    err = Next(indexFieldCursor);\n".echo();
"}\n".echo();
"```\n".echo();

/* ================================================================================ */
/* Test 4: Data Propagation During Field Changes */
/* ================================================================================ */
"Test 4: Data Propagation During Field Changes\n".echo();
"---------------------------------------------\n".echo();

"Understanding data propagation during field operations:\n".echo();

"Field Deletion Process:\n".echo();
"1. Index validation - check if field is used in any indexes\n".echo();
"2. Dictionary update - remove field from table dictionary\n".echo();
"3. Offset adjustment - update all remaining field offsets\n".echo();
"4. Data migration - propagate changes through all records\n".echo();

"Data Migration by Table Type:\n".echo();
"- ROW Tables: Bit-shift all record data to remove deleted field\n".echo();
"- COL Tables: Delete field's column tree/storage\n".echo();
"- GROUP Tables: Handle nested field structures\n".echo();

"ROW Table Field Management:\n".echo();
"```cpp\n".echo();
"// Bit-shift all records to remove deleted field\n".echo();
"err = CopyDataValue(tableCursor.mValue, toOffset, tableCursor.mValue, fromOffset, moveSize, &bytesWriten);\n".echo();
"```\n".echo();

"COL Table Field Management:\n".echo();
"```cpp\n".echo();
"// Delete field's column storage based on type and storage method\n".echo();
"switch (fieldStore) {\n".echo();
"    case STORE_VAR:\n".echo();
"    case STORE_PAR:\n".echo();
"        tableCursor.Set(storeTree, TREE_ITEM, pFieldId);\n".echo();
"        err = Delete(tableCursor);\n".echo();
"        break;\n".echo();
"    case STORE_FIX:\n".echo();
"        tableCursor.Set(storeTree, SDATA_ITEM, pFieldId);\n".echo();
"        err = Delete(tableCursor);\n".echo();
"        break;\n".echo();
"}\n".echo();
"```\n".echo();

/* ================================================================================ */
/* Test 5: Transaction Safety */
/* ================================================================================ */
"Test 5: Transaction Safety\n".echo();
"--------------------------\n".echo();

"Understanding transaction safety in field operations:\n".echo();

"Safety Mechanisms:\n".echo();
"- Dirty Bit Management: Set tree dirty during field operations\n".echo();
"- Atomic Operations: Field changes are atomic across the table\n".echo();
"- Rollback Capability: Support for transaction rollback on failure\n".echo();
"- Consistency Guarantees: Maintain data integrity during field changes\n".echo();

"Implementation:\n".echo();
"```cpp\n".echo();
"// Set tree dirty during field operations\n".echo();
"indexCursor.Set(pTable.mRecRef);\n".echo();
"err = SetTreeDirty(indexCursor, true);\n".echo();
"\n".echo();
"// Perform field operations\n".echo();
"// ... field modification code ...\n".echo();
"\n".echo();
"// Clear dirty bit when complete\n".echo();
"indexCursor.Set(pTable.mRecRef);\n".echo();
"err = SetTreeDirty(indexCursor, false);\n".echo();
"```\n".echo();

/* ================================================================================ */
/* Test 6: Field Operations Summary */
/* ================================================================================ */
"Test 6: Field Operations Summary\n".echo();
"--------------------------------\n".echo();

"Current field operations available:\n".echo();
"1. Add Fields: group_db.mkfield(fieldName, type, storage, size, grow)\n".echo();
"2. Delete Fields: group_db.delfield(fieldName) - with index validation\n".echo();
"3. List Fields: group_db.lsfields() - get all fields in table\n".echo();
"4. Field Access: group_db.get(record, fieldName) - retrieve field data\n".echo();
"5. Field Update: group_db.set(record, value, fieldName) - update field data\n".echo();

"Field Types Supported:\n".echo();
"- STR: String data (variable or fixed length)\n".echo();
"- INT: Integer data (fixed length)\n".echo();
"- FLOAT: Floating point data (fixed length)\n".echo();
"- BOOL: Boolean data (fixed length)\n".echo();
"- TIME: Time/date data (fixed length)\n".echo();
"- RAW: Raw binary data (variable length)\n".echo();
"- TABLE: Nested table data (variable length)\n".echo();

"Storage Types:\n".echo();
"- FIX: Fixed-length storage\n".echo();
"- VAR: Variable-length storage\n".echo();
"- PAR: Partitioned storage\n".echo();

/* ================================================================================ */
/* Test 7: List All Records and Fields */
/* ================================================================================ */
"Test 7: List All Records and Fields\n".echo();
"-----------------------------------\n".echo();

all_records = group_db.ls();
("Total records in database: " + all_records.len().str() + "\n").echo();

"Record list (showing $KEY and $VALUE fields):\n".echo();
all_records.echo();

"Demonstrating field access across all records:\n".echo();
for (i = 0; i < all_records.len(); i++) {
    record_name = all_records.get(i);
    name_value = group_db.get(record_name, "name");
    age_value = group_db.get(record_name, "age").raw().int();
    dept_value = group_db.get(record_name, "department");
    ("Record " + i.str() + " (" + record_name.str() + ") - name: " + name_value.str() + ", age: " + age_value.str() + ", dept: " + dept_value.str() + "\n").echo();
}

