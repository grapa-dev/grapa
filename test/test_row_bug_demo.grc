/* ROW Table Index Corruption Bug Demo (Updated August 2025) */
/* This script demonstrates the previous bug where the first record became unreadable after adding the third record in a ROW table. */
/* As of August 2025, the bug has been FIXED. See maintainers/RESEARCH_AND_ANALYSIS/ROW_TABLE_INDEX_BUG_DEBUG_CONTEXT.md for investigation details. */

"=== ROW TABLE INDEX CORRUPTION BUG DEMO ===".echo();
"\n".echo();

/* Create ROW table */
"Creating ROW table...\n".echo();
frow = $file().table("ROW");
frow.mkfield("name", "STR", "VAR");
frow.mkfield("age", "INT", "FIX", 4);
frow.mkfield("city", "STR", "VAR");

"ROW table created\n".echo();
"---\n".echo();

/* Add first record */
"Adding first record (user1)...\n".echo();
frow.set("user1", "Alice", "name");
frow.set("user1", 25, "age");
frow.set("user1", "New York", "city");

"First record added".echo();
"---\n".echo();

/* Test first record - should work */
"Testing first record retrieval (should work)...\n".echo();
name1 = frow.get("user1", "name").str();
age1 = frow.get("user1", "age").raw().int();
city1 = frow.get("user1", "city").str();

"user1.name: ".echo();
name1.echo();
"\n".echo();
"user1.age: ".echo();
age1.echo();
"\n".echo();
"user1.city: ".echo();
city1.echo();
"\n".echo();
"---".echo();

/* Add second record */
"Adding second record (user2)...\n".echo();
frow.set("user2", "Bob", "name");
frow.set("user2", 30, "age");
frow.set("user2", "Los Angeles", "city");

"Second record added\n".echo();
"---\n".echo();

/* Test both records - should work */
"Testing both records (should work)...\n".echo();
name1_again = frow.get("user1", "name");
name2 = frow.get("user2", "name");

"user1.name (after user2): ".echo();
name1_again.echo();
"\n".echo();
"user2.name: ".echo();
name2.echo();
"\n".echo();
"---\n".echo();

/* Add third record - THIS IS WHERE THE BUG OCCURS */
"Adding third record (user3)...\n".echo();
frow.set("user3", "Charlie", "name");
frow.set("user3", 35, "age");
frow.set("user3", "Chicago", "city");

"Third record added\n".echo();
"---\n".echo();

/* Test all records - first record should now fail */
"Testing all records (first record should now fail)...\n".echo();
name1_bug = frow.get("user1", "name");
name2_bug = frow.get("user2", "name");
name3_bug = frow.get("user3", "name");

"user1.name (after user3 - BUG): ".echo();
name1_bug.echo();
"\n".echo();
"user2.name (after user3): ".echo();
name2_bug.echo();
"\n".echo();
"user3.name (after user3): ".echo();
name3_bug.echo();
"\n".echo();
"---\n".echo();

/* Show debug output to see the corruption */
"ROW table debug output (showing corruption):\n".echo();
frow.debug();
"\n".echo();
"---\n".echo();

/* Compare with COL table that works correctly */
"Creating COL table for comparison...\n".echo();
fcol = $file().table("COL");
fcol.mkfield("name", "STR", "VAR");
fcol.mkfield("age", "INT", "FIX", 4);
fcol.mkfield("city", "STR", "VAR");

/* Add same 3 records to COL table */
fcol.set("user1", "Alice", "name");
fcol.set("user1", 25, "age");
fcol.set("user1", "New York", "city");

fcol.set("user2", "Bob", "name");
fcol.set("user2", 30, "age");
fcol.set("user2", "Los Angeles", "city");

fcol.set("user3", "Charlie", "name");
fcol.set("user3", 35, "age");
fcol.set("user3", "Chicago", "city");

/* Test COL table - should work correctly */
"Testing COL table (should work correctly)...\n".echo();
col_name1 = fcol.get("user1", "name");
col_name2 = fcol.get("user2", "name");
col_name3 = fcol.get("user3", "name");

"COL user1.name: ".echo();
col_name1.echo();
"\n".echo();
"COL user2.name: ".echo();
col_name2.echo();
"\n".echo();
"COL user3.name: ".echo();
col_name3.echo();
"\n".echo();
"---\n".echo();

/* Summary */
"=== BUG DEMONSTRATION SUMMARY ===\n".echo();
"ROW table: All records remain readable (BUG FIXED as of August 2025)\n".echo();
"COL table: All records remain readable (correct behavior)\n".echo();
"Status: Both ROW and COL tables now work correctly\n".echo();
"See maintainers/RESEARCH_AND_ANALYSIS/ROW_TABLE_INDEX_BUG_DEBUG_CONTEXT.md for full investigation and status.\n".echo();
"---\n".echo();

"Demo completed\n".echo(); 
