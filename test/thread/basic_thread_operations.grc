/* Basic Thread Operations Test
   Tests core thread lifecycle methods: start, stop, started, suspend, resume, suspended */

/* Thread-safe variable declarations */
$global counter = 0;
$global lock = $thread();
$global workers = [];

"=== Basic Thread Operations Test ===".echo();

/* Test 1: Basic thread creation and start */
"Test 1: Basic thread creation and start\n".echo();
thread1 = $thread();
result = thread1.started();
("Thread started before start: " + result + "\n").echo();

/* Start thread with simple work */
thread1.start(
    op() {
        "Thread 1: Starting work\n".echo();
        $sys().sleep(100);  /* Sleep for 100ms */
        "Thread 1: Work completed\n".echo();
        return "Thread 1 result";
    },
    null,  /* No parameters */
    op(input, result) {
        ("Thread 1 completion callback: " + result + "\n").echo();
    }
);

/* Check if thread started */
result = thread1.started();
("Thread started after start: " + result + "\n").echo();

/* Wait a bit for thread to complete */
$sys().sleep(200);

/* Test 2: Thread suspension and resumption */
"Test 2: Thread suspension and resumption\n".echo();
thread2 = $thread();

/* Start thread that will be suspended */
thread2.start(
    op() {
        "Thread 2: Starting work\n".echo();
        $sys().sleep(50);
        "Thread 2: About to be suspended\n".echo();
        thread2.suspend();  /* Suspend self */
        "Thread 2: Resumed from suspension\n".echo();
        $sys().sleep(50);
        "Thread 2: Work completed\n".echo();
        return "Thread 2 result";
    },
    null,
    op(input, result) {
        ("Thread 2 completion callback: " + result + "\n").echo();
    }
);

/* Wait a bit then check suspension state */
$sys().sleep(100);
suspended = thread2.suspended();
("Thread 2 suspended state: " + suspended + "\n").echo();

/* Resume the suspended thread */
"Resuming Thread 2\n".echo();
thread2.resume();

/* Wait for completion */
$sys().sleep(150);

/* Test 3: Thread stop functionality */
"Test 3: Thread stop functionality\n".echo();
thread3 = $thread();

/* Start a long-running thread */
thread3.start(
    op() {
        "Thread 3: Starting long work\n".echo();
        for (i = 0; i < 10; i = i + 1) {
            ("Thread 3: Working... " + i + "\n").echo();
            $sys().sleep(100);
        };
        "Thread 3: Work completed\n".echo();
        return "Thread 3 result";
    },
    null,
    op(input, result) {
        ("Thread 3 completion callback: " + result + "\n").echo();
    }
);

/* Let it run for a bit then stop it */
$sys().sleep(300);
"Stopping Thread 3\n".echo();
thread3.stop();

/* Check if thread stopped */
result = thread3.started();
("Thread 3 started after stop: " + result + "\n").echo();

/* Test 4: Multiple threads with coordination */
"Test 4: Multiple threads with coordination\n".echo();

/* Create multiple worker threads */
for (i = 0; i < 3; i = i + 1) {
    worker = $thread();
    worker.start(
        op(worker_id) {
            ("Worker " + worker_id + ": Starting\n").echo();
            
            /* Acquire lock to increment counter */
            lock.lock();
            counter = counter + 1;
            current = counter;
            lock.unlock();
            
            ("Worker " + worker_id + ": Counter = " + current + "\n").echo();
            $sys().sleep(50);
            
            ("Worker " + worker_id + ": Completed\n").echo();
            return "Worker " + worker_id + " result";
        },
        i,  /* Pass worker ID as parameter */
        op(input, result) {
            ("Worker completion: " + result + "\n").echo();
        }
    );
    workers.push(worker);
};

/* Wait for all workers to complete */
$sys().sleep(200);

/* Check final counter value */
("Final counter value: " + counter + "\n").echo();

/* Test 5: Thread state inspection */
"Test 5: Thread state inspection\n".echo();
test_thread = $thread();

/* Check initial state */
started = test_thread.started();
suspended = test_thread.suspended();
("Initial state - Started: " + started + ", Suspended: " + suspended + "\n").echo();

/* Start thread */
test_thread.start(
    op() {
        "Test thread: Working\n".echo();
        $sys().sleep(100);
        return "Test result";
    },
    null,
    op(input, result) {
        ("Test thread completed: " + result + "\n").echo();
    }
);

/* Check running state */
started = test_thread.started();
("Running state - Started: " + started + "\n").echo();

/* Wait for completion */
$sys().sleep(150);

/* Check final state */
started = test_thread.started();
("Final state - Started: " + started + "\n").echo();

"=== Basic Thread Operations Test Complete ===\n".echo();
