/* Performance Stress Test
   Tests thread system performance and stability under load */

/* Thread-safe variable declarations */
$global thread_count = 0;
$global lock = $thread();
$global condition = $thread();
$global waiting_threads = 0;
$global active_threads = 0;
$global completed_threads = 0;
$global memory_usage = [];
$global performance_results = {};

"=== Performance Stress Test ===".echo();

/* Test 1: Rapid thread creation/destruction */
"Test 1: Rapid thread creation/destruction\n".echo();
start_time = $TIME();

for (i = 0; i < 50; i++) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            $sys().sleep(10);  /* Minimal work */
            return "Thread " + thread_id + " completed";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
};

$sys().sleep(200);
end_time = $TIME();
creation_time = end_time - start_time;
("Thread creation time: " + creation_time + "ms\n").echo();

/* Test 2: Concurrent lock contention */
"Test 2: Concurrent lock contention\n".echo();
contention_threads = [];

for (i = 0; i < 20; i++) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            for (j = 0; j < 10; j++) {
                lock.lock();
                thread_count++;
                current = thread_count;
                lock.unlock();
                $sys().sleep(5);
            };
            return "Contention thread " + thread_id + " done";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
    contention_threads.push(thread);
};

$sys().sleep(300);
("Final thread count: " + thread_count + "\n").echo();

/* Test 3: Condition variable stress */
"Test 3: Condition variable stress\n".echo();

/* Create waiting threads */
for (i = 0; i < 15; i++) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            lock.lock();
            waiting_threads++;
            lock.unlock();
            
            condition.wait();  /* Wait for signal */
            
            lock.lock();
            waiting_threads--;
            lock.unlock();
            
            return "Waiter " + thread_id + " done";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
};

$sys().sleep(100);

/* Signal all waiting threads */
for (i = 0; i < 15; i++) {
    condition.signal();
};

$sys().sleep(200);
("Final waiting threads: " + waiting_threads + "\n").echo();

/* Test 4: Coroutine suspend/resume stress */
"Test 4: Coroutine suspend/resume stress\n".echo();
coroutine_threads = [];

for (i = 0; i < 10; i++) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            for (j = 0; j < 5; j++) {
                thread.suspend();  /* Suspend self */
                $sys().sleep(10);
            };
            return "Coroutine " + thread_id + " done";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
    coroutine_threads.push(thread);
};

/* Resume all coroutines multiple times */
for (cycle = 0; cycle < 5; cycle++) {
    for (i = 0; i < coroutine_threads.len(); i++) {
        if (coroutine_threads[i].suspended()) {
            coroutine_threads[i].resume();
        };
    };
    $sys().sleep(50);
};

$sys().sleep(200);

/* Test 5: Memory usage and resource cleanup */
"Test 5: Memory usage and resource cleanup\n".echo();

/* Create many threads and let them complete */
for (batch = 0; batch < 5; batch++) {
    batch_threads = [];
    
    for (i = 0; i < 20; i++) {
        thread = $thread();
        thread.start(
            op(thread_id) {
                $sys().sleep(20);
                return "Batch " + batch + " thread " + thread_id + " done";
            },
            i,
            op(input, result) {
                /* Minimal callback */
            }
        );
        batch_threads.push(thread);
    };
    
    $sys().sleep(100);
    ("Batch " + batch + " completed\n").echo();
};

/* Test 6: Mixed workload stress */
"Test 6: Mixed workload stress\n".echo();

/* Create mixed workload threads */
mixed_threads = [];

/* CPU-intensive threads */
for (i = 0; i < 5; i++) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            sum = 0;
            for (j = 0; j < 1000; j++) {
                sum += j;
            };
            return "CPU thread " + thread_id + " sum: " + sum;
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
    mixed_threads.push(thread);
};

/* I/O simulation threads */
for (i = 0; i < 5; i++) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            for (j = 0; j < 3; j++) {
                $sys().sleep(50);  /* Simulate I/O */
            };
            return "I/O thread " + thread_id + " done";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
    mixed_threads.push(thread);
};

/* Synchronization-heavy threads */
for (i = 0; i < 5; i++) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            for (j = 0; j < 10; j++) {
                lock.lock();
                active_threads++;
                $sys().sleep(5);
                active_threads--;
                lock.unlock();
            };
            return "Sync thread " + thread_id + " done";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
    mixed_threads.push(thread);
};

$sys().sleep(400);
("Final active threads: " + active_threads + "\n").echo();

/* Test 7: Thread state inspection under load */
"Test 7: Thread state inspection under load\n".echo();

/* Create threads and inspect their states */
inspection_threads = [];

for (i = 0; i < 8; i++) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            thread.suspend();  /* Suspend immediately */
            return "Inspection thread " + thread_id + " done";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
    inspection_threads.push(thread);
};

$sys().sleep(50);

/* Inspect thread states */
suspended_count = 0;
for (i = 0; i < inspection_threads.len(); i++) {
    if (inspection_threads[i].suspended()) {
        suspended_count++;
    };
};

("Suspended threads: " + suspended_count + "/" + inspection_threads.len() + "\n").echo();

/* Resume all suspended threads */
for (i = 0; i < inspection_threads.len(); i++) {
    if (inspection_threads[i].suspended()) {
        inspection_threads[i].resume();
    };
};

$sys().sleep(100);

/* Performance benchmark summary */
"=== Performance Benchmark Summary ===\n".echo();
("Total threads created: " + (50 + 20 + 15 + 10 + 100 + 15) + "\n").echo();
("Thread creation rate: " + (50 / (creation_time / 1000)) + " threads/second\n").echo();
("Final thread count: " + thread_count + "\n").echo();
("Final waiting threads: " + waiting_threads + "\n").echo();
("Final active threads: " + active_threads + "\n").echo();

/* Stability verification */
"=== Stability Verification ===\n".echo();
"All tests completed without crashes\n".echo();
"Thread system appears stable under load\n".echo();
"Performance stress test complete!\n".echo();
