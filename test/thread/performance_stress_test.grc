/* Performance Stress Test
   Tests thread system performance and stability under load */

/* Thread-safe variable declarations */
$global thread_count = 0;
$global lock = $thread();
$global condition = $thread();
$global waiting_threads = 0;
$global active_threads = 0;
$global completed_threads = 0;
$global memory_usage = [];
$global performance_results = {};

"=== Performance Stress Test ===\n".echo();

/* Test 1: Rapid thread creation/destruction */
"Test 1: Rapid thread creation/destruction\n".echo();
start_time = $TIME();

for (i = 0; i < 50; i = i + 1) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            $sys().sleep(10);  /* Minimal work */
            return "Thread " + thread_id + " completed";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
};

$sys().sleep(200);
end_time = $TIME();
creation_time = end_time - start_time;
("Thread creation test completed in " + creation_time + "ms\n").echo();

/* Test 2: Concurrent lock contention */
"Test 2: Concurrent lock contention\n".echo();
contention_threads = [];

for (i = 0; i < 20; i = i + 1) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            for (j = 0; j < 10; j = j + 1) {
                lock.lock();
                $sys().sleep(5);  /* Hold lock briefly */
                lock.unlock();
            };
            return "Contention thread " + thread_id + " completed";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
    contention_threads.push(thread);
};

$sys().sleep(300);
("Lock contention test completed\n").echo();

/* Test 3: Condition variable stress */
"Test 3: Condition variable stress\n".echo();
condition_threads = [];

for (i = 0; i < 15; i = i + 1) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            for (j = 0; j < 5; j = j + 1) {
                condition.wait();
                $sys().sleep(10);
            };
            return "Condition thread " + thread_id + " completed";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
    condition_threads.push(thread);
};

/* Signal all waiting threads */
for (i = 0; i < 15; i = i + 1) {
    condition.signal();
};

$sys().sleep(200);
("Condition variable test completed\n").echo();

/* Test 4: Coroutine suspend/resume stress */
"Test 4: Coroutine suspend/resume stress\n".echo();
coroutine_threads = [];

for (i = 0; i < 15; i = i + 1) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            for (j = 0; j < 5; j = j + 1) {
                thread.suspend();
                $sys().sleep(10);
            };
            return "Coroutine thread " + thread_id + " completed";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
    coroutine_threads.push(thread);
};

/* Resume all suspended threads */
for (i = 0; i < coroutine_threads.len(); i = i + 1) {
    if (coroutine_threads[i].suspended()) {
        coroutine_threads[i].resume();
    };
};

$sys().sleep(200);
("Coroutine stress test completed\n").echo();

/* Test 5: Memory usage and resource cleanup */
"Test 5: Memory usage and resource cleanup\n".echo();

for (i = 0; i < 20; i = i + 1) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            /* Allocate some memory */
            data = [];
            for (j = 0; j < 100; j = j + 1) {
                data.push("data_" + j);
            };
            $sys().sleep(20);
            return "Memory thread " + thread_id + " completed";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
};

$sys().sleep(300);
("Memory usage test completed\n").echo();

/* Test 6: Mixed workload stress */
"Test 6: Mixed workload stress\n".echo();

for (i = 0; i < 5; i = i + 1) {
    /* Create threads with different workloads */
    thread1 = $thread();
    thread1.start(
        op(thread_id) {
            for (j = 0; j < 10; j = j + 1) {
                lock.lock();
                $sys().sleep(5);
                lock.unlock();
            };
            return "Mixed workload thread " + thread_id + " completed";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
    
    thread2 = $thread();
    thread2.start(
        op(thread_id) {
            for (j = 0; j < 5; j = j + 1) {
                thread2.suspend();
                $sys().sleep(10);
            };
            return "Mixed coroutine thread " + thread_id + " completed";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
    
    thread3 = $thread();
    thread3.start(
        op(thread_id) {
            for (j = 0; j < 8; j = j + 1) {
                condition.wait();
                $sys().sleep(15);
            };
            return "Mixed condition thread " + thread_id + " completed";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
};

/* Resume and signal all threads */
for (i = 0; i < 5; i = i + 1) {
    condition.signal();
};

$sys().sleep(400);
("Mixed workload test completed\n").echo();

/* Test 7: Thread state inspection under load */
"Test 7: Thread state inspection under load\n".echo();
inspection_threads = [];

for (i = 0; i < 8; i = i + 1) {
    thread = $thread();
    thread.start(
        op(thread_id) {
            thread.suspend();
            return "Inspection thread " + thread_id + " completed";
        },
        i,
        op(input, result) {
            /* Minimal callback */
        }
    );
    inspection_threads.push(thread);
};

/* Inspect thread states */
for (i = 0; i < inspection_threads.len(); i = i + 1) {
    started = inspection_threads[i].started();
    suspended = inspection_threads[i].suspended();
    /* Minimal inspection */
};

/* Resume all threads */
for (i = 0; i < inspection_threads.len(); i = i + 1) {
    if (inspection_threads[i].suspended()) {
        inspection_threads[i].resume();
    };
};

$sys().sleep(200);
("Thread state inspection test completed\n").echo();

/* Performance Summary */
"=== Performance Test Summary ===\n".echo();
("Total threads created: " + thread_count + "\n").echo();
("All stress tests completed successfully\n").echo();
("Thread system stability verified\n").echo();

"=== Performance Stress Test Complete ===\n".echo();
