"Test 8: Real-World Examples\n".echo();
"---------------------------\n".echo();

"E-commerce Application:\n".echo();
"```grapa\n".echo();
" /* Index on product availability\n".echo(); */
"availability_index = products.mkformulaindex(\"availability_index\", \n".echo();
"    \"lambda(record) { \n".echo();
"        stock = record.get('stock').raw().int(); \n".echo();
"        if (stock > 0) 'in_stock' \n".echo();
"        else if (stock == 0) 'out_of_stock' \n".echo();
"        else 'backordered' \n".echo();
"    }\");\n".echo();
"\n".echo();
" /* Index on price tier\n".echo(); */
"price_tier_index = products.mkformulaindex(\"price_tier_index\", \n".echo();
"    \"lambda(record) { \n".echo();
"        price = record.get('price').raw().float(); \n".echo();
"        if (price < 10) 'budget' \n".echo();
"        else if (price < 50) 'mid_range' \n".echo();
"        else 'premium' \n".echo();
"    }\");\n".echo();
"```\n".echo();

"Financial Application:\n".echo();
"```grapa\n".echo();
" /* Index on risk category\n".echo(); */
"risk_index = accounts.mkformulaindex(\"risk_index\", \n".echo();
"    \"lambda(record) { \n".echo();
"        balance = record.get('balance').raw().float(); \n".echo();
"        credit_score = record.get('credit_score').raw().int(); \n".echo();
"        calculateRiskScore(balance, credit_score) \n".echo();
"    }\");\n".echo();
"\n".echo();
" /* Index on account status\n".echo(); */
"status_index = accounts.mkformulaindex(\"status_index\", \n".echo();
"    \"lambda(record) { \n".echo();
"        last_activity = record.get('last_activity'); \n".echo();
"        days_inactive = daysSince(last_activity); \n".echo();
"        if (days_inactive > 90) 'dormant' \n".echo();
"        else if (days_inactive > 30) 'inactive' \n".echo();
"        else 'active' \n".echo();
"    }\");\n".echo();
"```\n".echo();

