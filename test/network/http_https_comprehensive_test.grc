/* HTTP/HTTPS Network Test - Using $net() API
   Demonstrates low-level HTTP/HTTPS connections with SSL certificates
   This complements https_test.grc which uses the curl function
*/

"Starting HTTP/HTTPS tests with $net() API...\n".echo();

/* Test 1: HTTP GET Request */
"Test 1: HTTP GET Request\n".echo();
clienta = $net();
err = clienta.connect('http://httpbin.org', null, null);
if(err.type() != $ERR) {
    "HTTP connection successful\n".echo();
    clienta.send('GET / HTTP/1.1\r\nHost: httpbin.org\r\nConnection: close\r\n\r\n');
    responsea = clienta.receive();
    while(clienta.pending()) {
        responsea += clienta.receive();
    };
    clienta.disconnect();
    ("HTTP GET completed, response length: " + responsea.len() + "\n").echo();
} else {
    ("HTTP connection failed: " + err + "\n").echo();
};

/* Test 2: HTTPS GET Request (no certificate) */
"Test 2: HTTPS GET Request (no certificaten\n".echo();
clienta = $net();
err = clienta.connect('https://httpbin.org/get', null, null);
if(err.type() != $ERR) {
    "HTTPS connection successful (no cert)\n".echo();
    clienta.send('GET / HTTP/1.1\r\nHost: httpbin.org\r\nConnection: close\r\n\r\n');
    responsea = clienta.receive();
    while(clienta.pending()) {
        responsea += clienta.receive();
    };
    clienta.disconnect();
    ("HTTPS GET completed, response length: " + responsea.len() + "\n").echo();
} else {
    ("HTTPS connection failed: " + err + "\n").echo();
};

/* Test 3: HTTPS GET Request (with certificate) */
"Test 3: HTTPS GET Request (with certificate)\n".echo();
clienta = $net();
err = clienta.connect('https://httpbin.org/get', "keys/client.crt", null);
if(err.type() != $ERR) {
    "HTTPS connection successful (with cert)\n".echo();
    clienta.send('GET / HTTP/1.1\r\nHost: httpbin.org\r\nConnection: close\r\n\r\n');
    responsea = clienta.receive();
    while(clienta.pending()) {
        responsea += clienta.receive();
    };
    clienta.disconnect();
    ("HTTPS with cert completed, response length: " + responsea.len() + "\n").echo();
} else {
    ("HTTPS with certificate failed: " + err + "\n").echo();
};

/* Test 4: HTTP POST Request */
"Test 4: HTTP POST Request\n".echo();
clienta = $net();
err = clienta.connect('http://httpbin.org/post', null, null);
if(err.type() != $ERR) {
    "HTTP POST connection successful\n".echo();
    postData = '{"test": "data", "message": "Hello from Grapa"}';
    postHeaders = 'POST /post HTTP/1.1\r\nHost: httpbin.org\r\nContent-Type: application/json\r\nContent-Length: ' + postData.len() + '\r\nConnection: close\r\n\r\n';
    clienta.send(postHeaders + postData);
    responsea = clienta.receive();
    while(clienta.pending()) {
        responsea += clienta.receive();
    };
    clienta.disconnect();
    ("HTTP POST completed, response length: " + responsea.len() + "\n").echo();
} else {
    ("HTTP POST connection failed: " + err + "\n").echo();
};

/* Test 5: HTTPS POST Request */
"Test 5: HTTPS POST Request\n".echo();
clienta = $net();
err = clienta.connect('https://httpbin.org/post', null, null);
if(err.type() != $ERR) {
    "HTTPS POST connection successful\n".echo();
    postData = '{"test": "data", "message": "Hello from Grapa HTTPS"}';
    postHeaders = 'POST /post HTTP/1.1\r\nHost: httpbin.org\r\nContent-Type: application/json\r\nContent-Length: ' + postData.len() + '\r\nConnection: close\r\n\r\n';
    clienta.send(postHeaders + postData);
    responsea = clienta.receive();
    while(clienta.pending()) {
        responsea += clienta.receive();
    };
    clienta.disconnect();
    ("HTTPS POST completed, response length: " + responsea.len() + "\n").echo();
} else {
    ("HTTPS POST connection failed: " + err + "\n").echo();
};

"All HTTP/HTTPS tests completed.\n".echo();

/* Key Features Demonstrated:
   - Low-level $net() API for HTTP/HTTPS connections
   - SSL certificate handling with client certificates
   - Manual HTTP request construction and parsing
   - Connection management (connect, send, receive, disconnect)
   - Error handling for network operations
   - Support for both HTTP and HTTPS protocols
   - Default port handling (80 for HTTP, 443 for HTTPS)
*/
