/* HTTP/HTTPS Comprehensive Network Test
   Tests both HTTP and HTTPS connections with GET and POST methods
   Includes certificate handling and error checking
*/

"===== HTTP/HTTPS COMPREHENSIVE NETWORK TEST =====\n".echo();

/* Test 1: HTTP GET Request */
"----- Test 1: HTTP GET Request -----\n".echo();
clienta = $net();
err = clienta.connect('http://httpbin.org/get', null, null);
if(err == 0) {
    "HTTP connection successful\n".echo();
    clienta.send('GET / HTTP/1.1\r\nHost: httpbin.org\r\nConnection: close\r\n\r\n');
    responsea = "";
    $sys().sleep(1000);
    while(clienta.pending()) {
        chunk = clienta.receive();
        if(chunk != null) responsea = responsea + chunk;
    }
    clienta.disconnect();
    "HTTP GET response received\n".echo();
    if(responsea.grep("HTTP/1.1 200", "x").len() > 0) {
        "HTTP GET: Status 200 OK\n".echo();
    } else {
        "HTTP GET: Unexpected status\n".echo();
    }
} else {
    "HTTP connection failed\n".echo();
}

/* Test 2: HTTPS GET Request (no certificate) */
"----- Test 2: HTTPS GET Request (no certificate) -----\n".echo();
clienta = $net();
err = clienta.connect('https://httpbin.org/get', null, null);
