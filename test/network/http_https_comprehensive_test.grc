    if(responsea.grep("HTTP/1.1 200", "x").len() > 0) {
        "HTTPS GET: Status 200 OK\n".echo();
    } else {
        "HTTPS GET: Unexpected status\n".echo();
    }
} else {
    "HTTPS connection failed\n".echo();
}

/* Test 4: HTTP POST Request */
"----- Test 4: HTTP POST Request -----\n".echo();
clienta = $net();
err = clienta.connect('http://httpbin.org/post', null, null);
if(err == 0) {
    "HTTP connection successful\n".echo();
    postData = '{"test": "data", "message": "Hello from Grapa"}';
    postHeaders = 'POST /post HTTP/1.1\r\nHost: httpbin.org\r\nContent-Type: application/json\r\nContent-Length: 47\r\nConnection: close\r\n\r\n';
    clienta.send(postHeaders + postData);
    responsea = "";
    $sys().sleep(1000);
    while(clienta.pending()) {
        chunk = clienta.receive();
        if(chunk != null) responsea = responsea + chunk;
    }
    clienta.disconnect();
    "HTTP POST response received\n".echo();
    if(responsea.grep("HTTP/1.1 200", "x").len() > 0) {
        "HTTP POST: Status 200 OK\n".echo();
    } else {
        "HTTP POST: Unexpected status\n".echo();
    }
} else {
    "HTTP connection failed\n".echo();
}

