/* HTTP/HTTPS Network Test - Following Grapa Syntax Rules */

"Starting HTTP/HTTPS tests...".echo();

/* Test 1: HTTP GET */
"Test 1: HTTP GET".echo();
clienta = $net();
err = clienta.connect('http://httpbin.org/get', null, null);
if(err == 0) {
    "HTTP connection successful".echo();
    clienta.send('GET / HTTP/1.1\r\nHost: httpbin.org\r\nConnection: close\r\n\r\n');
    responsea = "";
    $sys().sleep(1000);
    while(clienta.pending()) {
        chunk = clienta.receive();
        if(chunk != null) {
            responsea = responsea + chunk;
        };
    };
    clienta.disconnect();
    ("HTTP GET completed, response length: " + responsea.len()).echo();
} else {
    ("HTTP connection failed: " + err).echo();
};

/* Test 2: HTTPS GET */
"Test 2: HTTPS GET".echo();
clienta = $net();
err = clienta.connect('https://httpbin.org/get', null, null);
if(err == 0) {
    "HTTPS connection successful".echo();
    clienta.send('GET / HTTP/1.1\r\nHost: httpbin.org\r\nConnection: close\r\n\r\n');
    responsea = "";
    $sys().sleep(1000);
    while(clienta.pending()) {
        chunk = clienta.receive();
        if(chunk != null) {
            responsea = responsea + chunk;
        };
    };
    clienta.disconnect();
    ("HTTPS GET completed, response length: " + responsea.len()).echo();
} else {
    ("HTTPS connection failed: " + err).echo();
};

/* Test 3: HTTPS with Certificate */
"Test 3: HTTPS with Certificate".echo();
clienta = $net();
err = clienta.connect('https://httpbin.org/get', "keys/client.crt", null);
if(err == 0) {
    "HTTPS connection with certificate successful".echo();
    clienta.send('GET / HTTP/1.1\r\nHost: httpbin.org\r\nConnection: close\r\n\r\n');
    responsea = "";
    $sys().sleep(1000);
    while(clienta.pending()) {
        chunk = clienta.receive();
        if(chunk != null) {
            responsea = responsea + chunk;
        };
    };
    clienta.disconnect();
    ("HTTPS with cert completed, response length: " + responsea.len()).echo();
} else {
    ("HTTPS with certificate failed: " + err).echo();
};

/* Test 4: HTTP POST */
"Test 4: HTTP POST".echo();
clienta = $net();
err = clienta.connect('http://httpbin.org/post', null, null);
if(err == 0) {
    "HTTP POST connection successful".echo();
    postData = '{"test": "data", "message": "Hello from Grapa"}';
    postHeaders = 'POST /post HTTP/1.1\r\nHost: httpbin.org\r\nContent-Type: application/json\r\nContent-Length: ' + postData.len() + '\r\nConnection: close\r\n\r\n';
    clienta.send(postHeaders + postData);
    responsea = "";
    $sys().sleep(1000);
    while(clienta.pending()) {
        chunk = clienta.receive();
        if(chunk != null) {
            responsea = responsea + chunk;
        };
    };
    clienta.disconnect();
    ("HTTP POST completed, response length: " + responsea.len()).echo();
} else {
    ("HTTP POST connection failed: " + err).echo();
};

/* Test 5: HTTPS POST */
"Test 5: HTTPS POST".echo();
clienta = $net();
err = clienta.connect('https://httpbin.org/post', null, null);
if(err == 0) {
    "HTTPS POST connection successful".echo();
    postData = '{"test": "data", "message": "Hello from Grapa HTTPS"}';
    postHeaders = 'POST /post HTTP/1.1\r\nHost: httpbin.org\r\nContent-Type: application/json\r\nContent-Length: ' + postData.len() + '\r\nConnection: close\r\n\r\n';
    clienta.send(postHeaders + postData);
    responsea = "";
    $sys().sleep(1000);
    while(clienta.pending()) {
        chunk = clienta.receive();
        if(chunk != null) {
            responsea = responsea + chunk;
        };
    };
    clienta.disconnect();
    ("HTTPS POST completed, response length: " + responsea.len()).echo();
} else {
    ("HTTPS POST connection failed: " + err).echo();
};

"All tests completed.".echo();
