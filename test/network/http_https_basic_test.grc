/* Basic HTTP/HTTPS Network Test */

"Starting HTTP/HTTPS tests...\n".echo();

/* Test 1: HTTP GET */
"Test 1: HTTP GET\n".echo();
clienta = $net();
err = clienta.connect('http://httpbin.org/get', null, null);
if(err == 0) {
    "HTTP connection successful\n".echo();
    clienta.send('GET / HTTP/1.1\r\nHost: httpbin.org\r\nConnection: close\r\n\r\n');
    responsea = "";
    $sys().sleep(1000);
    while(clienta.pending()) {
        chunk = clienta.receive();
        if(chunk != null) responsea = responsea + chunk;
    }
    clienta.disconnect();
    "HTTP GET completed\n".echo();
} else {
    "HTTP connection failed\n".echo();
}

/* Test 2: HTTPS GET */
"Test 2: HTTPS GET\n".echo();
clienta = $net();
err = clienta.connect('https://httpbin.org/get', null, null);
if(err == 0) {
    "HTTPS connection successful\n".echo();
    clienta.send('GET / HTTP/1.1\r\nHost: httpbin.org\r\nConnection: close\r\n\r\n');
    responsea = "";
    $sys().sleep(1000);
    while(clienta.pending()) {
        chunk = clienta.receive();
        if(chunk != null) responsea = responsea + chunk;
    }
    clienta.disconnect();
    "HTTPS GET completed\n".echo();
} else {
    "HTTPS connection failed\n".echo();
}

/* Test 3: HTTP POST */
"Test 3: HTTP POST\n".echo();
clienta = $net();
err = clienta.connect('http://httpbin.org/post', null, null);
if(err == 0) {
    "HTTP connection successful\n".echo();
    postData = '{"test": "data"}';
    postHeaders = 'POST /post HTTP/1.1\r\nHost: httpbin.org\r\nContent-Type: application/json\r\nContent-Length: 17\r\nConnection: close\r\n\r\n';
    clienta.send(postHeaders + postData);
    responsea = "";
    $sys().sleep(1000);
    while(clienta.pending()) {
        chunk = clienta.receive();
        if(chunk != null) responsea = responsea + chunk;
    }
    clienta.disconnect();
    "HTTP POST completed\n".echo();
} else {
    "HTTP connection failed\n".echo();
}

/* Test 4: HTTPS POST */
"Test 4: HTTPS POST\n".echo();
clienta = $net();
err = clienta.connect('https://httpbin.org/post', null, null);
if(err == 0) {
    "HTTPS connection successful\n".echo();
    postData = '{"test": "data"}';
    postHeaders = 'POST /post HTTP/1.1\r\nHost: httpbin.org\r\nContent-Type: application/json\r\nContent-Length: 17\r\nConnection: close\r\n\r\n';
    clienta.send(postHeaders + postData);
    responsea = "";
    $sys().sleep(1000);
    while(clienta.pending()) {
        chunk = clienta.receive();
        if(chunk != null) responsea = responsea + chunk;
    }
    clienta.disconnect();
    "HTTPS POST completed\n".echo();
} else {
    "HTTPS connection failed\n".echo();
}

"All tests completed.\n".echo();
