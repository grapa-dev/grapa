/* Large Scale Metadata Similarity Performance Test */
/* Tests performance of metadata similarity search at larger scales */

("=== Large Scale Metadata Similarity Performance Test ===\n").echo();

/* Test larger sizes incrementally */
test_sizes = [15000, 20000, 25000, 50000, 100000];
pinecone_threshold = 100;  /* Pinecone typically < 100ms */
acceptable_threshold = 500;  /* Acceptable for local use */
warning_threshold = 2000;   /* Warning threshold */

("Testing metadata similarity search at larger scales...\n").echo();
("Pinecone threshold: < " + pinecone_threshold.str() + "ms\n").echo();
("Acceptable threshold: < " + acceptable_threshold.str() + "ms\n").echo();
("\n").echo();

/* Results storage */
results = [];

for test_size in test_sizes {
    ("--- Testing " + test_size.str() + " records ---\n").echo();
    
    /* Test 1: Pure metadata similarity */
    ("  Test 1: Pure metadata similarity...\n").echo();
    start_time = $TIME().utc();
    
    /* Create metadata objects with various fields */
    metadata_objects = [];
    for i in test_size.range() {
        /* Create diverse metadata objects */
        category = ["tech", "science", "business", "health", "education"][i % 5];
        type = ["article", "blog", "paper", "tutorial", "review"][i % 5];
        author = ["Alice", "Bob", "Charlie", "Diana", "Eve"][i % 5];
        status = ["published", "draft", "archived"][i % 3];
        priority = ["high", "medium", "low"][i % 3];
        
        metadata_obj = {
            "id": "doc_" + i.str(),
            "category": category,
            "type": type,
            "author": author,
            "status": status,
            "priority": priority,
            "views": (i * 10),
            "rating": (i % 5) + 1,
            "tags": ["tag" + (i % 10).str(), "category_" + category]
        };
        metadata_objects += metadata_obj;
    };
    
    create_metadata_time = start_time.ms();

    /* Query object with subset of fields */
    query_metadata = {
        "category": "tech",
        "type": "article",
        "author": "Alice",
        "status": "published"
    };
    
    metadata_results = metadata_objects.similarity(query_metadata, "object", {
        "top_n": 10,
        "include_scores": true,
        "include_items": true
    });
    
    pure_metadata_time = start_time.ms() - create_metadata_time;
    ("    Metadata create: " + create_metadata_time.float(30).str() + "ms\n").echo();
    ("    Metadata search: " + pure_metadata_time.float(30).str() + "ms\n").echo();
    ("    Results: " + metadata_results."results".len().str() + "\n").echo();
    
    /* Performance analysis */
    if (pure_metadata_time < pinecone_threshold) {
        ("    ✅ EXCELLENT (< " + pinecone_threshold.str() + "ms)\n").echo();
    } else if (pure_metadata_time < acceptable_threshold) {
        ("    ✅ GOOD (< " + acceptable_threshold.str() + "ms)\n").echo();
    } else if (pure_metadata_time < warning_threshold) {
        ("    ⚠️  ACCEPTABLE (< " + warning_threshold.str() + "ms)\n").echo();
    } else {
        ("    ❌ SLOW (> " + warning_threshold.str() + "ms)\n").echo();
    };
    
    /* Store result */
    result = {
        "size": test_size,
        "pure_metadata_time": pure_metadata_time
    };
    results += result;
    
    ("\n").echo();
};

/* Summary Report */
("=== PERFORMANCE SUMMARY ===\n").echo();
("Size\tMetadata Search\tRecommendation\n").echo();
("----\t---------------\t---------------\n").echo();

for result in results {
    size = result."size";
    metadata_time = result."pure_metadata_time";
    
    /* Determine recommendation */
    if (metadata_time < pinecone_threshold) {
        recommendation = "✅ EXCELLENT - Competitive with Pinecone";
    } else if (metadata_time < acceptable_threshold) {
        recommendation = "✅ GOOD - Suitable for local use";
    } else if (metadata_time < warning_threshold) {
        recommendation = "⚠️  ACCEPTABLE - Consider Pinecone";
    } else {
        recommendation = "❌ SLOW - Use Pinecone";
    };
    
    (size.str() + "\t" + metadata_time.str() + "ms\t" + recommendation + "\n").echo();
};

/* Scaling Analysis */
("\n=== SCALING ANALYSIS ===\n").echo();
if (results.len() >= 2) {
    first = results[0];
    last = results[results.len() - 1];
    
    size_ratio = last."size" / first."size";
    time_ratio = last."pure_metadata_time" / first."pure_metadata_time";
    
    ("Size increase: " + size_ratio.str() + "x\n").echo();
    ("Time increase: " + time_ratio.str() + "x\n").echo();
    
    if (time_ratio < size_ratio) {
        ("✅ Sub-linear scaling - Performance scales well\n").echo();
    } else if (time_ratio == size_ratio) {
        ("✅ Linear scaling - Expected performance\n").echo();
    } else {
        ("⚠️  Super-linear scaling - Performance degrades\n").echo();
    };
};

/* Performance Breakpoint Analysis */
("\n=== PERFORMANCE BREAKPOINT ANALYSIS ===\n").echo();
("Based on metadata similarity test results:\n").echo();

if (results.len() > 0) {
    max_time = 0;
    max_size = 0;
    excellent_count = 0;
    good_count = 0;
    acceptable_count = 0;
    slow_count = 0;
    
    for result in results {
        if (result."pure_metadata_time" > max_time) {
            max_time = result."pure_metadata_time";
            max_size = result."size";
        };
        
        if (result."pure_metadata_time" < pinecone_threshold) {
            excellent_count = excellent_count + 1;
        } else if (result."pure_metadata_time" < acceptable_threshold) {
            good_count = good_count + 1;
        } else if (result."pure_metadata_time" < warning_threshold) {
            acceptable_count = acceptable_count + 1;
        } else {
            slow_count = slow_count + 1;
        };
    };
    
    ("• Maximum search time: " + max_time.str() + "ms at " + max_size.str() + " records\n").echo();
    ("• Excellent performance: " + excellent_count.str() + " tests\n").echo();
    ("• Good performance: " + good_count.str() + " tests\n").echo();
    ("• Acceptable performance: " + acceptable_count.str() + " tests\n").echo();
    ("• Slow performance: " + slow_count.str() + " tests\n").echo();
    
    if (excellent_count > 0) {
        ("• ✅ Grapa metadata search is competitive with Pinecone at tested scales\n").echo();
    };
    
    if (good_count > 0) {
        ("• ✅ Grapa metadata search is suitable for local/offline applications\n").echo();
    };
    
    if (acceptable_count > 0) {
        ("• ⚠️  Consider Pinecone for production metadata workloads at larger scales\n").echo();
    };
    
    if (slow_count > 0) {
        ("• ❌ Use Pinecone for large-scale production metadata applications\n").echo();
    };
};

/* Updated Recommendations */
("\n=== UPDATED RECOMMENDATIONS ===\n").echo();
("Based on large-scale metadata similarity testing:\n").echo();
("\n").echo();
("Use Grapa for metadata search when:\n").echo();
("• Dataset size < 50,000 records (based on performance testing)\n").echo();
("• Local/offline applications\n").echo();
("• Cost-sensitive projects\n").echo();
("• Need for complex object similarity algorithms\n").echo();
("• Integration with existing Grapa applications\n").echo();
("• Metadata filtering and search requirements\n").echo();
("\n").echo();
("Use Pinecone for metadata search when:\n").echo();
("• Dataset size > 100,000 records\n").echo();
("• High-throughput production metadata workloads\n").echo();
("• Need for advanced metadata indexing and optimization\n").echo();
("• Multi-tenant SaaS applications with metadata\n").echo();
("• Global scale and availability requirements\n").echo();

("\n=== TEST COMPLETE ===\n").echo();
