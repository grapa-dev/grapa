/* Simple Performance Test for Vector Similarity */
/* Tests performance at different scales: 100, 500, 1000, 10000 records */

("=== Vector Similarity Performance Test ===\n").echo();

/* Test sizes */
test_sizes = [100, 500, 1000, 10000];
("Testing similarity search at scales: " + test_sizes.str() + "\n").echo();
("\n").echo();

/* Performance thresholds */
pinecone_threshold = 100;  /* Pinecone typically < 100ms */
acceptable_threshold = 500;  /* Acceptable for local use */
warning_threshold = 2000;   /* Warning threshold */

/* Results storage */
results = [];

for test_size in test_sizes {
    ("--- Testing " + test_size.str() + " records ---\n").echo();
    
    /* Generate test vectors */
    ("  Generating " + test_size.str() + " vectors...\n").echo();
    start_time = $TIME().utc();
    
    vectors = [];
    for i in test_size.range() {
        /* Create vectors with some variation for realistic similarity */
        vector = [];
        for j in 5.range() {
            base_value = 0.5 + (i % 10) / 100.0;
            vector.push(base_value);
        };
        vectors.push(vector);
    };
    
    generation_time = start_time.ms();
    ("  Generation time: " + generation_time.str() + "ms\n").echo();
    
    /* Test similarity search */
    ("  Testing similarity search...\n").echo();
    start_time = $TIME().utc();
    
    query_vector = [0.8, 0.7, 0.6, 0.5, 0.4];
    search_results = vectors.similarity(query_vector, "cosine", {
        "top_n": 10,
        "include_scores": true,
        "include_items": true
    });
    
    search_time = start_time.ms();
    ("  Search time: " + search_time.str() + "ms\n").echo();
    ("  Results found: " + search_results."results".len().str() + "\n").echo();
    
    /* Performance analysis */
    if (search_time < pinecone_threshold) {
        ("  ✅ EXCELLENT (< " + pinecone_threshold.str() + "ms)\n").echo();
    } else if (search_time < acceptable_threshold) {
        ("  ✅ GOOD (< " + acceptable_threshold.str() + "ms)\n").echo();
    } else if (search_time < warning_threshold) {
        ("  ⚠️  ACCEPTABLE (< " + warning_threshold.str() + "ms)\n").echo();
    } else {
        ("  ❌ SLOW (> " + warning_threshold.str() + "ms)\n").echo();
    };
    
    /* Store result */
    result = {
        "size": test_size,
        "generation_time": generation_time,
        "search_time": search_time,
        "results_count": search_results."results".len()
    };
    results.push(result);
    
    ("\n").echo();
};

/* Summary Report */
("=== PERFORMANCE SUMMARY ===\n").echo();
("Size\tGeneration\tSearch\tRecommendation\n").echo();
("----\t----------\t------\t---------------\n").echo();

for result in results {
    size = result."size";
    gen_time = result."generation_time";
    search_time = result."search_time";
    
    /* Determine recommendation */
    if (search_time < pinecone_threshold) {
        recommendation = "✅ EXCELLENT - Competitive with Pinecone";
    } else if (search_time < acceptable_threshold) {
        recommendation = "✅ GOOD - Suitable for local use";
    } else if (search_time < warning_threshold) {
        recommendation = "⚠️  ACCEPTABLE - Consider Pinecone";
    } else {
        recommendation = "❌ SLOW - Use Pinecone";
    };
    
    (size.str() + "\t" + gen_time.str() + "ms\t" + search_time.str() + "ms\t" + recommendation + "\n").echo();
};

/* Scaling Analysis */
("\n=== SCALING ANALYSIS ===\n").echo();
if (results.len() >= 2) {
    first = results[0];
    last = results[results.len() - 1];
    
    size_ratio = last."size" / first."size";
    time_ratio = last."search_time" / first."search_time";
    
    ("Size increase: " + size_ratio.str() + "x\n").echo();
    ("Time increase: " + time_ratio.str() + "x\n").echo();
    
    if (time_ratio < size_ratio) {
        ("✅ Sub-linear scaling - Performance scales well\n").echo();
    } else if (time_ratio == size_ratio) {
        ("✅ Linear scaling - Expected performance\n").echo();
    } else {
        ("⚠️  Super-linear scaling - Performance degrades\n").echo();
    };
};

/* Recommendations */
("\n=== RECOMMENDATIONS ===\n").echo();

excellent_count = 0;
good_count = 0;
acceptable_count = 0;
slow_count = 0;

for result in results {
    search_time = result."search_time";
    if (search_time < pinecone_threshold) {
        excellent_count = excellent_count + 1;
    } else if (search_time < acceptable_threshold) {
        good_count = good_count + 1;
    } else if (search_time < warning_threshold) {
        acceptable_count = acceptable_count + 1;
    } else {
        slow_count = slow_count + 1;
    };
};

if (excellent_count > 0) {
    ("✅ Grapa is competitive with Pinecone for small to medium datasets\n").echo();
};

if (good_count > 0) {
    ("✅ Grapa is suitable for local/offline applications\n").echo();
};

if (acceptable_count > 0) {
    ("⚠️  Consider Pinecone for production workloads at larger scales\n").echo();
};

if (slow_count > 0) {
    ("❌ Use Pinecone for large-scale production applications\n").echo();
};

("\n=== TEST COMPLETE ===\n").echo();
