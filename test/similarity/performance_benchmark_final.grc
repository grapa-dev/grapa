/* Final Performance Benchmark Test */
/* Tests Grapa similarity performance vs Pinecone thresholds */

("=== Grapa Vector Similarity Performance Benchmark ===\n").echo();

/* Test configuration */
test_sizes = [100, 500, 1000, 5000];
pinecone_threshold = 100;  /* Pinecone typically < 100ms */
acceptable_threshold = 500;  /* Acceptable for local use */

("Testing similarity search performance at different scales...\n").echo();
("Pinecone threshold: < " + pinecone_threshold.str() + "ms\n").echo();
("Acceptable threshold: < " + acceptable_threshold.str() + "ms\n").echo();
("\n").echo();

/* Results storage */
results = [];

for test_size in test_sizes {
    ("--- Testing " + test_size.str() + " records ---\n").echo();
    
    /* Test 1: Pure vector similarity (no database) */
    ("  Test 1: Pure vector similarity...\n").echo();
    start_time = $TIME().utc();
    
    vectors = [];
    for i in test_size.range() {
        vector = [0.8, 0.6, 0.4, 0.2, 0.1];
        vectors.push(vector);
    };
    
    vector_results = vectors.similarity([0.8, 0.6, 0.4, 0.2, 0.1], "cosine", {
        "top_n": 10,
        "include_scores": true,
        "include_items": true
    });
    
    pure_vector_time = start_time.ms();
    ("    Pure vector search: " + pure_vector_time.str() + "ms\n").echo();
    ("    Results: " + vector_results."results".len().str() + "\n").echo();
    
    /* Test 2: Database + vector similarity */
    ("  Test 2: Database + vector similarity...\n").echo();
    start_time = $TIME().utc();
    
    /* Create database */
    vector_db = {}.table();
    for i in test_size.range() {
        doc_id = "doc_" + i.str();
        vector_db.setfield(doc_id, {
            "id": doc_id,
            "category": "category_" + (i % 5).str(),
            "vector": [0.8, 0.6, 0.4, 0.2, 0.1]
        });
    };
    
    /* Extract vectors from database */
    all_records = vector_db.ls();
    db_vectors = [];
    for i in all_records.range() {
        record = all_records[i];
        record_id = record["$ID"];
        vector = vector_db.getfield(record_id, "vector");
        db_vectors.push(vector);
    };
    
    /* Perform similarity search */
    db_results = db_vectors.similarity([0.8, 0.6, 0.4, 0.2, 0.1], "cosine", {
        "top_n": 10,
        "include_scores": true,
        "include_items": true
    });
    
    db_vector_time = start_time.ms();
    ("    Database + vector search: " + db_vector_time.str() + "ms\n").echo();
    ("    Results: " + db_results."results".len().str() + "\n").echo();
    
    /* Test 3: Metadata filtering + vector similarity */
    ("  Test 3: Metadata filtering + vector similarity...\n").echo();
    start_time = $TIME().utc();
    
    /* Filter by metadata first */
    filtered_vectors = [];
    for i in all_records.range() {
        record = all_records[i];
        record_id = record["$ID"];
        category = vector_db.getfield(record_id, "category");
        
        if (category == "category_0" || category == "category_1") {
            vector = vector_db.getfield(record_id, "vector");
            filtered_vectors.push(vector);
        }
    };
    
    /* Perform similarity search on filtered set */
    if (filtered_vectors.len() > 0) {
        filtered_results = filtered_vectors.similarity([0.8, 0.6, 0.4, 0.2, 0.1], "cosine", {
            "top_n": 10,
            "include_scores": true,
            "include_items": true
        });
    } else {
        filtered_results = {"results": []};
    };
    
    hybrid_time = start_time.ms();
    ("    Hybrid search: " + hybrid_time.str() + "ms\n").echo();
    ("    Filtered records: " + filtered_vectors.len().str() + "\n").echo();
    ("    Results: " + filtered_results."results".len().str() + "\n").echo();
    
    /* Performance analysis */
    ("  Performance Analysis:\n").echo();
    
    if (pure_vector_time < pinecone_threshold) {
        ("    ✅ Pure vector: EXCELLENT (< " + pinecone_threshold.str() + "ms)\n").echo();
    } else if (pure_vector_time < acceptable_threshold) {
        ("    ✅ Pure vector: GOOD (< " + acceptable_threshold.str() + "ms)\n").echo();
    } else {
        ("    ❌ Pure vector: SLOW (> " + acceptable_threshold.str() + "ms)\n").echo();
    };
    
    if (db_vector_time < pinecone_threshold) {
        ("    ✅ Database + vector: EXCELLENT (< " + pinecone_threshold.str() + "ms)\n").echo();
    } else if (db_vector_time < acceptable_threshold) {
        ("    ✅ Database + vector: GOOD (< " + acceptable_threshold.str() + "ms)\n").echo();
    } else {
        ("    ❌ Database + vector: SLOW (> " + acceptable_threshold.str() + "ms)\n").echo();
    };
    
    if (hybrid_time < pinecone_threshold) {
        ("    ✅ Hybrid search: EXCELLENT (< " + pinecone_threshold.str() + "ms)\n").echo();
    } else if (hybrid_time < acceptable_threshold) {
        ("    ✅ Hybrid search: GOOD (< " + acceptable_threshold.str() + "ms)\n").echo();
    } else {
        ("    ❌ Hybrid search: SLOW (> " + acceptable_threshold.str() + "ms)\n").echo();
    };
    
    /* Store results */
    result = {
        "size": test_size,
        "pure_vector_time": pure_vector_time,
        "db_vector_time": db_vector_time,
        "hybrid_time": hybrid_time,
        "filtered_count": filtered_vectors.len()
    };
    results.push(result);
    
    ("\n").echo();
};

/* Summary Report */
("=== PERFORMANCE SUMMARY ===\n").echo();
("Size\tPure\tDB+Vector\tHybrid\tRecommendation\n").echo();
("----\t----\t---------\t-------\t---------------\n").echo();

for result in results {
    size = result."size";
    pure_time = result."pure_vector_time";
    db_time = result."db_vector_time";
    hybrid_time = result."hybrid_time";
    
    /* Determine recommendation */
    if (pure_time < pinecone_threshold && db_time < pinecone_threshold) {
        recommendation = "✅ EXCELLENT - Competitive with Pinecone";
    } else if (pure_time < acceptable_threshold && db_time < acceptable_threshold) {
        recommendation = "✅ GOOD - Suitable for local use";
    } else {
        recommendation = "❌ SLOW - Use Pinecone";
    };
    
    (size.str() + "\t" + pure_time.str() + "ms\t" + db_time.str() + "ms\t" + hybrid_time.str() + "ms\t" + recommendation + "\n").echo();
};

/* Scaling Analysis */
("\n=== SCALING ANALYSIS ===\n").echo();
if (results.len() >= 2) {
    first = results[0];
    last = results[results.len() - 1];
    
    size_ratio = last."size" / first."size";
    pure_time_ratio = last."pure_vector_time" / first."pure_vector_time";
    db_time_ratio = last."db_vector_time" / first."db_vector_time";
    
    ("Size increase: " + size_ratio.str() + "x\n").echo();
    ("Pure vector time increase: " + pure_time_ratio.str() + "x\n").echo();
    ("DB + vector time increase: " + db_time_ratio.str() + "x\n").echo();
    
    if (pure_time_ratio < size_ratio) {
        ("✅ Pure vector: Sub-linear scaling - Performance scales well\n").echo();
    } else if (pure_time_ratio == size_ratio) {
        ("✅ Pure vector: Linear scaling - Expected performance\n").echo();
    } else {
        ("⚠️  Pure vector: Super-linear scaling - Performance degrades\n").echo();
    };
    
    if (db_time_ratio < size_ratio) {
        ("✅ DB + vector: Sub-linear scaling - Performance scales well\n").echo();
    } else if (db_time_ratio == size_ratio) {
        ("✅ DB + vector: Linear scaling - Expected performance\n").echo();
    } else {
        ("⚠️  DB + vector: Super-linear scaling - Performance degrades\n").echo();
    };
};

/* Performance Breakpoint Analysis */
("\n=== PERFORMANCE BREAKPOINT ANALYSIS ===\n").echo();
("Based on test results:\n").echo();

if (results.len() > 0) {
    max_pure_time = 0;
    max_db_time = 0;
    max_size = 0;
    
    for result in results {
        if (result."pure_vector_time" > max_pure_time) {
            max_pure_time = result."pure_vector_time";
        };
        if (result."db_vector_time" > max_db_time) {
            max_db_time = result."db_vector_time";
        };
        if (result."size" > max_size) {
            max_size = result."size";
        };
    };
    
    ("• Maximum pure vector search time: " + max_pure_time.str() + "ms\n").echo();
    ("• Maximum DB + vector search time: " + max_db_time.str() + "ms\n").echo();
    ("• Tested up to " + max_size.str() + " records\n").echo();
    
    if (max_pure_time < pinecone_threshold) {
        ("• ✅ Pure vector search is competitive with Pinecone at all tested scales\n").echo();
    };
    
    if (max_db_time < pinecone_threshold) {
        ("• ✅ DB + vector search is competitive with Pinecone at all tested scales\n").echo();
    };
};

/* Recommendations */
("\n=== RECOMMENDATIONS ===\n").echo();

excellent_count = 0;
good_count = 0;
slow_count = 0;

for result in results {
    db_time = result."db_vector_time";
    if (db_time < pinecone_threshold) {
        excellent_count = excellent_count + 1;
    } else if (db_time < acceptable_threshold) {
        good_count = good_count + 1;
    } else {
        slow_count = slow_count + 1;
    };
};

if (excellent_count > 0) {
    ("✅ Grapa is competitive with Pinecone for small to medium datasets\n").echo();
};

if (good_count > 0) {
    ("✅ Grapa is suitable for local/offline applications\n").echo();
};

if (slow_count > 0) {
    ("❌ Use Pinecone for large-scale production applications\n").echo();
};

/* When to use Grapa vs Pinecone */
("\n=== WHEN TO USE GRAPA VS PINECONE ===\n").echo();
("Use Grapa when:\n").echo();
("• Dataset size < 10,000 records\n").echo();
("• Local/offline applications\n").echo();
("• Cost-sensitive projects\n").echo();
("• Need for complex similarity algorithms\n").echo();
("• Integration with existing Grapa applications\n").echo();
("\n").echo();
("Use Pinecone when:\n").echo();
("• Dataset size > 100,000 records\n").echo();
("• High-throughput production workloads\n").echo();
("• Need for advanced indexing and optimization\n").echo();
("• Multi-tenant SaaS applications\n").echo();
("• Global scale and availability requirements\n").echo();

("\n=== TEST COMPLETE ===\n").echo();
