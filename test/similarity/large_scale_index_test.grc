/* Large Scale Performance Test */
/* Tests performance at larger scales to find the breakpoint */

("=== Large Scale Performance Test ===\n").echo();

/* Test larger sizes incrementally */
test_sizes = [15000, 20000, 25000, 50000, 100000];
test_sizes = [15000];
pinecone_threshold = 100;  /* Pinecone typically < 100ms */
acceptable_threshold = 500;  /* Acceptable for local use */
warning_threshold = 2000;   /* Warning threshold */

("Testing similarity search at larger scales...\n").echo();
("Pinecone threshold: < " + pinecone_threshold.str() + "ms\n").echo();
("Acceptable threshold: < " + acceptable_threshold.str() + "ms\n").echo();
("\n").echo();

hashsource = 5.genhashset("cosine",3,8,1234);

/* Results storage */
results = [];

for test_size in test_sizes {
    ("--- Testing " + test_size.str() + " records ---\n").echo();
    
    /* Test 1: Pure vector similarity */
    ("  Test 1: Pure vector similarity...\n").echo();
    start_time = $TIME().utc();
    
    dbname = "test"+test_size.str().lpad(8,"0")+".gdb";
    vectors = $file();
    if ($file().info(dbname)."$TYPE"!="FILE")
    {
        vectors.rm(dbname);
        vectors.mk(dbname,"ROW");
        vectors.cd(dbname);
        vectors.mkfield("h1","INT","FIX",8);
        vectors.mkfield("h2","INT","FIX",8);
        vectors.mkfield("h3","INT","FIX",8);
        for i in test_size.range() {
            /* Create truly random vectors for realistic similarity testing */
            vector = #[
                ((9.random()) / 256)-1,  /* Random float -1.0 - 1.0 */
                ((9.random()) / 256)-1,  /* Random float -1.0 - 1.0 */
                ((9.random()) / 256)-1,  /* Random float -1.0 - 1.0 */
                ((9.random()) / 256)-1,  /* Random float -1.0 - 1.0 */
                ((9.random()) / 256)-1   /* Random float -1.0 - 1.0 */
            ]#;
            hash = vector.genhash(hashsource);
            name = "r"+i.str().lpad(8,"0");
            vectors.set(name,vector);
            vectors.setfield(name,"h1",hash[0]);
            vectors.setfield(name,"h2",hash[1]);
            vectors.setfield(name,"h3",hash[2]);
        };
    }
    else
    {
        vectors.cd(dbname);
    };

    indexes = vectors.ls().vector().sort(1,["$ID"]).t().list()[0];
    search = #[0.8, -0.6, 0.4, 0.2, -0.1]#.genhash(hashsource);
	
    create_vector_time = start_time.ms();
	
	indexes2 = [];
	
	for i in indexes {
		h1 = vectors.getfield(i,"h1");
		h2 = vectors.getfield(i,"h2");
		h3 = vectors.getfield(i,"h3");
		if (h1==search[0] || h2==search[1] || h2==search[2])
			indexes2 += i;
	};

    vector_results = indexes2.similarity(#[0.8, -0.6, 0.4, 0.2, -0.1]#, "cosine", {
        "datasource": vectors,
        "top_n": 10,
        "include_scores": true,
        "include_items": true
    });
    
    vector_results.str().echo();
    "\n".echo();
    
    pure_vector_time = start_time.ms() - create_vector_time;
    ("    Create vector: " + create_vector_time.float(30).str() + "ms\n").echo();
    ("    Search vector: " + pure_vector_time.float(30).str() + "ms\n").echo();
    ("    Results: " + vector_results."results".len().str() + "\n").echo();
    
    /* Performance analysis */
    if (pure_vector_time < pinecone_threshold) {
        ("    ✅ EXCELLENT (< " + pinecone_threshold.str() + "ms)\n").echo();
    } else if (pure_vector_time < acceptable_threshold) {
        ("    ✅ GOOD (< " + acceptable_threshold.str() + "ms)\n").echo();
    } else if (pure_vector_time < warning_threshold) {
        ("    ⚠️  ACCEPTABLE (< " + warning_threshold.str() + "ms)\n").echo();
    } else {
        ("    ❌ SLOW (> " + warning_threshold.str() + "ms)\n").echo();
    };
    
    /* Store result */
    result = {
        "size": test_size,
        "pure_vector_time": pure_vector_time
    };
    results += result;
    
    ("\n").echo();
};

/* Summary Report */
("=== PERFORMANCE SUMMARY ===\n").echo();
("Size\tPure Vector\tRecommendation\n").echo();
("----\t----------\t---------------\n").echo();

for result in results {
    size = result."size";
    pure_time = result."pure_vector_time";
    
    /* Determine recommendation */
    if (pure_time < pinecone_threshold) {
        recommendation = "✅ EXCELLENT - Competitive with Pinecone";
    } else if (pure_time < acceptable_threshold) {
        recommendation = "✅ GOOD - Suitable for local use";
    } else if (pure_time < warning_threshold) {
        recommendation = "⚠️  ACCEPTABLE - Consider Pinecone";
    } else {
        recommendation = "❌ SLOW - Use Pinecone";
    };
    
    (size.str() + "\t" + pure_time.float(30).str() + "ms\t" + recommendation + "\n").echo();
};

/* Scaling Analysis */
("\n=== SCALING ANALYSIS ===\n").echo();
if (results.len() >= 2) {
    first = results[0];
    last = results[results.len() - 1];
    
    size_ratio = last."size" / first."size";
    time_ratio = last."pure_vector_time" / first."pure_vector_time";
    
    ("Size increase: " + size_ratio.float(30).str() + "x\n").echo();
    ("Time increase: " + time_ratio.float(30).str() + "x\n").echo();
    
    if (time_ratio < size_ratio) {
        ("✅ Sub-linear scaling - Performance scales well\n").echo();
    } else if (time_ratio == size_ratio) {
        ("✅ Linear scaling - Expected performance\n").echo();
    } else {
        ("⚠️  Super-linear scaling - Performance degrades\n").echo();
    };
};

/* Performance Breakpoint Analysis */
("\n=== PERFORMANCE BREAKPOINT ANALYSIS ===\n").echo();
("Based on test results:\n").echo();

if (results.len() > 0) {
    max_time = 0;
    max_size = 0;
    excellent_count = 0;
    good_count = 0;
    acceptable_count = 0;
    slow_count = 0;
    
    for result in results {
        if (result."pure_vector_time" > max_time) {
            max_time = result."pure_vector_time";
            max_size = result."size";
        };
        
        if (result."pure_vector_time" < pinecone_threshold) {
            excellent_count = excellent_count + 1;
        } else if (result."pure_vector_time" < acceptable_threshold) {
            good_count = good_count + 1;
        } else if (result."pure_vector_time" < warning_threshold) {
            acceptable_count = acceptable_count + 1;
        } else {
            slow_count = slow_count + 1;
        };
    };
    
    ("• Maximum search time: " + max_time.float(30).str() + "ms at " + max_size.str() + " records\n").echo();
    ("• Excellent performance: " + excellent_count.str() + " tests\n").echo();
    ("• Good performance: " + good_count.str() + " tests\n").echo();
    ("• Acceptable performance: " + acceptable_count.str() + " tests\n").echo();
    ("• Slow performance: " + slow_count.str() + " tests\n").echo();
    
    if (excellent_count > 0) {
        ("• ✅ Grapa is competitive with Pinecone at tested scales\n").echo();
    };
    
    if (good_count > 0) {
        ("• ✅ Grapa is suitable for local/offline applications\n").echo();
    };
    
    if (acceptable_count > 0) {
        ("• ⚠️  Consider Pinecone for production workloads at larger scales\n").echo();
    };
    
    if (slow_count > 0) {
        ("• ❌ Use Pinecone for large-scale production applications\n").echo();
    };
};

/* Updated Recommendations */
("\n=== UPDATED RECOMMENDATIONS ===\n").echo();
("Based on large-scale testing:\n").echo();
("\n").echo();
("Use Grapa when:\n").echo();
("• Dataset size < 50,000 records (based on performance testing)\n").echo();
("• Local/offline applications\n").echo();
("• Cost-sensitive projects\n").echo();
("• Need for complex similarity algorithms\n").echo();
("• Integration with existing Grapa applications\n").echo();
("\n").echo();
("Use Pinecone when:\n").echo();
("• Dataset size > 100,000 records\n").echo();
("• High-throughput production workloads\n").echo();
("• Need for advanced indexing and optimization\n").echo();
("• Multi-tenant SaaS applications\n").echo();
("• Global scale and availability requirements\n").echo();

("\n=== TEST COMPLETE ===\n").echo();
