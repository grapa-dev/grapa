"✓ WITH high_earners AS (SELECT * FROM employees WHERE salary > 50000), dept_stats AS (SELECT department, COUNT(*) as count, AVG(salary) as avg_salary FROM high_earners GROUP BY department) SELECT * FROM dept_stats WHERE count > 5;\n".echo();
