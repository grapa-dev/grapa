"================================================================================\n".echo();
"Get $file().table('ROW')\n".echo();
"================================================================================\n".echo();
"Create and initialize name,age,city\n".echo();
fdata = $file().table("ROW");
setFields = op(pData,rName,pName,pAge,pCity) {
	pData.set(rName, pName);
};
getFields = op(pData,rName) {
	{"name":pData.get(rName, "name")};
};
"================================================================================\n".echo();
("Set user1 " + {"name":"Alice","age":25,"city":"New York"}.str() + "\n").echo();
setFields(fdata,"user1","Alice",25,"New York");
("Get user1 " + {"name":"Alice","age":25,"city":"New York"}.str() + "\n").echo();
(getFields(fdata,"user1").str() + "\n").echo();
"--------------------------\n".echo();
fdata.debug();
"\n".echo();
"================================================================================\n".echo();
("Set user2 " + {"name":"Bob","age":30,"city":"Los Angeles"}.str() + "\n").echo();
setFields(fdata,"user2","Bob",30,"Los Angeles");
("Get user1 " + {"name":"Alice","age":25,"city":"New York"}.str() + "\n").echo();
(getFields(fdata,"user1").str() + "\n").echo();
"--------------------------\n".echo();
fdata.debug();
"================================================================================\n".echo();
("Set user3 " + {"name":"Charlie","age":35,"city":"Chicago"}.str() + "\n").echo();
setFields(fdata,"user3","Charlie",35,"Chicago");
("Get user1 " + {"name":"Alice","age":25,"city":"New York"}.str() + "\n").echo();
(getFields(fdata,"user1").str() + "\n").echo();
"--------------------------\n".echo();
fdata.debug();
"================================================================================\n".echo();