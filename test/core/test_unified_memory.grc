/* Test Memory Storage Backend Integration */

"=== MEMORY STORAGE BACKEND TEST ===\n".echo();

/* Test 1: Memory Storage Creation and Basic Operations */
"Test 1: Memory Storage Creation and Basic Operations\n".echo();
"---------------------------------------------------\n".echo();

/* Create unified storage object with memory */
u = $unified();
"Testing memory storage...\n".echo();
result = u.create("memory: /* "); */
"Create result: ".echo();
result.echo();
"\n".echo();

/* Test getType */
"Storage type: ".echo();
result = u.getType();
result.echo();
"\n".echo();

/* Test getInfo */
"Storage info: ".echo();
result = u.getInfo();
result.echo();
"\n".echo();

/* Test ls (directory listing) */
"Testing ls (directory listing)...\n".echo();
result = u.ls();
"List result: ".echo();
result.echo();
"\n".echo();

/* Test ls with different output formats */
"Testing ls with JSON output:\n".echo();
result = u.ls().json();
"JSON result: ".echo();
result.echo();
"\n".echo();

"Testing ls with table output:\n".echo();
result = u.ls().table();
"Table result: ".echo();
result.echo();
"\n".echo();

"Testing ls with simple output:\n".echo();
result = u.ls().simple();
"Simple result: ".echo();
result.echo();
"\n".echo();

/* Test 2: Memory File Operations */
"Test 2: Memory File Operations\n".echo();
"-----------------------------\n".echo();

/* Test mk (create file) */
"Testing mk (create file)...\n".echo();
result = u.mk("testfile.txt", "FILE");
"Make result: ".echo();
result.echo();
"\n".echo();

/* Test set (write content) */
"Testing set (write content)...\n".echo();
result = u.set("testfile.txt", "This is test content for memory storage", "$VALUE");
"Set result: ".echo();
result.echo();
"\n".echo();

/* Test get (read content) */
"Testing get (read content)...\n".echo();
result = u.get("testfile.txt", "$VALUE");
"Get result: ".echo();
result.echo();
"\n".echo();

/* Test ls again to see the new file */
"Testing ls again (should show new file)...\n".echo();
result = u.ls();
"List result: ".echo();
result.echo();
"\n".echo();

/* Test ls with field selection */
"Testing ls with field selection:\n".echo();
result = u.ls("$KEY,$TYPE").table();
"Field selection result: ".echo();
result.echo();
"\n".echo();

/* Test 3: Memory Directory Operations */
"Test 3: Memory Directory Operations\n".echo();
"----------------------------------\n".echo();

/* Test mk (create directory) */
"Testing mk (create directory)...\n".echo();
result = u.mk("testdir", "DIR");
"Make directory result: ".echo();
result.echo();
"\n".echo();

/* Test cd (change directory) */
"Testing cd (change directory)...\n".echo();
result = u.cd("testdir");
"Change directory result: ".echo();
result.echo();
"\n".echo();

/* Test pwd (print working directory) */
"Testing pwd (print working directory)...\n".echo();
result = u.pwd();
"Current directory: ".echo();
result.echo();
"\n".echo();

/* Test ls in new directory */
"Testing ls in new directory...\n".echo();
result = u.ls();
"List result: ".echo();
result.echo();
"\n".echo();

/* Test 4: Multiple File Operations */
"Test 4: Multiple File Operations\n".echo();
"-------------------------------\n".echo();

/* Create multiple files */
"Creating multiple files...\n".echo();
u.mk("file1.txt", "FILE");
u.set("file1.txt", "Content for file 1", "$VALUE");

u.mk("file2.txt", "FILE");
u.set("file2.txt", "Content for file 2", "$VALUE");

u.mk("file3.txt", "FILE");
u.set("file3.txt", "Content for file 3", "$VALUE");

"Created 3 files\n".echo();

/* Test ls to see all files */
"Testing ls to see all files...\n".echo();
result = u.ls();
"List result: ".echo();
result.echo();
"\n".echo();

/* Test ls with different output formats */
"Testing ls with JSON output:\n".echo();
result = u.ls().json();
"JSON result: ".echo();
result.echo();
"\n".echo();

"Testing ls with table output:\n".echo();
result = u.ls().table();
"Table result: ".echo();
result.echo();
"\n".echo();

"Testing ls with simple output:\n".echo();
result = u.ls().simple();
"Simple result: ".echo();
result.echo();
"\n".echo();

/* Test 5: File Content Operations */
"Test 5: File Content Operations\n".echo();
"------------------------------\n".echo();

/* Test reading all files */
"Reading content from all files...\n".echo();
content1 = u.get("file1.txt", "$VALUE");
content2 = u.get("file2.txt", "$VALUE");
content3 = u.get("file3.txt", "$VALUE");

"File 1 content: ".echo();
content1.echo();
"\n".echo();

"File 2 content: ".echo();
content2.echo();
"\n".echo();

"File 3 content: ".echo();
content3.echo();
"\n".echo();

/* Test updating file content */
"Updating file content...\n".echo();
u.set("file1.txt", "Updated content for file 1", "$VALUE");
updated_content = u.get("file1.txt", "$VALUE");
"Updated file 1 content: ".echo();
updated_content.echo();
"\n".echo();

/* Test 6: Error Handling */
"Test 6: Error Handling\n".echo();
"---------------------\n".echo();

/* Test reading non-existent file */
"Testing read of non-existent file...\n".echo();
result = u.get("nonexistent.txt", "$VALUE");
"Get result: ".echo();
result.echo();
"\n".echo();

/* Test deleting non-existent file */
"Testing delete of non-existent file...\n".echo();
result = u.rm("nonexistent.txt");
"Remove result: ".echo();
result.echo();
"\n".echo();

/* Test 7: Cleanup Operations */
"Test 7: Cleanup Operations\n".echo();
"-------------------------\n".echo();

/* Test rm (delete files) */
"Testing rm (delete files)...\n".echo();
result = u.rm("file1.txt");
"Remove file1 result: ".echo();
result.echo();
"\n".echo();

result = u.rm("file2.txt");
"Remove file2 result: ".echo();
result.echo();
"\n".echo();

result = u.rm("file3.txt");
"Remove file3 result: ".echo();
result.echo();
"\n".echo();

result = u.rm("testfile.txt");
"Remove testfile result: ".echo();
result.echo();
"\n".echo();

/* Test ls after cleanup */
"Testing ls after cleanup...\n".echo();
result = u.ls();
"List result after cleanup: ".echo();
result.echo();
"\n".echo();

/* Test 8: Performance Test */
"Test 8: Performance Test\n".echo();
"-----------------------\n".echo();

/* Create many files for performance testing */
"Creating 100 files for performance test...\n".echo();
start_time = $time().now();

i = 0;
while (i < 100) {
    filename = "perf_file_" + i + ".txt";
    content = "Performance test content for file " + i;
    u.mk(filename, "FILE");
    u.set(filename, content, "$VALUE");
    i = i + 1;
}

end_time = $time().now();
creation_time = end_time - start_time;
"Creation time: ".echo();
creation_time.echo();
" seconds\n".echo();

/* Test ls performance */
"Testing ls performance...\n".echo();
start_time = $time().now();
result = u.ls();
end_time = $time().now();
ls_time = end_time - start_time;
"LS time: ".echo();
ls_time.echo();
" seconds\n".echo();

"Files created: ".echo();
result.len().echo();
"\n".echo();

/* Test ls with different output formats performance */
"Testing output format performance...\n".echo();
start_time = $time().now();
json_result = u.ls().json();
end_time = $time().now();
json_time = end_time - start_time;
"JSON format time: ".echo();
json_time.echo();
" seconds\n".echo();

start_time = $time().now();
table_result = u.ls().table();
end_time = $time().now();
table_time = end_time - start_time;
"Table format time: ".echo();
table_time.echo();
" seconds\n".echo();

start_time = $time().now();
simple_result = u.ls().simple();
end_time = $time().now();
simple_time = end_time - start_time;
"Simple format time: ".echo();
simple_time.echo();
" seconds\n".echo();

/* Test 9: Cross-Storage Operations */
"Test 9: Cross-Storage Operations\n".echo();
"--------------------------------\n".echo();

/* Test moving data between memory and file system */
"Testing data transfer between memory and file system...\n".echo();

/* Create local file system storage */
local = $unified();
local.create("file: /* /tmp"); */

/* Create memory test file */
u.set("memory_file.txt", "This is memory content", "$VALUE");
"Created memory file\n".echo();

/* Copy from memory to local file system */
"Copying from memory to local file system...\n".echo();
memory_content = u.get("memory_file.txt", "$VALUE");
local.set("local_file.txt", memory_content, "$VALUE");
"Copy complete\n".echo();

/* Verify the content */
"Verifying content...\n".echo();
local_content = local.get("local_file.txt", "$VALUE");
"Local file content: ".echo();
local_content.echo();
"\n".echo();

/* Copy back from local to memory with different name */
"Copying from local to memory...\n".echo();
u.set("downloaded_file.txt", local_content, "$VALUE");
"Copy complete\n".echo();

/* Verify the content */
"Verifying downloaded content...\n".echo();
downloaded_content = u.get("downloaded_file.txt", "$VALUE");
"Downloaded content: ".echo();
downloaded_content.echo();
"\n".echo();

/* Cleanup */
"Cleanup: Removing test files...\n".echo();
local.rm("local_file.txt");
u.rm("memory_file.txt");
u.rm("downloaded_file.txt");

/* Cleanup performance test files */
"Cleaning up performance test files...\n".echo();
i = 0;
while (i < 100) {
    filename = "perf_file_" + i + ".txt";
    u.rm(filename);
    i = i + 1;
}

"=== MEMORY STORAGE BACKEND TEST COMPLETE ===\n".echo(); 