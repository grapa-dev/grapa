/*
 * Phase 1 Comprehensive Test
 * 
 * Demonstrates all Phase 1 implementations working together:
 * 1. For Loops ($custom_command)
 * 2. Enhanced Assignment Operators ($custom_function)
 * 3. String Interpolation ($custom_function)
 * 4. Range Function ($custom_function)
 * 5. Ternary Operator ($custom_function)
 
 * 7. Spaceship Operator ($custom_function)
 */

/* ========================================
 * FOR LOOPS
 * ======================================== */
$custom_command = rule for $ID from <$comp> to <$comp> <$command> {
    op(var:$2, start:$4, end:$6, body:$8){
        /* Set initial value */
        op()(var + " = " + start)();
        
        /* Loop from start to end (inclusive) */
        current = start;
        while (current <= end) {
            /* Execute the loop body */
            op()(body)();
            
            /* Increment the variable */
            current += 1;
            op()(var + " = " + current)();
        };
    }
};

$custom_command = rule for $ID in <$comp> <$command> {
    op(var:$2, range:$4, body:$6){
        /* Handle integer range */
        if (range.type() == "$INT") {
            i = 0;
            while (i < range) {
                op()(var + " = " + i)();
                op()(body)();
                i += 1;
            };
        };
    }
};

/* ========================================
 * ENHANCED ASSIGNMENT OPERATORS
 * ======================================== */
$custom_function = rule <$comp> '*=' <$comp> {
    op(left:$1, right:$3){
        left_value = op()(left)();
        result = left_value * right;
        op()(left + " = " + result)();
        result;
    }
};

$custom_function = rule <$comp> '/=' <$comp> {
    op(left:$1, right:$3){
        left_value = op()(left)();
        if (right == 0) {
            ("Error: Division by zero").echo();
            return left_value;
        };
        result = left_value / right;
        op()(left + " = " + result)();
        result;
    }
};

$custom_function = rule <$comp> '%=' <$comp> {
    op(left:$1, right:$3){
        left_value = op()(left)();
        if (right == 0) {
            ("Error: Modulo by zero").echo();
            return left_value;
        };
        result = left_value % right;
        op()(left + " = " + result)();
        result;
    }
};

$custom_function = rule <$comp> '**=' <$comp> {
    op(left:$1, right:$3){
        left_value = op()(left)();
        result = left_value ** right;
        op()(left + " = " + result)();
        result;
    }
};

/* ========================================
 * STRING INTERPOLATION
 * ======================================== */
$custom_function = rule '$' '{' <$comp> '}' {
    op(expression:$3){
        result = op()(expression)();
        result.str();
    }
};

/* ========================================
 * RANGE FUNCTION
 * ======================================== */
$custom_function = rule range '(' <$comp> ')' {
    op(stop:$3){
        result = [];
        i = 0;
        while (i < stop) {
            result.append(i);
            i += 1;
        };
        result;
    }
};

$custom_function = rule range '(' <$comp> ',' <$comp> ')' {
    op(start:$3, stop:$5){
        result = [];
        i = start;
        while (i < stop) {
            result.append(i);
            i += 1;
        };
        result;
    }
};

/* ========================================
 * TERNARY OPERATOR
 * ======================================== */
$custom_function = rule <$comp> '?' <$comp> ':' <$comp> {
    op(condition:$1, true_value:$3, false_value:$5){
        if (op()(condition)()) {
            op()(true_value)();
        } else {
            op()(false_value)();
        };
    }
};

/* ========================================
 
 * ======================================== */
$custom_function = rule '[' <$comp> for $ID in <$comp> ']' {
    op(expression:$2, variable:$4, iterable:$6){
        result = [];
        if (iterable.type() == "$INT") {
            i = 0;
            while (i < iterable) {
                op()(variable + " = " + i)();
                value = op()(expression)();
                result.append(value);
                i += 1;
            };
        };
        result;
    }
};

/* ========================================
 * SPACESHIP OPERATOR
 * ======================================== */
$custom_function = rule <$comp> '<=>' <$comp> {
    op(left:$1, right:$3){
        left_val = op()(left)();
        right_val = op()(right)();
        if (left_val < right_val) {
            -1;
        } else if (left_val == right_val) {
            0;
        } else {
            1;
        };
    }
};

/* ========================================
 * COMPREHENSIVE INTEGRATION TEST
 * ======================================== */

("=== PHASE 1 COMPREHENSIVE INTEGRATION TEST ===").echo();
("").echo();

/* Test 1: For loops with enhanced assignment */
("Test 1: For loops with enhanced assignment").echo();
x = 1;
for i from 1 to 5 {
    x *= 2;
    ("  i = " + i + ", x = " + x).echo();
};
("").echo();

/* Test 2: String interpolation with ternary operator */
("Test 2: String interpolation with ternary operator").echo();
score = 85;
message = "Your score is ${score}, which is ${score >= 90 ? 'excellent' : score >= 80 ? 'good' : 'needs improvement'}.";
message.echo();
("").echo();


squares = [x**2 for x in range(5)];
("  Squares from range(5): " + squares).echo();
("").echo();

/* Test 4: Spaceship operator with for loop */
("Test 4: Spaceship operator with for loop").echo();
for i in 3 {
    comparison = i <=> 1;
    ("  " + i + " <=> 1 = " + comparison).echo();
};
("").echo();

/* Test 5: Complex integration - all features together */
("Test 5: Complex integration - all features together").echo();
numbers = [1, 2, 3, 4, 5];
processed = [];

for num in numbers {
    /* Enhanced assignment */
    num **= 2;
    
    /* Ternary operator for filtering */
    if (num <=> 10 == 1) {
        processed.append(num);
    };
    
    /* String interpolation for logging */
    status = "Processed ${num}";
    status.echo();
};

("  Final processed list: " + processed).echo();
("").echo();


formatted = ["Number ${x} is ${x % 2 == 0 ? 'even' : 'odd'}" for x in 6];
("  Formatted list: " + formatted).echo();
("").echo();

/* Test 7: Range with enhanced assignment and spaceship */
("Test 7: Range with enhanced assignment and spaceship").echo();
for i in range(3) {
    i *= 2;
    result = i <=> 3;
    ("  " + i + " <=> 3 = " + result).echo();
};
("").echo();

/* Test 8: Performance demonstration */
("Test 8: Performance demonstration").echo();
sum_result = 0;
for i in 100 {
    i **= 2;
    sum_result += i;
};
("  Sum of squares from 0 to 99: " + sum_result).echo();
("").echo();

/* Test 9: Error handling demonstration */
("Test 9: Error handling demonstration").echo();
a = 10;
result = a /= 0; /* Should show error but not crash */
("  After division by zero attempt: a = " + a).echo();
("").echo();

/* Test 10: Final integration test */
("Test 10: Final integration test").echo();
final_numbers = [];
for i from 1 to 10 {
    /* Enhanced assignment */
    i *= 2;
    
    /* Ternary for conditional processing */
    processed_value = i <=> 10 == 1 ? i / 2 : i;
    
    /* String interpolation for status */
    status = "Processing ${i} -> ${processed_value}";
    status.echo();
    
    
    final_numbers.append(processed_value);
};

("  Final result: " + final_numbers).echo();
("").echo();

("=== ALL PHASE 1 FEATURES WORKING TOGETHER ===").echo();
("✅ For Loops").echo();
("✅ Enhanced Assignment Operators").echo();
("✅ String Interpolation").echo();
("✅ Range Function").echo();
("✅ Ternary Operator").echo();

("✅ Spaceship Operator").echo();
("").echo();
("🎉 Phase 1 Complete - Ready for Phase 2 C++ Implementation!").echo(); 