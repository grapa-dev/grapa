/* Test .get() compatibility for various Grapa types */

"=== $LIST ===\n".echo();
my_arr = ["a", "b", "c"];
("my_arr.getfield(1): " + my_arr.getfield(1).str() + "\n").echo();
("my_arr[1]: " + my_arr[1].str() + "\n").echo();

"=== $GOBJ ===\n".echo();
my_list = {foo: 42, bar: 99};
("my_list.getfield(0): " + my_list.getfield(0).str() + "\n").echo();
("my_list.getfield(\"foo\"): ").echo();
try { (my_list.getfield("foo").str() + "\n").echo(); } catch (e) { "[error]\n".echo(); }
("my_list[0]: " + my_list[0].str() + "\n").echo();
("my_list[\"foo\"]: " + my_list["foo"].str() + "\n").echo();
("my_list.foo: " + my_list.foo.str() + "\n").echo();

"=== $file ===\n".echo();
my_fs = $file();
my_fs.setfield("testfile.txt", "hello");
("my_fs.getfield(\"testfile.txt\"): " + my_fs.getfield("testfile.txt").str() + "\n").echo();
try { (my_fs.getfield(0).str() + "\n").echo(); } catch (e) { "[error]\n".echo(); }

"=== $TABLE ===\n".echo();
my_table = my_fs.table("ROW");
my_table.mkfield("name", "STR", "VAR");
my_table.setfield("row1", "name", "Alice");
("my_table.getfield(\"row1\", \"name\"): " + my_table.getfield("row1", "name").str() + "\n").echo();
try { (my_table.getfield(0).str() + "\n").echo(); } catch (e) { "[error]\n".echo(); }

"=== $OBJ (class instance) ===\n".echo();
myC = class {myV = 123;};
myIns = obj myC;
("myIns.getfield(\"myV\"): ").echo();
try { (myIns.getfield("myV").str() + "\n").echo(); } catch (e) { "[error]\n".echo(); }
("myIns[\"myV\"]: " + myIns["myV"].str() + "\n").echo();
("myIns.myV: " + myIns.myV.str() + "\n").echo();

/* Clean up */
my_fs.rm("testfile.txt"); 