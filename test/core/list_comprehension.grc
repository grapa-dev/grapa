/*
 * List Comprehension Implementation
 * 
 * Implements list comprehension using custom_function mechanism.
 * Supports [expression for variable in iterable] syntax.
 */

/* ========================================
 * List Comprehension: [expression for variable in iterable]
 * ======================================== */
custom_function = rule '[' <$comp> for $ID in <$comp> ']' {
    op(expression:$2, variable:$4, iterable:$6){
        /* Create list comprehension */
        result = [];
        
        /* Handle different iterable types */
        if (iterable.type() == "$INT") {
            /* Integer range from 0 to iterable-1 */
            i = 0;
            while (i < iterable) {
                /* Set variable and evaluate expression */
                op()(variable + " = " + i)();
                value = op()(expression)();
                result.append(value);
                i += 1;
            };
        } else if (iterable.type() == "$LIST" || iterable.type() == "$ARRAY") {
            /* List/Array iteration */
            i = 1;
            while (i <= iterable.len()) {
                /* Set variable and evaluate expression */
                op()(variable + " = " + iterable[i])();
                value = op()(expression)();
                result.append(value);
                i += 1;
            };
        } else if (iterable.type() == "$STR") {
            /* String iteration - character by character */
            i = 1;
            while (i <= iterable.len()) {
                /* Set variable and evaluate expression */
                op()(variable + " = '" + iterable[i] + "'")();
                value = op()(expression)();
                result.append(value);
                i += 1;
            };
        } else {
            ("Error: Cannot iterate over type " + iterable.type()).echo();
        };
        
        result;
    }
};

/* ========================================
 * List Comprehension with condition: [expression for variable in iterable if condition]
 * ======================================== */
custom_function = rule '[' <$comp> for $ID in <$comp> if <$comp> ']' {
    op(expression:$2, variable:$4, iterable:$6, condition:$8){
        /* Create filtered list comprehension */
        result = [];
        
        /* Handle different iterable types */
        if (iterable.type() == "$INT") {
            /* Integer range from 0 to iterable-1 */
            i = 0;
            while (i < iterable) {
                /* Set variable */
                op()(variable + " = " + i)();
                
                /* Check condition */
                if (op()(condition)()) {
                    value = op()(expression)();
                    result.append(value);
                };
                i += 1;
            };
        } else if (iterable.type() == "$LIST" || iterable.type() == "$ARRAY") {
            /* List/Array iteration */
            i = 1;
            while (i <= iterable.len()) {
                /* Set variable */
                op()(variable + " = " + iterable[i])();
                
                /* Check condition */
                if (op()(condition)()) {
                    value = op()(expression)();
                    result.append(value);
                };
                i += 1;
            };
        } else if (iterable.type() == "$STR") {
            /* String iteration - character by character */
            i = 1;
            while (i <= iterable.len()) {
                /* Set variable */
                op()(variable + " = '" + iterable[i] + "'")();
                
                /* Check condition */
                if (op()(condition)()) {
                    value = op()(expression)();
                    result.append(value);
                };
                i += 1;
            };
        } else {
            ("Error: Cannot iterate over type " + iterable.type()).echo();
        };
        
        result;
    }
};

/* ========================================
 * COMPREHENSIVE TESTING
 * ======================================== */

("=== LIST COMPREHENSION TESTS ===").echo();
("").echo();

/* Test 1: Basic list comprehension */
("Test 1: Basic list comprehension").echo();
squares = [x**2 for x in 5];
("  [x**2 for x in 5] = " + squares).echo();
("").echo();

/* Test 2: List comprehension with existing list */
("Test 2: List comprehension with existing list").echo();
numbers = [1, 2, 3, 4, 5];
doubles = [x * 2 for x in numbers];
("  numbers = " + numbers).echo();
("  [x * 2 for x in numbers] = " + doubles).echo();
("").echo();

/* Test 3: String list comprehension */
("Test 3: String list comprehension").echo();
chars = [c for c in "hello"];
("  [c for c in 'hello'] = " + chars).echo();
("").echo();

/* Test 4: List comprehension with condition */
("Test 4: List comprehension with condition").echo();
evens = [x for x in 10 if x % 2 == 0];
("  [x for x in 10 if x % 2 == 0] = " + evens).echo();
("").echo();

/* Test 5: Complex expression in comprehension */
("Test 5: Complex expression in comprehension").echo();
complex_squares = [x**2 + 2*x + 1 for x in 4];
("  [x**2 + 2*x + 1 for x in 4] = " + complex_squares).echo();
("").echo();

/* Test 6: List comprehension with string operations */
("Test 6: List comprehension with string operations").echo();
words = ["hello", "world", "grapa"];
upper_words = [word.upper() for word in words];
("  words = " + words).echo();
("  [word.upper() for word in words] = " + upper_words).echo();
("").echo();

/* Test 7: Nested list comprehension */
("Test 7: Nested list comprehension").echo();
pairs = [(x, y) for x in 3 for y in 2];
("  [(x, y) for x in 3 for y in 2] = " + pairs).echo();
("").echo();

/* Test 8: List comprehension with range function */
("Test 8: List comprehension with range function").echo();
range_squares = [x**2 for x in range(5)];
("  [x**2 for x in range(5)] = " + range_squares).echo();
("").echo();

/* Test 9: Conditional list comprehension with strings */
("Test 9: Conditional list comprehension with strings").echo();
vowels = [c for c in "hello world" if c in ["a", "e", "i", "o", "u"]];
("  [c for c in 'hello world' if c in ['a','e','i','o','u']] = " + vowels).echo();
("").echo();

/* Test 10: List comprehension with mathematical functions */
("Test 10: List comprehension with mathematical functions").echo();
factorials = [x.factorial() for x in [1, 2, 3, 4, 5]];
("  [x.factorial() for x in [1,2,3,4,5]] = " + factorials).echo();
("").echo();

/* Test 11: List comprehension with type checking */
("Test 11: List comprehension with type checking").echo();
mixed = [1, "hello", 3.14, true, [1, 2, 3]];
numbers_only = [x for x in mixed if x.type() == "$INT" || x.type() == "$FLOAT"];
("  mixed = " + mixed).echo();
("  [x for x in mixed if x.type() == '$INT' || x.type() == '$FLOAT'] = " + numbers_only).echo();
("").echo();

/* Test 12: List comprehension with function calls */
("Test 12: List comprehension with function calls").echo();
lengths = [word.len() for word in ["cat", "dog", "elephant"]];
("  [word.len() for word in ['cat','dog','elephant']] = " + lengths).echo();
("").echo();

/* Test 13: List comprehension with ternary operator */
("Test 13: List comprehension with ternary operator").echo();
parity = [x % 2 == 0 ? "even" : "odd" for x in 6];
("  [x % 2 == 0 ? 'even' : 'odd' for x in 6] = " + parity).echo();
("").echo();

/* Test 14: List comprehension with string interpolation */
("Test 14: List comprehension with string interpolation").echo();
formatted = ["Number ${x}" for x in 3];
("  ['Number ${x}' for x in 3] = " + formatted).echo();
("").echo();

/* Test 15: Performance test - large list comprehension */
("Test 15: Performance test - large list comprehension").echo();
large_squares = [x**2 for x in 100];
("  [x**2 for x in 100] length = " + large_squares.len()).echo();
("  First 5 elements: " + large_squares.slice(1, 5)).echo();
("").echo();

("=== ALL LIST COMPREHENSION TESTS COMPLETED ===").echo(); 