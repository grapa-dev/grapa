weather = "sunny";
activity = temperature > 70 && weather == "sunny" ? "Go outside" : "Stay inside";
("  temperature = " + temperature + ", weather = " + weather + ", activity: " + activity).echo();
("").echo();

/* Test 12: Zero and null handling */
