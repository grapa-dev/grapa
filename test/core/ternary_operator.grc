/*
 * Ternary Operator Implementation
 * 
 * Implements ternary operator ?: using $custom_function mechanism.
 * Supports condition ? true_value : false_value syntax.
 */

/* ========================================
 * Ternary Operator: condition ? true_value : false_value
 * ======================================== */
$custom_function = rule <$comp> '?' <$comp> ':' <$comp> {
    op(condition:$1, true_value:$3, false_value:$5){
        /* Evaluate condition and return appropriate value */
        if (op()(condition)()) {
            op()(true_value)();
        } else {
            op()(false_value)();
        };
    }
};

/* ========================================
 * COMPREHENSIVE TESTING
 * ======================================== */

("=== TERNARY OPERATOR TESTS ===").echo();
("").echo();

/* Test 1: Basic ternary operator */
("Test 1: Basic ternary operator").echo();
x = 10;
result1 = x > 5 ? "x is greater than 5" : "x is not greater than 5";
("  x = " + x + ", result: " + result1).echo();
("").echo();

/* Test 2: Numeric comparison */
("Test 2: Numeric comparison").echo();
y = 3;
max = x > y ? x : y;
("  x = " + x + ", y = " + y + ", max = " + max).echo();
("").echo();

/* Test 3: String comparison */
("Test 3: String comparison").echo();
name = "Alice";
greeting = name == "Alice" ? "Hello Alice!" : "Hello stranger!";
("  name = " + name + ", greeting: " + greeting).echo();
("").echo();

