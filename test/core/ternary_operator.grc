zero_test = 0 ? "Non-zero" : "Zero";
("  0 ? result: " + zero_test).echo();
("").echo();

/* Test 13: String interpolation with ternary */
("Test 13: String interpolation with ternary").echo();
user = "admin";
access = user == "admin" ? "Full access" : "Limited access";
message = "User ${user} has ${access}";
("  " + message).echo();
("").echo();

/* Test 14: Complex nested expressions */
("Test 14: Complex nested expressions").echo();
x = 10;
y = 20;
z = 15;
result = x > y ? "x is largest" : y > z ? "y is largest" : "z is largest";
("  x = " + x + ", y = " + y + ", z = " + z + ", " + result).echo();
("").echo();

/* Test 15: Performance test - multiple ternaries */
("Test 15: Performance test - multiple ternaries").echo();
i = 0;
while (i < 5) {
    status = i % 2 == 0 ? "even" : "odd";
    ("  i = " + i + " is " + status).echo();
    i += 1;
};
("").echo();

