/* Test $unified create method

/* Test instantiation with create
"Testing $unified create method...\n".echo();
u = $unified();
"Created unified storage object: ".echo();
u.echo();
"\n".echo();

/* Call create with a storage URL
"Calling create with file: /* /tmp/test...\n".echo();
result = u.create("file: /* /tmp/test");
