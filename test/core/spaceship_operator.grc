/*
 * Spaceship Operator Implementation
 * 
 * Implements spaceship operator <=> using $custom_function mechanism.
 * Returns -1 if left < right, 0 if left == right, 1 if left > right.
 */

/* ========================================
 * Spaceship Operator: <=>
 * Returns -1, 0, or 1 based on comparison
 * ======================================== */
$custom_function = rule <$comp> '<=>' <$comp> {
    op(left:$1, right:$3){
        /* Get the values to compare */
        left_val = op()(left)();
        right_val = op()(right)();
        
        /* Perform comparison and return result */
        if (left_val < right_val) {
            -1;
        } else if (left_val == right_val) {
            0;
        } else {
            1;
        };
    }
};

/* ========================================
 * COMPREHENSIVE TESTING
 * ======================================== */

("=== SPACESHIP OPERATOR TESTS ===").echo();
("").echo();

/* Test 1: Basic numeric comparison */
("Test 1: Basic numeric comparison").echo();
result1 = 5 <=> 10;
("  5 <=> 10 = " + result1).echo();
result2 = 10 <=> 5;
("  10 <=> 5 = " + result2).echo();
result3 = 5 <=> 5;
("  5 <=> 5 = " + result3).echo();
("").echo();

/* Test 2: String comparison */
("Test 2: String comparison").echo();
str1 = "apple" <=> "banana";
("  'apple' <=> 'banana' = " + str1).echo();
str2 = "zebra" <=> "apple";
("  'zebra' <=> 'apple' = " + str2).echo();
str3 = "hello" <=> "hello";
("  'hello' <=> 'hello' = " + str3).echo();
("").echo();

