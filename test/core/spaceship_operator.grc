zero1 = 0 <=> 5;
("  0 <=> 5 = " + zero1).echo();
zero2 = -5 <=> 0;
("  -5 <=> 0 = " + zero2).echo();
zero3 = -10 <=> -5;
("  -10 <=> -5 = " + zero3).echo();
("").echo();

/* Test 6: Large numbers */
("Test 6: Large numbers").echo();
large1 = 1000000 <=> 999999;
("  1000000 <=> 999999 = " + large1).echo();
large2 = 999999 <=> 1000000;
("  999999 <=> 1000000 = " + large2).echo();
("").echo();

/* Test 7: Boolean comparison */
("Test 7: Boolean comparison").echo();
bool1 = true <=> false;
("  true <=> false = " + bool1).echo();
bool2 = false <=> true;
("  false <=> true = " + bool2).echo();
bool3 = true <=> true;
("  true <=> true = " + bool3).echo();
("").echo();

/* Test 8: List comparison */
("Test 8: List comparison").echo();
list1 = [1, 2, 3] <=> [1, 2, 4];
("  [1,2,3] <=> [1,2,4] = " + list1).echo();
list2 = [1, 2, 3] <=> [1, 2, 3];
("  [1,2,3] <=> [1,2,3] = " + list2).echo();
("").echo();

/* Test 9: Variables in comparison */
("Test 9: Variables in comparison").echo();
a = 15;
b = 20;
c = 15;
result_a_b = a <=> b;
result_a_c = a <=> c;
("  a = " + a + ", b = " + b + ", c = " + c).echo();
("  a <=> b = " + result_a_b).echo();
("  a <=> c = " + result_a_c).echo();
("").echo();

/* Test 10: Expressions in comparison */
("Test 10: Expressions in comparison").echo();
expr1 = (5 + 3) <=> (2 * 4);
("  (5 + 3) <=> (2 * 4) = " + expr1).echo();
expr2 = (10 / 2) <=> (3 + 2);
("  (10 / 2) <=> (3 + 2) = " + expr2).echo();
("").echo();

/* Test 11: Chaining spaceship operators */
("Test 11: Chaining spaceship operators").echo();
chain1 = 5 <=> 10 <=> 15;
("  5 <=> 10 <=> 15 = " + chain1).echo();
("").echo();

/* Test 12: Spaceship in conditional statements */
("Test 12: Spaceship in conditional statements").echo();
x = 7;
y = 3;
if (x <=> y == 1) {
    ("  x is greater than y").echo();
} else if (x <=> y == -1) {
    ("  x is less than y").echo();
} else {
    ("  x equals y").echo();
};
("").echo();

/* Test 13: Spaceship with function calls */
("Test 13: Spaceship with function calls").echo();
func1 = "hello".len() <=> "world".len();
("  'hello'.len() <=> 'world'.len() = " + func1).echo();
("").echo();

/* Test 14: Edge cases */
("Test 14: Edge cases").echo();
edge1 = 0 <=> 0;
("  0 <=> 0 = " + edge1).echo();
edge2 = "" <=> "";
("  '' <=> '' = " + edge2).echo();
edge3 = [] <=> [];
("  [] <=> [] = " + edge3).echo();
("").echo();

/* Test 15: Performance test - multiple comparisons */
("Test 15: Performance test - multiple comparisons").echo();
i = 0;
while (i < 5) {
    j = 0;
    while (j < 5) {
        result = i <=> j;
        ("  " + i + " <=> " + j + " = " + result).echo();
        j += 1;
    };
    i += 1;
};
("").echo();

("=== ALL SPACESHIP OPERATOR TESTS COMPLETED ===").echo(); 