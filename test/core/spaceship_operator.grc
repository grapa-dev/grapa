mixed1 = 5 <=> "5";
("  5 <=> '5' = " + mixed1).echo();
mixed2 = "10" <=> 5;
("  '10' <=> 5 = " + mixed2).echo();
("").echo();

/* Test 5: Zero and negative numbers */
