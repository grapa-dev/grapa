/* Test $GOBJ uniqueness scenarios */

/* Test 1: Basic list creation */
"Test 1: Basic list creation".echo();
list1 = [1, 2, 3, 4, 5];
"list1: ".echo(); list1.echo();

/* Test 2: List with duplicate values */
"Test 2: List with duplicate values".echo();
list2 = [1, 2, 2, 3, 3, 3];
"list2: ".echo(); list2.echo();

/* Test 3: List with duplicate strings */
"Test 3: List with duplicate strings".echo();
list3 = ["a", "b", "a", "c", "b"];
"list3: ".echo(); list3.echo();

/* Test 4: List with mixed types */
"Test 4: List with mixed types".echo();
list4 = [1, "hello", 1, true, "hello"];
"list4: ".echo(); list4.echo();

/* Test 5: List with objects */
"Test 5: List with objects".echo();
obj1 = {name: "Alice", age: 30};
obj2 = {name: "Bob", age: 25};
obj3 = {name: "Alice", age: 30};  /* Same as obj1 */
list5 = [obj1, obj2, obj3];
"list5: ".echo(); list5.echo();

/* Test 6: List with nested structures */
"Test 6: List with nested structures".echo();
nested1 = {data: [1, 2, 3]};
nested2 = {data: [1, 2, 3]};  /* Same structure */
list6 = [nested1, nested2];
"list6: ".echo(); list6.echo();

/* Test 7: ++= operation */
"Test 7: ++= operation".echo();
list7 = [1, 2, 3];
list7 ++= [3, 4, 5];  /* Should add 3, 4, 5 to the end */
"list7 after ++=: ".echo(); list7.echo();

/* Test 8: Multiple ++= operations */
"Test 8: Multiple ++= operations".echo();
list8 = [1, 2];
list8 ++= [2, 3];
list8 ++= [3, 4];
"list8 after multiple ++=: ".echo(); list8.echo();

/* Test 9: Check if ++= preserves order */
"Test 9: Check if ++= preserves order".echo();
list9 = ["a", "b"];
list9 ++= ["c", "d"];
list9 ++= ["e", "f"];
"list9 order: ".echo(); list9.echo();

/* Test 10: Check list length after operations */
"Test 10: Check list length after operations".echo();
"list8 length: ".echo(); list8.len().echo();
"list9 length: ".echo(); list9.len().echo();

"List uniqueness tests completed".echo();
