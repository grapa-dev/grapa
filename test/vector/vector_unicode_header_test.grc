/* Vector Unicode Header Support - Comprehensive Regression Test
 * 
 * This test validates Unicode header support in vectors, including:
 * - UTF-8 BOM detection and handling
 * - Unicode header name preservation
 * - Cyrillic and other non-Latin scripts
 * - Mixed encoding support
 * - Header extraction functionality
 * - Data access by Unicode header names
 */

("=== Vector Unicode Header Support - Comprehensive Regression Test ===").echo();

/* Define the keys function for header extraction */
keys = op(lst){lst.reduce(op(acc,x){if(x.type()==$GOBJ){acc += keys(x);}else{acc += 'x'.getname();}},[]);};

/* Header extraction function */
extract_headers = op(csv_string) {
    keys = op(lst){lst.reduce(op(acc,x){if(x.type()==$GOBJ){acc += keys(x);}else{acc += 'x'.getname();}},[]);};
    vec = csv_string.vector();
    arr = vec.array();
    first = arr[0];
    keys(first);
};

/* ======================================== */
/* 1. Basic ASCII CSV Tests */
/* ======================================== */

("\n--- Test 1: Basic ASCII CSV ---").echo();

ascii_csv = "Name,Age,City\nJohn,25,NYC\nJane,30,LA";
vec1 = ascii_csv.vector();

("ASCII CSV vector created: " + (vec1 != null)).echo();
if (vec1 != null) {
    ("Vector type: " + vec1.type()).echo();
    ("Vector shape: " + vec1.shape()).echo();
    
    /* Test header extraction */
    headers = extract_headers(ascii_csv);
    ("Headers: " + headers).echo();
    
    /* Test data access */
    arr = vec1.array();
    first = arr[0];
    ("First row Name: " + first.Name).echo();
    ("First row Age: " + first.Age).echo();
    ("First row City: " + first.City).echo();
}

/* ======================================== */
/* 2. UTF-8 BOM Tests */
/* ======================================== */

("\n--- Test 2: UTF-8 BOM CSV ---").echo();

bom_csv = "ï»¿Name,Value,Category\nAlice,100,A\nBob,200,B";
vec2 = bom_csv.vector();

("BOM CSV vector created: " + (vec2 != null)).echo();
if (vec2 != null) {
    ("Vector type: " + vec2.type()).echo();
    ("Vector shape: " + vec2.shape()).echo();
    
    /* Test header extraction */
    headers = extract_headers(bom_csv);
    ("Headers: " + headers).echo();
    
    /* Test data access */
    arr = vec2.array();
    first = arr[0];
    ("First row Name: " + first.Name).echo();
    ("First row Value: " + first.Value).echo();
    ("First row Category: " + first.Category).echo();
}

