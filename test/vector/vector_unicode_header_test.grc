/* ======================================== */
/* 7. Header Operations Tests */
/* ======================================== */

("\n--- Test 7: Header Operations ---").echo();

test_csv = "Product,Q1,Q2,Q3,Q4\nWidget,100,120,110,130\nGadget,80,90,85,95";
vec7 = test_csv.vector();

("Header operations test vector created: " + (vec7 != null)).echo();
if (vec7 != null) {
    /* Test header extraction */
    headers = extract_headers(test_csv);
    ("Headers: " + headers).echo();
    
    /* Test header count */
    ("Header count: " + headers.len()).echo();
    
    /* Test header access by index */
    ("First header: " + headers[0]).echo();
    ("Second header: " + headers[1]).echo();
    ("Third header: " + headers[2]).echo();
    ("Fourth header: " + headers[3]).echo();
    
    /* Test data access by header names */
    arr = vec7.array();
    first = arr[0];
    ("Product: " + first.Product).echo();
    ("Q1: " + first.Q1).echo();
    ("Q2: " + first.Q2).echo();
    ("Q3: " + first.Q3).echo();
    ("Q4: " + first.Q4).echo();
}

/* ======================================== */
/* 8. Edge Cases Tests */
/* ======================================== */

("\n--- Test 8: Edge Cases ---").echo();

/* Test with empty headers */
empty_headers_csv = ",,\n1,2,3\n4,5,6";
vec8 = empty_headers_csv.vector();

("Empty headers CSV vector created: " + (vec8 != null)).echo();
if (vec8 != null) {
    headers = extract_headers(empty_headers_csv);
    ("Empty headers: " + headers).echo();
}

/* Test with single column */
single_col_csv = "Name\nAlice\nBob";
vec9 = single_col_csv.vector();

("Single column CSV vector created: " + (vec9 != null)).echo();
if (vec9 != null) {
    headers = extract_headers(single_col_csv);
    ("Single column headers: " + headers).echo();
    
    arr = vec9.array();
    first = arr[0];
    ("First row Name: " + first.Name).echo();
}

/* Test with very long header names */
long_headers_csv = "VeryLongHeaderNameForTestingPurposes,AnotherVeryLongHeaderName\nValue1,Value2";
vec10 = long_headers_csv.vector();

("Long headers CSV vector created: " + (vec10 != null)).echo();
if (vec10 != null) {
    headers = extract_headers(long_headers_csv);
    ("Long headers: " + headers).echo();
    
    arr = vec10.array();
    first = arr[0];
    ("First row VeryLongHeaderNameForTestingPurposes: " + first.VeryLongHeaderNameForTestingPurposes).echo();
}

/* ======================================== */
/* 9. Performance Tests */
/* ======================================== */

("\n--- Test 9: Performance Tests ---").echo();

/* Test with larger dataset */
large_csv = "ID,Name,Age,City,Country,Email,Phone,Address,Company,Position\n";
i = 1;
while (i <= 100) {
    large_csv += i + ",User" + i + "," + (20 + i) + ",City" + i + ",Country" + i + ",user" + i + "@example.com,555-000" + i + ",Address" + i + ",Company" + i + ",Position" + i + "\n";
    i += 1;
}

vec11 = large_csv.vector();

("Large CSV vector created: " + (vec11 != null)).echo();
if (vec11 != null) {
    ("Vector shape: " + vec11.shape()).echo();
    
    /* Test header extraction performance */
    start_time = $time();
    headers = extract_headers(large_csv);
    end_time = $time();
    ("Header extraction time: " + (end_time - start_time) + " ms").echo();
    ("Large dataset headers: " + headers).echo();
}

/* ======================================== */
/* 10. Backward Compatibility Tests */
/* ======================================== */

("\n--- Test 10: Backward Compatibility ---").echo();

/* Test that existing functionality still works */
simple_csv = "A,B,C\n1,2,3\n4,5,6";
vec12 = simple_csv.vector();

("Simple CSV vector created: " + (vec12 != null)).echo();
if (vec12 != null) {
    ("Vector type: " + vec12.type()).echo();
    ("Vector shape: " + vec12.shape()).echo();
    
    /* Test array conversion still works */
    arr = vec12.array();
    ("Array conversion: " + arr).echo();
    
    /* Test header extraction works */
    headers = extract_headers(simple_csv);
    ("Simple headers: " + headers).echo();
}

