/* Test $unified() with Different Storage Types

"=== Testing $unified() with Different Storage Types ===\n".echo();

/* Test 1: Filesystem storage
"Test 1: Filesystem storage...\n".echo();

u1 = $unified();
result1 = u1.create("file:///tmp/test_filesystem");
if (result1.type() == $ERR) {
    "Filesystem creation failed\n".echo();
} else {
    "Filesystem creation succeeded\n".echo();
    
    u1.mk("test_dir", "DIR");
    u1.cd("test_dir");
    u1.set("test_file.txt", "filesystem_content");
    content = u1.get("test_file.txt");
    ("Filesystem retrieved content: " + content + "\n").echo();
}

/* Test 2: Memory storage
"Test 2: Memory storage...\n".echo();

u2 = $unified();
result2 = u2.create("memory://test_memory");
if (result2.type() == $ERR) {
    "Memory creation failed\n".echo();
} else {
    "Memory creation succeeded\n".echo();
    
    u2.mk("test_table", "GROUP");
    u2.cd("test_table");
    u2.mkfield("value", "STR", "VAR");
    u2.set("key1", "memory_value", "value");
    val2 = u2.get("key1", "value");
    ("Memory retrieved value: " + val2 + "\n").echo();
}

"=== Storage Type Tests Complete ===\n".echo(); 