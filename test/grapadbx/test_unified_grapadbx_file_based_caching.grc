/* ========================================================================
   Test Unified GrapaDBX File-Based Database with Caching
   Tests the file-based database capabilities with automatic caching
   ========================================================================

"================================================================================\n".echo();
"Testing GrapaDBX File-Based Database with Caching\n".echo();
"================================================================================\n".echo();

/* Test 1: Create File-Based Database
"Test 1: Create File-Based Database\n".echo();
"Expected: Should create persistent database with automatic caching\n".echo();

u = $unified();
err = u.create("grapadbx://test_caching.dbx");  /* File path = persistent database with caching */

if (err == 0) {
    "✅ File-based database created successfully\n".echo();
} else {
    "❌ Failed to create file-based database: " + err.str() + "\n".echo();
    exit(1);
}

/* Test 2: Create Tables with Different Storage Types
"Test 2: Create Tables with Different Storage Types\n".echo();
"Expected: Should support ROW, COL, and GROUP storage types\n".echo();

/* Users table (ROW store for transactional data)
err = u.mk("users", "ROW");
if (err == 0) {
    "✅ Users table (ROW) created successfully\n".echo();
} else {
    "❌ Failed to create users table: " + err.str() + "\n".echo();
}

u.mkfield("name", "STR", "VAR");
u.mkfield("email", "STR", "VAR");
u.mkfield("age", "INT", "FIX", 4);
u.mkfield("created_date", "TIME", "FIX", 8);

/* Analytics table (COL store for analytical queries)
err = u.mk("analytics", "COL");
if (err == 0) {
    "✅ Analytics table (COL) created successfully\n".echo();
} else {
    "❌ Failed to create analytics table: " + err.str() + "\n".echo();
}

u.mkfield("timestamp", "TIME", "FIX", 8);
u.mkfield("user_id", "INT", "FIX", 4);
u.mkfield("metric_value", "FLOAT", "FIX", 8);
u.mkfield("category", "STR", "VAR");

/* Products table (GROUP store for hierarchical data)
err = u.mk("products", "GROUP");
if (err == 0) {
    "✅ Products table (GROUP) created successfully\n".echo();
} else {
    "❌ Failed to create products table: " + err.str() + "\n".echo();
}

u.mkfield("name", "STR", "VAR");
u.mkfield("price", "FLOAT", "FIX", 8);
u.mkfield("category", "STR", "VAR");

/* Test 3: Store Data in Different Table Types
"Test 3: Store Data in Different Table Types\n".echo();
"Expected: Should store data efficiently with caching\n".echo();

/* Store user data (ROW store)
u.cd("users");
err = u.set("user001", "Alice Johnson", "name");
err = u.set("user001", "alice@example.com", "email");
err = u.set("user001", 28, "age");
err = u.set("user001", $time().utc(), "created_date");

err = u.set("user002", "Bob Smith", "name");
err = u.set("user002", "bob@example.com", "email");
err = u.set("user002", 32, "age");
err = u.set("user002", $time().utc(), "created_date");

if (err == 0) {
    "✅ User data stored successfully\n".echo();
} else {
    "❌ Failed to store user data: " + err.str() + "\n".echo();
}

/* Store analytics data (COL store)
u.cd("/analytics");
err = u.set("event001", $time().utc(), "timestamp");
err = u.set("event001", 1, "user_id");
err = u.set("event001", 42.5, "metric_value");
err = u.set("event001", "page_view", "category");

err = u.set("event002", $time().utc(), "timestamp");
err = u.set("event002", 2, "user_id");
err = u.set("event002", 78.3, "metric_value");
err = u.set("event002", "purchase", "category");

if (err == 0) {
    "✅ Analytics data stored successfully\n".echo();
} else {
    "❌ Failed to store analytics data: " + err.str() + "\n".echo();
}

/* Store product data (GROUP store)
u.cd("/products");
err = u.set("prod001", "Laptop", "name");
err = u.set("prod001", 999.99, "price");
err = u.set("prod001", "Electronics", "category");

err = u.set("prod002", "Mouse", "name");
err = u.set("prod002", 29.99, "price");
err = u.set("prod002", "Electronics", "category");

if (err == 0) {
    "✅ Product data stored successfully\n".echo();
} else {
    "❌ Failed to store product data: " + err.str() + "\n".echo();
}

/* Test 4: Demonstrate Caching Benefits
"Test 4: Demonstrate Caching Benefits\n".echo();
"Expected: Second read should be faster due to caching\n".echo();

u.cd("/users");

/* First read (may hit disk)
read_start = $time().utc();
name1 = u.get("user001", "name");
email1 = u.get("user001", "email");
age1 = u.get("user001", "age");
read_end = $time().utc();
first_read_time = read_end - read_start;

/* Second read (should hit cache)
read_start = $time().utc();
name1_again = u.get("user001", "name");
email1_again = u.get("user001", "email");
age1_again = u.get("user001", "age");
read_end = $time().utc();
second_read_time = read_end - read_start;

("First read time: " + first_read_time + " ns\n").echo();
("Second read time: " + second_read_time + " ns\n").echo();

if (second_read_time < first_read_time) {
    speedup = first_read_time / second_read_time;
    ("✅ Cache speedup: " + speedup.str() + "x faster\n").echo();
} else {
    "⚠️  No significant cache speedup detected\n".echo();
}

/* Test 5: Verify Data Persistence
"Test 5: Verify Data Persistence\n".echo();
"Expected: Data should persist between operations\n".echo();

/* Retrieve and verify data
u.cd("/users");
name1 = u.get("user001", "name");
email1 = u.get("user001", "email");
age1 = u.get("user001", "age");

if (name1 && email1 && age1) {
    "✅ Data persistence verified\n".echo();
    ("User 1: " + name1 + ", Email: " + email1 + ", Age: " + age1 + "\n").echo();
} else {
    "❌ Data persistence failed\n".echo();
}

/* Test 6: Complex Queries with Caching
"Test 6: Complex Queries with Caching\n".echo();
"Expected: Should perform complex queries efficiently\n".echo();

/* Query all users
u.cd("/users");
users = u.ls();
if (users && users.len() > 0) {
    ("Found " + users.len() + " users:\n").echo();
    i = 0;
    while (i < users.len()) {
        user = users[i];
        name = u.get(user.name, "name");
        email = u.get(user.name, "email");
        age = u.get(user.name, "age");
        ("  " + user.name + ": " + name + " <" + email + "> (" + age + " years)\n").echo();
        i = i + 1;
    }
} else {
    "❌ Failed to query users\n".echo();
}

/* Query analytics by category
u.cd("/analytics");
events = u.ls();
if (events && events.len() > 0) {
    ("Found " + events.len() + " analytics events:\n").echo();
    i = 0;
    while (i < events.len()) {
        event = events[i];
        category = u.get(event.name, "category");
        value = u.get(event.name, "metric_value");
        ("  " + event.name + ": " + category + " = " + value + "\n").echo();
        i = i + 1;
    }
} else {
    "❌ Failed to query analytics\n".echo();
}

/* Query products by category
u.cd("/products");
products = u.ls();
if (products && products.len() > 0) {
    ("Found " + products.len() + " products:\n").echo();
    i = 0;
    while (i < products.len()) {
        product = products[i];
        name = u.get(product.name, "name");
        price = u.get(product.name, "price");
        category = u.get(product.name, "category");
        ("  " + product.name + ": " + name + " ($" + price + ") - " + category + "\n").echo();
        i = i + 1;
    }
} else {
    "❌ Failed to query products\n".echo();
}

/* Test 7: Performance Benchmark
"Test 7: Performance Benchmark\n".echo();
"Expected: Should demonstrate good performance with caching\n".echo();

/* Write performance test
write_start = $time().utc();
i = 0;
while (i < 100) {
    u.cd("/users");
    u.set("perf" + i.str(), "value" + i.str(), "name");
    i = i + 1;
}
write_end = $time().utc();
write_time = write_end - write_start;

/* Read performance test
read_start = $time().utc();
i = 0;
while (i < 100) {
    u.cd("/users");
    value = u.get("perf" + i.str(), "name");
    i = i + 1;
}
read_end = $time().utc();
read_time = read_end - read_start;

("Write Performance: " + write_time + " ns for 100 operations\n").echo();
("Read Performance: " + read_time + " ns for 100 operations\n").echo();
("Average Write: " + (write_time / 100) + " ns per operation\n").echo();
("Average Read: " + (read_time / 100) + " ns per operation\n").echo();

/* Test 8: File System Verification
"Test 8: File System Verification\n".echo();
"Expected: Database file should exist on disk\n".echo();

/* Check if file exists
f = $file();
file_info = f.info("test_caching.dbx");
if (file_info && file_info.type == "file") {
    "✅ Database file exists on disk\n".echo();
    ("File size: " + file_info.size + " bytes\n").echo();
} else {
    "❌ Database file not found on disk\n".echo();
}

