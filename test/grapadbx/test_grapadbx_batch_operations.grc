/* Test script for GrapaDBX batch field operations */
/* This demonstrates the performance benefits of batch operations */

"Testing GrapaDBX Batch Field Operations Concept...\n".echo();
"==================================================\n".echo();

/* Test 1: Individual Field Operations (Current Approach) */
"Test 1: Individual Field Operations (Current Approach)\n".echo();
"-----------------------------------------------------\n".echo();

"Creating table with individual field operations...\n".echo();
f = $file().table("ROW");
f.mkfield("name", "STR", "VAR");
f.mkfield("age", "INT", "FIX", 4);
f.mkfield("salary", "FLOAT", "FIX", 8);
f.mkfield("department", "STR", "VAR");
f.mkfield("email", "STR", "VAR");
f.mkfield("phone", "STR", "VAR");
f.mkfield("address", "STR", "VAR");
f.mkfield("city", "STR", "VAR");

"Setting data using individual operations (inefficient):\n".echo();
f.set("user1", "John Doe", "name");
f.set("user1", 30, "age");
f.set("user1", 75000.50, "salary");
f.set("user1", "Engineering", "department");
f.set("user1", "john.doe@company.com", "email");
f.set("user1", "555-1234", "phone");
f.set("user1", "123 Main St", "address");
f.set("user1", "New York", "city");

"Getting data using individual operations (inefficient):\n".echo();
name1 = f.get("user1", "name");
age1 = f.get("user1", "age");
salary1 = f.get("user1", "salary");
dept1 = f.get("user1", "department");
email1 = f.get("user1", "email");
phone1 = f.get("user1", "phone");
address1 = f.get("user1", "address");
city1 = f.get("user1", "city");

("Retrieved user1: " + name1 + ", age " + age1.raw().int().str() + ", salary " + salary1.raw().float().str() + "\n").echo();

