/* Test script to verify BTree Read/Write Caching implementation in GrapaDBX */

.echo("=== GrapaDBX Caching Implementation Test ===\n");

/* Test 1: Create database with default caching (should be enabled) */
.echo("Test 1: Creating database with default caching\n");
dbx = $unified("grapadbx://test_caching.dbx");
.echo("Database created successfully\n");

/* Test 2: Verify database operations work (caching should be active) */
.echo("\nTest 2: Basic database operations with caching\n");

/* Create a test table */
.echo("Creating test table...\n");
dbx.mk("test_table");

/* Add some test data */
.echo("Adding test data...\n");
dbx.set("test_table/record1", "John Doe", "$VALUE");
dbx.set("test_table/record2", "Jane Smith", "$VALUE");
dbx.set("test_table/record3", "Bob Johnson", "$VALUE");

/* Retrieve data (should benefit from caching) */
.echo("Retrieving data (should use cache)...\n");
value1 = dbx.get("test_table/record1", "$VALUE");
value2 = dbx.get("test_table/record2", "$VALUE");
value3 = dbx.get("test_table/record3", "$VALUE");

.echo("Retrieved values:\n");
.echo("  record1: " + value1 + "\n");
.echo("  record2: " + value2 + "\n");
.echo("  record3: " + value3 + "\n");

/* Test 3: Multiple operations to test caching effectiveness */
.echo("\nTest 3: Multiple operations to test caching\n");

/* Add more data */
.echo("Adding more test data...\n");
i = 1;
while (i <= 10) {
    dbx.set("test_table/user" + i, "User" + i + " Data", "$VALUE");
    i = i + 1;
}

/* Retrieve all data (should benefit from caching) */
.echo("Retrieving all data...\n");
i = 1;
while (i <= 10) {
    userData = dbx.get("test_table/user" + i, "$VALUE");
    .echo("  user" + i + ": " + userData + "\n");
    i = i + 1;
}

/* Test 4: List operations (should use cache) */
.echo("\nTest 4: List operations\n");
listing = dbx.ls("test_table");
.echo("Table contents:\n");
.echo(listing + "\n");

/* Test 5: Update operations (should update cache) */
.echo("\nTest 5: Update operations\n");
dbx.set("test_table/record1", "John Doe Updated", "$VALUE");
updatedValue = dbx.get("test_table/record1", "$VALUE");
.echo("Updated record1: " + updatedValue + "\n");

/* Test 6: Delete operations (should update cache) */
.echo("\nTest 6: Delete operations\n");
dbx.rm("test_table/record3");
.echo("Deleted record3\n");

/* Verify deletion */
try {
    deletedValue = dbx.get("test_table/record3", "$VALUE");
    .echo("ERROR: record3 still exists: " + deletedValue + "\n");
} catch {
    .echo("✅ record3 successfully deleted\n");
}

/* Test 7: Performance test - repeated access */
.echo("\nTest 7: Performance test - repeated access\n");
.echo("Accessing same data multiple times (should benefit from caching)...\n");

i = 1;
while (i <= 5) {
    value1 = dbx.get("test_table/record1", "$VALUE");
    value2 = dbx.get("test_table/record2", "$VALUE");
    .echo("  Iteration " + i + ": record1=" + value1 + ", record2=" + value2 + "\n");
    i = i + 1;
}

/* Clean up */
.echo("\nCleaning up...\n");
dbx.close();

.echo("=== Caching Implementation Test Complete ===\n");
.echo("✅ Database operations working with caching\n");
.echo("✅ Read operations should benefit from cache\n");
.echo("✅ Write operations should update cache\n");
.echo("✅ Delete operations should update cache\n");
.echo("✅ Multiple operations working correctly\n");
.echo("\nNote: Caching is implemented at the C++ level.\n");
.echo("Performance improvements will be visible in benchmarks.\n"); 