/* Test 4: Attempt to delete field used in index (should fail) */
('=== Testing Field Deletion with Index (should fail) ===').echo();
db4 = $unified();
db4.create('grapadbx://test_field_deletion_index.dbx?type=ROW');

/* Create table with fields */
db4.mk('test_table');
db4.mkfield('test_table', 'field1', 'STR', 'VAR', 0, 0);
db4.mkfield('test_table', 'field2', 'INT', 'FIX', 8, 0);

/* Create index on field2 */
db4.mkindex('test_table', 'index1', 'field2');

/* Add some records */
db4.set('record1', 'value1', 'test_table');
db4.set('record2', 'value2', 'test_table');

/* Attempt to delete field2 (should fail) */
('Attempting to delete field2 (used in index)...').echo();
result = db4.rmfield('test_table', 'field2');
if (result == -1) {
    ('SUCCESS: Field deletion correctly failed for indexed field').echo();
} else {
    ('ERROR: Field deletion should have failed for indexed field').echo();
}

('=== Field Deletion Tests Complete ===').echo(); 