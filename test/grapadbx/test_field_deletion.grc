/* Test 3: Field deletion in GROUP table */
('=== Testing Field Deletion in GROUP Table ===').echo();
db3 = $unified();
db3.create('grapadbx://test_field_deletion_group.dbx?type=GROUP');

/* Create table with multiple fields */
db3.mk('test_table');
db3.mkfield('test_table', 'field1', 'STR', 'VAR', 0, 0);
db3.mkfield('test_table', 'field2', 'INT', 'FIX', 8, 0);
db3.mkfield('test_table', 'field3', 'FLOAT', 'FIX', 8, 0);

