/* Test script for field deletion functionality in GrapaDBX */

/* Test 1: Basic field deletion in ROW table */
('=== Testing Field Deletion in ROW Table ===').echo();
db = $unified();
db.create('grapadbx://test_field_deletion_row.dbx?type=ROW');

/* Create table with multiple fields */
db.mk('test_table');
db.mkfield('test_table', 'field1', 'STR', 'VAR', 0, 0);
db.mkfield('test_table', 'field2', 'INT', 'FIX', 8, 0);
db.mkfield('test_table', 'field3', 'FLOAT', 'FIX', 8, 0);

/* Add some records */
db.set('record1', 'value1', 'test_table');
db.set('record2', 'value2', 'test_table');
db.set('record3', 'value3', 'test_table');

/* Verify records exist */
('Before deletion:').echo();
db.debug();

/* Delete field2 */
('Deleting field2...').echo();
db.rmfield('test_table', 'field2');

/* Verify field was deleted */
('After deletion:').echo();
db.debug();

