/* Test script for validating index-based searching implementation using debug functions

/* This script tests the index-based searching implementation and uses debug functions
/* to validate what's in the database and indexes during testing

/* Test 1: Basic database creation and index validation
("=== Test 1: Basic Database Creation and Index Validation ===\n").echo();

u = $unified();
result = u.create("memory://test_index_debug");
if (result.type() == $ERR) {
    ("ERROR: Failed to create database: " + result + "\n").echo();
    exit(1);
}
("Database created successfully\n").echo();

/* Create table and fields
u.mk("test_table", "GROUP");
u.cd("test_table");
u.mkfield("name", "STR", "VAR");
u.mkfield("age", "INT", "VAR");
u.mkfield("email", "STR", "VAR");

/* Add some test data
u.set("user1", "John Doe", "name");
u.set("user1", 25, "age");
u.set("user1", "john@example.com", "email");

u.set("user2", "Jane Smith", "name");
u.set("user2", 30, "age");
u.set("user2", "jane@example.com", "email");

u.set("user3", "Bob Johnson", "name");
u.set("user3", 35, "age");
u.set("user3", "bob@example.com", "email");

("Added 3 test records\n").echo();

/* Test 2: Debug index contents
("=== Test 2: Debug Index Contents ===\n").echo();

/* Get table reference for debug functions
tableRef = u.get("test_table", "$REF");
("Table reference: " + tableRef + "\n").echo();

/* Debug: Print all index pointers
("Debug: Printing all index pointers for table\n").echo();
/* Note: This would call the debug function in the implementation

/* Test 3: Test index-based search
("=== Test 3: Test Index-Based Search ===\n").echo();

/* Search for specific user by key
result = u.get("user1", "name");
("Search result for user1.name: " + result + "\n").echo();

result = u.get("user2", "age");
("Search result for user2.age: " + result + "\n").echo();

/* Test 4: Debug specific index entries
("=== Test 4: Debug Specific Index Entries ===\n").echo();

/* Debug: Print specific index pointer and record
("Debug: Printing index pointer and record for user1\n").echo();
