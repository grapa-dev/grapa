/* Test 5: Test search with non-existent key
("=== Test 5: Test Search with Non-existent Key ===\n").echo();

result = u.get("nonexistent", "name");
if (result.type() == $ERR) {
    ("Correctly returned error for non-existent key\n").echo();
} else {
    ("WARNING: Should have returned error for non-existent key\n").echo();
}

/* Test 6: Performance test with multiple records
("=== Test 6: Performance Test with Multiple Records ===\n").echo();

/* Add more records for performance testing
i = 1;
while (i <= 10) {
    key = "perf_user" + i.str();
    name = "Performance User " + i.str();
    age = 20 + i;
    email = "perf" + i.str() + "@example.com";
    
    u.set(key, name, "name");
    u.set(key, age, "age");
    u.set(key, email, "email");
    
    i = i + 1;
}
("Added 10 performance test records\n").echo();

/* Test search performance
start_time = $time();
result = u.get("perf_user5", "name");
end_time = $time();
search_time = end_time - start_time;

("Search time for perf_user5.name: " + search_time + " ms\n").echo();
("Search result: " + result + "\n").echo();

