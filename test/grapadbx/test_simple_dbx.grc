/* Simple test for GrapaDBX direct usage

"=== Testing Direct GrapaDBX ===".echo();

/* Try direct file operations
f = $file();
"Created file object".echo();

/* Try to create a DBX file directly
result = f.create("test_direct.dbx");
("File create result: " + result).echo();

if (result.type() != $ERR) {
    "✅ Direct file creation succeeded".echo();
    
    /* Try to write some data
    f.set("testkey", "testvalue");
    "Data written".echo();
    
    /* Try to read it back
    retrieved = f.get("testkey");
    ("Retrieved: " + retrieved).echo();
    
} else {
    ("❌ Direct file creation failed: " + result).echo();
}

"=== Test complete ===".echo(); 