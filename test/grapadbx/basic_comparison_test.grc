/* Basic Comparison Test
 * Simple test to compare GrapaDBX with reference implementation
 */

/* Test ROW table comparison */
("=== Testing ROW Table Comparison ===").echo();

/* Test DBX ROW */
dbx_row = $unified();
dbx_row.create("grapadbx://test_row_comparison.dbx?type=ROW");
dbx_row.mk("test_table");
dbx_row.set("key1", "value1");
dbx_result = dbx_row.get("key1");
("DBX ROW result: " + dbx_result).echo();

/* Test reference ROW */
ref_row = $file().table("ROW");
ref_row.mk("test_table");
ref_row.set("key1", "value1");
ref_result = ref_row.get("key1");
("Reference ROW result: " + ref_result).echo();

/* Compare results */
if (dbx_result == ref_result) {
    "✅ ROW comparison PASSED".echo();
} else {
    "❌ ROW comparison FAILED".echo();
}

