/* Test different data types */
("=== Testing Different Data Types ===").echo();

/* Test integer */
dbx_int = $unified();
dbx_int.create("grapadbx://test_int.dbx?type=ROW");
dbx_int.mk("test_table");
dbx_int.set("int_key", 42);
int_result = dbx_int.get("int_key");
("DBX integer result: " + int_result).echo();

/* Test float */
dbx_float = $unified();
dbx_float.create("grapadbx://test_float.dbx?type=ROW");
dbx_float.mk("test_table");
dbx_float.set("float_key", 3.14159);
float_result = dbx_float.get("float_key");
("DBX float result: " + float_result).echo();

/* Test boolean */
dbx_bool = $unified();
dbx_bool.create("grapadbx://test_bool.dbx?type=ROW");
dbx_bool.mk("test_table");
dbx_bool.set("bool_key", true);
bool_result = dbx_bool.get("bool_key");
("DBX boolean result: " + bool_result).echo();

/* Test array */
dbx_array = $unified();
dbx_array.create("grapadbx://test_array.dbx?type=ROW");
dbx_array.mk("test_table");
dbx_array.set("array_key", [1, 2, 3]);
array_result = dbx_array.get("array_key");
("DBX array result: " + array_result).echo();

/* Test list */
dbx_list = $unified();
dbx_list.create("grapadbx://test_list.dbx?type=ROW");
dbx_list.mk("test_table");
dbx_list.set("list_key", {"key": "value"});
list_result = dbx_list.get("list_key");
("DBX list result: " + list_result).echo();

("=== All Basic Tests Completed ===").echo(); 