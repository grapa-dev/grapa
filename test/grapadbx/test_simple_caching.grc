/* test/grapadbx/test_simple_caching.grc
"=== Simple GrapaDBX Caching Test ===\n".echo();

/* Test basic caching functionality
"Test: Basic caching functionality...\n".echo();

u = $unified();
result = u.create("grapadbx://test_simple.dbx");
("Creation result: " + result + "\n").echo();

if (result.type() != $ERR) {
    "✅ Database creation succeeded\n".echo();
    
    /* Set up test structure
    u.mk("test", "GROUP");
    u.cd("test");
    u.mkfield("name", "STR", "VAR");
    u.mkfield("value", "STR", "VAR");
    
    /* Write test data
    "Writing test data...\n".echo();
    start_time = $TIME().utc();
    i = 0;
    while (i < 50) {
        u.set("key" + i.str(), "value" + i.str(), "name");
        u.set("key" + i.str(), "data" + i.str(), "value");
        i = i + 1;
    }
    write_time = (($TIME().utc() - start_time) / 1000000).int();
    ("Write 50 records: " + write_time + "ms\n").echo();
    
    /* Read test data
    "Reading test data...\n".echo();
    start_time = $TIME().utc();
    i = 0;
    while (i < 50) {
        name = u.get("key" + i.str(), "name");
        value = u.get("key" + i.str(), "value");
        i = i + 1;
    }
    read_time = (($TIME().utc() - start_time) / 1000000).int();
    ("Read 50 records: " + read_time + "ms\n").echo();
    
    /* Test caching by reading again
    "Reading test data again (caching test)...\n".echo();
    start_time = $TIME().utc();
    i = 0;
    while (i < 50) {
        name = u.get("key" + i.str(), "name");
        value = u.get("key" + i.str(), "value");
        i = i + 1;
    }
    read_time2 = (($TIME().utc() - start_time) / 1000000).int();
    ("Read 50 records (second time): " + read_time2 + "ms\n").echo();
    
    /* Performance analysis
    "=== Performance Analysis ===\n".echo();
    ("Write performance: " + write_time + "ms for 50 records\n").echo();
    ("Read performance: " + read_time + "ms for 50 records\n").echo();
    ("Second read performance: " + read_time2 + "ms for 50 records\n").echo();
    
    if (read_time > 0 && read_time2 > 0) {
        if (read_time2 < read_time) {
            ("✅ Caching appears to be working (second read faster)\n").echo();
        } else {
            ("⚠️ Caching may not be working (second read not faster)\n").echo();
        }
    }
    
    /* Clean up
    u.close();
    "✅ Test completed\n".echo();
} else {
    ("❌ Database creation failed: " + result + "\n").echo();
}

"=== Test Complete ===\n".echo(); 