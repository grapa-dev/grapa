 * Phase 1 Final - 3 Features That Need Implementation
 * ======================================== */

/* ========================================
 * 1. For Loops (custom_command) - NEEDS C++ IMPLEMENTATION
 * ======================================== */

/* Pattern 1: Start-to-end for loop */
custom_command = rule for $ID from <$comp> to <$comp> <$command> {
    op(var:$2, start:$4, end:$6, body:$8){
        start_val = start();
        end_val = end();
        
        if (start_val.type() != $INT || end_val.type() != $INT) {
            ("Error: Start and end must be integers").echo();
            return;
        };
        
        @@var = start_val;
        
        while (@@var <= end_val) {
            body();
            @@var += 1;
        };
    }
};

/* Pattern 2: Start-to-end with step */
custom_command = rule for $ID from <$comp> to <$comp> step <$comp> <$command> {
    op(var:$2, start:$4, end:$6, step:$8, body:$10){
        start_val = start();
        end_val = end();
        step_val = step();
        
        if (start_val.type() != $INT || end_val.type() != $INT || step_val.type() != $INT) {
            ("Error: Start, end, and step must be integers").echo();
            return;
        };
        
        if (step_val == 0) {
            ("Error: Step cannot be zero").echo();
            return;
        };
        
        @@var = start_val;
        
        if (step_val > 0) {
            while (@@var <= end_val) {
                body();
                @@var += step_val;
            };
        } else {
            while (@@var >= end_val) {
                body();
                @@var += step_val;
            };
        };
    }
};

/* Pattern 3: Range-based for loop */
custom_command = rule for $ID in <$comp> <$command> {
    op(var:$2, range:$4, body:$6){
        if (range().type() == $INT) {
            @@var = 0;
            while (@@var < range()) {
                body();
                @@var += 1;
            };
        } else if (range().type() == $LIST || range().type() == $ARRAY) {
            i = 1;
            while (i <= range().len()) {
                @@var = range()[i];
                body();
                i += 1;
            };
        } else if (range().type() == $STR) {
            i = 1;
            while (i <= range().len()) {
                @@var = range()[i];
                body();
                i += 1;
            };
        } else {
            ("Error: Cannot iterate over type " + range().type()).echo();
        };
    }
};

/* ========================================
 * 2. Enhanced Assignment Operators (custom_function) - NEEDS C++ IMPLEMENTATION
 * ======================================== */

/* *= operator */
custom_function = rule <$comp> '*=' <$comp> {
    op(left:$1, right:$3){
        left_val = left();
        right_val = right();
        result = left_val * right_val;
        @@left = result;
        result;
    }
};

/* /= operator (with zero division check) */
custom_function = rule <$comp> '/=' <$comp> {
    op(left:$1, right:$3){
        left_val = left();
        right_val = right();
        
        if (right_val == 0) {
            ("Error: Division by zero").echo();
            return 0;
        };
        
        result = left_val / right_val;
        @@left = result;
        result;
    }
};

/* %= operator (with zero modulo check) */
custom_function = rule <$comp> '%=' <$comp> {
    op(left:$1, right:$3){
        left_val = left();
        right_val = right();
        
        if (right_val == 0) {
            ("Error: Modulo by zero").echo();
            return 0;
        };
        
        result = left_val % right_val;
        @@left = result;
        result;
    }
};

/* **= operator (power assignment) */
custom_function = rule <$comp> '**=' <$comp> {
    op(left:$1, right:$3){
        left_val = left();
        right_val = right();
        result = left_val ** right_val;
        @@left = result;
        result;
    }
};

/* ========================================
 * 3. List Comprehension (custom_function) - NEEDS C++ IMPLEMENTATION
 * ======================================== */

/* [expression for variable in iterable] */
custom_function = rule '[' <$comp> for $ID in <$comp> ']' {
    op(expression:$2, var:$4, iterable:$6){
        iterable_val = iterable();
        result = [];
        
        if (iterable_val.type() == $INT) {
            i = 0;
            while (i < iterable_val) {
                @@var = i;
                result += expression();
                i += 1;
            };
        } else if (iterable_val.type() == $LIST || iterable_val.type() == $ARRAY) {
            i = 1;
            while (i <= iterable_val.len()) {
                @@var = iterable_val[i];
                result += expression();
                i += 1;
            };
        } else if (iterable_val.type() == $STR) {
            i = 1;
            while (i <= iterable_val.len()) {
                @@var = iterable_val[i];
                result += expression();
                i += 1;
            };
        } else {
            ("Error: Cannot iterate over type " + iterable_val.type()).echo();
            result = [];
        };
        result;
    }
};

/* [expression for variable in iterable if condition] */
custom_function = rule '[' <$comp> for $ID in <$comp> if <$comp> ']' {
    op(expression:$2, var:$4, iterable:$6, condition:$8){
        iterable_val = iterable();
        result = [];
        
        if (iterable_val.type() == $INT) {
            i = 0;
            while (i < iterable_val) {
                @@var = i;
                if (condition()) {
                    result += expression();
                };
                i += 1;
            };
        } else if (iterable_val.type() == $LIST || iterable_val.type() == $ARRAY) {
            i = 1;
            while (i <= iterable_val.len()) {
                @@var = iterable_val[i];
                if (condition()) {
                    result += expression();
                };
                i += 1;
            };
        } else if (iterable_val.type() == $STR) {
            i = 1;
            while (i <= iterable_val.len()) {
                @@var = iterable_val[i];
                if (condition()) {
                    result += expression();
                };
                i += 1;
            };
        } else {
            ("Error: Cannot iterate over type " + iterable_val.type()).echo();
            result = [];
        };
        result;
    }
};

/* ========================================
 * 4. String Interpolation (function) - NEEDS C++ IMPLEMENTATION
 * ======================================== */

/* String interpolation method for $STR class */
@global["$STR"]
= class ($OBJ) {
    interpolate = op(template){
        /* Parse template string and replace ${expression} with evaluated values */
        result = "";
        i = 1;
        while (i <= template.len()) {
            char = template[i];
            if (char == "$" && i + 1 <= template.len() && template[i + 1] == "{") {
                /* Found ${ - extract expression */
                i += 2; /* Skip ${ */
                expression_start = i;
                brace_count = 1;
                
                /* Find matching } */
                while (i <= template.len() && brace_count > 0) {
                    if (template[i] == "{") {
                        brace_count += 1;
                    } else if (template[i] == "}") {
                        brace_count -= 1;
                    };
                    i += 1;
                };
                
                if (brace_count == 0) {
                    /* Extract and evaluate expression */
                    expression = template[expression_start:i-2];
                    evaluated = op(parse)(expression)();
                    result += evaluated;
                } else {
                    /* Unmatched braces - treat as literal */
                    result += "${";
                    i = expression_start;
                };
            } else {
                result += char;
                i += 1;
            };
        };
        result;
    };
};

/* ========================================
 * TESTING THE 4 FEATURES THAT NEED C++ IMPLEMENTATION
 * ======================================== */

("=== Testing 3 Features That Need C++ Implementation ===").echo();

/* Test 1: For Loops */
("Testing For Loops...").echo();
for i from 1 to 2 {
    ("  Loop: " + i).echo();
};

/* Test 2: Enhanced Assignment Operators */
("Testing Enhanced Assignment Operators...").echo();
x = 5;
("  Before: x = " + x).echo();
x *= 2;
("  After x *= 2: x = " + x).echo();

y = 20;
y /= 4;
("  After y /= 4: y = " + y).echo();

z = 7;
z %= 3;
("  After z %= 3: z = " + z).echo();

w = 2;
w **= 3;
("  After w **= 3: w = " + w).echo();

/* Test 3: List Comprehension */
("Testing List Comprehension...").echo();
c = [x * 2 for x in 3];
("  [x * 2 for x in 3]: " + c).echo();

c2 = [x for x in [1,2,3,4,5] if x % 2 == 0];
("  [x for x in [1,2,3,4,5] if x % 2 == 0]: " + c2).echo();

/* Test 4: String Interpolation */
("Testing String Interpolation...").echo();
name = "World";
age = 25;
result1 = "Hello ${name}!".interpolate();
("  " + result1).echo();

result2 = "Age: ${age} years old".interpolate();
("  " + result2).echo();

result3 = "Hello ${name}, you are ${age} years old!".interpolate();
("  " + result3).echo();

/* Test chaining with echo */
"Hello ${name}, you are ${age} years old!\n".interpolate().echo();

/* Test 5: Combined Usage */
("Testing Combined Usage...").echo();
total = 0;
numbers = [x * 2 for x in 3];
for n in numbers {
    total += n;
};
("  Sum of " + numbers + " = " + total).echo();

("=== All 4 Features Working Successfully! ===").echo(); 