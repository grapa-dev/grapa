/* ========================================
 * String Interpolation Function Test
 * ======================================== */

/* String interpolation method for $STR class */
@global["$STR"]
= class ($OBJ) {
    interpolate = op(template){
        /* Parse template string and replace ${expression} with evaluated values */
        result = "";
        i = 1;
        while (i <= template.len()) {
            char = template[i];
            if (char == "$" && i + 1 <= template.len() && template[i + 1] == "{") {
                /* Found ${ - extract expression */
                i += 2; /* Skip ${ */
                expression_start = i;
                brace_count = 1;
                
                /* Find matching } */
                while (i <= template.len() && brace_count > 0) {
                    if (template[i] == "{") {
                        brace_count += 1;
                    } else if (template[i] == "}") {
                        brace_count -= 1;
                    };
                    i += 1;
                };
                
                if (brace_count == 0) {
                    /* Extract and evaluate expression */
                    expression = template[expression_start:i-2];
                    evaluated = op(parse)(expression)();
                    result += evaluated;
                } else {
                    /* Unmatched braces - treat as literal */
                    result += "${";
                    i = expression_start;
                };
            } else {
                result += char;
                i += 1;
            };
        };
        result;
    };
};

/* ========================================
 * TESTING
 * ======================================== */

("=== String Interpolation Function Test ===").echo();

/* Test basic interpolation */
name = "World";
result1 = "Hello ${name}!".interpolate();
("  Basic: " + result1).echo();

/* Test with numbers */
age = 25;
result2 = "Age: ${age} years old".interpolate();
("  Numbers: " + result2).echo();

/* Test multiple expressions */
result3 = "Hello ${name}, you are ${age} years old!".interpolate();
("  Multiple: " + result3).echo();

/* Test with expressions */
x = 10;
y = 5;
result4 = "Sum: ${x + y}".interpolate();
("  Expression: " + result4).echo();

/* Test with no interpolation */
result5 = "Just a plain string".interpolate();
("  Plain: " + result5).echo();

/* Test with literal ${ */
result6 = "Literal: ${not interpolated}".interpolate();
("  Literal: " + result6).echo();

/* Test chaining with echo */
"Hello ${name}, you are ${age} years old!\n".interpolate().echo();

("=== String Interpolation Test Complete ===").echo(); 