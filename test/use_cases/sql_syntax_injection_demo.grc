/* SQL Syntax Injection Demo
 * 
 * This test demonstrates how to inject SQL-like syntax into Grapa using
 * custom_function and custom_command grammar injection, combined with
 * the $file() object for data operations.
 */

("=== SQL Syntax Injection Demo ===").echo();

/* Step 1: Create sample data files for testing */
("Creating sample data files...").echo();

/* Create a simple CSV file with user data */
users_data = "name,age,city\nJohn,25,New York\nJane,30,Los Angeles\nBob,35,Chicago\nAlice,28,Boston";
$file().write("users.csv", users_data);

/* Create a simple CSV file with product data */
products_data = "id,name,price,category\n1,Laptop,999,Electronics\n2,Book,25,Education\n3,Phone,699,Electronics";
$file().write("products.csv", products_data);

("Sample data files created successfully.\n").echo();

/* Step 2: Inject SQL-like SELECT syntax */
("Injecting SELECT syntax...").echo();
custom_function = rule select $STR from $STR {op(fields:$2,table:$4){
    ("SQL SELECT: " + fields + " FROM " + table).echo();
    
    /* Read the file and parse CSV */
    file_content = $file().read(table);
    if (file_content.err()) {
        ("Error reading file: " + table).echo();
        return $err("File read error");
    };
    
    /* Simple CSV parsing (split by lines and commas) */
    lines = file_content.split("\n");
    if (lines.len() < 2) {
        return $err("File too small");
    };
    
    /* Parse headers */
    headers = lines[1].split(",");
    
    /* Parse data rows */
    data = [];
    i = 2;
    while (i <= lines.len()) {
        if (lines[i].len() > 0) {
            row = lines[i].split(",");
            row_data = {};
            j = 1;
            while (j <= headers.len()) {
                if (j <= row.len()) {
                    row_data[headers[j]] = row[j];
                };
                j += 1;
            };
            data += row_data;
        };
        i += 1;
    };
    
    /* Filter fields if specific fields requested */
    if (fields != "*") {
        field_list = fields.split(",");
        filtered_data = [];
        i = 1;
        while (i <= data.len()) {
            filtered_row = {};
            j = 1;
            while (j <= field_list.len()) {
                field_name = field_list[j].trim();
                if (data[i][field_name]) {
                    filtered_row[field_name] = data[i][field_name];
                };
                j += 1;
            };
            filtered_data += filtered_row;
        };
        data = filtered_data;
    };
    
    ("Query returned " + data.len() + " rows").echo();
    return data;
}};

/* Step 3: Inject SQL-like INSERT syntax */
("Injecting INSERT syntax...").echo();
custom_command = rule insert into $STR values $STR {op(table:$3,values:$5){
    ("SQL INSERT: INSERT INTO " + table + " VALUES " + values).echo();
    
    /* Read existing file */
    existing_content = $file().read(table);
    if (existing_content.err()) {
        ("Error reading file: " + table).echo();
        return;
    };
    
    /* Parse headers from first line */
    lines = existing_content.split("\n");
    if (lines.len() < 1) {
        ("Cannot determine headers from empty file").echo();
        return;
    };
    
    headers = lines[1].split(",");
    
    /* Append new row */
    new_row = values;
    updated_content = existing_content + "\n" + new_row;
    
    /* Write back to file */
    result = $file().write(table, updated_content);
    if (result.err()) {
        ("Error writing to file: " + table).echo();
    } else {
        ("Successfully inserted row into " + table).echo();
    };
}};

/* Step 4: Inject SQL-like UPDATE syntax */
("Injecting UPDATE syntax...").echo();
custom_command = rule update $STR set $STR where $STR {op(table:$2,set_clause:$4,where_clause:$6){
    ("SQL UPDATE: UPDATE " + table + " SET " + set_clause + " WHERE " + where_clause).echo();
    
    /* Read existing file */
    content = $file().read(table);
    if (content.err()) {
        ("Error reading file: " + table).echo();
        return;
    };
    
    /* Parse CSV content */
    lines = content.split("\n");
    if (lines.len() < 2) {
        ("File too small to update").echo();
        return;
    };
    
    /* Parse headers */
    headers = lines[1].split(",");
    
    /* Parse set clause (e.g., "age=26") */
    set_parts = set_clause.split("=");
    if (set_parts.len() != 2) {
        ("Invalid SET clause format. Use 'field=value'").echo();
        return;
    };
    set_field = set_parts[1].trim();
    set_value = set_parts[2].trim();
    
    /* Parse where clause (e.g., "name=John") */
    where_parts = where_clause.split("=");
    if (where_parts.len() != 2) {
        ("Invalid WHERE clause format. Use 'field=value'").echo();
        return;
    };
    where_field = where_parts[1].trim();
    where_value = where_parts[2].trim();
    
    /* Find field indices */
    set_field_idx = 0;
    where_field_idx = 0;
    i = 1;
    while (i <= headers.len()) {
        if (headers[i].trim() == set_field) {
            set_field_idx = i;
        };
        if (headers[i].trim() == where_field) {
            where_field_idx = i;
        };
        i += 1;
    };
    
    if (set_field_idx == 0 || where_field_idx == 0) {
        ("Field not found in table").echo();
        return;
    };
    
    /* Update matching rows */
    updated_lines = [];
    updated_lines += lines[1]; /* Keep header */
    
    i = 2;
    while (i <= lines.len()) {
        if (lines[i].len() > 0) {
            row = lines[i].split(",");
            if (row[where_field_idx] == where_value) {
                /* Update the matching row */
                row[set_field_idx] = set_value;
                updated_lines += row.join(",");
                ("Updated row " + (i-1)).echo();
            } else {
                updated_lines += lines[i];
            };
        };
        i += 1;
    };
    
    /* Write updated content back */
    updated_content = updated_lines.join("\n");
    result = $file().write(table, updated_content);
    if (result.err()) {
        ("Error writing updated file: " + table).echo();
    } else {
        ("Successfully updated " + table).echo();
    };
}};

("SQL syntax injection complete!\n").echo();

/* Step 5: Test the injected SQL syntax */
("=== Testing SQL Syntax ===").echo();

("1. Testing SELECT * FROM users.csv:").echo();
result1 = select * from users.csv;
result1.echo();

("\n2. Testing SELECT name,age FROM users.csv:").echo();
result2 = select name,age from users.csv;
result2.echo();

("\n3. Testing INSERT INTO users.csv VALUES 'David,40,Seattle':").echo();
insert into users.csv values David,40,Seattle;

("\n4. Testing SELECT * FROM users.csv after INSERT:").echo();
result3 = select * from users.csv;
result3.echo();

("\n5. Testing UPDATE users.csv SET age=26 WHERE name=John:").echo();
update users.csv set age=26 where name=John;

("\n6. Testing SELECT * FROM users.csv after UPDATE:").echo();
result4 = select * from users.csv;
result4.echo();

("\n7. Testing SELECT * FROM products.csv:").echo();
result5 = select * from products.csv;
result5.echo();

/* Step 6: Test dynamic execution with op(parse) */
("\n=== Testing Dynamic SQL Execution ===").echo();

("Executing dynamic SQL script:").echo();
sql_script = "select name,city from users.csv";
("Script: " + sql_script).echo();

dynamic_result = op(parse)(sql_script)();
("Dynamic execution result:").echo();
dynamic_result.echo();

("\n=== SQL Syntax Injection Demo Complete ===").echo(); 
