/* Test for predefined function names in rule tokens */

/* Define a predefined function */
filter_function = op(a) { 
    a.grep("pattern"); 
};

/* Define another predefined function */
length_function = op(a) { 
    a.len(); 
};

/* Test rule using predefined function name */
test_rule = rule $STR <filter_function> {op(a:$1){a}};

/* Test rule using predefined function with parameter */
test_rule2 = rule $STR <$1,length_function> {op(a:$1){a}};

/* Test with op() wrapper for comparison */
test_rule3 = rule $STR <op(a:$1){a.grep("pattern")}> {op(a:$1){a}};

/* Execute tests */
echo("Testing predefined function in rule token:");
result1 = op(parse)("'test pattern data'", test_rule)();
echo("Result 1: " + result1);

echo("Testing predefined function with parameter:");
result2 = op(parse)("'test data'", test_rule2)();
echo("Result 2: " + result2);

echo("Testing op() wrapper for comparison:");
result3 = op(parse)("'test pattern data'", test_rule3)();
echo("Result 3: " + result3); 