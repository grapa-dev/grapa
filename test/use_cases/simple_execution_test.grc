/* Simple execution test for predefined functions in rule tokens */

echo("=== Simple execution test ===");

/* Define a simple rule for testing */
x = rule $STR {@<lit,{$1}>};

/* Test rule with predefined function */
test_rule = rule $INT <x,@<len,{@<this>}>> $INT {op(a:$2){a}};

echo("Rule created, testing execution:");

/* Test execution */
result = op()("44 'test data' 22", test_rule)();
echo("Result: " + result);

/* Test with different input */
result2 = op()("10 'hello' 20", test_rule)();
echo("Result 2: " + result2); 