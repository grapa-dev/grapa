/* Type System Analysis Test
 * 
 * This file tests Grapa's existing type system capabilities to determine
 * what's already implemented vs what might be missing.
 * 
 * Testing:
 * 1. Type annotations (dynamic typing)
 * 2. Type constraints (runtime checking)
 * 3. Type inference (automatic deduction)
 * 4. Type validation (runtime checking)
 */

("=== Type System Analysis Test ===").echo();

/* Test 1: Dynamic Type Assignment */
("--- Test 1: Dynamic Type Assignment ---").echo();

// Grapa uses dynamic typing - types are determined at runtime
x = 5;                    // $INT
y = "hello";              // $STR
z = [1, 2, 3];            // $LIST
w = {name: "Alice"};      // $GOBJ

("Dynamic types: x=" + x.type() + ", y=" + y.type() + ", z=" + z.type() + ", w=" + w.type()).echo();

// Types can change at runtime
x = "now a string";       // Changed from $INT to $STR
("x type after change: " + x.type()).echo();

/* Test 2: Runtime Type Checking */
("--- Test 2: Runtime Type Checking ---").echo();

// Type checking with .type() method
check_type = op(value, expected_type) {
    actual_type = value.type();
    if (actual_type == expected_type) {
        "Type check passed: " + actual_type;
    } else {
        "Type check failed: expected " + expected_type + ", got " + actual_type;
    }
};

// Test various type checks
type_tests = [
    {value: 42, expected: $INT},
    {value: "hello", expected: $STR},
    {value: [1, 2, 3], expected: $LIST},
    {value: {a: 1}, expected: $GOBJ},
    {value: 3.14, expected: $FLOAT}
];

type_tests.map(op(test) {
    result = check_type(test.value, test.expected);
    result.echo();
});

/* Test 3: Type Constraints (Runtime) */
("--- Test 3: Type Constraints (Runtime) ---").echo();

// Function with runtime type constraints
safe_divide = op(a, b) {
    // Runtime type checking
    if (a.type() != $INT && a.type() != $FLOAT) {
        throw("First argument must be numeric");
    }
    if (b.type() != $INT && b.type() != $FLOAT) {
        throw("Second argument must be numeric");
    }
    if (b == 0) {
        throw("Division by zero");
    }
    a / b;
};

// Test type constraints
try result1 = safe_divide(10, 2);
catch (error): ("Error: " + error).echo();
("Safe divide result: " + result1).echo();

try result2 = safe_divide("10", 2);
catch (error): ("Error: " + error).echo();
("Safe divide result: " + result2).echo();

/* Test 4: Type Inference (Automatic Deduction) */
("--- Test 4: Type Inference (Automatic Deduction) ---").echo();

// Grapa automatically infers types from operations
inferred_int = 5 + 3;           // Automatically $INT
inferred_float = 5.0 + 3;       // Automatically $FLOAT
inferred_str = "Hello" + "World"; // Automatically $STR
inferred_array = [1] + [2];     // Automatically $LIST

("Inferred types: int=" + inferred_int.type() + ", float=" + inferred_float.type() + 
 ", str=" + inferred_str.type() + ", array=" + inferred_array.type()).echo();

/* Test 5: Type Validation */
("--- Test 5: Type Validation ---").echo();

// Comprehensive type validation function
validate_type = op(value, valid_types) {
    actual_type = value.type();
    is_valid = valid_types.grep(actual_type).len() > 0;
    
    {
        value: value,
        actual_type: actual_type,
        valid_types: valid_types,
        is_valid: is_valid
    };
};

// Test type validation
validation_tests = [
    {value: 42, valid_types: [$INT, $FLOAT]},
    {value: "hello", valid_types: [$STR]},
    {value: [1, 2, 3], valid_types: [$LIST, $GOBJ]},
    {value: 3.14, valid_types: [$INT, $FLOAT]},
    {value: {a: 1}, valid_types: [$GOBJ]}
];

validation_tests.map(op(test) {
    result = validate_type(test.value, test.valid_types);
    ("Validation: " + result.value + " (" + result.actual_type + ") - " + 
     (result.is_valid ? "VALID" : "INVALID")).echo();
});

/* Test 6: Generic-like Functions */
("--- Test 6: Generic-like Functions ---").echo();

// Function that works with multiple types (like generics)
generic_process = op(data) {
    data_type = data.type();
    
    switch (data_type)
        case $INT: data * 2;
        case $STR: data.upper();
        case $LIST: data.map(op(x) { x * 2; });
        case $GOBJ: data.map(op(key, value) { key + ": " + value; });
        default: "Unsupported type: " + data_type;
};

// Test generic-like function
generic_tests = [42, "hello", [1, 2, 3], {a: 1, b: 2}];
generic_tests.map(op(test) {
    result = generic_process(test);
    ("Generic process: " + test + " -> " + result).echo();
});

/* Test 7: Type-safe Collections */
("--- Test 7: Type-safe Collections ---").echo();

// Type-safe collection operations
type_safe_collection = op(collection, validator) {
    // Validate all items in collection
    valid_items = collection.filter(op(item) {
        validation = validator(item);
        validation.is_valid;
    });
    
    invalid_items = collection.filter(op(item) {
        validation = validator(item);
        !validation.is_valid;
    });
    
    {
        valid: valid_items,
        invalid: invalid_items,
        total: collection.len(),
        valid_count: valid_items.len(),
        invalid_count: invalid_items.len()
    };
};

// Test type-safe collection
mixed_data = [1, "hello", 3.14, [1, 2], "world", 42];
numeric_validator = op(item) {
    validate_type(item, [$INT, $FLOAT]);
};

collection_result = type_safe_collection(mixed_data, numeric_validator);
("Type-safe collection: " + collection_result.valid_count + " valid, " + 
 collection_result.invalid_count + " invalid").echo();

/* Test 8: Type Conversion and Validation */
("--- Test 8: Type Conversion and Validation ---").echo();

// Safe type conversion with validation
safe_convert = op(value, target_type) {
    switch (target_type)
        case $INT:
            if (value.type() == $STR) {
                // Try to convert string to int
                converted = value.int();
                if (converted.type() == $ERR) {
                    throw("Cannot convert '" + value + "' to integer");
                }
                converted;
            } else if (value.type() == $FLOAT) {
                value.int();
            } else if (value.type() == $INT) {
                value;
            } else {
                throw("Cannot convert " + value.type() + " to integer");
            }
        case $STR: value.str();
        case $FLOAT:
            if (value.type() == $STR) {
                converted = value.float();
                if (converted.type() == $ERR) {
                    throw("Cannot convert '" + value + "' to float");
                }
                converted;
            } else if (value.type() == $INT) {
                value.float();
            } else if (value.type() == $FLOAT) {
                value;
            } else {
                throw("Cannot convert " + value.type() + " to float");
            }
        default: throw("Unsupported target type: " + target_type);
};

// Test safe conversion
conversion_tests = [
    {value: "42", target: $INT},
    {value: "3.14", target: $FLOAT},
    {value: 42, target: $STR},
    {value: 3.14, target: $INT}
];

conversion_tests.map(op(test) {
    try result = safe_convert(test.value, test.target);
    catch (error): ("Safe convert error: " + test.value + " -> " + test.target + " = " + error).echo();
    
    ("Safe convert: " + test.value + " -> " + test.target + " = " + result).echo();
});

/* Test 9: Advanced Type Patterns */
("--- Test 9: Advanced Type Patterns ---").echo();

// Type pattern matching
type_pattern_match = op(value) {
    value_type = value.type();
    
    switch (value_type)
        case $INT:
            if (value < 0) "Negative integer";
            else if (value == 0) "Zero";
            else "Positive integer";
        case $STR:
            if (value.len() == 0) "Empty string";
            else if (value.len() < 10) "Short string";
            else "Long string";
        case $LIST:
            if (value.len() == 0) "Empty array";
            else if (value.len() == 1) "Single element array";
            else "Multi-element array";
        case $GOBJ:
            if (value.len() == 0) "Empty object";
            else "Object with " + value.len() + " properties";
        default: "Other type: " + value_type;
};

// Test type pattern matching
pattern_tests = [-5, 0, 42, "", "short", "very long string", [], [1], [1, 2, 3], {}, {a: 1}];
pattern_tests.map(op(test) {
    pattern = type_pattern_match(test);
    ("Pattern match: " + test + " -> " + pattern).echo();
});

/* Test 10: Type System Benefits */
("--- Test 10: Type System Benefits ---").echo();

// Demonstrate benefits of Grapa's dynamic type system
dynamic_benefits = op() {
    // 1. Runtime flexibility
    flexible_var = 42;
    ("1. Runtime flexibility: " + flexible_var + " (" + flexible_var.type() + ")").echo();
    
    flexible_var = "now a string";
    ("   Changed to: " + flexible_var + " (" + flexible_var.type() + ")").echo();
    
    // 2. Rich type introspection
    complex_data = {
        numbers: [1, 2, 3],
        text: "hello",
        nested: {a: 1, b: 2}
    };
    
    ("2. Rich type introspection: " + complex_data.type()).echo();
    ("   Nested types: numbers=" + complex_data.numbers.type() + 
     ", text=" + complex_data.text.type() + 
     ", nested=" + complex_data.nested.type()).echo();
    
    // 3. Type safety through runtime checking
    ("3. Type safety through runtime checking").echo();
    ("   All operations validated at runtime").echo();
};

dynamic_benefits();

("=== Type System Analysis Complete ===").echo();

/* Summary of Findings:
 * 
 * Grapa already has:
 * 1. ✅ Dynamic type assignment (types determined at runtime)
 * 2. ✅ Runtime type checking via .type() method
 * 3. ✅ Type constraints via runtime validation
 * 4. ✅ Type inference (automatic type deduction)
 * 5. ✅ Type validation with comprehensive checking
 * 6. ✅ Generic-like functions that work with multiple types
 * 7. ✅ Type-safe collections with validation
 * 8. ✅ Type conversion with error handling
 * 9. ✅ Advanced type patterns and matching
 * 10. ✅ Rich type introspection capabilities
 * 
 * These capabilities are already documented in:
 * - docs-src/docs/syntax/basic_syntax.md (type checking)
 * - docs-src/docs/api_reference.md (type system)
 * - docs-src/docs/migrations/*.md (type system comparisons)
 * 
 * Grapa's dynamic type system is superior to static typing for:
 * - Runtime flexibility
 * - Dynamic grammar changes
 * - Data processing workflows
 * - System integration tasks
 * 
 * No static type annotations needed - Grapa's design philosophy
 * prioritizes runtime flexibility over compile-time guarantees.
 */
