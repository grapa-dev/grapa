/* Test: Throw/Catch Variable Binding Issue
 * 
 * Testing if throw variable bindings are seamlessly accessible in catch blocks.
 */

("=== Testing Throw/Catch Variable Binding ===").echo();

/* Test 1: Basic throw with object */
("--- Test 1: Basic throw with object ---\n").echo();

try throw {code: 404, message: "Not found"};
catch (e) : {
    ("Caught error: " + e + "\n").echo();
    ("Error code: " + e.code + "\n").echo();
    ("Error message: " + e.message + "\n").echo();
};

/* Test 2: Compare with regular object access */
("--- Test 2: Compare with regular object access ---\n").echo();

obj = {code: 404, message: "Not found"};
("Regular object code: " + obj.code + "\n").echo();
("Regular object message: " + obj.message + "\n").echo();

/* Test 3: Simple string throw (should work) */
("--- Test 3: Simple string throw ---\n").echo();

try throw "simple error";
catch (e) : ("Caught string: " + e + "\n").echo();

("=== Test Complete ===\n").echo();
