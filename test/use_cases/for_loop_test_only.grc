/* ========================================
 * For Loop Test Only
 * ======================================== */

/* Pattern 1: Start-to-end for loop */
custom_command = rule for $ID from <$comp> to <$comp> <$command> {
    op(var:$2, start:$4, end:$6, body:$8){
        start_val = start();
        end_val = end();
        
        if (start_val.type() != $INT || end_val.type() != $INT) {
            ("Error: Start and end must be integers").echo();
            return;
        };
        
        @@var = start_val;
        
        while (@@var <= end_val) {
            body();
            @@var += 1;
        };
    }
};

/* ========================================
 * TEST
 * ======================================== */

("=== For Loop Test Only ===").echo();

/* Test for loop */
("Testing For Loop...").echo();
for i from 1 to 2 {
    ("  Loop: " + i).echo();
};

("=== For Loop Test Complete ===").echo(); 