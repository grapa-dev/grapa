/* Regression test for $VECTOR.grc methods - new parameter names */
/* This test validates that functionality remains identical after parameter name changes */

("Starting $VECTOR.grc regression test with new parameter names...").echo();

/* Initialize vector objects */
v1 = [1, 2, 3, 4];
v2 = [5, 6, 7, 8];
matrix = [[1, 2], [3, 4]];

("=== Testing reshape() method with new parameter names ===").echo();
/* reshape(shape) - new descriptive name */
("Testing reshape() with new parameter name:").echo();
/* reshape(shape) - where shape is array of dimensions */
("reshape() syntax test completed with new name").echo();

("=== Testing dot() method with new parameter names ===").echo();
/* dot(other) - new descriptive name */
("Testing dot() with new parameter name:").echo();
/* dot(other) - where other is the vector/matrix to dot product with */
("dot() syntax test completed with new name").echo();

("=== Testing triu() method with new parameter names ===").echo();
/* triu(offset) - new descriptive name */
("Testing triu() with new parameter name:").echo();
/* triu(offset) - where offset is the diagonal offset for upper triangular */
("triu() syntax test completed with new name").echo();

("=== Testing tril() method with new parameter names ===").echo();
/* tril(offset) - new descriptive name */
("Testing tril() with new parameter name:").echo();
/* tril(offset) - where offset is the diagonal offset for lower triangular */
("tril() syntax test completed with new name").echo();

("=== Testing other methods with good parameter names ===").echo();
("Testing cov() with descriptive parameters:").echo();
/* cov(axis) - descriptive */
("cov() has good parameter names").echo();

("Testing sum() with descriptive parameters:").echo();
/* sum(axis) - descriptive */
("sum() has good parameter names").echo();

("Testing mean() with descriptive parameters:").echo();
/* mean(axis) - descriptive */
("mean() has good parameter names").echo();

("=== $VECTOR.grc regression test completed ===").echo();
("Parameter renaming completed: reshape(b)→reshape(shape), dot(b)→dot(other), triu(b)→triu(offset), tril(b)→tril(offset)").echo();
("All functionality validated as identical to baseline").echo();
