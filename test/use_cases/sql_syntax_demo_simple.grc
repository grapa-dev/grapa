/* Simple SQL Syntax Demo - Demonstrating custom_command vs custom_function */

("=== Simple SQL Syntax Demo ===").echo();

/* Create a simple table */
table = $file().table("ROW");
table.mkfield("name", "STR", "VAR");
table.mkfield("age", "INT");

/* Add some data */
table.set("user1", "John", "name");
table.set("user1", 25, "age");
table.set("user2", "Jane", "name");
table.set("user2", 30, "age");

("Table created with 2 users.\n").echo();

/* Define SELECT as custom_command (action) */
("Defining SELECT as custom_command...").echo();
custom_command = rule select $STR from $STR {op(fields:$2,table_name:$4){
    ("SELECT " + fields + " FROM " + table_name).echo();
    
    if (table_name == "users") {
        records = table.ls();
        ("Found " + records.len() + " records:").echo();
        
        i = 0;
        while (i < records.len()) {
            record = records[i];
            key = record.getname(1);
            name = table.get(key, "name");
            age = table.get(key, "age");
            ("  " + name + " (age " + age + ")").echo();
            i = i + 1;
        };
    } else {
        ("Unknown table: " + table_name).echo();
    };
}};

/* Define COUNT as custom_function (returns value) */
("Defining COUNT as custom_function...").echo();
custom_function = rule count '(' $STR ')' from $STR {op(field:$3,table_name:$6){
    ("COUNT(" + field + ") FROM " + table_name).echo();
    
    if (table_name == "users") {
        records = table.ls();
        count = records.len();
        ("Count: " + count).echo();
        return count;
    } else {
        ("Unknown table: " + table_name).echo();
        return 0;
    };
}};

("Custom syntax defined!\n").echo();

/* Test custom_command (action) */
("Testing SELECT (custom_command - action):").echo();
op(parse)("select * from users")();

("\n").echo();

/* Test custom_function (expression) */
("Testing COUNT (custom_function - expression):").echo();
user_count = op(parse)("count(*) from users")();
("User count variable: " + user_count).echo();

("\n").echo();

/* Demonstrate the difference in usage */
("Demonstrating usage difference:").echo();
("1. SELECT is an action (displays results):").echo();
op(parse)("select * from users")();

("2. COUNT is an expression (returns a value):").echo();
total = op(parse)("count(*) from users")();
("Total users: " + total).echo();

("3. You can use COUNT in expressions:").echo();
if (op(parse)("count(*) from users")() > 1) {
    ("There are multiple users").echo();
} else {
    ("There is only one user").echo();
};

("\n=== Demo Complete ===").echo(); 