/* Corrected BNF Integration Approach
 * 
 * This demonstrates the proper way to add new syntax using custom_command
 * while leveraging existing $comp and $command rules, just like if/while do.
 */

/* For Loops - Using same pattern as if/while */
custom_command = rule for '(' <$comp> ';' <$comp> ';' <$comp> ')' <$command> {
    op(init:$3, condition:$5, increment:$7, body:$9){
        /* Execute initialization */
        op()(init)();
        
        /* Main loop */
        while (op()(condition)()) {
            op()(body)();
            op()(increment)();
        };
    }
};

custom_command = rule for $ID in <$comp> <$command> {
    op(var:$2, iterable:$4, body:$6){
        /* Get the iterable */
        items = op()(iterable)();
        
        /* Iterate through items */
        i = 0;
        while (i < items.len()) {
            /* Set the loop variable */
            op()(var + " = " + items[i])();
            
            /* Execute body */
            op()(body)();
            
            i += 1;
        };
    }
};

custom_command = rule for $ID from <$comp> to <$comp> <$command> {
    op(var:$2, start:$4, end:$6, body:$8){
        /* Initialize loop variable */
        op()(var + " = " + start)();
        
        /* Main loop */
        while (op()(var + " <= " + end)()) {
            op()(body)();
            op()(var + " = " + var + " + 1")();
        };
    }
};

custom_command = rule for $ID from <$comp> to <$comp> step <$comp> <$command> {
    op(var:$2, start:$4, end:$6, step:$8, body:$10){
        /* Initialize loop variable */
        op()(var + " = " + start)();
        
        /* Main loop */
        while (op()(var + " <= " + end)()) {
            op()(body)();
            op()(var + " = " + var + " + " + step)();
        };
    }
};

/* Enhanced Assignment Operators - Using $comp patterns */
custom_function = rule <$comp> '*=' <$comp> {
    op(left:$1, right:$3){
        result = op()(left)() * op()(right)();
        op()(left + " = " + result)();
        result;
    }
};

custom_function = rule <$comp> '/=' <$comp> {
    op(left:$1, right:$3){
        right_val = op()(right)();
        if (right_val == 0) {
            $err("Division by zero");
        } else {
            result = op()(left)() / right_val;
            op()(left + " = " + result)();
            result;
        };
    }
};

custom_function = rule <$comp> '%=' <$comp> {
    op(left:$1, right:$3){
        right_val = op()(right)();
        if (right_val == 0) {
            $err("Modulo by zero");
        } else {
            result = op()(left)() % right_val;
            op()(left + " = " + result)();
            result;
        };
    }
};

custom_function = rule <$comp> '**=' <$comp> {
    op(left:$1, right:$3){
        result = op()(left)() ** op()(right)();
        op()(left + " = " + result)();
        result;
    }
};

/* String Interpolation - Using $comp patterns */
custom_function = rule '$' '{' <$comp> '}' {
    op(expression:$3){
        result = op()(expression)();
        result.str();
    }
};

/* Range Function - Using $comp patterns */
custom_function = rule range '(' <$comp> ')' {
    op(stop:$3){
        stop_val = op()(stop)();
        result = [];
        i = 0;
        while (i < stop_val) {
            result.append(i);
            i += 1;
        };
        result;
    }
};

custom_function = rule range '(' <$comp> ',' <$comp> ')' {
    op(start:$3, stop:$5){
        start_val = op()(start)();
        stop_val = op()(stop)();
        result = [];
        i = start_val;
        while (i < stop_val) {
            result.append(i);
            i += 1;
        };
        result;
    }
};

custom_function = rule range '(' <$comp> ',' <$comp> ',' <$comp> ')' {
    op(start:$3, stop:$5, step:$7){
        start_val = op()(start)();
        stop_val = op()(stop)();
        step_val = op()(step)();
        
        if (step_val == 0) {
            $err("Range step cannot be zero");
        };
        
        result = [];
        i = start_val;
        while (i < stop_val) {
            result.append(i);
            i += step_val;
        };
        result;
    }
};

/* Ternary Operator - Using $comp patterns */
custom_function = rule <$comp> '?' <$comp> ':' <$comp> {
    op(condition:$1, true_value:$3, false_value:$5){
        if (op()(condition)()) {
            op()(true_value)();
        } else {
            op()(false_value)();
        };
    }
};

/* List Comprehension - Using $comp patterns */
custom_function = rule '[' <$comp> for $ID in <$comp> ']' {
    op(expression:$2, var:$4, iterable:$6){
        items = op()(iterable)();
        result = [];
        
        i = 0;
        while (i < items.len()) {
            /* Set the variable */
            op()(var + " = " + items[i])();
            
            /* Evaluate expression */
            value = op()(expression)();
            result.append(value);
            
            i += 1;
        };
        
        result;
    }
};

custom_function = rule '[' <$comp> for $ID in <$comp> if <$comp> ']' {
    op(expression:$2, var:$4, iterable:$6, condition:$8){
        items = op()(iterable)();
        result = [];
        
        i = 0;
        while (i < items.len()) {
            /* Set the variable */
            op()(var + " = " + items[i])();
            
            /* Check condition */
            if (op()(condition)()) {
                /* Evaluate expression */
                value = op()(expression)();
                result.append(value);
            };
            
            i += 1;
        };
        
        result;
    }
};

/* Spaceship Operator - Using $comp patterns */
custom_function = rule <$comp> '<=>' <$comp> {
    op(left:$1, right:$3){
        left_val = op()(left)();
        right_val = op()(right)();
        
        if (left_val < right_val) {
            -1;
        } else if (left_val == right_val) {
            0;
        } else {
            1;
        };
    }
};

/* Test the implementations */
("=== Testing Corrected BNF Integration ===").echo();

/* Test For Loops */
("Testing for loops...").echo();

/* C-style for loop */
for (i=0; i<3; i++) {
    ("C-style loop iteration: " + i).echo();
};

/* Range-based for loop */
for x in [1, 2, 3] {
    ("Range loop: " + x).echo();
};

/* From-to for loop */
for j from 1 to 3 {
    ("From-to loop: " + j).echo();
};

/* From-to-step for loop */
for k from 0 to 6 step 2 {
    ("From-to-step loop: " + k).echo();
};

/* Test Enhanced Assignment */
("Testing enhanced assignment...").echo();
x = 10;
x *= 3;
("x *= 3: " + x).echo();

y = 20;
y /= 4;
("y /= 4: " + y).echo();

z = 15;
z %= 7;
("z %= 7: " + z).echo();

w = 2;
w **= 3;
("w **= 3: " + w).echo();

/* Test String Interpolation */
("Testing string interpolation...").echo();
name = "World";
message = "Hello ${name}!";
message.echo();

/* Test Range Function */
("Testing range function...").echo();
r1 = range(5);
("range(5): " + r1).echo();

r2 = range(1, 6);
("range(1, 6): " + r2).echo();

r3 = range(0, 10, 2);
("range(0, 10, 2): " + r3).echo();

/* Test Ternary Operator */
("Testing ternary operator...").echo();
result1 = 5 > 3 ? "yes" : "no";
("5 > 3 ? 'yes' : 'no': " + result1).echo();

result2 = 2 > 5 ? "yes" : "no";
("2 > 5 ? 'yes' : 'no': " + result2).echo();

/* Test List Comprehension */
("Testing list comprehension...").echo();
squares = [x * x for x in [1, 2, 3, 4, 5]];
("Squares: " + squares).echo();

evens = [x for x in [1, 2, 3, 4, 5, 6] if x % 2 == 0];
("Evens: " + evens).echo();

/* Test Spaceship Operator */
("Testing spaceship operator...").echo();
("5 <=> 3: " + (5 <=> 3)).echo();
("3 <=> 3: " + (3 <=> 3)).echo();
("3 <=> 5: " + (3 <=> 5)).echo();

("=== All tests completed successfully! ===").echo(); 