/*
 * Improved For Loop Implementation
 * 
 * Using the @var syntax for indirect variable assignment.
 * Based on the discovery that @@var can be used for indirect access.
 */

/* ========================================
 * Pattern 1: Start-to-end for loop with @var syntax
 * for var from start to end { body }
 * ======================================== */
custom_command = rule for $ID from <$comp> to <$comp> <$command> {
    op(var:$2, start:$4, end:$6, body:$8){
        /* Validate inputs */
        start_val = start();
        end_val = end();
        
        if (start_val.type() != "$INT" || end_val.type() != "$INT") {
            ("Error: Start and end must be integers").echo();
            return;
        };
        
        /* Set initial value using @var syntax */
        @@var = start_val;
        
        /* Loop from start to end (inclusive) */
        while (@@var <= end_val) {
            /* Execute the loop body */
            body();
            
            /* Increment using @var syntax */
            @@var += 1;
        };
    }
};

/* ========================================
 * Pattern 2: Start-to-end with step
 * for var from start to end step increment { body }
 * ======================================== */
custom_command = rule for $ID from <$comp> to <$comp> step <$comp> <$command> {
    op(var:$2, start:$4, end:$6, step:$8, body:$10){
        /* Validate inputs */
        start_val = start();
        end_val = end();
        step_val = step();
        
        if (start_val.type() != "$INT" || end_val.type() != "$INT" || step_val.type() != "$INT") {
            ("Error: Start, end, and step must be integers").echo();
            return;
        };
        
        if (step_val == 0) {
            ("Error: Step cannot be zero").echo();
            return;
        };
        
        /* Set initial value */
        @@var = start_val;
        
        /* Loop with step */
        if (step_val > 0) {
            /* Forward iteration */
            while (@@var <= end_val) {
                body();
                @@var += step_val;
            };
        } else {
            /* Backward iteration */
            while (@@var >= end_val) {
                body();
                @@var += step_val;
            };
        };
    }
};

/* ========================================
 * Pattern 3: Range-based for loop
 * for var in range { body }
 * ======================================== */
custom_command = rule for $ID in <$comp> <$command> {
    op(var:$2, range:$4, body:$6){
        /* Handle different range types */
        if (range().type() == "$INT") {
            /* Single integer - iterate from 0 to range-1 */
            @@var = 0;
            while (@@var < range()) {
                body();
                @@var += 1;
            };
        } else if (range().type() == "$LIST" || range().type() == "$ARRAY") {
            /* List/Array iteration */
            i = 1;
            while (i <= range().len()) {
                @@var = range()[i];
                body();
                i += 1;
            };
        } else if (range().type() == "$STR") {
            /* String iteration - character by character */
            i = 1;
            while (i <= range().len()) {
                @@var = range()[i];
                body();
                i += 1;
            };
        } else {
            ("Error: Cannot iterate over type " + range().type()).echo();
        };
    }
};

/* ========================================
 * COMPREHENSIVE TESTING
 * ======================================== */

("=== IMPROVED FOR LOOP IMPLEMENTATION TESTS ===").echo();
("").echo();

/* Test 1: Basic for loop with @var syntax */
("Test 1: Basic for loop (1 to 3)").echo();
for i from 1 to 3 {
    ("  Loop iteration: " + i).echo();
};
("").echo();

/* Test 2: For loop with step */
("Test 2: For loop with step (0 to 10, step 2)").echo();
for j from 0 to 10 step 2 {
    ("  Even number: " + j).echo();
};
("").echo();

/* Test 3: Backward iteration */
("Test 3: Backward iteration (5 to 1, step -1)").echo();
for k from 5 to 1 step -1 {
    ("  Countdown: " + k).echo();
};
("").echo();

/* Test 4: Range-based iteration */
("Test 4: Range-based iteration (0 to 4)").echo();
for x in 5 {
    ("  Range iteration: " + x).echo();
};
("").echo();

/* Test 5: List iteration */
("Test 5: List iteration").echo();
numbers = [10, 20, 30, 40];
for num in numbers {
    ("  List item: " + num).echo();
};
("").echo();

/* Test 6: String iteration */
("Test 6: String iteration").echo();
text = "Hello";
for char in text {
    ("  Character: " + char).echo();
};
("").echo();

/* Test 7: Variable scope test */
("Test 7: Variable scope test").echo();
outer_var = 100;
for test_var from 1 to 2 {
    ("  Inside loop: test_var = " + test_var + ", outer_var = " + outer_var).echo();
};
("  Outside loop: outer_var = " + outer_var).echo();
("").echo();

("=== ALL TESTS COMPLETED SUCCESSFULLY ===").echo(); 