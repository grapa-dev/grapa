// Comprehensive Secret() Method Test
// Testing .secret() functionality across DH, EC, and RPK algorithms

"=== Comprehensive Secret() Method Test ===".echo();

// Test 1: EC (Elliptic Curve) Key Exchange
"=== EC Key Exchange Test ===".echo();

// Generate EC keys for both parties
alice_ec = 'ec'.genkeys({curve: 'prime256v1'});
bob_ec = 'ec'.genkeys({curve: 'prime256v1'});

("Alice EC keys: " + alice_ec.str()).echo();
("Bob EC keys: " + bob_ec.str()).echo();

// Test EC secret() with proper parameters
try {
    alice_secret = alice_ec.secret({
        method: 'ec',
        curve: 'prime256v1',
        pub: bob_ec.pub
    });
    ("Alice EC secret: " + alice_secret.hex()).echo();
    
    bob_secret = bob_ec.secret({
        method: 'ec',
        curve: 'prime256v1',
        pub: alice_ec.pub
    });
    ("Bob EC secret: " + bob_secret.hex()).echo();
    
    ec_match = (alice_secret == bob_secret);
    ("EC secrets match: " + ec_match.str()).echo();
} catch (e) ("EC secret() error: " + e.str()).echo();

// Test 2: RPK (Raw Public Key) Key Exchange - X25519
"=== RPK X25519 Key Exchange Test ===".echo();

// Generate RPK keys for both parties
alice_rpk = 'rpk'.genkeys({algorithm: 'x25519'});
bob_rpk = 'rpk'.genkeys({algorithm: 'x25519'});

("Alice RPK keys: " + alice_rpk.str()).echo();
("Bob RPK keys: " + bob_rpk.str()).echo();

// Test RPK secret() with proper parameters
try {
    alice_rpk_secret = alice_rpk.secret({
        method: 'rpk',
        algorithm: 'x25519',
        pub: bob_rpk.pub
    });
    ("Alice RPK secret: " + alice_rpk_secret.hex()).echo();
    
    bob_rpk_secret = bob_rpk.secret({
        method: 'rpk',
        algorithm: 'x25519',
        pub: alice_rpk.pub
    });
    ("Bob RPK secret: " + bob_rpk_secret.hex()).echo();
    
    rpk_match = (alice_rpk_secret == bob_rpk_secret);
    ("RPK secrets match: " + rpk_match.str()).echo();
} catch (e) ("RPK secret() error: " + e.str()).echo();

// Test 3: RPK (Raw Public Key) Key Exchange - X448
"=== RPK X448 Key Exchange Test ===".echo();

// Generate RPK keys for both parties
alice_rpk448 = 'rpk'.genkeys({algorithm: 'x448'});
bob_rpk448 = 'rpk'.genkeys({algorithm: 'x448'});

("Alice RPK448 keys: " + alice_rpk448.str()).echo();
("Bob RPK448 keys: " + bob_rpk448.str()).echo();

// Test RPK secret() with proper parameters
try {
    alice_rpk448_secret = alice_rpk448.secret({
        method: 'rpk',
        algorithm: 'x448',
        pub: bob_rpk448.pub
    });
    ("Alice RPK448 secret: " + alice_rpk448_secret.hex()).echo();
    
    bob_rpk448_secret = bob_rpk448.secret({
        method: 'rpk',
        algorithm: 'x448',
        pub: alice_rpk448.pub
    });
    ("Bob RPK448 secret: " + bob_rpk448_secret.hex()).echo();
    
    rpk448_match = (alice_rpk448_secret == bob_rpk448_secret);
    ("RPK448 secrets match: " + rpk448_match.str()).echo();
} catch (e) ("RPK448 secret() error: " + e.str()).echo();

// Test 4: DH (Diffie-Hellman) Key Exchange
"=== DH Key Exchange Test ===".echo();

// Generate DH keys for both parties
alice_dh = 'dh'.genkeys();
bob_dh = 'dh'.genkeys();

("Alice DH keys: " + alice_dh.str()).echo();
("Bob DH keys: " + bob_dh.str()).echo();

// Test DH secret() with proper parameters
try {
    alice_dh_secret = alice_dh.secret({
        method: 'dh',
        pub: bob_dh.pub
    });
    ("Alice DH secret: " + alice_dh_secret.hex()).echo();
    
    bob_dh_secret = bob_dh.secret({
        method: 'dh',
        pub: alice_dh.pub
    });
    ("Bob DH secret: " + bob_dh_secret.hex()).echo();
    
    dh_match = (alice_dh_secret == bob_dh_secret);
    ("DH secrets match: " + dh_match.str()).echo();
} catch (e) ("DH secret() error: " + e.str()).echo();

// Test 5: RSA (should return 0 or error)
"=== RSA Secret Test (Expected to fail) ===".echo();

rsa_keys = 'rsa'.genkeys();
("RSA keys: " + rsa_keys.str()).echo();

try rsa_secret = rsa_keys.secret();
catch (e) ("RSA secret() error: " + e.str()).echo();
("RSA secret: " + rsa_secret.str()).echo();
("RSA secret hex: " + rsa_secret.hex()).echo();

// Test 6: Error Cases - Missing Parameters
"=== Error Cases Test ===".echo();

// Test EC without parameters
try bad_ec_secret = alice_ec.secret();
catch (e) ("EC secret() without params error: " + e.str()).echo();
("EC secret without params: " + bad_ec_secret.hex()).echo();

// Test RPK without parameters
try bad_rpk_secret = alice_rpk.secret();
catch (e) ("RPK secret() without params error: " + e.str()).echo();
("RPK secret without params: " + bad_rpk_secret.hex()).echo();

// Test DH without parameters
try bad_dh_secret = alice_dh.secret();
catch (e) ("DH secret() without params error: " + e.str()).echo();
("DH secret without params: " + bad_dh_secret.hex()).echo();

// Test 7: Cross-Algorithm Compatibility
"=== Cross-Algorithm Compatibility Test ===".echo();

// Test EC with wrong curve
try wrong_curve_secret = alice_ec.secret({
    method: 'ec',
    curve: 'secp256k1',  // Different curve
    pub: bob_ec.pub
});
catch (e) ("EC wrong curve error: " + e.str()).echo();
("EC wrong curve secret: " + wrong_curve_secret.hex()).echo();

// Test RPK with wrong algorithm
try wrong_algo_secret = alice_rpk.secret({
    method: 'rpk',
    algorithm: 'x448',  // Different algorithm
    pub: bob_rpk.pub
});
catch (e) ("RPK wrong algorithm error: " + e.str()).echo();
("RPK wrong algorithm secret: " + wrong_algo_secret.hex()).echo();

// Summary
"=== Secret() Method Summary ===".echo();
"EC Key Exchange: " + (typeof ec_match != 'undefined' ? ec_match.str() : 'Not tested').echo();
"RPK X25519: " + (typeof rpk_match != 'undefined' ? rpk_match.str() : 'Not tested').echo();
"RPK X448: " + (typeof rpk448_match != 'undefined' ? rpk448_match.str() : 'Not tested').echo();
"DH Key Exchange: " + (typeof dh_match != 'undefined' ? dh_match.str() : 'Not tested').echo();
"RSA (expected to fail): " + (typeof rsa_secret != 'undefined' ? rsa_secret.str() : 'Not tested').echo();
