/* ========================================
 * Enhanced Assignment Test Only
 * ======================================== */

/* *= operator */
custom_function = rule <$comp> '*=' <$comp> {
    op(left:$1, right:$3){
        left_val = left();
        right_val = right();
        result = left_val * right_val;
        @@left = result;
        result;
    }
};

/* ========================================
 * TEST
 * ======================================== */

("=== Enhanced Assignment Test Only ===").echo();

/* Test enhanced assignment */
("Testing Enhanced Assignment...").echo();
x = 5;
("  Before: x = " + x).echo();
x *= 2;
("  After x *= 2: x = " + x).echo();

("=== Enhanced Assignment Test Complete ===").echo(); 