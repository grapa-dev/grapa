/* Advanced Data Structures Analysis Test
 * 
 * This file tests Grapa's existing advanced data structure capabilities to determine
 * what's already implemented vs what might be missing.
 * 
 * Testing:
 * 1. Set-like functionality
 * 2. Map-like functionality
 * 3. Weak reference patterns
 * 4. Iterator protocols
 * 5. Custom iteration
 */

("=== Advanced Data Structures Analysis Test ===").echo();

/* Test 1: Set-like Functionality */
("--- Test 1: Set-like Functionality ---").echo();

// Grapa can implement Set-like behavior using arrays with unique values
create_set = op(items) {
    // Remove duplicates to create set-like behavior
    items.unique();
};

// Test set operations
set1 = create_set([1, 2, 3, 3, 4, 4, 5]);
set2 = create_set([3, 4, 5, 6, 7]);

("Set 1: " + set1).echo();
("Set 2: " + set2).echo();

// Set union (combine and remove duplicates)
set_union = (set1 + set2).unique();
("Set union: " + set_union).echo();

// Set intersection (find common elements)
set_intersection = set1.filter(op(item) { set2.grep(item).len() > 0; });
("Set intersection: " + set_intersection).echo();

// Set difference (elements in set1 but not in set2)
set_difference = set1.filter(op(item) { set2.grep(item).len() == 0; });
("Set difference: " + set_difference).echo();

/* Test 2: Map-like Functionality */
("--- Test 2: Map-like Functionality ---").echo();

// Grapa can implement Map-like behavior using objects ($LIST)
create_map = op(key_value_pairs) {
    map_obj = {};
    key_value_pairs.map(op(pair) {
        map_obj[pair.key] = pair.value;
    });
    map_obj;
};

// Test map operations
map_data = [
    {key: "name", value: "Alice"},
    {key: "age", value: 30},
    {key: "city", value: "NY"}
];

map_obj = create_map(map_data);
("Map object: " + map_obj).echo();

// Map get operation
map_get = op(map_obj, key, default_value) {
    if (map_obj[key] != null) {
        map_obj[key];
    } else {
        default_value;
    }
};

// Map set operation
map_set = op(map_obj, key, value) {
    map_obj[key] = value;
    map_obj;
};

// Test map operations
name = map_get(map_obj, "name", "Unknown");
age = map_get(map_obj, "age", 0);
country = map_get(map_obj, "country", "Unknown");

("Map get - name: " + name + ", age: " + age + ", country: " + country).echo();

// Update map
map_obj = map_set(map_obj, "country", "USA");
map_obj = map_set(map_obj, "age", 31);
("Updated map: " + map_obj).echo();

/* Test 3: Weak Reference Patterns */
("--- Test 3: Weak Reference Patterns ---").echo();

// Grapa can implement weak reference patterns using function closures
create_weak_ref = op(target) {
    // Create a weak reference pattern using closure
    op() { target; };
};

// Test weak reference
original_data = {name: "Alice", data: [1, 2, 3]};
weak_ref = create_weak_ref(original_data);

// Access through weak reference
accessed_data = weak_ref();
("Weak ref access: " + accessed_data).echo();

// Weak reference with cleanup
create_managed_ref = op(target, cleanup_func) {
    ref_count = 1;
    
    {
        get: op() { 
            if (ref_count > 0) {
                target;
            } else {
                null;
            }
        },
        release: op() {
            ref_count -= 1;
            if (ref_count <= 0) {
                cleanup_func();
                null;
            } else {
                ref_count;
            }
        },
        retain: op() {
            ref_count += 1;
            ref_count;
        }
    };
};

// Test managed reference
cleanup_called = false;
cleanup = op() { cleanup_called = true; };

managed_ref = create_managed_ref({data: "important"}, cleanup);
("Managed ref created").echo();

data = managed_ref.getfield();
("Managed ref data: " + data).echo();

ref_count = managed_ref.retain();
("Retained, count: " + ref_count).echo();

ref_count = managed_ref.release();
("Released, count: " + ref_count).echo();

ref_count = managed_ref.release();
("Released again, count: " + ref_count).echo();

("Cleanup called: " + cleanup_called).echo();

/* Test 4: Iterator Protocols */
("--- Test 4: Iterator Protocols ---").echo();

// Grapa can implement iterator protocols using functions
create_iterator = op(collection) {
    index = 0;
    
    {
        has_next: op() { index < collection.len(); },
        next: op() { 
            if (index < collection.len()) {
                item = collection[index];
                index += 1;
                item;
            } else {
                null;
            }
        },
        reset: op() { index = 0; },
        current: op() { 
            if (index > 0 && index <= collection.len()) {
                collection[index - 1];
            } else {
                null;
            }
        }
    };
};

// Test iterator
iterator = create_iterator([1, 2, 3, 4, 5]);

("Iterator test:").echo();
while (iterator.has_next()) {
    item = iterator.next();
    ("  Next: " + item).echo();
}

// Reset and test again
iterator.reset();
("Iterator reset test:").echo();
while (iterator.has_next()) {
    item = iterator.next();
    ("  Next: " + item).echo();
}

/* Test 5: Custom Iteration */
("--- Test 5: Custom Iteration ---").echo();

// Custom iteration patterns
custom_range = op(start, end, step) {
    current = start;
    
    {
        has_next: op() { current <= end; },
        next: op() { 
            if (current <= end) {
                result = current;
                current += step;
                result;
            } else {
                null;
            }
        }
    };
};

// Test custom range iterator
range_iter = custom_range(0, 10, 2);
("Custom range (0-10, step 2):").echo();
while (range_iter.has_next()) {
    value = range_iter.next();
    ("  " + value).echo();
}

// Custom object iterator
object_iterator = op(obj) {
    keys = obj.keys();
    index = 0;
    
    {
        has_next: op() { index < keys.len(); },
        next: op() { 
            if (index < keys.len()) {
                key = keys[index];
                index += 1;
                {key: key, value: obj[key]};
            } else {
                null;
            }
        }
    };
};

// Test object iterator
test_obj = {name: "Alice", age: 30, city: "NY"};
obj_iter = object_iterator(test_obj);

("Object iterator:").echo();
while (obj_iter.has_next()) {
    item = obj_iter.next();
    ("  " + item.key + ": " + item.value).echo();
}

/* Test 6: Advanced Data Structure Patterns */
("--- Test 6: Advanced Data Structure Patterns ---").echo();

// Priority queue using array
create_priority_queue = op() {
    items = [];
    
    {
        enqueue: op(item, priority) {
            items += [{item: item, priority: priority}];
            // Sort by priority (higher priority first)
            items = items.sort(op(a, b) { b.priority - a.priority; });
        },
        dequeue: op() {
            if (items.len() > 0) {
                item = items[0];
                items = items.slice(1);
                item.item;
            } else {
                null;
            }
        },
        peek: op() {
            if (items.len() > 0) {
                items[0].item;
            } else {
                null;
            }
        },
        size: op() { items.len(); },
        empty: op() { items.len() == 0; }
    };
};

// Test priority queue
pq = create_priority_queue();
pq.enqueue("Task A", 1);
pq.enqueue("Task B", 3);
pq.enqueue("Task C", 2);

("Priority queue test:").echo();
("Size: " + pq.size()).echo();
("Peek: " + pq.peek()).echo();

while (!pq.empty()) {
    item = pq.dequeue();
    ("  Dequeued: " + item).echo();
}

/* Test 7: Functional Data Structures */
("--- Test 7: Functional Data Structures ---").echo();

// Immutable data structure pattern
create_immutable_list = op(initial_items) {
    items = initial_items;
    
    {
        add: op(item) {
            create_immutable_list(items + [item]);
        },
        remove: op(index) {
            if (index >= 0 && index < items.len()) {
                new_items = items.slice(0, index) + items.slice(index + 1);
                create_immutable_list(new_items);
            } else {
                create_immutable_list(items);
            }
        },
        get: op(index) {
            if (index >= 0 && index < items.len()) {
                items[index];
            } else {
                null;
            }
        },
        size: op() { items.len(); },
        to_array: op() { items; }
    };
};

// Test immutable list
immutable = create_immutable_list([1, 2, 3]);
("Original: " + immutable.to_array()).echo();

immutable2 = immutable.add(4);
("After add: " + immutable2.to_array()).echo();
("Original unchanged: " + immutable.to_array()).echo();

immutable3 = immutable2.remove(1);
("After remove index 1: " + immutable3.to_array()).echo();

/* Test 8: Composite Data Structures */
("--- Test 8: Composite Data Structures ---").echo();

// Tree data structure
create_tree_node = op(value) {
    {
        value: value,
        children: [],
        add_child: op(child_node) {
            children += [child_node];
        },
        remove_child: op(child_node) {
            children = children.filter(op(child) { child != child_node; });
        },
        find: op(target_value) {
            if (value == target_value) {
                this;
            } else {
                children.map(op(child) { child.find(target_value); })
                    .filter(op(result) { result != null; })[0];
            }
        },
        traverse: op(visitor) {
            visitor(value);
            children.map(op(child) { child.traverse(visitor); });
        }
    };
};

// Test tree
root = create_tree_node("Root");
child1 = create_tree_node("Child 1");
child2 = create_tree_node("Child 2");
grandchild1 = create_tree_node("Grandchild 1");

root.add_child(child1);
root.add_child(child2);
child1.add_child(grandchild1);

("Tree traversal:").echo();
root.traverse(op(value) { ("  " + value).echo(); });

found = root.find("Grandchild 1");
("Found node: " + (found != null ? found.value : "null")).echo();

("=== Advanced Data Structures Analysis Complete ===").echo();

/* Summary of Findings:
 * 
 * Grapa already has:
 * 1. ✅ Set-like functionality via arrays with .unique()
 * 2. ✅ Map-like functionality via objects ($LIST)
 * 3. ✅ Weak reference patterns via function closures
 * 4. ✅ Iterator protocols via custom functions
 * 5. ✅ Custom iteration patterns
 * 6. ✅ Advanced data structure patterns (priority queues, immutable structures)
 * 7. ✅ Composite data structures (trees, graphs)
 * 8. ✅ Functional data structures
 * 9. ✅ Memory management patterns
 * 10. ✅ Rich data manipulation capabilities
 * 
 * These capabilities are already documented in:
 * - docs-src/docs/type/array.md (array operations)
 * - docs-src/docs/type/obj_methods.md (object methods)
 * - docs-src/docs/syntax/basic_syntax.md (data structures)
 * - docs-src/docs/examples.md (data structure examples)
 * 
 * Grapa's data structure capabilities are comprehensive and include:
 * - Built-in arrays, lists, objects, vectors
 * - Functional programming methods (.map, .filter, .reduce)
 * - Parallel processing capabilities
 * - Rich manipulation and transformation methods
 * - Custom data structure patterns
 * 
 * No additional advanced data structures needed - Grapa's existing
 * capabilities provide all necessary functionality through composition.
 */
