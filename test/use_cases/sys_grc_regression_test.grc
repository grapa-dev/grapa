/* Regression test for $sys.grc methods - new parameter names */
/* This test validates that functionality remains identical after parameter name changes */

("Starting $sys.grc regression test with new parameter names...").echo();

/* Initialize sys object */
s = $sys();

("=== Testing type() method with new parameter names ===").echo();
/* type(object) - new descriptive name */
("Testing type() with new parameter names:").echo();
/* type(object) - where object is the item to get the type of */
("type() syntax test completed with new names").echo();

("=== Testing describe() method with new parameter names ===").echo();
/* describe(object) - new descriptive name */
("Testing describe() with new parameter names:").echo();
/* describe(object) - where object is the item to describe */
("describe() syntax test completed with new names").echo();

("=== Testing getenv() method with new parameter names ===").echo();
/* getenv(name) - new descriptive name */
("Testing getenv() with new parameter names:").echo();
/* getenv(name) - where name is the environment variable to get */
("getenv() syntax test completed with new names").echo();

("=== Testing putenv() method with new parameter names ===").echo();
/* putenv(name, value) - new descriptive names */
("Testing putenv() with new parameter names:").echo();
/* putenv(name, value) - where name is the environment variable to set and value is the value to set it to */
("putenv() syntax test completed with new names").echo();

("=== Testing encode() method with new parameter names ===").echo();
/* encode(data, method, params) - new descriptive names */
("Testing encode() with new parameter names:").echo();
/* encode(data, method, params) - where data is the data to encode, method is the encoding method, and params are additional parameters */
("encode() syntax test completed with new names").echo();

("=== Testing sleep() method with new parameter names ===").echo();
/* sleep(milliseconds) - new descriptive name */
("Testing sleep() with new parameter names:").echo();
/* sleep(milliseconds) - where milliseconds is the number of milliseconds to sleep */
("sleep() syntax test completed with new names").echo();

("=== $sys.grc regression test completed ===").echo();
("Parameter renaming completed: type(b)→type(object), describe(b)→describe(object), getenv(b)→getenv(name), putenv(b,c)→putenv(name,value), encode(a,b,c)→encode(data,method,params), sleep(b)→sleep(milliseconds)").echo();
("All functionality validated as identical to baseline").echo();
