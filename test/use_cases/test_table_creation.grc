/* Simple table creation test */

"Testing table creation...".echo();

/* Create a simple table */
table = $file().table("ROW");
("Table created, type: " + table.type()).echo();

/* Add a field */
table.mkfield("name", "STR", "VAR");
"Field added".echo();

/* Set a value */
table.set("key1", "value1", "name");
"Value set".echo();

/* Get the value */
value = table.get("key1", "name");
("Retrieved value: " + value).echo();

"Test complete".echo(); 