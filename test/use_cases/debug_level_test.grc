/* Test to check debug levels */

"Testing debug levels".echo();

/* Test with level 0 */
"Level 0 test:".echo();
"test".debug("test", 0);

/* Test with level 1 */
"Level 1 test:".echo();
"test".debug("test", 1);

/* Test with level 2 */
"Level 2 test:".echo();
"test".debug("test", 2);

/* Test with level -1 */
"Level -1 test:".echo();
"test".debug("test", -1);
