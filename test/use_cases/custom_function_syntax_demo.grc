/*
 * Custom Function Syntax Improvements Demo
 * 
 * This script demonstrates how to use custom_function to extend Grapa's grammar
 * with new syntax that returns values, making it feel natural to developers
 * from Python, JavaScript, and other mainstream languages.
 * 
 * Key difference from custom_command:
 * - custom_command: For actions that don't return values (like loops, commands)
 * - custom_function: For expressions that return values (like operators, functions)
 */

/* Step 1: Enhanced Assignment Operators using custom_function */
("Defining enhanced assignment operators...").echo();

/* *= operator */
custom_function = rule <$litname> '*=' <$comp> {@<assignmul,{$1,$3}>};

/* /= operator */
custom_function = rule <$litname> '/=' <$comp> {@<assigndiv,{$1,$3}>};

/* %= operator */
custom_function = rule <$litname> '%=' <$comp> {@<assignmod,{$1,$3}>};

/* **= operator */
custom_function = rule <$litname> '**=' <$comp> {@<assignpow,{$1,$3}>};

/* Test enhanced assignment operators */
("Testing enhanced assignment operators...").echo();

x = 10;
x *= 3;  /* Should set x = 30 */
("x *= 3: " + x).echo();

y = 100;
y /= 4;  /* Should set y = 25 */
("y /= 4: " + y).echo();

z = 17;
z %= 5;  /* Should set z = 2 */
("z %= 5: " + z).echo();

w = 2;
w **= 3; /* Should set w = 8 */
("w **= 3: " + w).echo();

/* Step 2: String Interpolation using custom_function */
("Defining string interpolation...").echo();

/* Template string interpolation */
custom_function = rule '`' <> '`' {op(template:$2){
    /* Parse template and interpolate variables */
    result = template;
    
    /* Simple variable interpolation: ${var} */
    i = 1;
    while (i <= result.len()) {
        if (result[i] == '$' && i < result.len() && result[i+1] == '{') {
            /* Find closing brace */
            j = i + 2;
            while (j <= result.len() && result[j] != '}') {
                j += 1;
            };
            
            if (j <= result.len()) {
                /* Extract variable name */
                var_name = result.substring(i+2, j-1).trim();
                
                /* Get variable value */
                var_value = op()("@" + var_name)();
                
                /* Replace in template */
                before = result.substring(1, i-1);
                after = result.substring(j+1, result.len());
                result = before + var_value + after;
                
                /* Adjust position */
                i = before.len() + var_value.len();
            };
        };
        i += 1;
    };
    
    result;
}};

/* Test string interpolation */
("Testing string interpolation...").echo();

name = "Alice";
age = 30;
city = "New York";

message = `Hello ${name}, you are ${age} years old and live in ${city}`;
("Interpolated message: " + message).echo();

/* Step 3: Range function using custom_function */
("Defining range function...").echo();

/* Python-style range function */
custom_function = rule range '(' <$comp> ')' {op(end:$3){
    /* Create range from 1 to end */
    result = [];
    i = 1;
    while (i <= end) {
        result += i;
        i += 1;
    };
    result;
}};

custom_function = rule range '(' <$comp> ',' <$comp> ')' {op(start:$3,end:$5){
    /* Create range from start to end */
    result = [];
    i = start;
    while (i <= end) {
        result += i;
        i += 1;
    };
    result;
}};

custom_function = rule range '(' <$comp> ',' <$comp> ',' <$comp> ')' {op(start:$3,end:$5,step:$7){
    /* Create range from start to end with step */
    result = [];
    i = start;
    while (i <= end) {
        result += i;
        i += step;
    };
    result;
}};

/* Test range function */
("Testing range function...").echo();

r1 = range(5);
("range(5): " + r1).echo();

r2 = range(2, 8);
("range(2, 8): " + r2).echo();

r3 = range(0, 10, 2);
("range(0, 10, 2): " + r3).echo();

/* Step 4: Enhanced comparison operators using custom_function */
("Defining enhanced comparison operators...").echo();

/* <=> spaceship operator (returns -1, 0, 1) */
custom_function = rule <$comp> '<=>' <$comp> {op(left:$1,right:$3){
    if (left < right) {
        -1;
    } else if (left > right) {
        1;
    } else {
        0;
    };
}};

/* Test spaceship operator */
("Testing spaceship operator...").echo();

result1 = 5 <=> 10;
("5 <=> 10: " + result1).echo();

result2 = 10 <=> 5;
("10 <=> 5: " + result2).echo();

result3 = 5 <=> 5;
("5 <=> 5: " + result3).echo();

/* Step 5: List comprehension using custom_function */
("Defining list comprehension...").echo();

/* Python-style list comprehension */
custom_function = rule '[' <$comp> for $ID in <$comp> ']' {op(expr:$2,var:$4,items:$6){
    result = [];
    i = 1;
    while (i <= items.len()) {
        /* Set the loop variable */
        op()(var + " = " + items[i])();
        
        /* Evaluate the expression */
        value = op()(expr)();
        result += value;
        
        i += 1;
    };
    result;
}};

/* Test list comprehension */
("Testing list comprehension...").echo();

squares = [x * x for x in range(1, 6)];
("Squares: " + squares).echo();

doubles = [n * 2 for n in [1, 2, 3, 4, 5]];
("Doubles: " + doubles).echo();

/* Step 6: Ternary operator using custom_function */
("Defining ternary operator...").echo();

/* JavaScript-style ternary operator */
custom_function = rule <$comp> '?' <$comp> ':' <$comp> {op(condition:$1,true_val:$3,false_val:$5){
    if (condition) {
        true_val;
    } else {
        false_val;
    };
}};

/* Test ternary operator */
("Testing ternary operator...").echo();

age = 25;
status = age >= 18 ? "adult" : "minor";
("Age " + age + " is " + status).echo();

score = 85;
grade = score >= 90 ? "A" : score >= 80 ? "B" : score >= 70 ? "C" : "D";
("Score " + score + " gets grade " + grade).echo();

/* Step 7: Enhanced string operations using custom_function */
("Defining enhanced string operations...").echo();

/* String formatting with placeholders */
custom_function = rule <$comp> '.format' '(' <$list> ')' {op(template:$1,args:$4){
    result = template;
    
    /* Replace {0}, {1}, etc. with arguments */
    i = 1;
    while (i <= args.len()) {
        placeholder = "{" + (i-1) + "}";
        value = args[i];
        
        /* Simple string replacement */
        result = result.replace(placeholder, value);
        
        i += 1;
    };
    
    result;
}};

/* Test string formatting */
("Testing string formatting...").echo();

formatted = "Hello {0}, you have {1} messages".format("Bob", 5);
("Formatted: " + formatted).echo();

/* Step 8: Demonstrate integration with existing syntax */
("Demonstrating integration with existing syntax...").echo();

/* Mix custom functions with regular Grapa code */
numbers = [1, 2, 3, 4, 5];
squared = [n * n for n in numbers];
sum_squared = 0;

for i in range(1, squared.len() + 1) {
    sum_squared += squared[i];
};

("Sum of squares: " + sum_squared).echo();

/* Use with conditionals */
scores = [85, 92, 78, 96, 88];
passing = [score >= 80 ? "PASS" : "FAIL" for score in scores];
("Passing status: " + passing).echo();

("Custom function syntax demo completed successfully!").echo(); 