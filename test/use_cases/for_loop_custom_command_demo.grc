/*
 * Custom "for" Loop Implementation using custom_command
 * 
 * This script demonstrates how to extend Grapa's grammar with a custom "for" loop
 * syntax that feels natural to developers from Python, JavaScript, and other languages.
 * 
 * The implementation shows:
 * 1. How to define custom_command rules that extend the grammar
 * 2. How to implement the entire for loop logic within the rule definition
 * 3. How to use op()()() pattern to execute custom code
 * 4. How to handle different for loop patterns (range, list iteration, etc.)
 */

/* Step 1: Define the custom "for" loop command */
("Defining custom 'for' loop command...").echo();

custom_command = rule for '(' <$comp> ')' <$command> {op(init:$3,body:$6){
    /* Parse the initialization part (e.g., "i=0;i<10;i++") */
    init_parts = init.split(";");
    
    if (init_parts.len() < 3) {
        ("Error: for loop requires 3 parts separated by semicolons").echo();
        ("Format: for(init; condition; increment)").echo();
        return;
    };
    
    /* Extract the three parts */
    init_stmt = init_parts[1].trim();
    condition = init_parts[2].trim();
    increment = init_parts[3].trim();
    
    /* Execute the initialization */
    ("Executing initialization: " + init_stmt).echo();
    op()(init_stmt)();
    
    /* Main loop */
    loop_count = 0;
    max_iterations = 1000; /* Safety limit */
    
    while (loop_count < max_iterations) {
        /* Check condition */
        condition_result = op()(condition)();
        if (!condition_result || condition_result == 0 || condition_result == false) {
            break;
        };
        
        /* Execute loop body */
        ("Loop iteration " + (loop_count + 1) + ": executing body").echo();
        op()(body)();
        
        /* Execute increment */
        ("Executing increment: " + increment).echo();
        op()(increment)();
        
        loop_count += 1;
    };
    
    if (loop_count >= max_iterations) {
        ("Warning: Loop exceeded maximum iterations (" + max_iterations + ")").echo();
    };
    
    ("For loop completed after " + loop_count + " iterations").echo();
}};

/* Step 2: Define a more advanced "for" loop with range syntax */
("Defining advanced 'for' loop with range syntax...").echo();

custom_command = rule for $ID in <$comp> <$command> {op(var_name:$2,range_expr:$4,body:$6){
    /* Handle different range expressions */
    if (range_expr.type() == "$STR") {
        /* String iteration - iterate over characters */
        ("Iterating over string: " + range_expr).echo();
        i = 1;
        while (i <= range_expr.len()) {
            /* Set the loop variable */
            op()(var_name + " = \"" + range_expr[i] + "\"")();
            
            /* Execute loop body */
            ("Character " + i + ": " + range_expr[i]).echo();
            op()(body)();
            
            i += 1;
        };
    } else if (range_expr.type() == "$LIST" || range_expr.type() == "$ARRAY") {
        /* List/Array iteration */
        ("Iterating over list/array with " + range_expr.len() + " elements").echo();
        i = 1;
        while (i <= range_expr.len()) {
            /* Set the loop variable */
            op()(var_name + " = " + range_expr[i])();
            
            /* Execute loop body */
            ("Element " + i + ": " + range_expr[i]).echo();
            op()(body)();
            
            i += 1;
        };
    } else if (range_expr.type() == "$INT") {
        /* Integer range - treat as upper bound */
        ("Iterating from 1 to " + range_expr).echo();
        i = 1;
        while (i <= range_expr) {
            /* Set the loop variable */
            op()(var_name + " = " + i)();
            
            /* Execute loop body */
            ("Iteration " + i).echo();
            op()(body)();
            
            i += 1;
        };
    } else {
        ("Error: Unsupported range type: " + range_expr.type()).echo();
        return;
    };
    
    ("Range-based for loop completed").echo();
}};

/* Step 3: Test the basic for loop */
("Testing basic for loop...").echo();

/* Initialize a counter for demonstration */
counter = 0;

/* Execute the custom for loop */
for (i=0; i<5; i++) {
    counter += 1;
    ("Basic for loop iteration " + i + ", counter: " + counter).echo();
};

/* Step 4: Test the range-based for loop */
("Testing range-based for loop...").echo();

/* Test with string iteration */
for char in "Hello" {
    ("Character: " + char).echo();
};

/* Test with list iteration */
my_list = [10, 20, 30, 40, 50];
for item in my_list {
    ("List item: " + item).echo();
};

/* Test with integer range */
for num in 3 {
    ("Number: " + num).echo();
};

/* Step 5: Demonstrate nested for loops */
("Testing nested for loops...").echo();

for (i=1; i<=3; i++) {
    ("Outer loop iteration " + i).echo();
    
    for (j=1; j<=2; j++) {
        ("  Inner loop iteration " + j).echo();
    };
};

/* Step 6: Show how the custom command integrates with existing Grapa syntax */
("Demonstrating integration with existing Grapa syntax...").echo();

/* Mix custom for loops with regular Grapa code */
result = 0;
for (i=1; i<=5; i++) {
    result += i * i;
};
("Sum of squares from 1 to 5: " + result).echo();

/* Use for loop with conditional logic */
for (i=1; i<=10; i++) {
    if (i % 2 == 0) {
        ("Even number: " + i).echo();
    } else {
        ("Odd number: " + i).echo();
    };
};

("Custom for loop demonstration completed successfully!").echo(); 