/* Explanation: The Issue with sql_syntax_injection_table_demo.grc */

("=== The Issue with sql_syntax_injection_table_demo.grc ===").echo();

/* The original file had this fundamental problem: */

("PROBLEM: SELECT was defined as custom_function instead of custom_command").echo();
("\n").echo();

("❌ INCORRECT (Original file):").echo();
("custom_function = rule select $STR from $STR { ... }").echo();
("  - SELECT is an ACTION, not an expression").echo();
("  - SELECT displays results, doesn't return a value").echo();
("  - The 'return result_data' was ignored").echo();

("\n").echo();

("✅ CORRECT (Fixed):").echo();
("custom_command = rule select $STR from $STR { ... }").echo();
("  - SELECT is an ACTION that displays results").echo();
("  - No return value needed").echo();
("  - Used with op(parse)() to execute").echo();

("\n").echo();

("KEY DISTINCTION:").echo();
("custom_command: For ACTIONS (SELECT, INSERT, UPDATE)").echo();
("custom_function: For EXPRESSIONS that return values (COUNT, RANGE)").echo();

("\n").echo();

/* Demonstrate the correct usage */
("=== Correct Usage Demo ===").echo();

/* Create test data */
table = $file().table("ROW");
table.mkfield("name", "STR", "VAR");
table.set("user1", "John", "name");
table.set("user2", "Jane", "name");

/* Define SELECT as custom_command (CORRECT) */
custom_command = rule select $STR from $STR {op(fields:$2,table_name:$4){
    ("SELECT " + fields + " FROM " + table_name + " executed!").echo();
    records = table.ls();
    ("Found " + records.len() + " records").echo();
}};

/* Define COUNT as custom_function (CORRECT) */
custom_function = rule count '(' $STR ')' from $STR {op(field:$3,table_name:$6){
    ("COUNT(" + field + ") FROM " + table_name + " executed!").echo();
    records = table.ls();
    count = records.len();
    return count;  /* Returns a value */
}};

("Custom syntax defined!\n").echo();

/* Test the correct usage */
("Testing SELECT (action):").echo();
op(parse)("select * from users")();

("\n").echo();

("Testing COUNT (expression):").echo();
result = op(parse)("count(*) from users")();
("COUNT returned: " + result).echo();

("\n").echo();

("=== Summary ===").echo();
("The original file's issue: SELECT was custom_function instead of custom_command").echo();
("The fix: Use custom_command for actions, custom_function for expressions").echo();
("The execution: Use op(parse)() to run custom syntax after defining rules").echo();

("\n=== Explanation Complete ===").echo(); 