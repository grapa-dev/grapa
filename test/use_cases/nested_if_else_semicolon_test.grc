/* Test nested if/else semicolon requirements */

x = 10;

/* Test 1: Simple nested if/else */
if (x > 5) {
    if (x > 8) {
        "x > 8".echo();
    } else {
        "5 < x <= 8".echo();
    }
}

/* Test 2: Nested if/else with outer else */
if (x > 5) {
    if (x > 8) {
        "x > 8".echo();
    } else {
        "5 < x <= 8".echo();
    }
} else {
    "x <= 5".echo();
}

/* Test 3: Nested if/else with elseif */
if (x > 10) {
    if (x > 15) {
        "x > 15".echo();
    } else {
        "10 < x <= 15".echo();
    }
} else if (x > 5) {
    if (x > 8) {
        "8 < x <= 10".echo();
    } else {
        "5 < x <= 8".echo();
    }
} else {
    "x <= 5".echo();
}

/* Test 4: Nested if/else inside a block */
{
    if (x > 5) {
        if (x > 8) {
            "nested in block: x > 8".echo();
        } else {
            "nested in block: 5 < x <= 8".echo();
        }
    }
}

/* Test 5: Nested if/else with assignment */
result = if (x > 5) {
    if (x > 8) {
        "high"
    } else {
        "medium"
    }
} else {
    "low"
}

/* Test 6: Nested if/else in function */
testFunc = op() {
    if (x > 5) {
        if (x > 8) {
            "func nested: x > 8".echo();
        } else {
            "func nested: 5 < x <= 8".echo();
        }
    }
}

/* Test 7: Nested if/else with multiple statements */
if (x > 5) {
    "outer if".echo();
    if (x > 8) {
        "inner if".echo();
        "x > 8".echo();
    } else {
        "inner else".echo();
        "5 < x <= 8".echo();
    }
    "after nested".echo();
}

/* Test 8: Nested if/else with return */
if (x > 5) {
    if (x > 8) {
        return("high");
    } else {
        return("medium");
    }
} else {
    return("low");
}

"All nested if/else tests completed".echo();
