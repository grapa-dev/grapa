/* ========================================
 * String Interpolation - IMPROVED VERSION
 * Applying recent learnings: direct evaluation
 * ======================================== */

/* ========================================
 * ${expression} syntax
 * ======================================== */
custom_function = rule '$' '{' <$comp> '}' {
    op(expression:$3){
        result = expression();
        result.str();
    }
};

/* ========================================
 * Test the implementation
 * ======================================== */
("=== Testing String Interpolation (Improved) ===").echo();

/* Test basic string interpolation */
("Testing basic string interpolation...").echo();
name = "World";
greeting = "Hello ${name}!";
("Result: " + greeting).echo();

/* Test with mathematical expressions */
("Testing with mathematical expressions...").echo();
x = 5;
y = 3;
result = "The sum of ${x} and ${y} is ${x + y}";
("Result: " + result).echo();

/* Test with function calls */
("Testing with function calls...").echo();
numbers = [1, 2, 3, 4, 5];
result = "The length of the array is ${numbers.len()}";
("Result: " + result).echo();

/* Test with nested expressions */
("Testing with nested expressions...").echo();
data = [10, 20, 30];
result = "The first element is ${data[1]} and the sum is ${data[1] + data[2] + data[3]}";
("Result: " + result).echo();

/* Test with conditional expressions */
("Testing with conditional expressions...").echo();
value = 15;
result = "The value is ${value > 10 ? 'high' : 'low'}";
("Result: " + result).echo();

/* Test with string operations */
("Testing with string operations...").echo();
text = "hello world";
result = "Uppercase: ${text.upper()}";
("Result: " + result).echo();

/* Test with complex expressions */
("Testing with complex expressions...").echo();
a = 10;
b = 5;
c = 2;
result = "Complex calculation: ${(a + b) * c / 2}";
("Result: " + result).echo();

/* Test with multiple interpolations in one string */
("Testing with multiple interpolations...").echo();
name = "Alice";
age = 30;
city = "New York";
result = "Name: ${name}, Age: ${age}, City: ${city}";
("Result: " + result).echo();

("=== All string interpolation tests completed! ===").echo(); 