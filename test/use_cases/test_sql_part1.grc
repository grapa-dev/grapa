/* Test SQL Part 1: Table creation and custom_function */

"=== Testing SQL Part 1 ===").echo();

/* Create a users table */
users_table = $file().table("ROW");
users_table.mkfield("name", "STR", "VAR");
users_table.mkfield("age", "INT");
users_table.mkfield("city", "STR", "VAR");

/* Populate users table */
users_table.set("user1", "John", "name");
users_table.set("user1", 25, "age");
users_table.set("user1", "New York", "city");

("Sample data table created successfully.").echo();

/* Test the custom_function definition */
("Defining custom_function for SELECT...").echo();
custom_function = rule select $STR from $STR {op(fields:$2,table_name:$4){
    ("SQL SELECT: " + fields + " FROM " + table_name).echo();
    return "test result";
}};

("Custom function defined successfully.").echo();

/* Test the custom function */
("Testing custom function...").echo();
result = select * from users;
("Result: " + result).echo();

"=== Test Part 1 Complete ===").echo(); 