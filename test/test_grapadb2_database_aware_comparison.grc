"Example: Custom Comparison Plugin\n".echo();
/* This would be the new syntax for GrapaDBX */
/*
// Custom comparison for geographic coordinates
class GeoComparison : public GrapaDBXComparison {
    virtual GrapaError Compare(const GrapaDBXComparisonContext& context, ComparisonResult& result) override {
        // Custom logic for geographic distance comparison
        return CompareGeographicDistance(context, result);
    }
};

// Register custom comparison
f.registerComparison("GEO", new GeoComparison());

// Use custom comparison
f.mkfield("location", "GEO", "VAR");
f.setBatch("store1", {"location": {"lat": 40.7128, "lng": -74.0060}});  // NYC
f.setBatch("store2", {"location": {"lat": 34.0522, "lng": -118.2437}}); // LA

// Geographic search
results = f.search({"location": {"$near": {"lat": 40.0, "lng": -74.0, "radius": 100}}});
*/
