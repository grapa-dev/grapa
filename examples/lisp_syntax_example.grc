/* LISP Syntax Extension Example - True Native Syntax Using Grapa Grammar System */

/* Step 1: Set up data structures */
("Setting up LISP environment...\n").echo();
lisp_env = $list();
lisp_env.append("x", 10);
lisp_env.append("y", 20);
lisp_env.append("z", 30);

("LISP environment created with variables: x=10, y=20, z=30\n").echo();

/* Step 2: Define LISP syntax using Grapa's grammar system - NO MANUAL PARSING */

/* Initialize custom_command and custom_function for LISP syntax */
("Defining LISP syntax with native grammar...\n").echo();

/* S-expression with multiple arguments (MOST SPECIFIC FIRST) */
custom_command = rule '(' $ID $STR $STR ')' {op(function:$2,arg1:$3,arg2:$4){
    ("LISP S-expression: (" + function + " " + arg1 + " " + arg2 + ")\n").echo();
    
    if (function == "cons") {
        result = "(" + arg1 + " . " + arg2 + ")";
        ("Result: " + result + "\n").echo();
        return result;
    } else if (function == "list") {
        result = "(" + arg1 + " " + arg2 + ")";
        ("Result: " + result + "\n").echo();
        return result;
    };
    
    ("Unknown function: " + function + "\n").echo();
    return null;
}};

/* Basic S-expression with single argument (LESS SPECIFIC) */
custom_command ++= rule '(' $ID $STR ')' {op(function:$2,arg1:$3){
    ("LISP S-expression: (" + function + " " + arg1 + ")\n").echo();
    
    if (function == "car") {
        if (arg1 == "(1 2 3)") {
            result = 1;
            ("Result: " + result + "\n").echo();
            return result;
        };
    } else if (function == "cdr") {
        if (arg1 == "(1 2 3)") {
            result = "(2 3)";
            ("Result: " + result + "\n").echo();
            return result;
        };
    } else if (function == "cons") {
        if (arg1 == "1") {
            result = "(1 . nil)";
            ("Result: " + result + "\n").echo();
            return result;
        };
    };
    
    ("Unknown function: " + function + "\n").echo();
    return null;
}};

/* Function definition with multiple parameters (MOST SPECIFIC FIRST) */
custom_function = rule defun $STR '(' $STR $STR ')' $STR {op(func_name:$2,param1:$4,param2:$5,body:$7){
    ("LISP function definition: (defun " + func_name + " (" + param1 + " " + param2 + ") " + body + ")").echo();
    
    /* Store function definition in environment */
    func_def = $list();
    func_def.append("name", func_name);
    func_def.append("params", param1 + " " + param2);
    func_def.append("body", body);
    
    lisp_env.append(func_name, func_def);
    ("Function " + func_name + " defined with 2 parameters").echo();
    return func_name;
}};

/* Function definition with single parameter (LESS SPECIFIC) */
custom_function ++= rule defun $STR '(' $STR ')' $STR {op(func_name:$2,param:$4,body:$6){
    ("LISP function definition: (defun " + func_name + " (" + param + ") " + body + ")").echo();
    
    /* Store function definition in environment */
    func_def = $list();
    func_def.append("name", func_name);
    func_def.append("params", param);
    func_def.append("body", body);
    
    lisp_env.append(func_name, func_def);
    ("Function " + func_name + " defined").echo();
    return func_name;
}};

/* List operations (MOST SPECIFIC FIRST) */
custom_command ++= rule '(' list $STR $STR ')' {op(item1:$3,item2:$4){
    ("LISP list: (list " + item1 + " " + item2 + ")").echo();
    result = "(" + item1 + " " + item2 + ")";
    ("Result: " + result).echo();
    return result;
}};

custom_command ++= rule '(' list $STR ')' {op(item:$3){
    ("LISP list: (list " + item + ")").echo();
    result = "(" + item + ")";
    ("Result: " + result).echo();
    return result;
}};

/* Variable assignment */
custom_command ++= rule setq $STR $STR {op(var_name:$2,value:$3){
    ("LISP setq: (setq " + var_name + " " + value + ")").echo();
    
    /* Store variable in environment */
    lisp_env.append(var_name, value);
    ("Variable " + var_name + " set to " + value).echo();
    return value;
}};

/* Conditional expression */
custom_command ++= rule '(' cond '(' $STR $STR ')' ')' {op(condition:$4,action:$5){
    ("LISP cond: (cond (" + condition + " " + action + "))").echo();
    
    if (condition == "t") {
        ("Condition is true, executing: " + action).echo();
        return action;
    } else {
        ("Condition is false").echo();
        return null;
    };
}};

/* Quote expression */
custom_command ++= rule '(' quote $STR ')' {op(expression:$3){
    ("LISP quote: (quote " + expression + ")").echo();
    ("Result: " + expression).echo();
    return expression;
}};

("LISP native syntax defined!\n").echo();

/* Step 3: Test LISP syntax using op()(script)() or script.exec() */

("=== Testing LISP Native Syntax ===\n").echo();

("1. Basic S-expressions:\n").echo();
op()('(car "(1 2 3)")')();
op()('(cdr "(1 2 3)")')();
op()('(cons "1" "nil")')();

("2. S-expressions with multiple arguments:\n").echo();
op()('(cons "1" "2")')();
op()('(list "a" "b")')();

("3. Function definitions:\n").echo();
defun_square = op()('defun "square" ("x") "(* x x)"')();
defun_add = op()('defun "add" ("x" "y") "(+ x y)"')();

("4. List operations:\n").echo();
list_result1 = op()('(list "a")')();
list_result2 = op()('(list "a" "b")')();

("5. Variable assignment:\n").echo();
setq_result = op()('setq "new_var" "42"')();

("6. Conditional expression:\n").echo();
cond_result = op()('("cond" ("t" "success"))')();

("7. Quote expression:\n").echo();
quote_result = op()('("quote" "(a b c)")')();

("8. Check environment:").echo();
("Environment variables:").echo();
i = 0;
while (i < lisp_env.len()) {
    var_name = lisp_env.getname(i + 1);
    var_value = lisp_env.get(var_name);
    ("  " + var_name + " = " + var_value).echo();
    i = i + 1;
};

/* Step 4: Demonstrate expression usage */
("=== Expression Usage ===").echo();

("Using LISP results in expressions:").echo();
combined = list_result1 + " and " + list_result2;
("Combined: " + combined).echo();

("Using LISP results in comparisons:").echo();
if (setq_result == 42) {
    ("Variable assignment successful").echo();
} else {
    ("Variable assignment failed").echo();
};

("=== Power of Native Syntax ===").echo();
("This demonstrates TRUE native syntax using Grapa's grammar system.").echo();
("All parsing is handled by Grapa's grammar - no manual string manipulation.").echo();
("The grammar rules capture individual components as separate tokens.").echo();
("Implementation code receives already-parsed, structured data.").echo();
("Multiple LISP syntax patterns coexist using the ++= operator.").echo();
("LISP syntax is now truly native to Grapa!").echo();
